    let cap: i32 = mmio_read32((base + (INPUT_REG_CAPACITY()) as i64));
    if ((cap < 1)) {
        return 0;
    }
    let head: i32 = mmio_read32((base + (INPUT_REG_HEAD()) as i64));
    let tail: i32 = mmio_read32((base + (INPUT_REG_TAIL()) as i64));
    if ((head == tail)) {
        return 0;
    }
    let slot: i32 = input_chamber_ring_index(head, cap);
    let ev: i64 = input_chamber_event_addr(slot);
    kind.* = mmio_read32((ev + 0));
    mx.* = mmio_read32((ev + 4));
    my.* = mmio_read32((ev + 8));
    btn.* = mmio_read32((ev + 12));
    let next: i32 = input_chamber_ring_index((head + 1), cap);
    mmio_write32((base + (INPUT_REG_HEAD()) as i64), next);
    hw_fence();
    return 1;
}

fn input_chamber_poll(mx: *i32, my: *i32, btn: *i32) i32 {
    let kind: i32 = 0;
    return input_chamber_poll_ev(&kind, mx, my, btn);
}

fn input_chamber_inject_ev(kind: i32, x: i32, y: i32, btn: i32) void {
    let _rc: i32 = input_chamber_push_event(kind, x, y, btn);
}

fn input_chamber_inject(x: i32, y: i32, btn: i32) void {
    let kind: i32 = (INPUT_KIND_MOVE()) as i32;
    if ((btn != 0)) {
        kind = (INPUT_KIND_BUTTON()) as i32;
    }
    let _rc: i32 = input_chamber_push_event(kind, x, y, btn);
}

fn main() i32 {
    _zag_println("RayOS Input Injector starting...");
    if ((input_chamber_init() != 0)) {
        _zag_println("Failed to initialize input chamber");
        return 1;
    }
    _zag_println("Input chamber initialized");
    _zag_println("Reading events from /tmp/rayos_input.ev");
    _zag_println("Format: kind x y button (one event per line)");
    let input_path: []u8 = "/tmp/rayos_input.ev";
    while (1) {
        if ((_zag_file_exists(input_path) == 0)) {
            let i: i32 = 0;
            while ((i < 4096)) {
                i = (i + 1);
            }
        } else {
            let content: []u8 = _zag_read_file(input_path);
            if ((content.len > 0)) {
                let i: i32 = 0;
                let kind_start: i32 = i;
                while (((i < content.len) && (content[i] != (32) as u8))) {
                    i = (i + 1);
                }
                let kind_str: []u8 = content[kind_start..i];
                let kind: i32 = (_zag_str_to_i64(kind_str)) as i32;
                if ((i < content.len)) {
                    i = (i + 1);
                    let x_start: i32 = i;
                    while (((i < content.len) && (content[i] != (32) as u8))) {
                        i = (i + 1);
                    }
                    let x_str: []u8 = content[x_start..i];
                    let x: i32 = (_zag_str_to_i64(x_str)) as i32;
                    if ((i < content.len)) {
                        i = (i + 1);
                        let y_start: i32 = i;
                        while (((i < content.len) && (content[i] != (32) as u8))) {
                            i = (i + 1);
                        }
                        let y_str: []u8 = content[y_start..i];
                        let y: i32 = (_zag_str_to_i64(y_str)) as i32;
                        if ((i < content.len)) {
                            i = (i + 1);
                            let btn_start: i32 = i;
                            while (((i < content.len) && (content[i] != (10) as u8))) {
                                i = (i + 1);
                            }
                            let btn_str: []u8 = content[btn_start..i];
                            let btn: i32 = (_zag_str_to_i64(btn_str)) as i32;
                            input_chamber_inject(x, y, btn);
                            _zag_print("Injected: kind=");
                            _zag_print(_zag_i64_to_str((kind) as i64));
                            _zag_print(" x=");
                            _zag_print(_zag_i64_to_str((x) as i64));
                            _zag_print(" y=");
                            _zag_print(_zag_i64_to_str((y) as i64));
                            _zag_print(" btn=");
                            _zag_println(_zag_i64_to_str((btn) as i64));
                        }
                    }
                }
                _zag_write_file(input_path, "");
            } else {
                let i: i32 = 0;
                while ((i < 4096)) {
                    i = (i + 1);
                }
            }
        }
    }
    return 0;
}

