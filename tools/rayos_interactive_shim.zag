    let ev: i64 = input_chamber_event_addr(slot);
    mmio_write32((ev + 0), kind);
    mmio_write32((ev + 4), x);
    mmio_write32((ev + 8), y);
    mmio_write32((ev + 12), btn);
    let next: i32 = input_chamber_ring_index((tail + 1), cap);
    mmio_write32((base + (INPUT_REG_TAIL()) as i64), next);
    hw_fence();
    return 0;
}

fn input_chamber_poll_ev(kind: *i32, mx: *i32, my: *i32, btn: *i32) i32 {
