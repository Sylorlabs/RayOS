// net/http.flash — HTTP/1.1 client over the socket + TLS data planes.
//
// URL parse → (TLS if https) → request → response, with redirect following
// and chunked transfer decoding. http:// uses the raw socket path; https://
// uses the TLS 1.3 client in net/tls.flash (verified crypto in net/crypto).
//
//   let r: HttpResponse = http_get("https://example.com/");

@import("../driver/net_socket.flash")
@import("tls.flash")

struct HttpUrl {
    ok: i32,
    secure: i32,
    host: []u8,
    port: i32,
    path: []u8,
}

struct HttpResponse {
    ok: i32,
    status: i32,
    secure: i32,
    ip: i64,
    headers: []u8,
    body: []u8,
    error: []u8,
}

fn http_lower(c: u8) u8 {
    if (c >= ('A' as u8) && c <= ('Z' as u8)) { return c + 32; }
    return c;
}

fn http_ci_contains(hay: []u8, needle: []u8) i32 {
    if (needle.len < 1) { return 1; }
    if (hay.len < needle.len) { return 0; }
    let i: i32 = 0;
    while (i <= hay.len - needle.len) {
        let j: i32 = 0;
        let hit: i32 = 1;
        while (j < needle.len) {
            if (http_lower(hay[i + j]) != http_lower(needle[j])) { hit = 0; j = needle.len; }
            else { j = j + 1; }
        }
        if (hit == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Value of header `name` (case-insensitive), trimmed; "" if absent.
fn http_header(headers: []u8, name: []u8) []u8 {
    let n: i32 = 0;
    let start: i32 = 0;
    while (n <= headers.len) {
        if (n == headers.len || headers[n] == (10 as u8)) {
            let line: []u8 = headers[start..n];
            // line "Name: value"
            if (line.len > name.len + 1) {
                let match: i32 = 1;
                let k: i32 = 0;
                while (k < name.len) {
                    if (http_lower(line[k]) != http_lower(name[k])) { match = 0; k = name.len; }
                    else { k = k + 1; }
                }
                if (match == 1 && line[name.len] == (':' as u8)) {
                    let v: i32 = name.len + 1;
                    while (v < line.len && (line[v] == (' ' as u8) || line[v] == (9 as u8))) { v = v + 1; }
                    let e: i32 = line.len;
                    while (e > v && (line[e - 1] == (13 as u8) || line[e - 1] == (' ' as u8))) { e = e - 1; }
                    return line[v..e];
                }
            }
            start = n + 1;
        }
        n = n + 1;
    }
    return "";
}

fn http_parse_url(url: []u8) HttpUrl {
    let bad: HttpUrl = HttpUrl{ .ok = 0, .secure = 0, .host = "", .port = 80, .path = "/" };
    let at: i32 = 0;
    let scheme_end: i32 = 0 - 1;
    let i: i32 = 0;
    while (i + 2 < url.len) {
        if (url[i] == (':' as u8) && url[i + 1] == ('/' as u8) && url[i + 2] == ('/' as u8)) {
            scheme_end = i;
            i = url.len;
        } else {
            i = i + 1;
        }
    }
    let secure: i32 = 0;
    let port: i32 = 80;
    if (scheme_end >= 0) {
        if (scheme_end == 5) { secure = 1; port = 443; }   // "https"
        at = scheme_end + 3;
    }
    let hstart: i32 = at;
    while (at < url.len && url[at] != ('/' as u8) && url[at] != (':' as u8)) { at = at + 1; }
    let host: []u8 = url[hstart..at];
    if (host.len < 1) { return bad; }
    if (at < url.len && url[at] == (':' as u8)) {
        at = at + 1;
        let pstart: i32 = at;
        while (at < url.len && url[at] != ('/' as u8)) { at = at + 1; }
        port = _zag_str_to_i64(url[pstart..at]) as i32;
    }
    let path: []u8 = "/";
    if (at < url.len) { path = url[at..url.len]; }
    return HttpUrl{ .ok = 1, .secure = secure, .host = host, .port = port, .path = path };
}

fn http_parse_status(resp: []u8) i32 {
    let i: i32 = 0;
    while (i < resp.len && resp[i] != (' ' as u8)) { i = i + 1; }
    while (i < resp.len && resp[i] == (' ' as u8)) { i = i + 1; }
    let code: i32 = 0;
    while (i < resp.len && resp[i] >= ('0' as u8) && resp[i] <= ('9' as u8)) {
        code = code * 10 + ((resp[i] as i32) - ('0' as i32));
        i = i + 1;
    }
    return code;
}

fn http_body_offset(resp: []u8) i32 {
    let i: i32 = 0;
    while (i + 3 < resp.len) {
        if (resp[i] == (13 as u8) && resp[i + 1] == (10 as u8)
            && resp[i + 2] == (13 as u8) && resp[i + 3] == (10 as u8)) {
            return i + 4;
        }
        i = i + 1;
    }
    i = 0;
    while (i + 1 < resp.len) {
        if (resp[i] == (10 as u8) && resp[i + 1] == (10 as u8)) { return i + 2; }
        i = i + 1;
    }
    return resp.len;
}

fn http_hexval(c: u8) i32 {
    if (c >= ('0' as u8) && c <= ('9' as u8)) { return (c as i32) - ('0' as i32); }
    if (c >= ('a' as u8) && c <= ('f' as u8)) { return (c as i32) - ('a' as i32) + 10; }
    if (c >= ('A' as u8) && c <= ('F' as u8)) { return (c as i32) - ('A' as i32) + 10; }
    return 0 - 1;
}

// Decode a chunked transfer body into a fresh []u8.
fn http_dechunk(body: []u8) []u8 {
    let out: *i8 = _zag_malloc(body.len + 1);
    let n: i32 = 0;
    let at: i32 = 0;
    let go: i32 = 1;
    while (go == 1 && at < body.len) {
        // hex chunk size until CRLF
        let sz: i32 = 0;
        let any: i32 = 0;
        while (at < body.len && http_hexval(body[at]) >= 0) {
            sz = sz * 16 + http_hexval(body[at]);
            at = at + 1;
            any = any + 1;
        }
        // skip to end of line
        while (at < body.len && body[at] != (10 as u8)) { at = at + 1; }
        at = at + 1;
        if (any == 0 || sz == 0) { go = 0; }
        else {
            let k: i32 = 0;
            while (k < sz && at < body.len) { out[n] = body[at] as i8; n = n + 1; at = at + 1; k = k + 1; }
            // skip trailing CRLF
            while (at < body.len && (body[at] == (13 as u8) || body[at] == (10 as u8))) { at = at + 1; }
        }
    }
    let ou: *u8 = out as *u8;
    return ou[0..n];
}

fn http_err(msg: []u8) HttpResponse {
    return HttpResponse{
        .ok = 0, .status = 0, .secure = 0, .ip = 0 - 1, .headers = "", .body = "", .error = msg,
    };
}

// Single request, no redirect handling.
fn http_fetch_once(url: []u8) HttpResponse {
    let u: HttpUrl = http_parse_url(url);
    if (u.ok == 0) { return http_err("bad url"); }

    let resp: []u8 = "";
    if (u.secure == 1) {
        let cap: i32 = 524288;
        let out: *i8 = _zag_malloc(cap);
        let n: i32 = tls_https_get(u.host, u.port, u.path, out, cap);
        if (n < 0) { return http_err("tls handshake failed"); }
        let ou: *u8 = out as *u8;
        resp = ou[0..n];
    } else {
        let ip: i64 = net_dns_resolve(u.host);
        if (ip < 0) { return http_err("dns resolution failed"); }
        let fd: i64 = net_tcp_connect(ip, u.port);
        if (fd < 0) { return http_err("connect failed"); }
        let req: []u8 = _zag_str_concat("GET ", u.path);
        req = _zag_str_concat(req, " HTTP/1.1\r\nHost: ");
        req = _zag_str_concat(req, u.host);
        req = _zag_str_concat(req, "\r\nUser-Agent: RayBrowser/0.1 (RayOS)\r\nConnection: close\r\n\r\n");
        let w: i64 = net_tcp_send(fd, req);
        if (w < 0) { net_tcp_close(fd); return http_err("send failed"); }
        resp = net_tcp_recv_all(fd, 524288);
        net_tcp_close(fd);
    }
    if (resp.len < 12) { return http_err("empty response"); }

    let status: i32 = http_parse_status(resp);
    let boff: i32 = http_body_offset(resp);
    let headers: []u8 = resp[0..boff];
    let body: []u8 = resp[boff..resp.len];
    if (http_ci_contains(http_header(headers, "transfer-encoding"), "chunked") == 1) {
        body = http_dechunk(body);
    }
    return HttpResponse{
        .ok = 1, .status = status, .secure = u.secure, .ip = 0,
        .headers = headers, .body = body, .error = "",
    };
}

// Resolve a possibly-relative Location against the current URL.
fn http_resolve_location(base: []u8, loc: []u8) []u8 {
    if (loc.len < 1) { return base; }
    // absolute
    let i: i32 = 0;
    while (i + 2 < loc.len) {
        if (loc[i] == (':' as u8) && loc[i + 1] == ('/' as u8) && loc[i + 2] == ('/' as u8)) {
            return loc;
        }
        i = i + 1;
    }
    // absolute path on same origin: reuse scheme://host from base
    let bu: HttpUrl = http_parse_url(base);
    let scheme: []u8 = "http://";
    if (bu.secure == 1) { scheme = "https://"; }
    let origin: []u8 = _zag_str_concat(scheme, bu.host);
    if (loc[0] == ('/' as u8)) {
        return _zag_str_concat(origin, loc);
    }
    return _zag_str_concat(origin, _zag_str_concat("/", loc));
}

// GET with redirect following (up to 5 hops) + chunked decode.
fn http_get(url: []u8) HttpResponse {
    let current: []u8 = url;
    let hops: i32 = 0;
    let r: HttpResponse = http_fetch_once(current);
    while (r.ok == 1 && hops < 5
        && (r.status == 301 || r.status == 302 || r.status == 303
            || r.status == 307 || r.status == 308)) {
        let loc: []u8 = http_header(r.headers, "location");
        if (loc.len < 1) { hops = 5; }
        else {
            current = http_resolve_location(current, loc);
            r = http_fetch_once(current);
            hops = hops + 1;
        }
    }
    return r;
}
