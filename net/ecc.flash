// net/ecc.flash — bignum + NIST P-256/P-384 ECDSA verification, in Flash.
//
// Verified against test vectors (tests/ecc_test.flash). Base-2^16 limb
// bignum (add/sub/mul/mod/modexp/modinv), Jacobian curve arithmetic for
// a = -3 curves, generic ECDSA verify parameterised by curve. This is the
// signature-verification core of TLS certificate authentication.
//
// Native RayOS exposes an ECC-verify offload chamber; this is the Phase-1
// reference and host data plane.

@import("../core/constants.flash")
@import("../driver/hw_rt.flash")

// bignum: base 2^16, little-endian, fixed L limbs in an i64 array.
fn BL() i32 { return 64; }   // limbs (1024-bit); products use 2*BL

fn bn_new() *i64 {
    let a: *i64 = _zag_malloc(BL() * 2 * 8) as *i64;
    let i: i32 = 0; while (i < BL()*2) { a[i] = 0; i = i + 1; }
    return a;
}
fn bn_zero(a: *i64) void { let i: i32 = 0; while (i < BL()*2) { a[i] = 0; i = i + 1; } }
fn bn_copy(o: *i64, a: *i64) void { let i: i32 = 0; while (i < BL()*2) { o[i] = a[i]; i = i + 1; } }
fn bn_set_u32(a: *i64, v: i64) void { bn_zero(a); a[0] = v & 65535; a[1] = (v >> 16) & 65535; }

// compare a,b over L limbs: -1,0,1
fn bn_cmp(a: *i64, b: *i64, L: i32) i32 {
    let i: i32 = L - 1;
    while (i >= 0) {
        if (a[i] > b[i]) { return 1; }
        if (a[i] < b[i]) { return 0 - 1; }
        i = i - 1;
    }
    return 0;
}

// o = a - b (assumes a>=b), L limbs
fn bn_sub(o: *i64, a: *i64, b: *i64, L: i32) void {
    let borrow: i64 = 0;
    let i: i32 = 0;
    while (i < L) {
        let d: i64 = a[i] - b[i] - borrow;
        if (d < 0) { d = d + 65536; borrow = 1; } else { borrow = 0; }
        o[i] = d;
        i = i + 1;
    }
}

// o = a * b  (L limbs each -> up to 2L limbs)
fn bn_mul(o: *i64, a: *i64, b: *i64, L: i32) void {
    let i: i32 = 0; while (i < 2*L) { o[i] = 0; i = i + 1; }
    i = 0;
    while (i < L) {
        let carry: i64 = 0;
        let j: i32 = 0;
        while (j < L) {
            let cur: i64 = o[i+j] + a[i] * b[j] + carry;
            o[i+j] = cur & 65535;
            carry = cur >> 16;
            j = j + 1;
        }
        o[i + L] = o[i + L] + carry;
        i = i + 1;
    }
}

// shift-left by 1 bit over L limbs
fn bn_shl1(a: *i64, L: i32) void {
    let carry: i64 = 0;
    let i: i32 = 0;
    while (i < L) {
        let v: i64 = (a[i] << 1) + carry;
        a[i] = v & 65535;
        carry = (v >> 16) & 1;
        i = i + 1;
    }
}

// bit length over L limbs
fn bn_bits(a: *i64, L: i32) i32 {
    let i: i32 = L - 1;
    while (i >= 0) {
        if (a[i] != 0) {
            let b: i32 = 15;
            while (b >= 0) {
                if ((a[i] >> b) & 1 == 1) { return i * 16 + b + 1; }
                b = b - 1;
            }
        }
        i = i - 1;
    }
    return 0;
}

fn bn_getbit(a: *i64, k: i32) i64 { return (a[k / 16] >> (k % 16)) & 1; }

// r = a mod m, where a has up to 2L limbs, m has L limbs. r sized L.
fn bn_mod(r: *i64, a: *i64, m: *i64, L: i32) void {
    // work copy of a (2L limbs)
    let x: *i64 = bn_new();
    let i: i32 = 0; while (i < 2*L) { x[i] = a[i]; i = i + 1; }
    let ab: i32 = bn_bits(x, 2*L);
    let mb: i32 = bn_bits(m, L);
    if (ab < mb) { let k: i32 = 0; while (k < L) { r[k] = x[k]; k = k + 1; } return; }
    // shifted m (2L limbs)
    let sm: *i64 = bn_new();
    let k: i32 = 0; while (k < L) { sm[k] = m[k]; k = k + 1; }
    let shift: i32 = ab - mb;
    let s: i32 = 0; while (s < shift) { bn_shl1(sm, 2*L); s = s + 1; }
    let bit: i32 = shift;
    while (bit >= 0) {
        if (bn_cmp(x, sm, 2*L) >= 0) { bn_sub(x, x, sm, 2*L); }
        // sm >>= 1
        let j: i32 = 0;
        let carry: i64 = 0;
        let jj: i32 = 2*L - 1;
        while (jj >= 0) {
            let cur: i64 = sm[jj] + (carry << 16);
            sm[jj] = cur >> 1;
            carry = cur & 1;
            jj = jj - 1;
        }
        let _j: i32 = j;
        bit = bit - 1;
    }
    let z: i32 = 0; while (z < L) { r[z] = x[z]; z = z + 1; }
}

// r = (a*b) mod m, L limbs
fn bn_modmul(r: *i64, a: *i64, b: *i64, m: *i64, L: i32) void {
    let p: *i64 = bn_new();
    bn_mul(p, a, b, L);
    bn_mod(r, p, m, L);
}

// r = a^e mod m
fn bn_modexp(r: *i64, a: *i64, e: *i64, m: *i64, L: i32) void {
    let result: *i64 = bn_new(); result[0] = 1;
    let base: *i64 = bn_new(); bn_mod(base, a, m, L);
    let bits: i32 = bn_bits(e, L);
    let i: i32 = 0;
    while (i < bits) {
        if (bn_getbit(e, i) == 1) {
            let t: *i64 = bn_new();
            bn_modmul(t, result, base, m, L);
            bn_copy(result, t);
        }
        let t2: *i64 = bn_new();
        bn_modmul(t2, base, base, m, L);
        bn_copy(base, t2);
        i = i + 1;
    }
    bn_copy(r, result);
}

fn p256_p() *i64 {
    let a: *i64 = bn_new();
    a[0] = 65535;
    a[1] = 65535;
    a[2] = 65535;
    a[3] = 65535;
    a[4] = 65535;
    a[5] = 65535;
    a[12] = 1;
    a[14] = 65535;
    a[15] = 65535;
    return a;
}
