// modinv via Fermat: a^(m-2) mod m  (m prime)
fn bn_modinv(r: *i64, a: *i64, m: *i64, L: i32) void {
    let two: *i64 = bn_new(); two[0] = 2;
    let e: *i64 = bn_new();
    bn_sub(e, m, two, L);
    bn_modexp(r, a, e, m, L);
}

// modular add/sub mod m
fn bn_modadd(r: *i64, a: *i64, b: *i64, m: *i64, L: i32) void {
    let t: *i64 = bn_new();
    let carry: i64 = 0; let i: i32 = 0;
    while (i < L) { let c: i64 = a[i] + b[i] + carry; t[i] = c & 65535; carry = c >> 16; i = i + 1; }
    t[L] = carry;
    // reduce
    if (bn_cmp(t, m, L) >= 0 || t[L] != 0) { bn_sub(t, t, m, L); }
    let k: i32 = 0; while (k < L) { r[k] = t[k]; k = k + 1; }
}
fn bn_modsub(r: *i64, a: *i64, b: *i64, m: *i64, L: i32) void {
    let t: *i64 = bn_new();
    if (bn_cmp(a, b, L) >= 0) { bn_sub(t, a, b, L); }
    else { let s: *i64 = bn_new(); bn_sub(s, m, b, L); bn_modadd(t, a, s, m, L); }
    let k: i32 = 0; while (k < L) { r[k] = t[k]; k = k + 1; }
}

// Jacobian point: 3 arrays X,Y,Z each L limbs. Infinity: Z all zero.
fn pt_is_inf(Z: *i64, L: i32) i32 {
    let i: i32 = 0; while (i < L) { if (Z[i] != 0) { return 0; } i = i + 1; }
    return 1;
}

fn ec_double(X: *i64, Y: *i64, Z: *i64, oX: *i64, oY: *i64, oZ: *i64, p: *i64, L: i32) void {
    if (pt_is_inf(Z, L) == 1) { bn_zero(oZ); return; }
    let A: *i64 = bn_new(); bn_modmul(A, Y, Y, p, L);            // Y^2
    let t: *i64 = bn_new(); bn_modmul(t, X, A, p, L);            // X*A
    let B: *i64 = bn_new(); bn_modadd(B, t, t, p, L); bn_modadd(B, B, B, p, L);  // 4XA
    let A2: *i64 = bn_new(); bn_modmul(A2, A, A, p, L);          // A^2
    let C: *i64 = bn_new(); bn_modadd(C, A2, A2, p, L); bn_modadd(C, C, C, p, L); bn_modadd(C, C, C, p, L); // 8A^2
    let ZZ: *i64 = bn_new(); bn_modmul(ZZ, Z, Z, p, L);         // Z^2
    let xm: *i64 = bn_new(); bn_modsub(xm, X, ZZ, p, L);        // X - Z^2
    let xp: *i64 = bn_new(); bn_modadd(xp, X, ZZ, p, L);        // X + Z^2
    let D: *i64 = bn_new(); bn_modmul(D, xm, xp, p, L);         // (X-Z^2)(X+Z^2)
    let D3: *i64 = bn_new(); bn_modadd(D3, D, D, p, L); bn_modadd(D3, D3, D, p, L); // 3*D
    let D2: *i64 = bn_new(); bn_modmul(D2, D3, D3, p, L);       // D^2
    let twoB: *i64 = bn_new(); bn_modadd(twoB, B, B, p, L);
    let nX: *i64 = bn_new(); bn_modsub(nX, D2, twoB, p, L);     // X3
    let bx: *i64 = bn_new(); bn_modsub(bx, B, nX, p, L);
    let dbx: *i64 = bn_new(); bn_modmul(dbx, D3, bx, p, L);
    let nY: *i64 = bn_new(); bn_modsub(nY, dbx, C, p, L);       // Y3
    let yz: *i64 = bn_new(); bn_modmul(yz, Y, Z, p, L);
    let nZ: *i64 = bn_new(); bn_modadd(nZ, yz, yz, p, L);       // Z3
    let k: i32 = 0; while (k < L) { oX[k]=nX[k]; oY[k]=nY[k]; oZ[k]=nZ[k]; k=k+1; }
}

fn ec_add(X1:*i64,Y1:*i64,Z1:*i64, X2:*i64,Y2:*i64,Z2:*i64, oX:*i64,oY:*i64,oZ:*i64, p:*i64, L:i32) void {
    if (pt_is_inf(Z1,L)==1) { let k:i32=0; while(k<L){oX[k]=X2[k];oY[k]=Y2[k];oZ[k]=Z2[k];k=k+1;} return; }
    if (pt_is_inf(Z2,L)==1) { let k:i32=0; while(k<L){oX[k]=X1[k];oY[k]=Y1[k];oZ[k]=Z1[k];k=k+1;} return; }
    let Z1Z1:*i64=bn_new(); bn_modmul(Z1Z1,Z1,Z1,p,L);
    let Z2Z2:*i64=bn_new(); bn_modmul(Z2Z2,Z2,Z2,p,L);
    let U1:*i64=bn_new(); bn_modmul(U1,X1,Z2Z2,p,L);
    let U2:*i64=bn_new(); bn_modmul(U2,X2,Z1Z1,p,L);
    let t1:*i64=bn_new(); bn_modmul(t1,Z2,Z2Z2,p,L);
    let S1:*i64=bn_new(); bn_modmul(S1,Y1,t1,p,L);
    let t2:*i64=bn_new(); bn_modmul(t2,Z1,Z1Z1,p,L);
    let S2:*i64=bn_new(); bn_modmul(S2,Y2,t2,p,L);
    if (bn_cmp(U1,U2,L)==0) {
        if (bn_cmp(S1,S2,L)==0) { ec_double(X1,Y1,Z1,oX,oY,oZ,p,L); return; }
        bn_zero(oZ); return;
    }
    let H:*i64=bn_new(); bn_modsub(H,U2,U1,p,L);
    let twoH:*i64=bn_new(); bn_modadd(twoH,H,H,p,L);
    let I:*i64=bn_new(); bn_modmul(I,twoH,twoH,p,L);
    let J:*i64=bn_new(); bn_modmul(J,H,I,p,L);
    let ds:*i64=bn_new(); bn_modsub(ds,S2,S1,p,L);
    let rr:*i64=bn_new(); bn_modadd(rr,ds,ds,p,L);
    let V:*i64=bn_new(); bn_modmul(V,U1,I,p,L);
    let rr2:*i64=bn_new(); bn_modmul(rr2,rr,rr,p,L);
    let twoV:*i64=bn_new(); bn_modadd(twoV,V,V,p,L);
    let nX:*i64=bn_new(); bn_modsub(nX,rr2,J,p,L); bn_modsub(nX,nX,twoV,p,L);
    let vx:*i64=bn_new(); bn_modsub(vx,V,nX,p,L);
    let rvx:*i64=bn_new(); bn_modmul(rvx,rr,vx,p,L);
    let s1j:*i64=bn_new(); bn_modmul(s1j,S1,J,p,L); bn_modadd(s1j,s1j,s1j,p,L);
    let nY:*i64=bn_new(); bn_modsub(nY,rvx,s1j,p,L);
    let z1z2:*i64=bn_new(); bn_modadd(z1z2,Z1,Z2,p,L);
    let zz:*i64=bn_new(); bn_modmul(zz,z1z2,z1z2,p,L);
    bn_modsub(zz,zz,Z1Z1,p,L); bn_modsub(zz,zz,Z2Z2,p,L);
    let nZ:*i64=bn_new(); bn_modmul(nZ,zz,H,p,L);
    let k:i32=0; while(k<L){oX[k]=nX[k];oY[k]=nY[k];oZ[k]=nZ[k];k=k+1;}
}

// scalar * (X,Y,1) -> (oX,oY,oZ) Jacobian
fn ec_mul(k: *i64, X:*i64,Y:*i64, oX:*i64,oY:*i64,oZ:*i64, p:*i64, L:i32) void {
    let rX:*i64=bn_new(); let rY:*i64=bn_new(); let rZ:*i64=bn_new(); bn_zero(rZ);  // infinity
    let bits: i32 = bn_bits(k, L);
    let i: i32 = bits - 1;
    while (i >= 0) {
        let dX:*i64=bn_new(); let dY:*i64=bn_new(); let dZ:*i64=bn_new();
        ec_double(rX,rY,rZ, dX,dY,dZ, p, L);
        let k2:i32=0; while(k2<L){rX[k2]=dX[k2];rY[k2]=dY[k2];rZ[k2]=dZ[k2];k2=k2+1;}
        if (bn_getbit(k, i) == 1) {
            let one:*i64=bn_new(); one[0]=1;
            let aX:*i64=bn_new(); let aY:*i64=bn_new(); let aZ:*i64=bn_new();
            ec_add(rX,rY,rZ, X,Y,one, aX,aY,aZ, p, L);
            let k3:i32=0; while(k3<L){rX[k3]=aX[k3];rY[k3]=aY[k3];rZ[k3]=aZ[k3];k3=k3+1;}
        }
        i = i - 1;
    }
    let kk:i32=0; while(kk<L){oX[kk]=rX[kk];oY[kk]=rY[kk];oZ[kk]=rZ[kk];kk=kk+1;}
}


// Generic ECDSA verify over a short-Weierstrass curve with a = -3
// (true for NIST P-256 and P-384). Curve supplied via p, n, gx, gy and L.
// hash is the big-endian message digest as a bignum (already truncated to
// the curve order's bit length by the caller). Returns 1 iff valid.
fn ecdsa_verify_curve(p:*i64, n:*i64, gx:*i64, gy:*i64, L:i32,
                      Qx:*i64, Qy:*i64, hash:*i64, r:*i64, s:*i64) i32 {
    // reject r,s outside [1, n-1]
    let zero:*i64=bn_new();
    if (bn_cmp(r, zero, L) == 0) { return 0; }
    if (bn_cmp(s, zero, L) == 0) { return 0; }
    if (bn_cmp(r, n, L) >= 0) { return 0; }
    if (bn_cmp(s, n, L) >= 0) { return 0; }
    let w:*i64=bn_new(); bn_modinv(w, s, n, L);
    let hn:*i64=bn_new(); bn_mod(hn, hash, n, L);
    let u1:*i64=bn_new(); bn_modmul(u1, hn, w, n, L);
    let u2:*i64=bn_new(); bn_modmul(u2, r, w, n, L);
    let aX:*i64=bn_new(); let aY:*i64=bn_new(); let aZ:*i64=bn_new();
    ec_mul(u1, gx, gy, aX,aY,aZ, p, L);
    let bX:*i64=bn_new(); let bY:*i64=bn_new(); let bZ:*i64=bn_new();
    ec_mul(u2, Qx, Qy, bX,bY,bZ, p, L);
    let RX:*i64=bn_new(); let RY:*i64=bn_new(); let RZ:*i64=bn_new();
    ec_add(aX,aY,aZ, bX,bY,bZ, RX,RY,RZ, p, L);
    if (pt_is_inf(RZ, L) == 1) { return 0; }
    let z2:*i64=bn_new(); bn_modmul(z2, RZ, RZ, p, L);
    let zi:*i64=bn_new(); bn_modinv(zi, z2, p, L);
    let x:*i64=bn_new(); bn_modmul(x, RX, zi, p, L);
    let xn:*i64=bn_new(); bn_mod(xn, x, n, L);
    if (bn_cmp(xn, r, L) == 0) { return 1; }
    return 0;
}

fn ecdsa_verify_p256(Qx:*i64,Qy:*i64,hash:*i64,r:*i64,s:*i64) i32 {
    return ecdsa_verify_curve(p256_p(), p256_n(), p256_gx(), p256_gy(), 16, Qx,Qy,hash,r,s);
}
fn ecdsa_verify_p384(Qx:*i64,Qy:*i64,hash:*i64,r:*i64,s:*i64) i32 {
    return ecdsa_verify_curve(p384_p(), p384_n(), p384_gx(), p384_gy(), 24, Qx,Qy,hash,r,s);
}

// Load a big-endian byte buffer into a bignum (L limbs, base 2^16).
fn bn_from_be(a:*i64, buf:*i8, off:i32, n:i32, L:i32) void {
    bn_zero(a);
    let i:i32=0;
    while (i < n) {
        let byteval:i64 = (buf[off + n - 1 - i] as u8) as i64;
        let limb:i32 = i / 2;
        if (i % 2 == 0) { a[limb] = a[limb] + byteval; }
        else { a[limb] = a[limb] + (byteval << 8); }
        i = i + 1;
    }
    let _l:i32 = L;
}
