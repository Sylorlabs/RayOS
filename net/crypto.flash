// net/crypto.flash — TLS 1.3 cryptographic primitives, in Flash.
//
// Every primitive below is verified bit-exact against its official test
// vector (see tests/crypto_test.flash): SHA-256 (FIPS 180-4), ChaCha20 +
// Poly1305 (RFC 8439), X25519 (RFC 7748). HMAC/HKDF follow RFC 5869 / RFC
// 8446 section 7.1. Native RayOS hardware exposes a crypto-offload chamber;
// these software implementations are the Phase-1 host data plane and the
// reference the offload must match.
//
// Note: M32()/rotl() etc. are defined once here; do not redefine downstream.

@import("../core/constants.flash")
@import("../driver/hw_rt.flash")

fn M32() i64 { return 4294967295; }
fn rotr(x: i64, n: i64) i64 { return ((x >> n) + (x << (32 - n))) & M32(); }
fn rotl(x: i64, n: i64) i64 { return ((x << n) + (x >> (32 - n))) & M32(); }
fn shr32(x: i64, n: i64) i64 { return (x >> n) & M32(); }

fn sha_k(i: i32) i64 {
    if (i == 0) { return 1116352408; }
    if (i == 1) { return 1899447441; }
    if (i == 2) { return 3049323471; }
    if (i == 3) { return 3921009573; }
    if (i == 4) { return 961987163; }
    if (i == 5) { return 1508970993; }
    if (i == 6) { return 2453635748; }
    if (i == 7) { return 2870763221; }
    if (i == 8) { return 3624381080; }
    if (i == 9) { return 310598401; }
    if (i == 10) { return 607225278; }
    if (i == 11) { return 1426881987; }
    if (i == 12) { return 1925078388; }
    if (i == 13) { return 2162078206; }
    if (i == 14) { return 2614888103; }
    if (i == 15) { return 3248222580; }
    if (i == 16) { return 3835390401; }
    if (i == 17) { return 4022224774; }
    if (i == 18) { return 264347078; }
    if (i == 19) { return 604807628; }
    if (i == 20) { return 770255983; }
    if (i == 21) { return 1249150122; }
    if (i == 22) { return 1555081692; }
    if (i == 23) { return 1996064986; }
    if (i == 24) { return 2554220882; }
    if (i == 25) { return 2821834349; }
    if (i == 26) { return 2952996808; }
    if (i == 27) { return 3210313671; }
    if (i == 28) { return 3336571891; }
    if (i == 29) { return 3584528711; }
    if (i == 30) { return 113926993; }
    if (i == 31) { return 338241895; }
    if (i == 32) { return 666307205; }
    if (i == 33) { return 773529912; }
    if (i == 34) { return 1294757372; }
    if (i == 35) { return 1396182291; }
    if (i == 36) { return 1695183700; }
    if (i == 37) { return 1986661051; }
    if (i == 38) { return 2177026350; }
    if (i == 39) { return 2456956037; }
    if (i == 40) { return 2730485921; }
    if (i == 41) { return 2820302411; }
    if (i == 42) { return 3259730800; }
    if (i == 43) { return 3345764771; }
    if (i == 44) { return 3516065817; }
    if (i == 45) { return 3600352804; }
    if (i == 46) { return 4094571909; }
    if (i == 47) { return 275423344; }
    if (i == 48) { return 430227734; }
    if (i == 49) { return 506948616; }
    if (i == 50) { return 659060556; }
    if (i == 51) { return 883997877; }
    if (i == 52) { return 958139571; }
    if (i == 53) { return 1322822218; }
    if (i == 54) { return 1537002063; }
    if (i == 55) { return 1747873779; }
    if (i == 56) { return 1955562222; }
    if (i == 57) { return 2024104815; }
    if (i == 58) { return 2227730452; }
    if (i == 59) { return 2361852424; }
    if (i == 60) { return 2428436474; }
    if (i == 61) { return 2756734187; }
    if (i == 62) { return 3204031479; }
    if (i == 63) { return 3329325298; }
    return 0;
}

// hash `msg` (len bytes) into out[0..32]
fn sha256(msg: *i8, mlen: i32, out: *i8) void {
    let h0: i64 = 1779033703; let h1: i64 = 3144134277; let h2: i64 = 1013904242; let h3: i64 = 2773480762;
    let h4: i64 = 1359893119; let h5: i64 = 2600822924; let h6: i64 = 528734635; let h7: i64 = 1541459225;
    // padded length
    let bitlen: i64 = (mlen as i64) * 8;
    let total: i32 = mlen + 1;
    while (total % 64 != 56) { total = total + 1; }
    total = total + 8;
    let buf: *i8 = _zag_malloc(total);
    let i: i32 = 0;
    while (i < mlen) { buf[i] = msg[i]; i = i + 1; }
    buf[mlen] = 128 as i8;   // 0x80
    let j: i32 = mlen + 1;
    while (j < total - 8) { buf[j] = 0 as i8; j = j + 1; }
    let b: i32 = 0;
    while (b < 8) {
        buf[total - 1 - b] = ((bitlen >> (b * 8)) & 255) as i8;
        b = b + 1;
    }
    let w: *i8 = _zag_malloc(64 * 8);   // schedule as i64 array via reinterpret
    let wi: *i64 = w as *i64;
    let blk: i32 = 0;
    while (blk < total) {
        let t: i32 = 0;
        while (t < 16) {
            let o: i32 = blk + t * 4;
            wi[t] = (((buf[o] as u8) as i64) << 24) + (((buf[o+1] as u8) as i64) << 16)
                  + (((buf[o+2] as u8) as i64) << 8) + ((buf[o+3] as u8) as i64);
            t = t + 1;
        }
        while (t < 64) {
            let s0: i64 = rotr(wi[t-15],7) ^ rotr(wi[t-15],18) ^ shr32(wi[t-15],3);
            let s1: i64 = rotr(wi[t-2],17) ^ rotr(wi[t-2],19) ^ shr32(wi[t-2],10);
            wi[t] = (wi[t-16] + s0 + wi[t-7] + s1) & M32();
            t = t + 1;
        }
        let a: i64 = h0; let bb: i64 = h1; let cc: i64 = h2; let dd: i64 = h3;
        let ee: i64 = h4; let ff: i64 = h5; let gg: i64 = h6; let hh: i64 = h7;
        t = 0;
        while (t < 64) {
            let S1: i64 = rotr(ee,6) ^ rotr(ee,11) ^ rotr(ee,25);
            let ch: i64 = (ee & ff) ^ (((ee ^ M32()) & gg));
            let temp1: i64 = (hh + S1 + ch + sha_k(t) + wi[t]) & M32();
            let S0: i64 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
            let maj: i64 = (a & bb) ^ (a & cc) ^ (bb & cc);
            let temp2: i64 = (S0 + maj) & M32();
            hh = gg; gg = ff; ff = ee; ee = (dd + temp1) & M32();
            dd = cc; cc = bb; bb = a; a = (temp1 + temp2) & M32();
            t = t + 1;
        }
        h0=(h0+a)&M32(); h1=(h1+bb)&M32(); h2=(h2+cc)&M32(); h3=(h3+dd)&M32();
        h4=(h4+ee)&M32(); h5=(h5+ff)&M32(); h6=(h6+gg)&M32(); h7=(h7+hh)&M32();
        blk = blk + 64;
    }
    let hs: *i64 = _zag_malloc(64) as *i64;
    hs[0]=h0; hs[1]=h1; hs[2]=h2; hs[3]=h3; hs[4]=h4; hs[5]=h5; hs[6]=h6; hs[7]=h7;
    let x: i32 = 0;
    while (x < 8) {
        out[x*4]   = ((hs[x] >> 24) & 255) as i8;
        out[x*4+1] = ((hs[x] >> 16) & 255) as i8;
        out[x*4+2] = ((hs[x] >> 8) & 255) as i8;
        out[x*4+3] = (hs[x] & 255) as i8;
        x = x + 1;
    }
}


fn le32(b: *i8, o: i32) i64 {
    return ((b[o] as u8) as i64) + (((b[o+1] as u8) as i64) << 8)
         + (((b[o+2] as u8) as i64) << 16) + (((b[o+3] as u8) as i64) << 24);
}

// one chacha20 block: key[32] nonce[12] counter -> out[64] keystream
fn chacha_block(key: *i8, nonce: *i8, counter: i64, out: *i8) void {
    let s: *i64 = _zag_malloc(16 * 8) as *i64;
    s[0]=1634760805; s[1]=857760878; s[2]=2036477234; s[3]=1797285236;
    let i: i32 = 0;
    while (i < 8) { s[4+i] = le32(key, i*4); i = i + 1; }
    s[12] = counter & M32();
    s[13] = le32(nonce, 0); s[14] = le32(nonce, 4); s[15] = le32(nonce, 8);
    let w: *i64 = _zag_malloc(16 * 8) as *i64;
    i = 0;
    while (i < 16) { w[i] = s[i]; i = i + 1; }
    let r: i32 = 0;
    while (r < 10) {
        chacha_qr(w, 0, 4, 8, 12);
        chacha_qr(w, 1, 5, 9, 13);
        chacha_qr(w, 2, 6, 10, 14);
        chacha_qr(w, 3, 7, 11, 15);
        chacha_qr(w, 0, 5, 10, 15);
        chacha_qr(w, 1, 6, 11, 12);
        chacha_qr(w, 2, 7, 8, 13);
        chacha_qr(w, 3, 4, 9, 14);
        r = r + 1;
    }
    i = 0;
    while (i < 16) {
        let v: i64 = (w[i] + s[i]) & M32();
        out[i*4]   = (v & 255) as i8;
        out[i*4+1] = ((v >> 8) & 255) as i8;
        out[i*4+2] = ((v >> 16) & 255) as i8;
        out[i*4+3] = ((v >> 24) & 255) as i8;
        i = i + 1;
    }
}

fn chacha_qr(w: *i64, a: i32, b: i32, c: i32, d: i32) void {
    w[a] = (w[a] + w[b]) & M32(); w[d] = rotl(w[d] ^ w[a], 16);
    w[c] = (w[c] + w[d]) & M32(); w[b] = rotl(w[b] ^ w[c], 12);
    w[a] = (w[a] + w[b]) & M32(); w[d] = rotl(w[d] ^ w[a], 8);
    w[c] = (w[c] + w[d]) & M32(); w[b] = rotl(w[b] ^ w[c], 7);
}


fn u8to32(m: *i8, o: i32) i64 {
    return ((m[o] as u8) as i64) + (((m[o+1] as u8) as i64) << 8)
         + (((m[o+2] as u8) as i64) << 16) + (((m[o+3] as u8) as i64) << 24);
}

// poly1305 MAC: msg[mlen], key[32] -> tag[16]
fn poly1305(msg: *i8, mlen: i32, key: *i8, tag: *i8) void {
    let t0: i64 = u8to32(key,0); let t1: i64 = u8to32(key,4);
    let t2: i64 = u8to32(key,8); let t3: i64 = u8to32(key,12);
    let r0: i64 = t0 & 67108863;
    let r1: i64 = ((t0 >> 26) + (t1 << 6)) & 67108611;
    let r2: i64 = ((t1 >> 20) + (t2 << 12)) & 67092735;
    let r3: i64 = ((t2 >> 14) + (t3 << 18)) & 66076671;
    let r4: i64 = (t3 >> 8) & 1048575;
    let s1: i64 = r1 * 5; let s2: i64 = r2 * 5; let s3: i64 = r3 * 5; let s4: i64 = r4 * 5;
    let h0: i64 = 0; let h1: i64 = 0; let h2: i64 = 0; let h3: i64 = 0; let h4: i64 = 0;

    let blk: *i8 = _zag_malloc(16);
    let at: i32 = 0;
    while (at < mlen) {
        let n: i32 = mlen - at;
        let hibit: i64 = 16777216;   // 1<<24
        if (n >= 16) {
            n = 16;
        } else {
            let z: i32 = 0;
            while (z < 16) { blk[z] = 0 as i8; z = z + 1; }
            z = 0;
            while (z < n) { blk[z] = msg[at+z]; z = z + 1; }
            blk[n] = 1 as i8;
            hibit = 0;
        }
        let mm: *i8 = msg;
        let off: i32 = at;
        if (n < 16 || hibit == 0) { mm = blk; off = 0; }
        let m0: i64 = u8to32(mm, off); let m1: i64 = u8to32(mm, off+4);
        let m2: i64 = u8to32(mm, off+8); let m3: i64 = u8to32(mm, off+12);
        h0 = h0 + (m0 & 67108863);
        h1 = h1 + (((m0 >> 26) + (m1 << 6)) & 67108863);
        h2 = h2 + (((m1 >> 20) + (m2 << 12)) & 67108863);
        h3 = h3 + (((m2 >> 14) + (m3 << 18)) & 67108863);
        h4 = h4 + ((m3 >> 8) + hibit);

        let d0: i64 = h0*r0 + h1*s4 + h2*s3 + h3*s2 + h4*s1;
        let d1: i64 = h0*r1 + h1*r0 + h2*s4 + h3*s3 + h4*s2;
        let d2: i64 = h0*r2 + h1*r1 + h2*r0 + h3*s4 + h4*s3;
        let d3: i64 = h0*r3 + h1*r2 + h2*r1 + h3*r0 + h4*s4;
        let d4: i64 = h0*r4 + h1*r3 + h2*r2 + h3*r1 + h4*r0;

        let c: i64 = d0 >> 26; h0 = d0 & 67108863;
        d1 = d1 + c; c = d1 >> 26; h1 = d1 & 67108863;
        d2 = d2 + c; c = d2 >> 26; h2 = d2 & 67108863;
        d3 = d3 + c; c = d3 >> 26; h3 = d3 & 67108863;
        d4 = d4 + c; c = d4 >> 26; h4 = d4 & 67108863;
        h0 = h0 + c * 5; c = h0 >> 26; h0 = h0 & 67108863; h1 = h1 + c;

        at = at + n;
    }
    // fully carry h
    let c: i64 = h1 >> 26; h1 = h1 & 67108863; h2 = h2 + c;
    c = h2 >> 26; h2 = h2 & 67108863; h3 = h3 + c;
    c = h3 >> 26; h3 = h3 & 67108863; h4 = h4 + c;
    c = h4 >> 26; h4 = h4 & 67108863; h0 = h0 + c * 5;
    c = h0 >> 26; h0 = h0 & 67108863; h1 = h1 + c;
    // compute h - p
    let g0: i64 = h0 + 5; c = g0 >> 26; g0 = g0 & 67108863;
    let g1: i64 = h1 + c; c = g1 >> 26; g1 = g1 & 67108863;
    let g2: i64 = h2 + c; c = g2 >> 26; g2 = g2 & 67108863;
    let g3: i64 = h3 + c; c = g3 >> 26; g3 = g3 & 67108863;
    let g4: i64 = h4 + c - 67108864;
    // select h if g4 negative
    let mask: i64 = (g4 >> 63);   // all-ones if negative
    let nmask: i64 = mask ^ 4611686018427387903;   // not, but simpler below
    // if mask==-1 keep h else keep g
    h0 = (h0 & mask) + (g0 & (mask ^ 18446744073709551615));
    h1 = (h1 & mask) + (g1 & (mask ^ 18446744073709551615));
    h2 = (h2 & mask) + (g2 & (mask ^ 18446744073709551615));
    h3 = (h3 & mask) + (g3 & (mask ^ 18446744073709551615));
    h4 = (h4 & mask) + (g4 & (mask ^ 18446744073709551615));
    let _n: i64 = nmask;
    // serialize h (26-bit limbs) to 128-bit little-endian
    let f0: i64 = (h0 + (h1 << 26)) & 4294967295;
    let f1: i64 = ((h1 >> 6) + (h2 << 20)) & 4294967295;
    let f2: i64 = ((h2 >> 12) + (h3 << 14)) & 4294967295;
    let f3: i64 = ((h3 >> 18) + (h4 << 8)) & 4294967295;
    // add s = key[16..32]
    let s0: i64 = u8to32(key,16); let sk1: i64 = u8to32(key,20);
    let s2v: i64 = u8to32(key,24); let s3v: i64 = u8to32(key,28);
    let acc: i64 = f0 + s0; let o0: i64 = acc & 4294967295;
    acc = f1 + sk1 + (acc >> 32); let o1: i64 = acc & 4294967295;
    acc = f2 + s2v + (acc >> 32); let o2: i64 = acc & 4294967295;
    acc = f3 + s3v + (acc >> 32); let o3: i64 = acc & 4294967295;
    let out: *i64 = _zag_malloc(32) as *i64;
    let vals: *i8 = tag;
    let words: i32 = 0;
    let ww: i32 = 0;
    // write 4 words LE
    let wv: *i8 = _zag_malloc(4);
    let _u: i32 = ww; let _w2: i32 = words; let _o: *i64 = out; let _wv: *i8 = wv; let _v2: *i8 = vals;
    tag[0]=(o0 & 255) as i8; tag[1]=((o0>>8)&255) as i8; tag[2]=((o0>>16)&255) as i8; tag[3]=((o0>>24)&255) as i8;
    tag[4]=(o1 & 255) as i8; tag[5]=((o1>>8)&255) as i8; tag[6]=((o1>>16)&255) as i8; tag[7]=((o1>>24)&255) as i8;
    tag[8]=(o2 & 255) as i8; tag[9]=((o2>>8)&255) as i8; tag[10]=((o2>>16)&255) as i8; tag[11]=((o2>>24)&255) as i8;
    tag[12]=(o3 & 255) as i8; tag[13]=((o3>>8)&255) as i8; tag[14]=((o3>>16)&255) as i8; tag[15]=((o3>>24)&255) as i8;
}


fn gf() *i64 {
    let g: *i64 = _zag_malloc(16 * 8) as *i64;
    let i: i32 = 0; while (i < 16) { g[i] = 0; i = i + 1; }
    return g;
}
fn gfcopy(o: *i64, a: *i64) void { let i: i32 = 0; while (i < 16) { o[i] = a[i]; i = i + 1; } }

fn car25519(o: *i64) void {
    let i: i32 = 0;
    while (i < 16) {
        o[i] = o[i] + 65536;      // 1<<16
        let c: i64 = o[i] >> 16;
        let idx: i32 = 0;
        if (i < 15) { idx = i + 1; }
        let add: i64 = c - 1;
        if (i == 15) { add = add + 37 * (c - 1); }
        o[idx] = o[idx] + add;
        o[i] = o[i] - (c << 16);
        i = i + 1;
    }
}

fn sel25519(p: *i64, q: *i64, b: i64) void {
    let c: i64 = (b - 1) ^ (0 - 1);   // ~(b-1)
    let i: i32 = 0;
    while (i < 16) {
        let t: i64 = c & (p[i] ^ q[i]);
        p[i] = p[i] ^ t;
        q[i] = q[i] ^ t;
        i = i + 1;
    }
}

fn A(o: *i64, a: *i64, b: *i64) void { let i: i32 = 0; while (i < 16) { o[i] = a[i] + b[i]; i = i + 1; } }
fn Z(o: *i64, a: *i64, b: *i64) void { let i: i32 = 0; while (i < 16) { o[i] = a[i] - b[i]; i = i + 1; } }

fn M(o: *i64, a: *i64, b: *i64) void {
    let t: *i64 = _zag_malloc(31 * 8) as *i64;
    let i: i32 = 0; while (i < 31) { t[i] = 0; i = i + 1; }
    i = 0;
    while (i < 16) {
        let j: i32 = 0;
        while (j < 16) { t[i+j] = t[i+j] + a[i] * b[j]; j = j + 1; }
        i = i + 1;
    }
    i = 0; while (i < 15) { t[i] = t[i] + 38 * t[i+16]; i = i + 1; }
    i = 0; while (i < 16) { o[i] = t[i]; i = i + 1; }
    car25519(o); car25519(o);
}
fn S(o: *i64, a: *i64) void { M(o, a, a); }

fn inv25519(o: *i64, in: *i64) void {
    let c: *i64 = gf(); gfcopy(c, in);
    let a: i32 = 253;
    while (a >= 0) {
        S(c, c);
        if (a != 2 && a != 4) { M(c, c, in); }
        a = a - 1;
    }
    gfcopy(o, c);
}

fn unpack25519(o: *i64, n: *i8) void {
    let i: i32 = 0;
    while (i < 16) {
        o[i] = ((n[2*i] as u8) as i64) + (((n[2*i+1] as u8) as i64) << 8);
        i = i + 1;
    }
    o[15] = o[15] & 32767;   // 0x7fff
}

fn pack25519(o: *i8, n: *i64) void {
    let t: *i64 = gf(); gfcopy(t, n);
    car25519(t); car25519(t); car25519(t);
    let j: i32 = 0;
    while (j < 2) {
        let m: *i64 = gf();
        m[0] = t[0] - 65517;   // 0xffed
        let i: i32 = 1;
        while (i < 15) {
            m[i] = t[i] - 65535 - ((m[i-1] >> 16) & 1);
            m[i-1] = m[i-1] & 65535;
            i = i + 1;
        }
        m[15] = t[15] - 32767 - ((m[14] >> 16) & 1);
        let b: i64 = (m[15] >> 16) & 1;
        m[14] = m[14] & 65535;
        sel25519(t, m, 1 - b);
        j = j + 1;
    }
    let i: i32 = 0;
    while (i < 16) {
        o[2*i] = (t[i] & 255) as i8;
        o[2*i+1] = ((t[i] >> 8) & 255) as i8;
        i = i + 1;
    }
}

fn scalarmult(q: *i8, n: *i8, p: *i8) void {
    let z: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while (i < 32) { z[i] = n[i]; i = i + 1; }
    z[31] = (((n[31] as u8) as i64 & 63) + 64) as i8;
    z[0] = ((n[0] as u8) as i64 & 248) as i8;
    let x: *i64 = gf(); unpack25519(x, p);
    let a: *i64 = gf(); let b: *i64 = gf(); let c: *i64 = gf(); let d: *i64 = gf();
    let e: *i64 = gf(); let f: *i64 = gf();
    i = 0; while (i < 16) { b[i] = x[i]; i = i + 1; }
    a[0] = 1; d[0] = 1;
    let bit: i32 = 254;
    while (bit >= 0) {
        let r: i64 = (((z[bit >> 3] as u8) as i64) >> (bit & 7)) & 1;
        sel25519(a, b, r); sel25519(c, d, r);
        A(e, a, c); Z(a, a, c); A(c, b, d); Z(b, b, d);
        S(d, e); S(f, a); M(a, c, a); M(c, b, e);
        A(e, a, c); Z(a, a, c); S(b, a); Z(c, d, f);
        let c121665: *i64 = gf(); c121665[0] = 56129; c121665[1] = 1;
        M(a, c, c121665); A(a, a, d); M(c, c, a); M(a, d, f); M(d, b, x);
        S(b, e); sel25519(a, b, r); sel25519(c, d, r);
        bit = bit - 1;
    }
    inv25519(c, c); M(a, a, c); pack25519(q, a);
}


// ── HMAC-SHA256 (RFC 2104) ───────────────────────────────────────────────────

fn hmac_sha256(key: *i8, keylen: i32, msg: *i8, msglen: i32, out: *i8) void {
    let k: *i8 = _zag_malloc(64);
    let i: i32 = 0;
    if (keylen > 64) {
        let kh: *i8 = _zag_malloc(32);
        sha256(key, keylen, kh);
        while (i < 32) { k[i] = kh[i]; i = i + 1; }
        while (i < 64) { k[i] = 0 as i8; i = i + 1; }
    } else {
        while (i < keylen) { k[i] = key[i]; i = i + 1; }
        while (i < 64) { k[i] = 0 as i8; i = i + 1; }
    }
    let ipad: *i8 = _zag_malloc(64 + msglen);
    i = 0;
    while (i < 64) { ipad[i] = (((k[i] as u8) as i64) ^ 54) as i8; i = i + 1; }
    i = 0;
    while (i < msglen) { ipad[64 + i] = msg[i]; i = i + 1; }
    let inner: *i8 = _zag_malloc(32);
    sha256(ipad, 64 + msglen, inner);
    let opad: *i8 = _zag_malloc(96);
    i = 0;
    while (i < 64) { opad[i] = (((k[i] as u8) as i64) ^ 92) as i8; i = i + 1; }
    i = 0;
    while (i < 32) { opad[64 + i] = inner[i]; i = i + 1; }
    sha256(opad, 96, out);
}

// ── HKDF (RFC 5869) + TLS 1.3 HKDF-Expand-Label (RFC 8446 7.1) ────────────────

fn hkdf_extract(salt: *i8, saltlen: i32, ikm: *i8, ikmlen: i32, prk: *i8) void {
    hmac_sha256(salt, saltlen, ikm, ikmlen, prk);
}

fn hkdf_expand(prk: *i8, info: *i8, infolen: i32, outlen: i32, out: *i8) void {
    let t: *i8 = _zag_malloc(32);
    let tlen: i32 = 0;
    let done: i32 = 0;
    let ctr: i32 = 1;
    while (done < outlen) {
        let buf: *i8 = _zag_malloc(32 + infolen + 1);
        let bl: i32 = 0;
        let j: i32 = 0;
        while (j < tlen) { buf[bl] = t[j]; bl = bl + 1; j = j + 1; }
        j = 0;
        while (j < infolen) { buf[bl] = info[j]; bl = bl + 1; j = j + 1; }
        buf[bl] = ctr as i8; bl = bl + 1;
        hmac_sha256(prk, 32, buf, bl, t);
        tlen = 32;
        let k: i32 = 0;
        while (k < 32 && done < outlen) { out[done] = t[k]; done = done + 1; k = k + 1; }
        ctr = ctr + 1;
    }
}

// HKDF-Expand-Label(secret, label, context, length)
fn hkdf_expand_label(secret: *i8, label: []u8, ctx: *i8, ctxlen: i32, outlen: i32, out: *i8) void {
    // HkdfLabel = uint16 length || (1+6+labellen) "tls13 "+label || (1+ctxlen) context
    let info: *i8 = _zag_malloc(16 + label.len + ctxlen);
    let n: i32 = 0;
    info[n] = ((outlen >> 8) & 255) as i8; n = n + 1;
    info[n] = (outlen & 255) as i8; n = n + 1;
    info[n] = (6 + label.len) as i8; n = n + 1;
    let pfx: []u8 = "tls13 ";
    let i: i32 = 0;
    while (i < 6) { info[n] = pfx[i] as i8; n = n + 1; i = i + 1; }
    i = 0;
    while (i < label.len) { info[n] = label[i] as i8; n = n + 1; i = i + 1; }
    info[n] = ctxlen as i8; n = n + 1;
    i = 0;
    while (i < ctxlen) { info[n] = ctx[i]; n = n + 1; i = i + 1; }
    hkdf_expand(secret, info, n, outlen, out);
}

// ── ChaCha20 stream + ChaCha20-Poly1305 AEAD (RFC 8439) ──────────────────────

fn chacha20_xor(key: *i8, nonce: *i8, counter: i64, data: *i8, dlen: i32, out: *i8) void {
    let ks: *i8 = _zag_malloc(64);
    let i: i32 = 0;
    while (i < dlen) {
        if (i % 64 == 0) {
            chacha_block(key, nonce, counter + (i / 64) as i64, ks);
        }
        out[i] = (((data[i] as u8) as i64) ^ ((ks[i % 64] as u8) as i64)) as i8;
        i = i + 1;
    }
}

fn aead_pad16(n: i32) i32 {
    let r: i32 = n % 16;
    if (r == 0) { return 0; }
    return 16 - r;
}

// Build the Poly1305 mac input: aad|pad|ct|pad|le64(aadlen)|le64(ctlen)
fn aead_mac_data(aad: *i8, aadlen: i32, ct: *i8, ctlen: i32, out: *i8) i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < aadlen) { out[n] = aad[i]; n = n + 1; i = i + 1; }
    let p: i32 = aead_pad16(aadlen);
    i = 0; while (i < p) { out[n] = 0 as i8; n = n + 1; i = i + 1; }
    i = 0; while (i < ctlen) { out[n] = ct[i]; n = n + 1; i = i + 1; }
    p = aead_pad16(ctlen);
    i = 0; while (i < p) { out[n] = 0 as i8; n = n + 1; i = i + 1; }
    let a: i64 = aadlen as i64;
    i = 0; while (i < 8) { out[n] = ((a >> (i * 8)) & 255) as i8; n = n + 1; i = i + 1; }
    let c: i64 = ctlen as i64;
    i = 0; while (i < 8) { out[n] = ((c >> (i * 8)) & 255) as i8; n = n + 1; i = i + 1; }
    return n;
}

// Seal: out gets ciphertext (dlen) followed by 16-byte tag.
fn aead_seal(key: *i8, nonce: *i8, aad: *i8, aadlen: i32, pt: *i8, dlen: i32, out: *i8) void {
    let polykey: *i8 = _zag_malloc(64);
    chacha_block(key, nonce, 0, polykey);
    chacha20_xor(key, nonce, 1, pt, dlen, out);
    let md: *i8 = _zag_malloc(aadlen + dlen + 64);
    let mdlen: i32 = aead_mac_data(aad, aadlen, out, dlen, md);
    poly1305(md, mdlen, polykey, ((out as i64) + (dlen as i64)) as *i8);
}

// Open: verifies the tag over ct[ctlen] (tag is the trailing 16 bytes). Returns
// 1 and writes plaintext (ctlen-16 bytes) to out on success, 0 on auth failure.
fn aead_open(key: *i8, nonce: *i8, aad: *i8, aadlen: i32, ct: *i8, ctlen: i32, out: *i8) i32 {
    if (ctlen < 16) { return 0; }
    let clen: i32 = ctlen - 16;
    let polykey: *i8 = _zag_malloc(64);
    chacha_block(key, nonce, 0, polykey);
    let md: *i8 = _zag_malloc(aadlen + clen + 64);
    let mdlen: i32 = aead_mac_data(aad, aadlen, ct, clen, md);
    let tag: *i8 = _zag_malloc(16);
    poly1305(md, mdlen, polykey, tag);
    let i: i32 = 0;
    let diff: i32 = 0;
    while (i < 16) {
        if (((tag[i] as u8) as i32) != ((ct[clen + i] as u8) as i32)) { diff = 1; }
        i = i + 1;
    }
    if (diff == 1) { return 0; }
    chacha20_xor(key, nonce, 1, ct, clen, out);
    return 1;
}

// ── randomness ───────────────────────────────────────────────────────────────
//
// Host: /dev/urandom. Native RayOS: the photonic true-random chamber. Both
// fill `out` with `n` cryptographically-strong bytes.
fn crypto_random(out: *i8, n: i32) i32 {
    let path: []u8 = "/dev/urandom";
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(path), 0, 0, 0, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let got: i32 = 0;
    while (got < n) {
        let r: i64 = _zag_raw_syscall(0, fd, (out as i64) + (got as i64), (n - got) as i64, 0, 0, 0);
        if (r <= 0) {
            let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
            return 0 - 2;
        }
        got = got + (r as i32);
    }
    let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return 0;
}

// X25519 base-point scalar mult (public key from private): base u=9.
fn x25519_base(pub: *i8, priv: *i8) void {
    let base: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while (i < 32) { base[i] = 0 as i8; i = i + 1; }
    base[0] = 9 as i8;
    scalarmult(pub, priv, base);
}

fn x25519_shared(out: *i8, priv: *i8, peer: *i8) void {
    scalarmult(out, priv, peer);
}
