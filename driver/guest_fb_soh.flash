// driver/guest_fb_soh.flash — SOH guest RGB24 pool bridge for compositor scanout.
//
// Binds to a compositor guest_pool ArrayList[u8] and provides bump allocation
// plus rectangular fill helpers for guest window content.
//
//   @import("guest_fb_soh.flash")
//   guest_fb_bind_pool(&comp.guest_pool);
//   let off: i32 = guest_fb_alloc(640, 400);
//   guest_fb_fill(comp.guest_pool, off, 640, 400, 32, 48, 96);

@import("hw_rt.flash")

struct GuestFbSohState {
    pool: *ArrayList[u8],
    bound: i32,
}

fn GUEST_FB_SOH_MAGIC() i32 { return 1195989076; }   // "GFBS" (0x47464253)

fn guest_fb_soh_state_new() GuestFbSohState {
    return GuestFbSohState{
        .pool = 0 as *ArrayList[u8],
        .bound = 0,
    };
}

fn guest_fb_soh_state_mut() *GuestFbSohState {
    let st: *GuestFbSohState = (hw_globals() + HW_GSLOT_GUEST_FB_SOH()) as *GuestFbSohState;
    return st;
}

fn guest_fb_bind_pool(pool: *ArrayList[u8]) void {
    let st: *GuestFbSohState = guest_fb_soh_state_mut();
    st.*.pool = pool;
    st.*.bound = 1;
}

fn guest_fb_alloc(w: i32, h: i32) i32 {
    if (w < 1) { return 0 - 1; }
    if (h < 1) { return 0 - 2; }
    let st: *GuestFbSohState = guest_fb_soh_state_mut();
    if (st.*.bound == 0) { return 0 - 3; }
    if (st.*.pool == (0 as *ArrayList[u8])) { return 0 - 4; }
    let bytes: i32 = w * h * 3;
    let off: i32 = len[u8](st.*.pool.*);
    let i: i32 = 0;
    while (i < bytes) {
        push[u8](st.*.pool, 0);
        i = i + 1;
    }
    return off;
}

fn guest_fb_fill(pool: ArrayList[u8], off: i32, w: i32, h: i32, r: i32, g: i32, b: i32) void {
    if (w < 1) { return; }
    if (h < 1) { return; }
    let y: i32 = 0;
    while (y < h) {
        let x: i32 = 0;
        while (x < w) {
            let di: i32 = off + (y * w + x) * 3;
            if (di >= 0) {
                if (di + 2 < len[u8](pool)) {
                    set[u8](&pool, di, r as u8);
                    set[u8](&pool, di + 1, g as u8);
                    set[u8](&pool, di + 2, b as u8);
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}