// driver/sysbus.flash — hardware topology access (Phase-1 host bootstrap).
//
// Real ternary hardware exposes bus topology through enumeration chambers;
// until then the host kernel's sysfs is the authoritative source, read
// through raw syscalls exactly like hw_rt reads the MMIO window. Nothing
// here is hardcoded: every device, link state, and mode is read live.
//
//   let names: []u8 = sysbus_listdir("/sys/class/net");   // newline-joined
//   let state: []u8 = sysbus_read_line("/sys/class/net/eth0/operstate");

@import("../core/constants.flash")
@import("hw_rt.flash")

fn SYSBUS_O_DIRECTORY() i64 { return 65536; }
fn SYSBUS_DENTS_BUF() i32 { return 16384; }

// Newline-joined directory entries ("." and ".." excluded); "" on failure.
fn sysbus_listdir(path: []u8) []u8 {
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(path), SYSBUS_O_DIRECTORY(), 0, 0, 0, 0);
    if (fd < 0) { return ""; }
    let buf: *i8 = _zag_malloc(SYSBUS_DENTS_BUF());
    let out: []u8 = "";
    let done: i32 = 0;
    while (done == 0) {
        let n: i64 = _zag_raw_syscall(217, fd, buf as i64, SYSBUS_DENTS_BUF() as i64, 0, 0, 0);
        if (n <= 0) {
            done = 1;
        } else {
            // struct linux_dirent64: u64 ino, u64 off, u16 reclen, u8 type, name...
            let at: i32 = 0;
            while ((at as i64) < n) {
                let reclen: i32 = ((buf[at + 16] as u8) as i32) + ((buf[at + 17] as u8) as i32) * 256;
                let ns: i32 = at + 19;
                let ne: i32 = ns;
                while (buf[ne] != (0 as i8)) { ne = ne + 1; }
                let bufu: *u8 = buf as *u8;
                let name: []u8 = bufu[ns..ne];
                if (_zag_strcmp(name, ".") == 0 && _zag_strcmp(name, "..") == 0) {
                    if (out.len > 0) {
                        out = _zag_str_concat(out, "\n");
                    }
                    out = _zag_str_concat(out, name);
                }
                at = at + reclen;
            }
        }
    }
    let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return out;
}

fn sysbus_exists(path: []u8) i32 {
    return _zag_file_exists(path);
}

// First line of a file, trailing whitespace stripped; "" when unreadable.
fn sysbus_read_line(path: []u8) []u8 {
    if (_zag_file_exists(path) == 0) { return ""; }
    let s: []u8 = _zag_read_file(path);
    if (s.len < 1) { return ""; }
    let end: i32 = 0;
    while (end < s.len && s[end] != ('\n' as u8) && s[end] != ('\r' as u8)) {
        end = end + 1;
    }
    while (end > 0 && s[end - 1] == (' ' as u8)) {
        end = end - 1;
    }
    return s[0..end];
}

fn sysbus_path2(a: []u8, b: []u8) []u8 {
    return _zag_str_concat(a, b);
}

fn sysbus_path3(a: []u8, b: []u8, c: []u8) []u8 {
    return _zag_str_concat(_zag_str_concat(a, b), c);
}

// 1 when `hay` contains `needle`.
fn sysbus_contains(hay: []u8, needle: []u8) i32 {
    if (needle.len < 1) { return 1; }
    if (hay.len < needle.len) { return 0; }
    let i: i32 = 0;
    while (i <= hay.len - needle.len) {
        let j: i32 = 0;
        let hit: i32 = 1;
        while (j < needle.len) {
            if (hay[i + j] != needle[j]) {
                hit = 0;
                j = needle.len;
            } else {
                j = j + 1;
            }
        }
        if (hit == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Split helper: line `idx` (0-based) of a newline-joined blob; "" past end.
fn sysbus_line_at(blob: []u8, idx: i32) []u8 {
    let line: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= blob.len) {
        if (i == blob.len || blob[i] == ('\n' as u8)) {
            if (line == idx) {
                return blob[start..i];
            }
            line = line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn sysbus_line_count(blob: []u8) i32 {
    if (blob.len < 1) { return 0; }
    let n: i32 = 1;
    let i: i32 = 0;
    while (i < blob.len) {
        if (blob[i] == ('\n' as u8)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
