// browser/html.flash — bounded HTML document parser for the native Ray browser.
//
// The parser owns no foreign engine. It tokenizes element/text/comment/doctype
// syntax, builds a parented DOM, handles void elements and mismatched closing
// tags, and treats scripts as inert document data until a Flash-native script
// runtime is available. Web bytes are an explicit foreign protocol boundary.

fn html_node_document() t9 { return 0; }
fn html_node_element() t9 { return 1; }
fn html_node_text() t9 { return 0 - 1; }
fn html_no_parent() t27 { return 0 - 1; }
fn html_max_nodes() t27 { return 729; }
fn html_max_depth() t9 { return 27; }

struct HtmlNode {
    kind: t9,
    parent: t27,
    depth: t9,
    tag: []u8,
    text: []u8,
}

struct HtmlDocument {
    source: []u8,
    nodes: ArrayList[HtmlNode],
    errors: t27,
    truncated: t9,
}

fn html_ascii_lower(c: u8) u8 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

fn html_equal_fold(a: []u8, b: []u8) i32 {
    if (a.len != b.len) { return 0; }
    let i: i32 = 0;
    while (i < a.len) {
        if (html_ascii_lower(a[i]) != html_ascii_lower(b[i])) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn html_is_space(c: u8) i32 {
    if (c == 9 || c == 10 || c == 12 || c == 13 || c == 32) { return 1; }
    return 0;
}

fn html_is_name_char(c: u8) i32 {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 45 || c == 58 || c == 95) { return 1; }
    return 0;
}

fn html_is_void(tag: []u8) i32 {
    if (html_equal_fold(tag, "area") == 1 || html_equal_fold(tag, "base") == 1) { return 1; }
    if (html_equal_fold(tag, "br") == 1 || html_equal_fold(tag, "col") == 1) { return 1; }
    if (html_equal_fold(tag, "embed") == 1 || html_equal_fold(tag, "hr") == 1) { return 1; }
    if (html_equal_fold(tag, "img") == 1 || html_equal_fold(tag, "input") == 1) { return 1; }
    if (html_equal_fold(tag, "link") == 1 || html_equal_fold(tag, "meta") == 1) { return 1; }
    if (html_equal_fold(tag, "source") == 1 || html_equal_fold(tag, "track") == 1) { return 1; }
    if (html_equal_fold(tag, "wbr") == 1) { return 1; }
    return 0;
}

fn html_find_sequence(source: []u8, start: i32, needle: []u8) i32 {
    if (needle.len < 1) { return start; }
    let i: i32 = start;
    while (i + needle.len <= source.len) {
        let match: i32 = 1;
        let j: i32 = 0;
        while (j < needle.len) {
            if (source[i + j] != needle[j]) { match = 0; }
            j = j + 1;
        }
        if (match == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn html_trim(source: []u8, start: i32, end: i32) []u8 {
    let lo: i32 = start;
    let hi: i32 = end;
    while (lo < hi && html_is_space(source[lo]) == 1) { lo = lo + 1; }
    while (hi > lo && html_is_space(source[hi - 1]) == 1) { hi = hi - 1; }
    return source[lo..hi];
}

fn html_document_new(source: []u8) HtmlDocument {
    let doc: HtmlDocument = HtmlDocument{
        .source = source,
        .nodes = make[HtmlNode](81),
        .errors = 0,
        .truncated = 0,
    };
    push[HtmlNode](&doc.nodes, HtmlNode{
        .kind = html_node_document(),
        .parent = html_no_parent(),
        .depth = 0,
        .tag = "#document",
        .text = "",
    });
    return doc;
}

fn html_document_free(doc: *HtmlDocument) void {
    free[HtmlNode](&doc.*.nodes);
}

fn html_parent(stack: *ArrayList[t27]) t27 {
    if (len[t27](stack.*) < 1) { return 0; }
    return get[t27](stack.*, len[t27](stack.*) - 1);
}

fn html_push_node(doc: *HtmlDocument, node: HtmlNode) t27 {
    if (len[HtmlNode](doc.*.nodes) as t27 >= html_max_nodes()) {
        doc.*.truncated = 1;
        return html_no_parent();
    }
    let index: t27 = len[HtmlNode](doc.*.nodes) as t27;
    push[HtmlNode](&doc.*.nodes, node);
    return index;
}

fn html_close_tag(doc: *HtmlDocument, stack: *ArrayList[t27], tag: []u8) void {
    let i: i32 = len[t27](stack.*) - 1;
    while (i > 0) {
        let index: t27 = get[t27](stack.*, i);
        let node: HtmlNode = get[HtmlNode](doc.*.nodes, index as i32);
        if (html_equal_fold(node.tag, tag) == 1) {
            while (len[t27](stack.*) - 1 >= i) { let _drop: t27 = pop[t27](stack); }
            return;
        }
        i = i - 1;
    }
    doc.*.errors = doc.*.errors + 1;
}

fn html_parse(source: []u8) HtmlDocument {
    let doc: HtmlDocument = html_document_new(source);
    let stack: ArrayList[t27] = make[t27](27);
    push[t27](&stack, 0);
    let at: i32 = 0;
    while (at < source.len && doc.truncated == 0) {
        if (source[at] != 60) {
            let end: i32 = at;
            while (end < source.len && source[end] != 60) { end = end + 1; }
            let text: []u8 = html_trim(source, at, end);
            if (text.len > 0) {
                let depth: t9 = (len[t27](stack) - 1) as t9;
                let _text_index: t27 = html_push_node(&doc, HtmlNode{
                    .kind = html_node_text(), .parent = html_parent(&stack),
                    .depth = depth, .tag = "#text", .text = text,
                });
            }
            at = end;
        } else if (at + 3 < source.len && source[at + 1] == 33 &&
                   source[at + 2] == 45 && source[at + 3] == 45) {
            let close: i32 = html_find_sequence(source, at + 4, "-->");
            if (close < 0) { doc.errors = doc.errors + 1; at = source.len; }
            else { at = close + 3; }
        } else if (at + 1 < source.len && source[at + 1] == 33) {
            let close2: i32 = html_find_sequence(source, at + 2, ">");
            if (close2 < 0) { doc.errors = doc.errors + 1; at = source.len; }
            else { at = close2 + 1; }
        } else {
            let closing: i32 = 0;
            let p: i32 = at + 1;
            if (p < source.len && source[p] == 47) { closing = 1; p = p + 1; }
            while (p < source.len && html_is_space(source[p]) == 1) { p = p + 1; }
            let name_start: i32 = p;
            while (p < source.len && html_is_name_char(source[p]) == 1) { p = p + 1; }
            let tag: []u8 = source[name_start..p];
            let quote: u8 = 0;
            let self_close: i32 = 0;
            let scan_done: i32 = 0;
            while (p < source.len && scan_done == 0) {
                let c: u8 = source[p];
                if (quote != 0) {
                    if (c == quote) { quote = 0; }
                } else if (c == 34 || c == 39) { quote = c; }
                else if (c == 62) { scan_done = 1; }
                else if (c == 47) { self_close = 1; }
                if (scan_done == 0) { p = p + 1; }
            }
            if (tag.len < 1 || p >= source.len) {
                doc.errors = doc.errors + 1;
                at = at + 1;
            } else {
                if (closing == 1) { html_close_tag(&doc, &stack, tag); }
                else {
                    let depth2: t9 = (len[t27](stack) - 1) as t9;
                    let index: t27 = html_push_node(&doc, HtmlNode{
                        .kind = html_node_element(), .parent = html_parent(&stack),
                        .depth = depth2, .tag = tag, .text = "",
                    });
                    if (index >= 0 && self_close == 0 && html_is_void(tag) == 0) {
                        if (depth2 < html_max_depth()) { push[t27](&stack, index); }
                        else { doc.errors = doc.errors + 1; }
                    }
                }
                at = p + 1;
            }
        }
    }
    free[t27](&stack);
    return doc;
}

fn html_count_kind(doc: *HtmlDocument, kind: t9) t27 {
    let count: t27 = 0;
    let i: i32 = 0;
    while (i < len[HtmlNode](doc.*.nodes)) {
        if (get[HtmlNode](doc.*.nodes, i).kind == kind) { count = count + 1; }
        i = i + 1;
    }
    return count;
}
