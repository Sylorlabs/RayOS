// A minimal flashz "process": prints its core id (stamped by the kernel into
// its private data page at physical/VA 0x4100000 = 68157440) in a loop with a
// busy delay. Integer-only (no SSE/mmap) so it only needs write(1).
fn main() i32 {
    let a: i64 = 68157440;
    let p: *u8 = a as *u8;
    let idch: u8 = p[0];
    let a2: i64 = 68157456;
    let b: *u8 = a2 as *u8;
    b[0] = ('c' as u8);
    b[1] = ('o' as u8);
    b[2] = ('r' as u8);
    b[3] = ('e' as u8);
    b[4] = (' ' as u8);
    b[5] = idch;
    b[6] = (10 as u8);
    let msg: []u8 = b[0..7];
    let k: i32 = 0;
    while (k < 1000000000) {
        _zag_print(msg);
        let d: i32 = 0;
        while (d < 600000000) { d = d + 1; }
        k = k + 1;
    }
    return 0;
}
