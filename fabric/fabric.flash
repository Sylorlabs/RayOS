// fabric.zag — RayOS Spatial Routing Fabric orchestrator
//
// Passive optical switchboard semantics: configure GeSn waveguide paths and
// WDM wavelength slots once; photonic data then flows continuously through
// the crossbar with no kernel, no interrupts, and no time-slicing.
//
//   @import("fabric.flash") as fabric
//   let f: fabric.SpatialRoutingFabric = fabric.fabric_new();
//   let bid: i32 = fabric.fabric_bind_application(&f, 42, 0, 7, 3);
//   if (fabric.fabric_resolve_route(f, 0, 7, 3)) |route| { ... }




// ── passive switchboard crosspoint ────────────────────────────────────────────

struct SwitchboardCrosspoint {
    src_chamber:  i32,
    dst_chamber:  i32,
    channel_id:   i32,
    path_slot:    i32,
    latched:      i32,   // 1 = optical path committed, continuous flow
}

struct ResolvedRoute {
    route_id:     i32,
    binding_id:   i32,
    path_slot:    i32,
    src_chamber:  i32,
    dst_chamber:  i32,
    channel_id:   i32,
    freq_ghz:     i32,
    hop_count:    i32,
    loss_db_x10:  i32,
    flowing:      i32,   // 1 when switchboard latched
}

struct FabricSummary {
    chambers:         i32,
    wdm_channels:       i32,
    waveguide_slots:  i32,
    paths_allocated:  i32,
    paths_flowing:    i32,
    routes_active:    i32,
    bindings_active:  i32,
}

struct SpatialRoutingFabric {
    waveguides:   WaveguidePool,
    routing:      RoutingTable,
    crosspoints:  *SwitchboardCrosspoint,
    cross_count:  i32,
    cross_capacity: i32,
}

// ── lifecycle ───────────────────────────────────────────────────────────────

fn fabric_new() SpatialRoutingFabric {
    let cross_cap: i32 = (RAYOS_WAVEGUIDE_SLOTS() as i32);
    let raw: *i8 = _zag_malloc(cross_cap * @sizeOf[SwitchboardCrosspoint]());
    let xs: *SwitchboardCrosspoint = raw as *SwitchboardCrosspoint;
    let i: i32 = 0;
    while (i < cross_cap) {
        xs[i] = SwitchboardCrosspoint{
            .src_chamber = 0 - 1,
            .dst_chamber = 0 - 1,
            .channel_id  = 0 - 1,
            .path_slot   = 0 - 1,
            .latched     = 0,
        };
        i = i + 1;
    }
    return SpatialRoutingFabric{
        .waveguides     = wg_pool_new(),
        .routing        = routing_table_new(),
        .crosspoints    = xs,
        .cross_count    = 0,
        .cross_capacity = cross_cap,
    };
}

fn fabric_free(f: *SpatialRoutingFabric) void {
    wg_pool_free(&f.*.waveguides);
    routing_table_free(&f.*.routing);
    if (f.*.crosspoints != null) {
        _zag_free(f.*.crosspoints as *i8);
    }
    f.*.crosspoints = null as *SwitchboardCrosspoint;
    f.*.cross_count = 0;
}

// ── passive switchboard latch ─────────────────────────────────────────────────
//
// The crossbar is write-once per binding: setting a crosspoint commits the
// optical path.  There is no runtime arbitration — photons propagate until
// fabric_release clears the latch.

fn fabric_find_crosspoint(f: SpatialRoutingFabric, path_slot: i32) i32 {
    let i: i32 = 0;
    while (i < f.cross_count) {
        if (f.crosspoints[i].path_slot == path_slot) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn fabric_latch_crosspoint(
    f: *SpatialRoutingFabric,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
    path_slot: i32,
) i32 {
    if (f.*.cross_count >= f.*.cross_capacity) { return 0; }
    let idx: i32 = f.*.cross_count;
    f.*.crosspoints[idx] = SwitchboardCrosspoint{
        .src_chamber = src_chamber,
        .dst_chamber = dst_chamber,
        .channel_id  = channel_id,
        .path_slot   = path_slot,
        .latched     = 1,
    };
    f.*.cross_count = f.*.cross_count + 1;
    return 1;
}

fn fabric_unlatch_crosspoint(f: *SpatialRoutingFabric, path_slot: i32) i32 {
    let i: i32 = 0;
    while (i < f.*.cross_count) {
        if (f.*.crosspoints[i].path_slot == path_slot) {
            let last: i32 = f.*.cross_count - 1;
            if (i < last) {
                f.*.crosspoints[i] = f.*.crosspoints[last];
            }
            f.*.crosspoints[last] = SwitchboardCrosspoint{
                .src_chamber = 0 - 1,
                .dst_chamber = 0 - 1,
                .channel_id  = 0 - 1,
                .path_slot   = 0 - 1,
                .latched     = 0,
            };
            f.*.cross_count = f.*.cross_count - 1;
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn fabric_crosspoint_flowing(f: SpatialRoutingFabric, path_slot: i32) i32 {
    let idx: i32 = fabric_find_crosspoint(f, path_slot);
    if (idx < 0) { return 0; }
    return f.crosspoints[idx].latched;
}

// ── application bind / release ────────────────────────────────────────────────

fn fabric_bind_application(
    f: *SpatialRoutingFabric,
    app_id: i32,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
) i32 {
    if (app_id < 0) { return 0 - 1; }
    if (chamber_id_valid(src_chamber) == 0 || chamber_id_valid(dst_chamber) == 0) { return 0 - 1; }

    let ch: i32 = channel_id;
    if (wdm_channel_valid(ch) == 0) {
        ch = rt_find_free_wavelength(f.*.routing, src_chamber);
        if (ch < 0) { return 0 - 1; }
    }

    if (rt_lookup_route_by_endpoint(f.*.routing, src_chamber, dst_chamber, ch)) |_| {
        return 0 - 1;
    }

    let alloc: PathAllocationResult = wg_allocate_path(
        &f.*.waveguides, src_chamber, dst_chamber, ch,
    );
    if (alloc.slot_id < 0) { return 0 - 1; }

    let route_id: i32 = rt_allocate_route(
        &f.*.routing,
        src_chamber,
        dst_chamber,
        ch,
        alloc.slot_id,
        alloc.loss_db_x10,
    );
    if (route_id < 0) {
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return 0 - 1;
    }

    let binding_id: i32 = rt_bind_application(
        &f.*.routing,
        app_id,
        route_id,
        src_chamber,
        ch,
        alloc.slot_id,
    );
    if (binding_id < 0) {
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return 0 - 1;
    }

    if (wg_latch_path(&f.*.waveguides, alloc.slot_id) == 0) {
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return 0 - 1;
    }
    if (rt_latch_route(&f.*.routing, route_id) == 0) {
        wg_unlatch_path(&f.*.waveguides, alloc.slot_id);
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return 0 - 1;
    }
    if (fabric_latch_crosspoint(f, src_chamber, dst_chamber, ch, alloc.slot_id) == 0) {
        wg_unlatch_path(&f.*.waveguides, alloc.slot_id);
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return 0 - 1;
    }

    return binding_id;
}

fn fabric_release(f: *SpatialRoutingFabric, binding_id: i32) i32 {
    if (rt_lookup_binding(f.*.routing, binding_id)) |bind| {
        let path_slot: i32 = bind.path_slot;
        let route_id: i32 = bind.route_id;

        fabric_unlatch_crosspoint(f, path_slot);
        wg_unlatch_path(&f.*.waveguides, path_slot);
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, path_slot);
        return 1;
    }
    return 0;
}

fn fabric_release_by_app(f: *SpatialRoutingFabric, app_id: i32) i32 {
    if (rt_lookup_binding_by_app(f.*.routing, app_id)) |bind| {
        return fabric_release(f, bind.binding_id);
    }
    return 0;
}

// ── route resolution ──────────────────────────────────────────────────────────

fn fabric_resolve_route(
    f: SpatialRoutingFabric,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
) ?ResolvedRoute {
    if (rt_lookup_route_by_endpoint(f.routing, src_chamber, dst_chamber, channel_id)) |entry| {
        let flowing: i32 = 0;
        if (entry.path.latched == 1 && wg_path_flowing(f.waveguides, entry.path.slot_id) == 1) {
            flowing = 1;
        }
        return ResolvedRoute{
            .route_id    = entry.route_id,
            .binding_id  = entry.binding_id,
            .path_slot   = entry.path.slot_id,
            .src_chamber = entry.src_chamber,
            .dst_chamber = entry.dst_chamber,
            .channel_id  = entry.channel_id,
            .freq_ghz    = entry.path.freq_ghz,
            .hop_count   = entry.path.hop_count,
            .loss_db_x10 = entry.path.loss_db_x10,
            .flowing     = flowing,
        };
    }
    return null;
}

fn fabric_resolve_by_binding(f: SpatialRoutingFabric, binding_id: i32) ?ResolvedRoute {
    if (rt_lookup_binding(f.routing, binding_id)) |bind| {
        if (rt_lookup_route(f.routing, bind.route_id)) |entry| {
            return fabric_resolve_route(
                f, entry.src_chamber, entry.dst_chamber, entry.channel_id,
            );
        }
    }
    return null;
}

fn fabric_resolve_by_app(f: SpatialRoutingFabric, app_id: i32) ?ResolvedRoute {
    if (rt_lookup_binding_by_app(f.routing, app_id)) |bind| {
        if (rt_lookup_route(f.routing, bind.route_id)) |entry| {
            return fabric_resolve_route(f, entry.src_chamber, entry.dst_chamber, entry.channel_id);
        }
    }
    return null;
}

// ── balanced-ternary lane bind (optional channel offset) ────────────────────────

fn fabric_bind_application_trit(
    f: *SpatialRoutingFabric,
    app_id: i32,
    src_chamber: i32,
    dst_chamber: i32,
    base_channel: i32,
    lane_trit: i8,
) i32 {
    if (wg_trit_lane_valid(lane_trit) == 0) { return 0 - 1; }
    let ch: i32 = wg_balance_channel_offset(base_channel, lane_trit);
    return fabric_bind_application(f, app_id, src_chamber, dst_chamber, ch);
}

// ── diagnostics ───────────────────────────────────────────────────────────────

fn fabric_summary(f: SpatialRoutingFabric) FabricSummary {
    let rs: RoutingSummary = routing_table_summary(f.routing);
    return FabricSummary{
        .chambers         = (RAYOS_CHAMBER_COUNT() as i32),
        .wdm_channels     = (RAYOS_WDM_CHANNELS() as i32),
        .waveguide_slots  = (RAYOS_WAVEGUIDE_SLOTS() as i32),
        .paths_allocated  = f.waveguides.allocated,
        .paths_flowing    = f.waveguides.latched,
        .routes_active    = rs.routes_active,
        .bindings_active  = rs.bindings_active,
    };
}