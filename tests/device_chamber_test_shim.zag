fn rtc_be32u(buf: *i8, off: i32) i64 {
    let v: i64 = rtc_byte(buf, off);
    v = ((v * 256) + rtc_byte(buf, (off + 1)));
    v = ((v * 256) + rtc_byte(buf, (off + 2)));
    v = ((v * 256) + rtc_byte(buf, (off + 3)));
    return v;
}

fn rtc_be32(buf: *i8, off: i32) i64 {
    let v: i64 = rtc_be32u(buf, off);
    if ((v >= 2147483648)) {
        v = (v - 4294967296);
    }
    return v;
}

fn rtc_be64(buf: *i8, off: i32) i64 {
    let v: i64 = 0;
    let i: i32 = 0;
    while ((i < 8)) {
        v = ((v * 256) + rtc_byte(buf, (off + i)));
        i = (i + 1);
    }
    return v;
}

fn rtc_tzif_magic_at(buf: *i8, n: i32, off: i32) i32 {
    if (((off + RTC_TZIF_HEADER()) > n)) {
        return 0;
    }
    if ((rtc_byte(buf, (off + 0)) != 84)) {
        return 0;
    }
    if ((rtc_byte(buf, (off + 1)) != 90)) {
        return 0;
    }
    if ((rtc_byte(buf, (off + 2)) != 105)) {
        return 0;
    }
    if ((rtc_byte(buf, (off + 3)) != 102)) {
        return 0;
    }
    return 1;
}

fn rtc_tzif_block_offset(buf: *i8, n: i32, off: i32, tsize: i32, now: i64) i64 {
    let isutcnt: i64 = rtc_be32u(buf, (off + 20));
    let isstdcnt: i64 = rtc_be32u(buf, (off + 24));
    let leapcnt: i64 = rtc_be32u(buf, (off + 28));
    let timecnt: i64 = rtc_be32u(buf, (off + 32));
    let typecnt: i64 = rtc_be32u(buf, (off + 36));
    if ((typecnt < 1)) {
        return 0;
    }
    let data: i32 = (off + RTC_TZIF_HEADER());
    let types_off: i32 = (data + ((timecnt) as i32 * tsize));
    let ttinfo_off: i32 = (types_off + (timecnt) as i32);
    if (((ttinfo_off + ((typecnt) as i32 * 6)) > n)) {
        return 0;
    }
    let _lc: i64 = leapcnt;
    let _sc: i64 = isstdcnt;
    let _uc: i64 = isutcnt;
    let idx: i32 = (0 - 1);
    let i: i32 = 0;
    while ((i < (timecnt) as i32)) {
        let t: i64 = 0;
        if ((tsize == 8)) {
            t = rtc_be64(buf, (data + (i * tsize)));
        } else {
            t = rtc_be32(buf, (data + (i * tsize)));
        }
        if ((t <= now)) {
            idx = i;
        }
        i = (i + 1);
    }
    let type_i: i32 = 0;
    if ((idx >= 0)) {
        type_i = (rtc_byte(buf, (types_off + idx))) as i32;
    }
    if ((type_i >= (typecnt) as i32)) {
        type_i = 0;
    }
    return rtc_be32(buf, (ttinfo_off + (type_i * 6)));
}

fn rtc_tzif_block_size(buf: *i8, off: i32, tsize: i32) i32 {
    let isutcnt: i32 = (rtc_be32u(buf, (off + 20))) as i32;
    let isstdcnt: i32 = (rtc_be32u(buf, (off + 24))) as i32;
    let leapcnt: i32 = (rtc_be32u(buf, (off + 28))) as i32;
    let timecnt: i32 = (rtc_be32u(buf, (off + 32))) as i32;
    let typecnt: i32 = (rtc_be32u(buf, (off + 36))) as i32;
    let charcnt: i32 = (rtc_be32u(buf, (off + 40))) as i32;
    return ((((((RTC_TZIF_HEADER() + (timecnt * (tsize + 1))) + (typecnt * 6)) + charcnt) + (leapcnt * (tsize + 4))) + isstdcnt) + isutcnt);
}

fn rtc_tzif_offset(buf: *i8, n: i32, now: i64) i64 {
    if ((rtc_tzif_magic_at(buf, n, 0) == 0)) {
        return 0;
    }
    let ver: i64 = rtc_byte(buf, 4);
    if ((ver >= 50)) {
        let off2: i32 = rtc_tzif_block_size(buf, 0, 4);
        if ((rtc_tzif_magic_at(buf, n, off2) == 1)) {
            return rtc_tzif_block_offset(buf, n, off2, 8, now);
        }
    }
    return rtc_tzif_block_offset(buf, n, 0, 4, now);
}

fn rtc_read_tzfile(buf: *i8, cap: i32) i32 {
    let path: []u8 = "/etc/localtime";
    let fd: i64 = _zag_raw_syscall(RTC_SYS_OPEN(), hw_rt_path_cstr(path), 0, 0, 0, 0, 0);
    if ((fd < 0)) {
        return 0;
    }
    let total: i32 = 0;
    let done: i32 = 0;
    while (((total < cap) && (done == 0))) {
        let n: i64 = _zag_raw_syscall(RTC_SYS_READ(), fd, ((buf) as i64 + (total) as i64), ((cap - total)) as i64, 0, 0, 0);
        if ((n <= 0)) {
            done = 1;
        } else {
            total = (total + (n) as i32);
        }
    }
    let _rc: i64 = _zag_raw_syscall(RTC_SYS_CLOSE(), fd, 0, 0, 0, 0, 0);
    return total;
}

fn rtc_host_utc_offset(now: i64) i64 {
    let buf: *i8 = _zag_malloc(RTC_TZFILE_MAX());
    let n: i32 = rtc_read_tzfile(buf, RTC_TZFILE_MAX());
    if ((n < RTC_TZIF_HEADER())) {
        return 0;
    }
    return rtc_tzif_offset(buf, n, now);
}

fn rtc_utc_offset_secs(now: i64) i64 {
    if ((rtc_chamber_init() != 0)) {
        return 0;
    }
    let base: i64 = RAYOS_RTC_MMIO_BASE();
    if (((mmio_read32((base + 8)) == 0) && (hw_rt_backend_host() == 1))) {
        mmio_write32((base + 4), (rtc_host_utc_offset(now)) as i32);
        mmio_write32((base + 8), 1);
        hw_fence();
    }
    return (mmio_read32((base + 4))) as i64;
}

fn main() i32 {
    _zag_println("device_chamber_test: running");
    if ((device_chamber_init() != 0)) {
        _zag_println("device_chamber_test: FAIL init");
        return 1;
    }
    let g0: i32 = device_chamber_generation();
    let sample: []u8 = "USB|Ternary Probe|0e8d:0616  480 Mb/s|attached\nWIFI|w0|aa:bb|up\n";
    let wrote: i32 = device_chamber_publish(sample);
    if ((wrote != 2)) {
        _zag_println("device_chamber_test: FAIL publish count");
        return 1;
    }
    if ((device_chamber_generation() != (g0 + 1))) {
        _zag_println("device_chamber_test: FAIL generation bump");
        return 1;
    }
    if ((device_chamber_count() != 2)) {
        _zag_println("device_chamber_test: FAIL count register");
        return 1;
    }
    let back: []u8 = device_chamber_report();
    if ((_zag_strcmp(back, sample) == 0)) {
        _zag_println("device_chamber_test: FAIL roundtrip");
        _zag_println(back);
        return 1;
    }
    let long: []u8 = "USB|This Device Name Is Much Longer Than The Fifty Six Byte Record Field Allows For|d|attached\n";
    let _w2: i32 = device_chamber_publish(long);
    let back2: []u8 = device_chamber_report();
    if ((back2.len < 8)) {
        _zag_println("device_chamber_test: FAIL truncation roundtrip");
        return 1;
    }
    let epoch: i64 = rtc_now_epoch();
    if ((epoch < 1000000000)) {
        _zag_println("device_chamber_test: FAIL rtc epoch");
        return 1;
    }
    let off: i64 = rtc_utc_offset_secs(epoch);
    if (((off < (0 - 50400)) || (off > 50400))) {
        _zag_println("device_chamber_test: FAIL rtc offset range");
        return 1;
    }
    _zag_println("device_chamber_test: ok");
    return 0;
}

