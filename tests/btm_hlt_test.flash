// btm_hlt_test.flash — HLT stops PC advance and sets btm_halted

@import("../core/init.flash")
@import("../driver/virtio_block_mmio_nop.flash")
@import("../driver/virtio_gpu_mmio_nop.flash")

fn test_fail(msg: []u8) void {
    _zag_print("btm_hlt_test FAIL: ");
    _zag_println(msg);
    _zag_exit(1);
}

fn test_expect_u64(got: u64, want: u64, msg: []u8) void {
    if (got != want) { test_fail(msg); }
}

fn test_expect_i32(got: i32, want: i32, msg: []u8) void {
    if (got != want) { test_fail(msg); }
}

fn main() i32 {
    _zag_println("btm_hlt_test: running");

    let gpa: i32 = 8192;
    let ram: ArrayList[u8] = guest_ram_new(16384);
    set[u8](&ram, gpa, 244);
    set[u8](&ram, gpa + 1, 144);

    let hv: *BinaryTranslationMatrix = btm_new();
    btm_attach_guest(hv, GuestArch.X86_64);
    btm_bind_guest_ram(hv, &ram);
    grf_set(&hv.*.guest, GuestRegId.Pc, gpa as u64);

    let code: []u8 = guest_ram_slice(ram, 0, len[u8](ram));

    test_expect_i32(btm_halted(hv.*), 0, "not halted before step");
    if (btm_step(hv, code) != 1) { test_fail("btm_step hlt len"); }
    test_expect_u64(btm_guest_pc(hv.*), gpa as u64, "pc unchanged after hlt");
    test_expect_i32(btm_halted(hv.*), 1, "halted after hlt");
    if (btm_step(hv, code) != 0 - 20) { test_fail("btm_step while halted"); }
    test_expect_u64(btm_guest_pc(hv.*), gpa as u64, "pc still at hlt after re-step");

    free[u8](&ram);
    btm_free(hv);

    _zag_println("btm_hlt_test: ok");
    return 0;
}