        let name: []u8 = sysbus_line_at(names, i);
        if ((name.len > 0)) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let state: []u8 = sysbus_read_line(sysbus_path2(base, "/operstate"));
            if ((state.len < 1)) {
                state = "unknown";
            }
            let mac: []u8 = sysbus_read_line(sysbus_path2(base, "/address"));
            let wireless: i32 = sysbus_exists(sysbus_path2(base, "/wireless"));
            if ((wireless == 0)) {
                wireless = sysbus_exists(sysbus_path2(base, "/phy80211"));
            }
            if ((wireless == 1)) {
                let q: []u8 = devbus_wifi_quality(name);
                let detail: []u8 = mac;
                if ((q.len > 0)) {
                    detail = _zag_str_concat(_zag_str_concat(mac, "  "), q);
                }
                report = devbus_row(report, "WIFI", name, detail, state);
            } else if ((_zag_strcmp(name, "lo") == 1)) {
                report = devbus_row(report, "ETHERNET", name, "loopback", state);
            } else {
                let speed: []u8 = sysbus_read_line(sysbus_path2(base, "/speed"));
                let detail2: []u8 = mac;
                if (((speed.len > 0) && (sysbus_contains(speed, "-") == 0))) {
                    detail2 = _zag_str_concat(_zag_str_concat(mac, "  "), _zag_str_concat(speed, " Mb/s"));
                }
                report = devbus_row(report, "ETHERNET", name, detail2, state);
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_scan_usb(report: []u8) []u8 {
    let root: []u8 = "/sys/bus/usb/devices";
    let names: []u8 = sysbus_listdir(root);
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if (((name.len > 0) && (sysbus_contains(name, ":") == 0))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let product: []u8 = sysbus_read_line(sysbus_path2(base, "/product"));
            if ((product.len > 0)) {
                let vid: []u8 = sysbus_read_line(sysbus_path2(base, "/idVendor"));
                let pid: []u8 = sysbus_read_line(sysbus_path2(base, "/idProduct"));
                let speed: []u8 = sysbus_read_line(sysbus_path2(base, "/speed"));
                let detail: []u8 = _zag_str_concat(_zag_str_concat(vid, ":"), _zag_str_concat(pid, _zag_str_concat("  ", _zag_str_concat(speed, " Mb/s"))));
                report = devbus_row(report, "USB", product, detail, "attached");
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_digit(ch: u8) i32 {
    if (((ch >= (48) as u8) && (ch <= (57) as u8))) {
        return 1;
    }
    return 0;
}

fn devbus_scan_audio(report: []u8) []u8 {
    let root: []u8 = "/sys/class/sound";
    let names: []u8 = sysbus_listdir(root);
    if ((names.len < 1)) {
        return report;
    }
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if ((((name.len > 4) && (sysbus_contains(name, "card") == 1)) && (devbus_digit(name[4]) == 1))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let id: []u8 = sysbus_read_line(sysbus_path2(base, "/id"));
            if ((id.len > 0)) {
                let suffix: []u8 = name[4..name.len];
                let pcm_tag: []u8 = _zag_str_concat("pcmC", suffix);
                let play: i32 = 0;
                let capt: i32 = 0;
                let j: i32 = 0;
                while ((j < n)) {
                    let other: []u8 = sysbus_line_at(names, j);
                    if ((sysbus_contains(other, pcm_tag) == 1)) {
                        if ((other[(other.len - 1)] == (112) as u8)) {
                            play = (play + 1);
                        }
                        if ((other[(other.len - 1)] == (99) as u8)) {
                            capt = (capt + 1);
                        }
                    }
                    j = (j + 1);
                }
                let detail: []u8 = _zag_str_concat(_zag_i64_to_str((play) as i64), " out / ");
                detail = _zag_str_concat(detail, _zag_i64_to_str((capt) as i64));
                detail = _zag_str_concat(detail, " in");
                report = devbus_row(report, "AUDIO", id, detail, "online");
            }
        }
        if (((name.len > 5) && (sysbus_contains(name, "midiC") == 1))) {
            report = devbus_row(report, "MIDI", name, "raw midi port", "online");
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_scan_thunderbolt(report: []u8) []u8 {
    let root: []u8 = "/sys/bus/thunderbolt/devices";
    let names: []u8 = sysbus_listdir(root);
    if ((names.len < 1)) {
        return report;
    }
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if ((name.len > 0)) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let dev: []u8 = sysbus_read_line(sysbus_path2(base, "/device_name"));
            if ((dev.len > 0)) {
                let vendor: []u8 = sysbus_read_line(sysbus_path2(base, "/vendor_name"));
                report = devbus_row(report, "THUNDERBOLT", dev, vendor, "online");
            } else if ((sysbus_contains(name, "domain") == 1)) {
                report = devbus_row(report, "THUNDERBOLT", name, "host domain", "online");
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_scan_typec(report: []u8) []u8 {
    let root: []u8 = "/sys/class/typec";
    let names: []u8 = sysbus_listdir(root);
    if ((names.len < 1)) {
        return report;
    }
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if (((name.len > 0) && (sysbus_contains(name, "partner") == 0))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let power: []u8 = sysbus_read_line(sysbus_path2(base, "/power_role"));
            let data: []u8 = sysbus_read_line(sysbus_path2(base, "/data_role"));
            let state: []u8 = "no device";
            if ((sysbus_exists(sysbus_path2(base, "-partner")) == 1)) {
                state = "connected";
            }
            let detail: []u8 = _zag_str_concat(power, _zag_str_concat("  ", data));
            report = devbus_row(report, "USB-C", name, detail, state);
        }
        i = (i + 1);
    }
    return report;
}

fn DEVICE_CHAMBER_MAGIC() i32 {
    return 1145391683;
}

fn DEVICE_REC_BASE() i32 {
    return 16;
}

fn DEVICE_REC_STRIDE() i32 {
    return 128;
}

fn DEVICE_F_BUS() i32 {
    return 0;
}

fn DEVICE_F_NAME() i32 {
    return 16;
}

fn DEVICE_F_DETAIL() i32 {
    return 72;
}

fn DEVICE_F_STATE() i32 {
    return 112;
}

fn DEVICE_BUS_CAP() i32 {
    return 16;
}

fn DEVICE_NAME_CAP() i32 {
    return 56;
}

fn DEVICE_DETAIL_CAP() i32 {
    return 40;
}

fn DEVICE_STATE_CAP() i32 {
    return 16;
}

fn device_chamber_max_records() i32 {
    return ((RAYOS_DEVICE_MMIO_BYTES() - DEVICE_REC_BASE()) / DEVICE_REC_STRIDE());
}

fn device_chamber_base() i64 {
    return RAYOS_DEVICE_MMIO_BASE();
}

fn device_chamber_init() i32 {
    if ((hw_rt_init() != 0)) {
        return (0 - 1);
    }
    let base: i64 = device_chamber_base();
    if ((mmio_read32(base) != DEVICE_CHAMBER_MAGIC())) {
        mmio_write32(base, DEVICE_CHAMBER_MAGIC());
        mmio_write32((base + 4), 0);
        mmio_write32((base + 8), 0);
    }
    return 0;
}

fn device_chamber_generation() i32 {
    return mmio_read32((device_chamber_base() + 4));
}

fn device_chamber_count() i32 {
    let n: i32 = mmio_read32((device_chamber_base() + 8));
    if ((n < 0)) {
        return 0;
    }
    if ((n > device_chamber_max_records())) {
        return device_chamber_max_records();
    }
    return n;
}

fn device_chamber_put_str(rec_off: i32, field_off: i32, cap: i32, s: []u8) void {
    let p: *i8 = hw_mmio_ptr((device_chamber_base() + ((rec_off + field_off)) as i64), cap);
    if ((p == null)) {
        return;
    }
    let n: i32 = s.len;
    if ((n > (cap - 1))) {
        n = (cap - 1);
    }
    let i: i32 = 0;
    while ((i < n)) {
        p[i] = (s[i]) as i8;
        i = (i + 1);
    }
    p[n] = (0) as i8;
}

fn device_chamber_get_str(rec_off: i32, field_off: i32, cap: i32) []u8 {
    let p: *i8 = hw_mmio_ptr((device_chamber_base() + ((rec_off + field_off)) as i64), cap);
    if ((p == null)) {
        return "";
    }
    let n: i32 = 0;
    while (((n < (cap - 1)) && (p[n] != (0) as i8))) {
        n = (n + 1);
    }
    let pu: *u8 = (p) as *u8;
    return pu[0..n];
}

fn device_chamber_row_field(line: []u8, idx: i32) []u8 {
    let field: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while ((i <= line.len)) {
        if (((i == line.len) || (line[i] == (124) as u8))) {
            if ((field == idx)) {
                return line[start..i];
            }
            field = (field + 1);
            start = (i + 1);
        }
        i = (i + 1);
    }
    return "";
}

fn device_chamber_publish(report: []u8) i32 {
    if ((device_chamber_init() != 0)) {
        return (0 - 1);
    }
    let base: i64 = device_chamber_base();
    let count: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (((i <= report.len) && (count < device_chamber_max_records()))) {
        if (((i == report.len) || (report[i] == (10) as u8))) {
            let line: []u8 = report[start..i];
            if ((line.len > 0)) {
                let rec: i32 = (DEVICE_REC_BASE() + (count * DEVICE_REC_STRIDE()));
                device_chamber_put_str(rec, DEVICE_F_BUS(), DEVICE_BUS_CAP(), device_chamber_row_field(line, 0));
                device_chamber_put_str(rec, DEVICE_F_NAME(), DEVICE_NAME_CAP(), device_chamber_row_field(line, 1));
                device_chamber_put_str(rec, DEVICE_F_DETAIL(), DEVICE_DETAIL_CAP(), device_chamber_row_field(line, 2));
                device_chamber_put_str(rec, DEVICE_F_STATE(), DEVICE_STATE_CAP(), device_chamber_row_field(line, 3));
                count = (count + 1);
            }
            start = (i + 1);
        }
        i = (i + 1);
    }
    mmio_write32((base + 8), count);
    mmio_write32((base + 4), (device_chamber_generation() + 1));
    hw_fence();
    return count;
}

fn device_chamber_report() []u8 {
    if ((device_chamber_init() != 0)) {
        return "";
    }
    let out: []u8 = "";
    let n: i32 = device_chamber_count();
    let i: i32 = 0;
    while ((i < n)) {
        let rec: i32 = (DEVICE_REC_BASE() + (i * DEVICE_REC_STRIDE()));
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_BUS(), DEVICE_BUS_CAP()));
        out = _zag_str_concat(out, "|");
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_NAME(), DEVICE_NAME_CAP()));
        out = _zag_str_concat(out, "|");
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_DETAIL(), DEVICE_DETAIL_CAP()));
        out = _zag_str_concat(out, "|");
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_STATE(), DEVICE_STATE_CAP()));
        out = _zag_str_concat(out, "\n");
        i = (i + 1);
    }
    return out;
}

fn device_manager_seed_from_host() i32 {
    let report: []u8 = "";
    report = devbus_scan_display(report);
    report = devbus_scan_net(report);
    report = devbus_scan_usb(report);
    report = devbus_scan_audio(report);
    report = devbus_scan_thunderbolt(report);
    report = devbus_scan_typec(report);
    return device_chamber_publish(report);
}

fn device_manager_scan() []u8 {
    if ((hw_rt_backend_host() == 1)) {
        let _n: i32 = device_manager_seed_from_host();
    }
    return device_chamber_report();
}

fn devtest_count_rows_with(report: []u8, tag: []u8) i32 {
    let n: i32 = sysbus_line_count(report);
    let hits: i32 = 0;
    let i: i32 = 0;
    while ((i < n)) {
        let line: []u8 = sysbus_line_at(report, i);
        if ((sysbus_contains(line, tag) == 1)) {
            hits = (hits + 1);
        }
        i = (i + 1);
    }
    return hits;
}

fn main() i32 {
    _zag_println("device_bus_test: running");
    let names: []u8 = sysbus_listdir("/sys/class/net");
    if ((names.len < 1)) {
        _zag_println("device_bus_test: FAIL listdir /sys/class/net empty");
        return 1;
    }
    if ((sysbus_contains(names, "lo") == 0)) {
        _zag_println("device_bus_test: FAIL loopback interface missing");
        return 1;
    }
    if ((sysbus_contains("card1-HDMI-A-1", "HDMI") == 0)) {
        _zag_println("device_bus_test: FAIL contains");
        return 1;
    }
    if ((sysbus_line_count("a\nb\nc") != 3)) {
        _zag_println("device_bus_test: FAIL line_count");
        return 1;
    }
    if ((_zag_strcmp(sysbus_line_at("a\nb\nc", 1), "b") == 0)) {
        _zag_println("device_bus_test: FAIL line_at");
        return 1;
    }
    let report: []u8 = device_manager_scan();
    if ((report.len < 1)) {
        _zag_println("device_bus_test: FAIL empty report");
        return 1;
    }
    if ((devtest_count_rows_with(report, "ETHERNET|lo|loopback") != 1)) {
        _zag_println("device_bus_test: FAIL loopback row");
        _zag_println(report);
        return 1;
    }
    let rows: i32 = (sysbus_line_count(report) - 1);
    _zag_print("device_bus_test: ");
    _zag_print(_zag_i64_to_str((rows) as i64));
    _zag_println(" live devices enumerated");
    _zag_println("device_bus_test: ok");
    return 0;
}

