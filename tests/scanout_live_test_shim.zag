fn softgpu_blend_round_rect_vgrad(fb: *SoftFb, x0: i32, y0: i32, w: i32, h: i32, rad: i32, r0: i32, g0: i32, b0: i32, r1: i32, g1: i32, b1: i32, a: i32) void {
    if ((((a < 1) || (w < 1)) || (h < 1))) {
        return;
    }
    if ((rad > (w / 2))) {
        rad = (w / 2);
    }
    if ((rad > (h / 2))) {
        rad = (h / 2);
    }
    if ((rad < 0)) {
        rad = 0;
    }
    let radf: f32 = (rad) as f32;
    let x1: i32 = ((x0 + w) - 1);
    let y1: i32 = ((y0 + h) - 1);
    let t_den: i32 = (h - 1);
    if ((t_den < 1)) {
        t_den = 1;
    }
    let y: i32 = y0;
    while ((y <= y1)) {
        let t_num: i32 = (y - y0);
        let rr: i32 = (r0 + (((r1 - r0) * t_num) / t_den));
        let rg: i32 = (g0 + (((g1 - g0) * t_num) / t_den));
        let rb: i32 = (b0 + (((b1 - b0) * t_num) / t_den));
        let cap: i32 = 0;
        if ((y < (y0 + rad))) {
            cap = 1;
        }
        if ((y > (y1 - rad))) {
            cap = 1;
        }
        if ((cap == 0)) {
            softgpu_blend_rect(fb, x0, y, w, 1, rr, rg, rb, a);
        } else {
            let ccy: f32 = ((y0 + rad)) as f32;
            if ((y > (y1 - rad))) {
                ccy = (((y1 + 1) - rad)) as f32;
            }
            softgpu_blend_rect(fb, (x0 + rad), y, (w - (rad * 2)), 1, rr, rg, rb, a);
            let ccxl: f32 = ((x0 + rad)) as f32;
            let ccxr: f32 = (((x1 + 1) - rad)) as f32;
            let cxp: i32 = x0;
            while ((cxp < (x0 + rad))) {
                let cov: i32 = softgpu_corner_cov((cxp) as f32, (y) as f32, ccxl, ccy, radf);
                if ((cov > 0)) {
                    softgpu_blend_px_fast(fb, cxp, y, rr, rg, rb, ((a * cov) / 16));
                }
                cxp = (cxp + 1);
            }
            cxp = ((x1 - rad) + 1);
            while ((cxp <= x1)) {
                let cov2: i32 = softgpu_corner_cov((cxp) as f32, (y) as f32, ccxr, ccy, radf);
                if ((cov2 > 0)) {
                    softgpu_blend_px_fast(fb, cxp, y, rr, rg, rb, ((a * cov2) / 16));
                }
                cxp = (cxp + 1);
            }
        }
        y = (y + 1);
    }
}

fn softgpu_blend_round_rect(fb: *SoftFb, x0: i32, y0: i32, w: i32, h: i32, rad: i32, r: i32, g: i32, b: i32, a: i32) void {
    softgpu_blend_round_rect_vgrad(fb, x0, y0, w, h, rad, r, g, b, r, g, b, a);
}

fn softgpu_compose_round_rect(dst: *SoftFb, src: *SoftFb, dx: i32, dy: i32, rad: i32) void {
    let sw: i32 = src.*.w;
    let sh: i32 = src.*.h;
    if (((sw < 1) || (sh < 1))) {
        return;
    }
    if ((rad > (sw / 2))) {
        rad = (sw / 2);
    }
    if ((rad > (sh / 2))) {
        rad = (sh / 2);
    }
    if ((rad < 0)) {
        rad = 0;
    }
    let radf: f32 = (rad) as f32;
    let d: *i8 = (dst.*.pix.data) as *i8;
    let s: *i8 = (src.*.pix.data) as *i8;
    let sy: i32 = 0;
    while ((sy < sh)) {
        let ty: i32 = (dy + sy);
        if (((ty >= 0) && (ty < dst.*.h))) {
            let cap: i32 = 0;
            if (((sy < rad) || (sy >= (sh - rad)))) {
                cap = 1;
            }
            let sx0: i32 = 0;
            let sx1: i32 = sw;
            if ((cap == 1)) {
                sx0 = rad;
                sx1 = (sw - rad);
            }
            let cx0: i32 = sx0;
            let cx1: i32 = sx1;
            if (((dx + cx0) < 0)) {
                cx0 = (0 - dx);
            }
            if (((dx + cx1) > dst.*.w)) {
                cx1 = (dst.*.w - dx);
            }
            if ((cx1 > cx0)) {
                softgpu_copy_bytes((((d) as i64 + (((((ty * dst.*.w) + dx) + cx0) * 3)) as i64)) as *i8, (((s) as i64 + ((((sy * sw) + cx0) * 3)) as i64)) as *i8, ((cx1 - cx0) * 3));
            }
            if ((cap == 1)) {
                let ccy: f32 = (rad) as f32;
                if ((sy >= (sh - rad))) {
                    ccy = ((sh - rad)) as f32;
                }
                let ccxl: f32 = (rad) as f32;
                let ccxr: f32 = ((sw - rad)) as f32;
                let cxp: i32 = 0;
                while ((cxp < sw)) {
                    if ((cxp == rad)) {
                        cxp = (sw - rad);
                    }
                    if ((cxp >= sw)) {
                    } else {
                        let tx: i32 = (dx + cxp);
                        if (((tx >= 0) && (tx < dst.*.w))) {
                            let ccx: f32 = ccxl;
                            if ((cxp >= (sw - rad))) {
                                ccx = ccxr;
                            }
                            let cov: i32 = softgpu_corner_cov((cxp) as f32, (sy) as f32, ccx, ccy, radf);
                            if ((cov > 0)) {
                                let so: i32 = (((sy * sw) + cxp) * 3);
                                let dofs: i32 = (((ty * dst.*.w) + tx) * 3);
                                if ((cov >= 16)) {
                                    d[dofs] = s[so];
                                    d[(dofs + 1)] = s[(so + 1)];
                                    d[(dofs + 2)] = s[(so + 2)];
                                } else {
                                    let ea: i32 = ((cov * 255) / 16);
                                    let inv: i32 = (255 - ea);
                                    d[dofs] = ((((((d[dofs]) as u8) as i32 * inv) + (((s[so]) as u8) as i32 * ea)) / 255)) as i8;
                                    d[(dofs + 1)] = ((((((d[(dofs + 1)]) as u8) as i32 * inv) + (((s[(so + 1)]) as u8) as i32 * ea)) / 255)) as i8;
                                    d[(dofs + 2)] = ((((((d[(dofs + 2)]) as u8) as i32 * inv) + (((s[(so + 2)]) as u8) as i32 * ea)) / 255)) as i8;
                                }
                            }
                        }
                        cxp = (cxp + 1);
                    }
                }
            }
        }
        sy = (sy + 1);
    }
    softgpu_damage_mark_rect(dst, dx, dy, ((dx + sw) - 1), ((dy + sh) - 1));
}

fn softgpu_dither_rect(fb: *SoftFb, x0: i32, y0: i32, w: i32, h: i32, r: i32, g: i32, b: i32) void {
    let y: i32 = y0;
    while ((y < (y0 + h))) {
        let x: i32 = x0;
        while ((x < (x0 + w))) {
            if ((((x + y) % 2) == 0)) {
                softgpu_pixel(fb, x, y, r, g, b);
            }
            x = (x + 1);
        }
        y = (y + 1);
    }
}

fn softgpu_frame_rect(fb: *SoftFb, x0: i32, y0: i32, w: i32, h: i32, r: i32, g: i32, b: i32) void {
    softgpu_line(fb, x0, y0, ((x0 + w) - 1), y0, r, g, b);
    softgpu_line(fb, x0, ((y0 + h) - 1), ((x0 + w) - 1), ((y0 + h) - 1), r, g, b);
    softgpu_line(fb, x0, y0, x0, ((y0 + h) - 1), r, g, b);
    softgpu_line(fb, ((x0 + w) - 1), y0, ((x0 + w) - 1), ((y0 + h) - 1), r, g, b);
}

fn softgpu_detect(out_path: []u8) SoftGpuDevice {
    if ((_zag_file_exists("/dev/fb0") == 1)) {
        return SoftGpuDevice{ .kind = 1, .path = "/dev/fb0" };
    }
    return SoftGpuDevice{ .kind = 0, .path = out_path };
}

fn softgpu_i32_text(v: i32) []u8 {
    return _zag_i64_to_str((v) as i64);
}

fn softgpu_present_ppm(fb: *SoftFb, path: []u8) i32 {
    let hdr: []u8 = _zag_str_concat("P6\n", softgpu_i32_text(fb.*.w));
    hdr = _zag_str_concat(hdr, " ");
    hdr = _zag_str_concat(hdr, softgpu_i32_text(fb.*.h));
    hdr = _zag_str_concat(hdr, "\n255\n");
    let n: i32 = ((fb.*.w * fb.*.h) * 3);
    let total: i32 = (hdr.len + n);
    let out: *i8 = _zag_malloc(total);
    let i: i32 = 0;
    while ((i < hdr.len)) {
        out[i] = (hdr[i]) as i8;
        i = (i + 1);
    }
    softgpu_copy_bytes((((out) as i64 + (hdr.len) as i64)) as *i8, (fb.*.pix.data) as *i8, n);
    let out_u8: *u8 = (out) as *u8;
    let rc: i32 = _zag_write_file(path, out_u8[0..total]);
    _zag_free(out);
    return rc;
}

fn softgpu_present_fbdev(fb: *SoftFb, path: []u8) i32 {
    let n: i32 = (fb.*.w * fb.*.h);
    let out: ArrayList[u8] = make[u8]((n * 4));
    let i: i32 = 0;
    while ((i < n)) {
        push[u8](&out, get[u8](fb.*.pix, ((i * 3) + 2)));
        push[u8](&out, get[u8](fb.*.pix, ((i * 3) + 1)));
        push[u8](&out, get[u8](fb.*.pix, (i * 3)));
        push[u8](&out, 0);
        i = (i + 1);
    }
    return _zag_write_file(path, out.data[0..out.len]);
}

fn softgpu_present(dev: SoftGpuDevice, fb: *SoftFb) i32 {
    if ((dev.kind == 1)) {
        let rc: i32 = softgpu_present_fbdev(fb, dev.path);
        if ((rc == 0)) {
            return 0;
        }
        return rc;
    }
    return softgpu_present_ppm(fb, dev.path);
}

fn softgpu_checksum(fb: *SoftFb) i32 {
    let acc: i32 = 7;
    let n: i32 = ((fb.*.w * fb.*.h) * 3);
    let i: i32 = 0;
    while ((i < n)) {
        acc = (((acc * 131) + (get[u8](fb.*.pix, i)) as i32) % 15485863);
        i = (i + 1);
    }
    return acc;
}

fn softgpu_checksum_region(fb: *SoftFb, x0: i32, y0: i32, x1: i32, y1: i32) i32 {
    let acc: i32 = 7;
    let y: i32 = y0;
    while ((y <= y1)) {
        let x: i32 = x0;
        while ((x <= x1)) {
            if (((((x >= 0) && (y >= 0)) && (x < fb.*.w)) && (y < fb.*.h))) {
                let o: i32 = (((y * fb.*.w) + x) * 3);
                acc = (((acc * 131) + (get[u8](fb.*.pix, o)) as i32) % 15485863);
                acc = (((acc * 131) + (get[u8](fb.*.pix, (o + 1))) as i32) % 15485863);
                acc = (((acc * 131) + (get[u8](fb.*.pix, (o + 2))) as i32) % 15485863);
            }
            x = (x + 1);
        }
        y = (y + 1);
    }
    return acc;
}

