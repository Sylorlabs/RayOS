    }
    if ((c == 71)) {
        return "10,3 7,0 3,0 0,3 0,11 3,14 7,14 10,11 10,8 5,8";
    }
    if ((c == 72)) {
        return "0,0 0,14;10,0 10,14;0,7 10,7";
    }
    if ((c == 73)) {
        return "5,0 5,14;2,0 8,0;2,14 8,14";
    }
    if ((c == 74)) {
        return "8,0 8,11 5,14 3,14 0,11";
    }
    if ((c == 75)) {
        return "0,0 0,14;10,0 0,7;3,5 10,14";
    }
    if ((c == 76)) {
        return "0,0 0,14 10,14";
    }
    if ((c == 77)) {
        return "0,14 0,0 5,8 10,0 10,14";
    }
    if ((c == 78)) {
        return "0,14 0,0 10,14 10,0";
    }
    if ((c == 79)) {
        return "3,0 7,0 10,3 10,11 7,14 3,14 0,11 0,3 3,0";
    }
    if ((c == 80)) {
        return "0,14 0,0 7,0 10,3 10,5 7,8 0,8";
    }
    if ((c == 81)) {
        return "3,0 7,0 10,3 10,11 7,14 3,14 0,11 0,3 3,0;6,10 10,14";
    }
    if ((c == 82)) {
        return "0,14 0,0 7,0 10,3 10,5 7,8 0,8;4,8 10,14";
    }
    if ((c == 83)) {
        return "10,3 7,0 3,0 0,2 0,5 3,7 7,7 10,9 10,12 7,14 3,14 0,11";
    }
    if ((c == 84)) {
        return "0,0 10,0;5,0 5,14";
    }
    if ((c == 85)) {
        return "0,0 0,11 3,14 7,14 10,11 10,0";
    }
    if ((c == 86)) {
        return "0,0 5,14 10,0";
    }
    if ((c == 87)) {
        return "0,0 2,14 5,6 8,14 10,0";
    }
    if ((c == 88)) {
        return "0,0 10,14;10,0 0,14";
    }
    if ((c == 89)) {
        return "0,0 5,7 10,0;5,7 5,14";
    }
    if ((c == 90)) {
        return "0,0 10,0 0,14 10,14";
    }
    if ((c == 48)) {
        return "3,0 7,0 10,3 10,11 7,14 3,14 0,11 0,3 3,0;3,10 7,4";
    }
    if ((c == 49)) {
        return "2,3 5,0 5,14;2,14 8,14";
    }
    if ((c == 50)) {
        return "0,3 3,0 7,0 10,3 10,5 0,14 10,14";
    }
    if ((c == 51)) {
        return "0,2 3,0 7,0 10,2 10,5 7,7 4,7;7,7 10,9 10,12 7,14 3,14 0,12";
    }
    if ((c == 52)) {
        return "8,14 8,0 0,10 10,10";
    }
    if ((c == 53)) {
        return "10,0 0,0 0,6 6,6 10,8 10,11 7,14 3,14 0,12";
    }
    if ((c == 54)) {
        return "9,2 6,0 3,0 0,3 0,11 3,14 7,14 10,11 10,9 7,6 3,6 0,9";
    }
    if ((c == 55)) {
        return "0,0 10,0 4,14";
    }
    if ((c == 56)) {
        return "3,0 7,0 9,2 9,5 7,7 3,7 1,5 1,2 3,0;3,7 7,7 10,9 10,12 7,14 3,14 0,12 0,9 3,7";
    }
    if ((c == 57)) {
        return "10,5 7,8 3,8 0,5 0,3 3,0 7,0 10,3 10,11 7,14 4,14 1,12";
    }
    if ((c == 45)) {
        return "2,7 8,7";
    }
    if ((c == 43)) {
        return "5,4 5,10;2,7 8,7";
    }
    if ((c == 46)) {
        return "5,13 5,14";
    }
    if ((c == 58)) {
        return "5,4 5,5;5,12 5,13";
    }
    if ((c == 61)) {
        return "1,5 9,5;1,9 9,9";
    }
    if ((c == 47)) {
