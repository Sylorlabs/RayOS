fn comp_guest_alloc(c: *Compositor, bytes: i32) i32 {
    let off: i32 = len[u8](c.*.guest_pool);
    let i: i32 = 0;
    while ((i < bytes)) {
        push[u8](&c.*.guest_pool, 0);
        i = (i + 1);
    }
    return off;
}

fn comp_task_state_text(state: i64) []u8 {
    if ((state == task_ready())) {
        return "READY";
    }
    if ((state == task_running())) {
        return "RUNNING";
    }
    if ((state == task_sleeping())) {
        return "SLEEPING";
    }
    if ((state == task_blocked())) {
        return "BLOCKED";
    }
    if ((state == task_stopped())) {
        return "STOPPED";
    }
    return "EXITED";
}

fn comp_task_metric_label(index: i32) []u8 {
    if ((index == 0)) {
        return "RUNNABLE";
    }
    if ((index == 1)) {
        return "DISPATCHES";
    }
    return "EPOCH";
}

fn comp_task_metric_value(c: *Compositor, index: i32) i32 {
    if ((index == 0)) {
        return (scheduler_runnable_count(&c.*.scheduler)) as i32;
    }
    if ((index == 1)) {
        return (c.*.scheduler.dispatches) as i32;
    }
    return (c.*.scheduler.clock) as i32;
}

fn comp_paint_content_header(c: *Compositor, fb: *SoftFb, x: i32, y: i32, w: i32, title: []u8, subtitle: []u8) void {
