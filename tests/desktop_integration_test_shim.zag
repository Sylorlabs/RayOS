    vg_text_vec(fb, ((x + 18)) as f32, ((y + 10)) as f32, title, 17.0, 0.75, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    vg_text_vec(fb, ((x + 18)) as f32, ((y + 34)) as f32, subtitle, 10.0, 0.55, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
}

fn comp_paint_tasks(c: *Compositor, fb: *SoftFb, x: i32, y: i32, w: i32, h: i32) void {
    let th: RayOsTheme = c.*.wm.theme;
    comp_paint_content_header(c, fb, x, y, w, "Task Manager", "TERNARY DEADLINE SCHEDULER / LIVE STATE");
    let metric_y: i32 = (y + 70);
    let card_w: i32 = ((w - 30) / 3);
    let mi: i32 = 0;
    while ((mi < 3)) {
        let mx: i32 = (x + (mi * (card_w + 8)));
        softgpu_blend_round_rect(fb, mx, metric_y, card_w, 54, 10, 255, 255, 255, 16);
        vg_text_vec(fb, ((mx + 12)) as f32, ((metric_y + 9)) as f32, comp_task_metric_label(mi), 9.0, 0.6, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
        rayos_paint_u32(fb, ((mx + 12)) as f32, ((metric_y + 27)) as f32, comp_task_metric_value(c, mi), 17.0, 0.75, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
        mi = (mi + 1);
    }
    let table_y: i32 = (metric_y + 66);
    vg_text_vec(fb, ((x + 12)) as f32, (table_y) as f32, "TASK", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    vg_text_vec(fb, (((x + w) - 245)) as f32, (table_y) as f32, "STATE", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    vg_text_vec(fb, (((x + w) - 155)) as f32, (table_y) as f32, "PRIORITY", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    vg_text_vec(fb, (((x + w) - 65)) as f32, (table_y) as f32, "TIME", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    let row_y: i32 = (table_y + 20);
    let i: i32 = 0;
    while (((i < len[RayTask](c.*.scheduler.tasks)) && ((row_y + 34) < (y + h)))) {
        let task: RayTask = get[RayTask](c.*.scheduler.tasks, i);
        if (((i % 2) == 0)) {
            softgpu_blend_round_rect(fb, (x + 4), row_y, (w - 8), 32, 8, 255, 255, 255, 11);
        }
        let running: i32 = 0;
        if ((task.state == task_running())) {
            running = 1;
        }
        rayos_paint_status_dot(fb, ((x + 16)) as f32, ((row_y + 16)) as f32, 4.0, running, th);
        rayos_paint_text_trunc(fb, ((x + 28)) as f32, ((row_y + 9)) as f32, task.name, (w - 300), 11.0, 0.58, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
        vg_text_vec(fb, (((x + w) - 245)) as f32, ((row_y + 9)) as f32, comp_task_state_text(task.state), 9.0, 0.6, th.base.acc_r, th.base.acc_g, th.base.acc_b, 255);
        rayos_paint_u32(fb, (((x + w) - 115)) as f32, ((row_y + 8)) as f32, ((task.priority + 8)) as i32, 11.0, 0.6, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
        rayos_paint_u32(fb, (((x + w) - 62)) as f32, ((row_y + 8)) as f32, (task.runtime) as i32, 11.0, 0.6, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
        row_y = (row_y + 36);
        i = (i + 1);
    }
}

fn comp_paint_files(c: *Compositor, fb: *SoftFb, x: i32, y: i32, w: i32, h: i32) void {
    let th: RayOsTheme = c.*.wm.theme;
    comp_paint_content_header(c, fb, x, y, w, "Files", "TRIFS / NATIVE T9 PAYLOADS / TRANSACTIONAL NAMESPACE");
