struct UiTheme {
    bg_r: i32,
    bg_g: i32,
    bg_b: i32,
    bg2_r: i32,
    bg2_g: i32,
    bg2_b: i32,
    card_r: i32,
    card_g: i32,
    card_b: i32,
    ink_r: i32,
    ink_g: i32,
    ink_b: i32,
    mut_r: i32,
    mut_g: i32,
    mut_b: i32,
    acc_r: i32,
    acc_g: i32,
    acc_b: i32,
    acc2_r: i32,
    acc2_g: i32,
    acc2_b: i32,
    radius: f32,
}

fn ui_theme_engine() UiTheme {
    return UiTheme{ .bg_r = 14, .bg_g = 16, .bg_b = 34, .bg2_r = 44, .bg2_g = 30, .bg2_b = 70, .card_r = 244, .card_g = 244, .card_b = 250, .ink_r = 40, .ink_g = 40, .ink_b = 62, .mut_r = 130, .mut_g = 130, .mut_b = 160, .acc_r = 255, .acc_g = 176, .acc_b = 32, .acc2_r = 96, .acc2_g = 80, .acc2_b = 220, .radius = 12.0 };
}

struct UiNode {
    kind: i32,
    parent: i32,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    text: []u8,
    value: i32,
    size: f32,
    accent: i32,
    dirty: i32,
    data: ArrayList[i32],
}

struct UiTree {
    w: i32,
    h: i32,
    theme: UiTheme,
    nodes: ArrayList[UiNode],
}

fn ui_new(w: i32, h: i32) UiTree {
    let t: UiTree = UiTree{ .w = w, .h = h, .theme = ui_theme_engine(), .nodes = make[UiNode](16) };
    return t;
}

fn ui_node_base(kind: i32, parent: i32, x: f32, y: f32, w: f32, h: f32) UiNode {
    return UiNode{ .kind = kind, .parent = parent, .x = x, .y = y, .w = w, .h = h, .text = "", .value = 0, .size = 12.0, .accent = 0, .dirty = 1, .data = make[i32](2) };
}

fn ui_push(t: *UiTree, n: UiNode) i32 {
    push[UiNode](&t.*.nodes, n);
    return (len[UiNode](t.*.nodes) - 1);
}

fn ui_card(t: *UiTree, parent: i32, x: f32, y: f32, w: f32, h: f32) i32 {
    return ui_push(t, ui_node_base(ui_kind_card(), parent, x, y, w, h));
}

fn ui_label(t: *UiTree, parent: i32, x: f32, y: f32, text: []u8, muted: i32) i32 {
    let n: UiNode = ui_node_base(ui_kind_label(), parent, x, y, ((text.len * 6)) as f32, 8.0);
    n.text = text;
    n.accent = muted;
    return ui_push(t, n);
}

fn ui_vlabel(t: *UiTree, parent: i32, x: f32, y: f32, text: []u8, size: f32, weight_accent: i32) i32 {
    let n: UiNode = ui_node_base(ui_kind_vlabel(), parent, x, y, vg_text_width(text, size), (size + 4.0));
    n.text = text;
    n.size = size;
    n.accent = weight_accent;
    return ui_push(t, n);
}

fn ui_button(t: *UiTree, parent: i32, x: f32, y: f32, w: f32, h: f32, text: []u8, secondary: i32) i32 {
    let n: UiNode = ui_node_base(ui_kind_button(), parent, x, y, w, h);
    n.text = text;
    n.accent = secondary;
    return ui_push(t, n);
}

fn ui_gauge(t: *UiTree, parent: i32, cx: f32, cy: f32, rad: f32, value: i32) i32 {
    let n: UiNode = ui_node_base(ui_kind_gauge(), parent, (cx - rad), (cy - rad), (rad * 2.0), (rad * 2.0));
    n.value = value;
    n.size = rad;
    return ui_push(t, n);
}

fn ui_progress(t: *UiTree, parent: i32, x: f32, y: f32, w: f32, value: i32) i32 {
    let n: UiNode = ui_node_base(ui_kind_progress(), parent, x, y, w, 10.0);
    n.value = value;
    return ui_push(t, n);
}

fn ui_toggle(t: *UiTree, parent: i32, x: f32, y: f32, on: i32) i32 {
    let n: UiNode = ui_node_base(ui_kind_toggle(), parent, x, y, 34.0, 18.0);
    n.value = on;
    return ui_push(t, n);
}

fn ui_spark(t: *UiTree, parent: i32, x: f32, y: f32, w: f32, h: f32) i32 {
    return ui_push(t, ui_node_base(ui_kind_spark(), parent, x, y, w, h));
}

fn ui_spark_push(t: *UiTree, id: i32, sample: i32) void {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    push[i32](&n.data, sample);
    n.dirty = 1;
    set[UiNode](&t.*.nodes, id, n);
}

fn ui_set_value(t: *UiTree, id: i32, v: i32) void {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    if ((n.value != v)) {
        n.value = v;
        n.dirty = 1;
        set[UiNode](&t.*.nodes, id, n);
    }
}

fn ui_set_text(t: *UiTree, id: i32, s: []u8) void {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    n.text = s;
    n.dirty = 1;
    set[UiNode](&t.*.nodes, id, n);
}

fn ui_abs_x(t: *UiTree, id: i32) f32 {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    if ((n.parent < 0)) {
        return n.x;
    }
    return (ui_abs_x(t, n.parent) + n.x);
}

fn ui_abs_y(t: *UiTree, id: i32) f32 {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    if ((n.parent < 0)) {
        return n.y;
    }
    return (ui_abs_y(t, n.parent) + n.y);
}

fn ui_paint_bg_region(t: *UiTree, fb: *SoftFb, x: f32, y: f32, w: f32, h: f32) void {
    let p: VPath = vg_path_new();
    vg_move_to(&p, x, y);
    vg_line_to(&p, (x + w), y);
    vg_line_to(&p, (x + w), (y + h));
    vg_line_to(&p, x, (y + h));
    vg_close(&p);
    vg_fill_linear(fb, &p, 0.0, 0.0, 0.0, (t.*.h) as f32, t.*.theme.bg_r, t.*.theme.bg_g, t.*.theme.bg_b, 255, t.*.theme.bg2_r, t.*.theme.bg2_g, t.*.theme.bg2_b, 255);
}

fn ui_paint_card_region(t: *UiTree, fb: *SoftFb, id: i32) void {
    let ax: f32 = ui_abs_x(t, id);
    let ay: f32 = ui_abs_y(t, id);
    let n: UiNode = get[UiNode](t.*.nodes, id);
    let p: VPath = vg_path_new();
    vg_rounded_rect(&p, ax, ay, n.w, n.h, t.*.theme.radius);
    vg_fill(fb, &p, t.*.theme.card_r, t.*.theme.card_g, t.*.theme.card_b, 255);
}

fn ui_paint_node(t: *UiTree, fb: *SoftFb, id: i32) void {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    let ax: f32 = ui_abs_x(t, id);
    let ay: f32 = ui_abs_y(t, id);
    let th: UiTheme = t.*.theme;
    if ((n.kind == ui_kind_card())) {
        let sh: VPath = vg_path_new();
        vg_rounded_rect(&sh, (ax + 2.0), (ay + 4.0), n.w, n.h, th.radius);
        vg_fill(fb, &sh, 0, 0, 0, 70);
        let p: VPath = vg_path_new();
        vg_rounded_rect(&p, ax, ay, n.w, n.h, th.radius);
        vg_fill(fb, &p, th.card_r, th.card_g, th.card_b, 250);
        return;
    }
    if ((n.kind == ui_kind_label())) {
        if ((n.accent == 1)) {
            softgpu_text(fb, (ax) as i32, (ay) as i32, n.text, th.mut_r, th.mut_g, th.mut_b);
        } else {
            softgpu_text(fb, (ax) as i32, (ay) as i32, n.text, th.ink_r, th.ink_g, th.ink_b);
        }
        return;
    }
    if ((n.kind == ui_kind_vlabel())) {
        let wgt: f32 = (n.size / 9.0);
        if ((n.accent == 1)) {
            wgt = (n.size / 5.5);
        }
        vg_text_vec(fb, ax, ay, n.text, n.size, wgt, 240, 240, 250, 255);
        return;
    }
    if ((n.kind == ui_kind_button())) {
        let p: VPath = vg_path_new();
        vg_rounded_rect(&p, ax, ay, n.w, n.h, (n.h * 0.5));
        if ((n.value == 1)) {
            vg_fill(fb, &p, (th.acc2_r / 2), (th.acc2_g / 2), (th.acc2_b / 2), 255);
        } else if ((n.accent == 1)) {
            vg_fill_linear(fb, &p, ax, ay, (ax + n.w), (ay + n.h), th.acc2_r, th.acc2_g, th.acc2_b, 255, 150, 60, 200, 255);
        } else {
            vg_fill_linear(fb, &p, ax, ay, (ax + n.w), (ay + n.h), th.acc_r, th.acc_g, th.acc_b, 255, 255, 120, 40, 255);
        }
        let tx: f32 = (ax + ((n.w - vg_text_width(n.text, 12.0)) * 0.5));
        vg_text_vec(fb, tx, (ay + ((n.h - 12.0) * 0.5)), n.text, 12.0, 1.8, 255, 255, 255, 255);
        return;
    }
    if ((n.kind == ui_kind_gauge())) {
        let cx: f32 = (ax + n.size);
        let cy: f32 = (ay + n.size);
        let full: f32 = 4.7124;
        let sweep: f32 = ((full * (n.value) as f32) / 100.0);
        let a0: f32 = 2.3562;
        let track: VPath = vg_path_new();
        vg_donut(&track, cx, cy, n.size, (n.size - 10.0), a0, (a0 + full));
        vg_fill(fb, &track, 220, 220, 232, 255);
        if ((n.value > 0)) {
            let arc: VPath = vg_path_new();
            vg_donut(&arc, cx, cy, n.size, (n.size - 10.0), a0, (a0 + sweep));
            vg_fill(fb, &arc, th.acc2_r, th.acc2_g, th.acc2_b, 255);
        }
        let label: []u8 = _zag_i64_to_str((n.value) as i64);
        let tx: f32 = (cx - (vg_text_width(label, 16.0) * 0.5));
        vg_text_vec(fb, tx, (cy - 8.0), label, 16.0, 2.6, th.ink_r, th.ink_g, th.ink_b, 255);
        return;
    }
    if ((n.kind == ui_kind_progress())) {
        let track: VPath = vg_path_new();
        vg_rounded_rect(&track, ax, ay, n.w, n.h, (n.h * 0.5));
        vg_fill(fb, &track, 220, 220, 232, 255);
        let fw: f32 = ((n.w * (n.value) as f32) / 100.0);
        if ((fw > n.h)) {
            let bar: VPath = vg_path_new();
            vg_rounded_rect(&bar, ax, ay, fw, n.h, (n.h * 0.5));
            vg_fill_linear(fb, &bar, ax, ay, (ax + n.w), ay, th.acc_r, th.acc_g, th.acc_b, 255, th.acc2_r, th.acc2_g, th.acc2_b, 255);
        }
        return;
    }
    if ((n.kind == ui_kind_toggle())) {
        let track: VPath = vg_path_new();
        vg_rounded_rect(&track, ax, ay, n.w, n.h, (n.h * 0.5));
        if ((n.value == 1)) {
            vg_fill(fb, &track, th.acc2_r, th.acc2_g, th.acc2_b, 255);
        } else {
            vg_fill(fb, &track, 200, 200, 214, 255);
        }
        let kx: f32 = (ax + 2.0);
        if ((n.value == 1)) {
            kx = (((ax + n.w) - n.h) + 2.0);
        }
        let knob: VPath = vg_path_new();
        vg_circle(&knob, (kx + ((n.h - 4.0) * 0.5)), (ay + (n.h * 0.5)), ((n.h - 4.0) * 0.5));
        vg_fill(fb, &knob, 255, 255, 255, 255);
        return;
    }
    if ((n.kind == ui_kind_spark())) {
        let cnt: i32 = len[i32](n.data);
        if ((cnt < 2)) {
            return;
        }
        let p: VPath = vg_path_new();
        let i: i32 = 0;
        while ((i < cnt)) {
            let sx: f32 = (ax + ((n.w * (i) as f32) / ((cnt - 1)) as f32));
            let sy: f32 = ((ay + n.h) - ((n.h * (get[i32](n.data, i)) as f32) / 100.0));
            if ((i == 0)) {
                vg_move_to(&p, sx, sy);
            } else {
                vg_line_to(&p, sx, sy);
            }
            i = (i + 1);
        }
        vg_stroke(fb, &p, 2.5, th.acc2_r, th.acc2_g, th.acc2_b, 255);
        return;
    }
}

fn ui_clear_dirty(t: *UiTree, id: i32) void {
    let n: UiNode = get[UiNode](t.*.nodes, id);
    n.dirty = 0;
    set[UiNode](&t.*.nodes, id, n);
}

fn ui_render_full(t: *UiTree, fb: *SoftFb) void {
    ui_paint_bg_region(t, fb, 0.0, 0.0, (t.*.w) as f32, (t.*.h) as f32);
    let i: i32 = 0;
    while ((i < len[UiNode](t.*.nodes))) {
        ui_paint_node(t, fb, i);
        ui_clear_dirty(t, i);
        i = (i + 1);
    }
}

fn ui_render_damage(t: *UiTree, fb: *SoftFb) i32 {
    let repainted: i32 = 0;
    let i: i32 = 0;
    while ((i < len[UiNode](t.*.nodes))) {
        let n: UiNode = get[UiNode](t.*.nodes, i);
        if ((n.dirty == 1)) {
            let ax: f32 = ui_abs_x(t, i);
            let ay: f32 = ui_abs_y(t, i);
            let pad: f32 = 3.0;
            let rx: i32 = ((ax - pad)) as i32;
            let ry: i32 = ((ay - pad)) as i32;
            let rw: i32 = ((n.w + (pad * 2.0))) as i32;
            let rh: i32 = ((n.h + (pad * 2.0))) as i32;
            vg_set_clip(fb, rx, ry, rw, rh);
            if ((n.parent >= 0)) {
                ui_paint_card_region(t, fb, n.parent);
            } else {
                ui_paint_bg_region(t, fb, (rx) as f32, (ry) as f32, (rw) as f32, (rh) as f32);
            }
            let j: i32 = 0;
            while ((j < len[UiNode](t.*.nodes))) {
                let sib: UiNode = get[UiNode](t.*.nodes, j);
                if (((j != n.parent) && (sib.kind != ui_kind_card()))) {
                    ui_paint_node(t, fb, j);
                }
                j = (j + 1);
            }
            vg_clear_clip(fb);
            ui_clear_dirty(t, i);
            repainted = (repainted + (rw * rh));
        }
        i = (i + 1);
    }
    return repainted;
}

struct RayOsTheme {
    base: UiTheme,
    chrome_tb_r: i32,
    chrome_tb_g: i32,
    chrome_tb_b: i32,
    chrome_tb_a: i32,
    chrome_tb_focus_r: i32,
    chrome_tb_focus_g: i32,
    chrome_tb_focus_b: i32,
    chrome_body_r: i32,
    chrome_body_g: i32,
    chrome_body_b: i32,
    chrome_body_a: i32,
    chrome_border_r: i32,
    chrome_border_g: i32,
    chrome_border_b: i32,
    chrome_border_a: i32,
    tl_close_r: i32,
    tl_close_g: i32,
    tl_close_b: i32,
    tl_min_r: i32,
    tl_min_g: i32,
    tl_min_b: i32,
    tl_max_r: i32,
    tl_max_g: i32,
    tl_max_b: i32,
    titlebar_h: i32,
    title_size: f32,
    title_weight: f32,
    chrome_radius: f32,
    traffic_r: f32,
    shadow_layers: i32,
    shadow_grow: f32,
    shadow_offset_y: f32,
    shadow_alpha: i32,
    taskbar_h: i32,
    taskbar_r: i32,
    taskbar_g: i32,
    taskbar_b: i32,
    taskbar_a: i32,
    wall_r0: i32,
    wall_g0: i32,
    wall_b0: i32,
    wall_r1: i32,
    wall_g1: i32,
    wall_b1: i32,
}

fn rayos_titlebar_h() i32 {
    return 28;
}

fn rayos_taskbar_h() i32 {
    return 48;
}

fn rayos_chrome_radius() f32 {
    return 12.0;
}

fn rayos_theme() RayOsTheme {
    let base: UiTheme = UiTheme{ .bg_r = 10, .bg_g = 12, .bg_b = 28, .bg2_r = 36, .bg2_g = 22, .bg2_b = 58, .card_r = 32, .card_g = 34, .card_b = 52, .ink_r = 235, .ink_g = 236, .ink_b = 245, .mut_r = 148, .mut_g = 152, .mut_b = 178, .acc_r = 56, .acc_g = 214, .acc_b = 230, .acc2_r = 140, .acc2_g = 92, .acc2_b = 255, .radius = rayos_chrome_radius() };
    return RayOsTheme{ .base = base, .chrome_tb_r = 42, .chrome_tb_g = 44, .chrome_tb_b = 68, .chrome_tb_a = 210, .chrome_tb_focus_r = 52, .chrome_tb_focus_g = 48, .chrome_tb_focus_b = 88, .chrome_body_r = 28, .chrome_body_g = 30, .chrome_body_b = 48, .chrome_body_a = 255, .chrome_border_r = 88, .chrome_border_g = 72, .chrome_border_b = 140, .chrome_border_a = 90, .tl_close_r = 255, .tl_close_g = 95, .tl_close_b = 86, .tl_min_r = 255, .tl_min_g = 189, .tl_min_b = 46, .tl_max_r = 39, .tl_max_g = 201, .tl_max_b = 102, .titlebar_h = rayos_titlebar_h(), .title_size = 13.0, .title_weight = 1.6, .chrome_radius = rayos_chrome_radius(), .traffic_r = 5.5, .shadow_layers = 2, .shadow_grow = 3.0, .shadow_offset_y = 4.0, .shadow_alpha = 26, .taskbar_h = rayos_taskbar_h(), .taskbar_r = 18, .taskbar_g = 20, .taskbar_b = 38, .taskbar_a = 235, .wall_r0 = 10, .wall_g0 = 12, .wall_b0 = 28, .wall_r1 = 48, .wall_g1 = 28, .wall_b1 = 72 };
}

fn rayos_theme_base(t: RayOsTheme) UiTheme {
    return t.base;
}

fn rayos_paint_shadow(fb: *SoftFb, x: f32, y: f32, w: f32, h: f32, rad: f32, th: RayOsTheme) void {
    let i: i32 = 0;
    while ((i < th.shadow_layers)) {
        let grow: f32 = ((i) as f32 * th.shadow_grow);
        let alpha: i32 = th.shadow_alpha;
        if ((i > 0)) {
            alpha = (alpha - (i * 4));
        }
        if ((alpha < 6)) {
            alpha = 6;
        }
        let sx: i32 = ((x - grow)) as i32;
        let sy: i32 = (((y + th.shadow_offset_y) - grow)) as i32;
        let sw: i32 = ((w + (grow * 2.0))) as i32;
        let sh: i32 = ((h + (grow * 2.0))) as i32;
        let bx0: i32 = (x) as i32;
        let by0: i32 = (y) as i32;
        let bx1: i32 = ((x + w)) as i32;
        let by1: i32 = ((y + h)) as i32;
        if ((sy < by0)) {
            softgpu_blend_rect(fb, sx, sy, sw, (by0 - sy), 0, 0, 0, alpha);
        }
        if (((sy + sh) > by1)) {
            softgpu_blend_rect(fb, sx, by1, sw, ((sy + sh) - by1), 0, 0, 0, alpha);
        }
        let mid_y: i32 = by0;
        if ((sy > mid_y)) {
            mid_y = sy;
        }
        let mid_h: i32 = (by1 - mid_y);
        if (((sy + sh) < by1)) {
            mid_h = ((sy + sh) - mid_y);
        }
        if ((mid_h > 0)) {
            if ((sx < bx0)) {
                softgpu_blend_rect(fb, sx, mid_y, (bx0 - sx), mid_h, 0, 0, 0, alpha);
            }
            if (((sx + sw) > bx1)) {
                softgpu_blend_rect(fb, bx1, mid_y, ((sx + sw) - bx1), mid_h, 0, 0, 0, alpha);
            }
        }
        i = (i + 1);
    }
}

fn rayos_digit_ch(d: i32) []u8 {
    if ((d == 0)) {
        return "0";
    }
    if ((d == 1)) {
        return "1";
    }
    if ((d == 2)) {
        return "2";
    }
    if ((d == 3)) {
        return "3";
    }
    if ((d == 4)) {
        return "4";
    }
    if ((d == 5)) {
        return "5";
    }
    if ((d == 6)) {
        return "6";
    }
    if ((d == 7)) {
        return "7";
    }
    if ((d == 8)) {
        return "8";
    }
    return "9";
}

fn rayos_glyph_advance(size: f32) f32 {
    return (size * 0.94);
}

fn rayos_paint_u32(fb: *SoftFb, x: f32, y: f32, v: i32, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    if ((v < 0)) {
        v = 0;
    }
    if ((v == 0)) {
        vg_text_vec(fb, x, y, "0", size, weight, r, g, b, a);
        return;
    }
    let div: i32 = 1000000000;
    let started: i32 = 0;
    while ((div > 0)) {
        let d: i32 = ((v / div) % 10);
        if (((d != 0) || (started == 1))) {
            started = 1;
            vg_text_vec(fb, x, y, rayos_digit_ch(d), size, weight, r, g, b, a);
            x = (x + rayos_glyph_advance(size));
        }
        div = (div / 10);
    }
}

fn rayos_paint_clock(fb: *SoftFb, x: f32, y: f32, secs: i64, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    let h: i32 = (((secs / 3600) % 24)) as i32;
    let m: i32 = (((secs / 60) % 60)) as i32;
    let hh: i32 = (h / 10);
    let hl: i32 = (h % 10);
    let mh: i32 = (m / 10);
    let ml: i32 = (m % 10);
    vg_text_vec(fb, x, y, rayos_digit_ch(hh), size, weight, r, g, b, a);
    vg_text_vec(fb, (x + (size * 0.94)), y, rayos_digit_ch(hl), size, weight, r, g, b, a);
    vg_text_vec(fb, (x + (size * 1.88)), y, ":", size, weight, r, g, b, a);
    vg_text_vec(fb, (x + (size * 2.82)), y, rayos_digit_ch(mh), size, weight, r, g, b, a);
    vg_text_vec(fb, (x + (size * 3.76)), y, rayos_digit_ch(ml), size, weight, r, g, b, a);
}

fn rayos_clock_width(size: f32) f32 {
    return (size * 4.8);
}

fn rayos_paint_vm_count(fb: *SoftFb, x: f32, y: f32, count: i32, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    vg_text_vec(fb, x, y, "VM:", size, weight, r, g, b, a);
    rayos_paint_u32(fb, (x + (size * 2.9)), y, count, size, weight, r, g, b, a);
}

fn rayos_vm_width(count: i32, size: f32) i32 {
    let digits: i32 = 1;
    let v: i32 = count;
    if ((v < 0)) {
        v = 0;
    }
    if ((v == 0)) {
        return ((((4.0 * size) * 0.94)) as i32 + 12);
    }
    while ((v >= 10)) {
        digits = (digits + 1);
        v = (v / 10);
    }
    return ((((((3 + digits)) as f32 * size) * 0.94)) as i32 + 12);
}

fn rayos_paint_orb(fb: *SoftFb, cx: f32, cy: f32, rad: f32, th: RayOsTheme) void {
    rayos_paint_shadow(fb, (cx - rad), (cy - rad), (rad * 2.0), (rad * 2.0), rad, th);
    let orb: VPath = vg_path_new();
    vg_circle(&orb, cx, cy, rad);
    vg_fill_linear(fb, &orb, (cx - rad), (cy - rad), (cx + rad), (cy + rad), th.base.acc_r, th.base.acc_g, th.base.acc_b, 255, th.base.acc2_r, th.base.acc2_g, th.base.acc2_b, 255);
    let core: VPath = vg_path_new();
    vg_circle(&core, (cx - (rad * 0.15)), (cy - (rad * 0.15)), (rad * 0.35));
    vg_fill(fb, &core, 255, 255, 255, 90);
}

fn rayos_paint_status_dot(fb: *SoftFb, cx: f32, cy: f32, rad: f32, on: i32, th: RayOsTheme) void {
    let rr: i32 = th.base.mut_r;
    let rg: i32 = th.base.mut_g;
    let rb: i32 = th.base.mut_b;
    if ((on == 1)) {
        rr = 64;
        rg = 210;
        rb = 120;
    }
    let glow: VPath = vg_path_new();
    vg_circle(&glow, cx, cy, (rad + 2.0));
    vg_fill(fb, &glow, rr, rg, rb, 60);
    let dot: VPath = vg_path_new();
    vg_circle(&dot, cx, cy, rad);
    vg_fill(fb, &dot, rr, rg, rb, 255);
}

fn rayos_paint_text_trunc(fb: *SoftFb, x: f32, y: f32, s: []u8, max_px: i32, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    let char_w: i32 = (rayos_glyph_advance(size)) as i32;
    if ((char_w < 1)) {
        char_w = 1;
    }
    let max_chars: i32 = (max_px / char_w);
    if ((max_chars < 1)) {
        return;
    }
    let draw_n: i32 = s.len;
    if ((s.len > max_chars)) {
        draw_n = (max_chars - 3);
        if ((draw_n < 0)) {
            draw_n = 0;
        }
    }
    let i: i32 = 0;
    while ((i < draw_n)) {
        let ch: []u8 = s[i..(i + 1)];
        vg_text_vec(fb, (x + ((i) as f32 * rayos_glyph_advance(size))), y, ch, size, weight, r, g, b, a);
        i = (i + 1);
    }
    if ((s.len > max_chars)) {
        let ex: f32 = (x + ((draw_n) as f32 * rayos_glyph_advance(size)));
        vg_text_vec(fb, ex, y, "...", size, weight, r, g, b, a);
    }
}

fn rayos_paint_frosted_panel(fb: *SoftFb, x: f32, y: f32, w: f32, h: f32, rad: f32, th: RayOsTheme) void {
    rayos_paint_shadow(fb, x, y, w, h, rad, th);
    softgpu_blend_round_rect(fb, (x) as i32, (y) as i32, (w) as i32, (h) as i32, (rad) as i32, (th.chrome_body_r + 200), (th.chrome_body_g + 200), (th.chrome_body_b + 200), 236);
    let rim: VPath = vg_path_new();
    vg_rounded_rect(&rim, (x + 0.5), (y + 0.5), (w - 1.0), (h - 1.0), rad);
    vg_stroke(fb, &rim, 1.0, 255, 255, 255, 48);
}

fn wm_content_native() i32 {
    return 0;
}

fn wm_content_guest() i32 {
    return 1;
}

fn wm_content_tasks() i32 {
    return 2;
}

fn wm_content_files() i32 {
    return 3;
}

fn wm_content_browser() i32 {
    return 4;
}

fn wm_content_devices() i32 {
    return 5;
}

fn wm_content_terminal() i32 {
    return 6;
}

fn wm_hit_none() i32 {
    return -1;
}

fn wm_hit_client() i32 {
    return 0;
}

fn wm_hit_titlebar() i32 {
    return 1;
}

fn wm_hit_close() i32 {
    return 2;
}

fn wm_hit_min() i32 {
    return 3;
}

fn wm_hit_max() i32 {
    return 4;
}

struct RayWindow {
    id: i32,
    title: []u8,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    z: i32,
    focused: i32,
    minimized: i32,
    maximized: i32,
    rest_x: i32,
    rest_y: i32,
    rest_w: i32,
    rest_h: i32,
    content_kind: i32,
    guest_id: i32,
    fb_offset: i32,
    ver: i32,
    cache_fb: i64,
    cache_ver: i32,
    cache_w: i32,
    cache_h: i32,
}

struct WmState {
    windows: ArrayList[RayWindow],
    next_id: i32,
    focused_id: i32,
    z_top: i32,
    theme: RayOsTheme,
}

fn wm_new() WmState {
    return WmState{ .windows = make[RayWindow](8), .next_id = 1, .focused_id = -1, .z_top = 0, .theme = rayos_theme() };
}

fn wm_find_index(wm: *WmState, id: i32) i32 {
    let i: i32 = 0;
    while ((i < len[RayWindow](wm.*.windows))) {
        let w: RayWindow = get[RayWindow](wm.*.windows, i);
        if ((w.id == id)) {
            return i;
        }
        i = (i + 1);
    }
    return -1;
}

fn wm_get(wm: *WmState, id: i32) RayWindow {
    let idx: i32 = wm_find_index(wm, id);
    if ((idx < 0)) {
        return RayWindow{ .id = -1, .title = "", .x = 0, .y = 0, .w = 0, .h = 0, .z = 0, .focused = 0, .minimized = 0, .maximized = 0, .rest_x = 0, .rest_y = 0, .rest_w = 0, .rest_h = 0, .content_kind = 0, .guest_id = 0, .fb_offset = 0, .ver = 0, .cache_fb = 0, .cache_ver = 0, .cache_w = 0, .cache_h = 0 };
    }
    return get[RayWindow](wm.*.windows, idx);
}

fn wm_set(wm: *WmState, id: i32, w: RayWindow) void {
    let idx: i32 = wm_find_index(wm, id);
    if ((idx >= 0)) {
        set[RayWindow](&wm.*.windows, idx, w);
    }
}

fn wm_add_window(wm: *WmState, title: []u8, x: i32, y: i32, w: i32, h: i32, content_kind: i32, guest_id: i32, fb_offset: i32) i32 {
    wm.*.z_top = (wm.*.z_top + 1);
    let id: i32 = wm.*.next_id;
    wm.*.next_id = (wm.*.next_id + 1);
    let win: RayWindow = RayWindow{ .id = id, .title = title, .x = x, .y = y, .w = w, .h = h, .z = wm.*.z_top, .focused = 1, .minimized = 0, .maximized = 0, .rest_x = x, .rest_y = y, .rest_w = w, .rest_h = h, .content_kind = content_kind, .guest_id = guest_id, .fb_offset = fb_offset, .ver = 1, .cache_fb = 0, .cache_ver = 0, .cache_w = 0, .cache_h = 0 };
    push[RayWindow](&wm.*.windows, win);
    wm_focus(wm, id);
    return id;
}

fn wm_clear_focus(wm: *WmState) void {
    let i: i32 = 0;
    while ((i < len[RayWindow](wm.*.windows))) {
        let w: RayWindow = get[RayWindow](wm.*.windows, i);
        if ((w.focused == 1)) {
            w.ver = (w.ver + 1);
        }
        w.focused = 0;
        set[RayWindow](&wm.*.windows, i, w);
        i = (i + 1);
    }
}

fn wm_focus(wm: *WmState, id: i32) void {
    if ((wm_find_index(wm, id) < 0)) {
        return;
    }
    wm_clear_focus(wm);
    wm.*.z_top = (wm.*.z_top + 1);
    let w: RayWindow = wm_get(wm, id);
    w.focused = 1;
    w.z = wm.*.z_top;
    w.minimized = 0;
    w.ver = (w.ver + 1);
    wm_set(wm, id, w);
    wm.*.focused_id = id;
}

fn wm_move(wm: *WmState, id: i32, x: i32, y: i32) void {
    let w: RayWindow = wm_get(wm, id);
    if ((w.id < 0)) {
        return;
    }
    w.x = x;
    w.y = y;
    wm_set(wm, id, w);
}

fn wm_resize(wm: *WmState, id: i32, w: i32, h: i32) void {
    let win: RayWindow = wm_get(wm, id);
    if ((win.id < 0)) {
        return;
    }
    if ((w < 120)) {
        w = 120;
    }
    if ((h < 80)) {
        h = 80;
    }
    win.w = w;
    win.h = h;
    win.ver = (win.ver + 1);
    wm_set(wm, id, win);
}

fn wm_minimize(wm: *WmState, id: i32) void {
    let w: RayWindow = wm_get(wm, id);
    if ((w.id < 0)) {
        return;
    }
    w.minimized = 1;
    w.focused = 0;
    w.ver = (w.ver + 1);
    wm_set(wm, id, w);
    if ((wm.*.focused_id == id)) {
        wm.*.focused_id = -1;
        let i: i32 = (len[RayWindow](wm.*.windows) - 1);
        while ((i >= 0)) {
            let cand: RayWindow = get[RayWindow](wm.*.windows, i);
            if ((cand.minimized == 0)) {
                wm_focus(wm, cand.id);
                return;
            }
            i = (i - 1);
        }
    }
}

fn wm_toggle_maximize(wm: *WmState, id: i32, work_w: i32, work_h: i32) void {
    let w: RayWindow = wm_get(wm, id);
    if ((w.id < 0)) {
        return;
    }
    if ((w.maximized == 0)) {
        w.rest_x = w.x;
        w.rest_y = w.y;
        w.rest_w = w.w;
        w.rest_h = w.h;
        w.x = 0;
        w.y = 0;
        w.w = work_w;
        w.h = work_h;
        w.maximized = 1;
    } else {
        w.x = w.rest_x;
        w.y = w.rest_y;
        w.w = w.rest_w;
        w.h = w.rest_h;
        w.maximized = 0;
    }
    w.ver = (w.ver + 1);
    wm_set(wm, id, w);
    wm_focus(wm, id);
}

fn wm_close(wm: *WmState, id: i32) void {
    let idx: i32 = wm_find_index(wm, id);
    if ((idx < 0)) {
        return;
    }
    let victim: RayWindow = get[RayWindow](wm.*.windows, idx);
    wm_free_cache(&victim);
    set[RayWindow](&wm.*.windows, idx, victim);
    let last: i32 = (len[RayWindow](wm.*.windows) - 1);
    if ((idx != last)) {
        let tail: RayWindow = get[RayWindow](wm.*.windows, last);
        set[RayWindow](&wm.*.windows, idx, tail);
    }
    pop[RayWindow](&wm.*.windows);
    if ((wm.*.focused_id == id)) {
        wm.*.focused_id = -1;
        let i: i32 = (len[RayWindow](wm.*.windows) - 1);
        while ((i >= 0)) {
            let cand: RayWindow = get[RayWindow](wm.*.windows, i);
            if ((cand.minimized == 0)) {
                wm_focus(wm, cand.id);
                return;
            }
            i = (i - 1);
        }
    }
}

fn wm_touch(wm: *WmState, id: i32) void {
    let w: RayWindow = wm_get(wm, id);
    if ((w.id < 0)) {
        return;
    }
    w.ver = (w.ver + 1);
    wm_set(wm, id, w);
}

fn wm_free_cache(win: *RayWindow) void {
    if ((win.*.cache_fb == 0)) {
        return;
    }
    let pfb: *SoftFb = (win.*.cache_fb) as *SoftFb;
    free[u8](&pfb.*.pix);
    free[u8](&pfb.*.mask);
    free[u8](&pfb.*.acc);
    _zag_free((win.*.cache_fb) as *i8);
    win.*.cache_fb = 0;
    win.*.cache_w = 0;
    win.*.cache_h = 0;
}

fn wm_client_y(th: RayOsTheme) i32 {
    return th.titlebar_h;
}

fn wm_client_h(win: RayWindow, th: RayOsTheme) i32 {
    let ch: i32 = (win.h - th.titlebar_h);
    if ((ch < 1)) {
        ch = 1;
    }
    return ch;
}

fn wm_dist2(ax: i32, ay: i32, bx: f32, by: f32) f32 {
    let dx: f32 = ((ax) as f32 - bx);
    let dy: f32 = ((ay) as f32 - by);
    return ((dx * dx) + (dy * dy));
}

fn wm_hit_test(wm: *WmState, mx: i32, my: i32) i32 {
    let best_z: i32 = -1;
    let best_hit: i32 = wm_hit_none();
    let th: RayOsTheme = wm.*.theme;
    let i: i32 = 0;
    while ((i < len[RayWindow](wm.*.windows))) {
        let w: RayWindow = get[RayWindow](wm.*.windows, i);
        if ((w.minimized == 0)) {
            if (((((mx >= w.x) && (mx < (w.x + w.w))) && (my >= w.y)) && (my < (w.y + w.h)))) {
                if ((w.z > best_z)) {
                    best_z = w.z;
                    let ay: f32 = ((w.y + (th.titlebar_h / 2))) as f32;
                    let ax: f32 = ((w.x + 14)) as f32;
                    let r2: f32 = 81.0;
                    if ((wm_dist2(mx, my, ax, ay) <= r2)) {
                        best_hit = wm_hit_close();
                    } else if ((wm_dist2(mx, my, (ax + 18.0), ay) <= r2)) {
                        best_hit = wm_hit_min();
                    } else if ((wm_dist2(mx, my, (ax + 36.0), ay) <= r2)) {
                        best_hit = wm_hit_max();
                    } else if ((my < (w.y + th.titlebar_h))) {
                        best_hit = wm_hit_titlebar();
                    } else {
                        best_hit = wm_hit_client();
                    }
                }
            }
        }
        i = (i + 1);
    }
    return best_hit;
}

fn wm_hit_test_window(wm: *WmState, mx: i32, my: i32) i32 {
    let best_id: i32 = -1;
    let best_z: i32 = -1;
    let i: i32 = 0;
    while ((i < len[RayWindow](wm.*.windows))) {
        let w: RayWindow = get[RayWindow](wm.*.windows, i);
        if ((w.minimized == 0)) {
            if (((((mx >= w.x) && (mx < (w.x + w.w))) && (my >= w.y)) && (my < (w.y + w.h)))) {
                if ((w.z > best_z)) {
                    best_z = w.z;
                    best_id = w.id;
                }
            }
        }
        i = (i + 1);
    }
    return best_id;
}

fn wm_paint_traffic_light(fb: *SoftFb, cx: f32, cy: f32, rad: f32, r: i32, g: i32, b: i32, glyph: i32) void {
    let glow: VPath = vg_path_new();
    vg_circle(&glow, cx, cy, (rad + 1.5));
    vg_fill(fb, &glow, r, g, b, 40);
    let dot: VPath = vg_path_new();
    vg_circle(&dot, cx, cy, rad);
    vg_fill(fb, &dot, r, g, b, 255);
    let s: f32 = (rad * 0.45);
    if ((glyph == 0)) {
        let a: VPath = vg_path_new();
        vg_move_to(&a, (cx - s), (cy - s));
        vg_line_to(&a, (cx + s), (cy + s));
        vg_stroke(fb, &a, 1.4, 40, 12, 8, 200);
        let bpath: VPath = vg_path_new();
        vg_move_to(&bpath, (cx + s), (cy - s));
        vg_line_to(&bpath, (cx - s), (cy + s));
        vg_stroke(fb, &bpath, 1.4, 40, 12, 8, 200);
    }
    if ((glyph == 1)) {
        let m: VPath = vg_path_new();
        vg_move_to(&m, (cx - s), cy);
        vg_line_to(&m, (cx + s), cy);
        vg_stroke(fb, &m, 1.4, 66, 44, 6, 200);
    }
    if ((glyph == 2)) {
        let q: VPath = vg_path_new();
        vg_rounded_rect(&q, (cx - s), (cy - s), (s * 2.0), (s * 2.0), 1.0);
        vg_stroke(fb, &q, 1.3, 8, 48, 22, 200);
    }
}

fn wm_paint_chrome_cache(wm: *WmState, fb: *SoftFb, win: RayWindow) void {
    let th: RayOsTheme = wm.*.theme;
    softgpu_blend_rect(fb, 0, 0, win.w, win.h, th.chrome_body_r, th.chrome_body_g, th.chrome_body_b, 255);
    let tb_r: i32 = th.chrome_tb_r;
    let tb_g: i32 = th.chrome_tb_g;
    let tb_b: i32 = th.chrome_tb_b;
    if ((win.focused == 1)) {
        tb_r = th.chrome_tb_focus_r;
        tb_g = th.chrome_tb_focus_g;
        tb_b = th.chrome_tb_focus_b;
    }
    softgpu_blend_vgrad_rect(fb, 0, 0, win.w, th.titlebar_h, tb_r, tb_g, tb_b, th.chrome_body_r, th.chrome_body_g, th.chrome_body_b, th.chrome_tb_a);
    let ri: i32 = (th.chrome_radius) as i32;
    softgpu_blend_rect(fb, ri, 0, (win.w - (ri * 2)), 1, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, ri, (win.h - 1), (win.w - (ri * 2)), 1, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, 0, ri, 1, (win.h - (ri * 2)), th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, (win.w - 1), ri, 1, (win.h - (ri * 2)), th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, 8, th.titlebar_h, (win.w - 16), 1, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, 50);
    let tb_h: f32 = (th.titlebar_h) as f32;
    let ty: f32 = ((tb_h - th.title_size) * 0.5);
    wm_paint_traffic_light(fb, 14.0, (tb_h * 0.5), th.traffic_r, th.tl_close_r, th.tl_close_g, th.tl_close_b, 0);
    wm_paint_traffic_light(fb, 32.0, (tb_h * 0.5), th.traffic_r, th.tl_min_r, th.tl_min_g, th.tl_min_b, 1);
    wm_paint_traffic_light(fb, 50.0, (tb_h * 0.5), th.traffic_r, th.tl_max_r, th.tl_max_g, th.tl_max_b, 2);
    let ink_r: i32 = th.base.ink_r;
    let ink_g: i32 = th.base.ink_g;
    let ink_b: i32 = th.base.ink_b;
    if ((win.focused == 0)) {
        ink_r = th.base.mut_r;
        ink_g = th.base.mut_g;
        ink_b = th.base.mut_b;
    }
    vg_text_vec(fb, 68.0, ty, win.title, th.title_size, th.title_weight, ink_r, ink_g, ink_b, 255);
}

fn wm_paint_chrome(wm: *WmState, fb: *SoftFb, id: i32) void {
    let win: RayWindow = wm_get(wm, id);
    if (((win.id < 0) || (win.minimized == 1))) {
        return;
    }
    let th: RayOsTheme = wm.*.theme;
    let ax: f32 = (win.x) as f32;
    let ay: f32 = (win.y) as f32;
    let aw: f32 = (win.w) as f32;
    let ah: f32 = (win.h) as f32;
    let rad: f32 = th.chrome_radius;
    rayos_paint_shadow(fb, ax, ay, aw, ah, rad, th);
    softgpu_blend_round_rect(fb, win.x, win.y, win.w, win.h, (rad) as i32, th.chrome_body_r, th.chrome_body_g, th.chrome_body_b, th.chrome_body_a);
    let tb_h: f32 = (th.titlebar_h) as f32;
    let tb_r: i32 = th.chrome_tb_r;
    let tb_g: i32 = th.chrome_tb_g;
    let tb_b: i32 = th.chrome_tb_b;
    if ((win.focused == 1)) {
        tb_r = th.chrome_tb_focus_r;
        tb_g = th.chrome_tb_focus_g;
        tb_b = th.chrome_tb_focus_b;
    }
    softgpu_blend_round_rect_vgrad(fb, win.x, win.y, win.w, th.titlebar_h, (rad) as i32, tb_r, tb_g, tb_b, th.chrome_body_r, th.chrome_body_g, th.chrome_body_b, th.chrome_tb_a);
    let ri: i32 = (rad) as i32;
    let bw2: i32 = (win.w - (ri * 2));
    let bh2: i32 = (win.h - (ri * 2));
    softgpu_blend_rect(fb, (win.x + ri), win.y, bw2, 1, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, (win.x + ri), ((win.y + win.h) - 1), bw2, 1, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, win.x, (win.y + ri), 1, bh2, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, ((win.x + win.w) - 1), (win.y + ri), 1, bh2, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, th.chrome_border_a);
    softgpu_blend_rect(fb, (win.x + 8), (win.y + th.titlebar_h), (win.w - 16), 1, th.chrome_border_r, th.chrome_border_g, th.chrome_border_b, 50);
    let ty: f32 = (ay + ((tb_h - th.title_size) * 0.5));
    wm_paint_traffic_light(fb, (ax + 14.0), (ay + (tb_h * 0.5)), th.traffic_r, th.tl_close_r, th.tl_close_g, th.tl_close_b, 0);
    wm_paint_traffic_light(fb, (ax + 32.0), (ay + (tb_h * 0.5)), th.traffic_r, th.tl_min_r, th.tl_min_g, th.tl_min_b, 1);
    wm_paint_traffic_light(fb, (ax + 50.0), (ay + (tb_h * 0.5)), th.traffic_r, th.tl_max_r, th.tl_max_g, th.tl_max_b, 2);
    let title_x: f32 = (ax + 68.0);
    let ink_r: i32 = th.base.ink_r;
    let ink_g: i32 = th.base.ink_g;
    let ink_b: i32 = th.base.ink_b;
    if ((win.focused == 0)) {
        ink_r = th.base.mut_r;
        ink_g = th.base.mut_g;
        ink_b = th.base.mut_b;
    }
    vg_text_vec(fb, title_x, ty, win.title, th.title_size, th.title_weight, ink_r, ink_g, ink_b, 255);
}

fn wm_icon_generic() i32 {
    return 0;
}

fn wm_icon_terminal() i32 {
    return 1;
}

fn wm_icon_settings() i32 {
    return 2;
}

fn wm_icon_linux() i32 {
    return 3;
}

fn wm_icon_windows() i32 {
    return 4;
}

fn wm_icon_files() i32 {
    return 5;
}

fn wm_icon_home() i32 {
    return 6;
}

fn wm_icon_browser() i32 {
    return 7;
}

fn wm_icon_trash() i32 {
    return 8;
}

fn wm_window_icon(win: RayWindow) i32 {
    if ((win.content_kind == wm_content_guest())) {
        if ((win.guest_id == 2)) {
            return wm_icon_windows();
        }
        return wm_icon_linux();
    }
    if (((win.guest_id == 0) && (win.fb_offset > 0))) {
        return wm_icon_settings();
    }
    return wm_icon_terminal();
}

fn wm_paint_taskbar_icon(fb: *SoftFb, icon: i32, x: f32, y: f32, size: f32, th: RayOsTheme) void {
    let s: f32 = size;
    let lw: f32 = (s * 0.07);
    if ((lw < 1.2)) {
        lw = 1.2;
    }
    let corner: f32 = (s * 0.2);
    let rr: i32 = th.base.acc2_r;
    let rg: i32 = th.base.acc2_g;
    let rb: i32 = th.base.acc2_b;
    if ((icon == wm_icon_terminal())) {
        rr = 22;
        rg = 34;
        rb = 40;
    }
    if ((icon == wm_icon_settings())) {
        rr = 96;
        rg = 104;
        rb = 132;
    }
    if ((icon == wm_icon_linux())) {
        rr = 235;
        rg = 180;
        rb = 40;
    }
    if ((icon == wm_icon_windows())) {
        rr = 36;
        rg = 120;
        rb = 210;
    }
    if ((icon == wm_icon_files())) {
        rr = 245;
        rg = 158;
        rb = 44;
    }
    if ((icon == wm_icon_home())) {
        rr = 122;
        rg = 88;
        rb = 235;
    }
    if ((icon == wm_icon_browser())) {
        rr = 26;
        rg = 150;
        rb = 180;
    }
    if ((icon == wm_icon_trash())) {
        rr = 108;
        rg = 116;
        rb = 140;
    }
    let box: VPath = vg_path_new();
    vg_rounded_rect(&box, x, y, s, s, corner);
    vg_fill(fb, &box, rr, rg, rb, 255);
    let shine: VPath = vg_path_new();
    vg_rounded_rect(&shine, x, y, s, (s * 0.5), corner);
    vg_fill(fb, &shine, 255, 255, 255, 26);
    if ((icon == wm_icon_terminal())) {
        let c0: VPath = vg_path_new();
        vg_move_to(&c0, (x + (s * 0.22)), (y + (s * 0.3)));
        vg_line_to(&c0, (x + (s * 0.42)), (y + (s * 0.5)));
        vg_line_to(&c0, (x + (s * 0.22)), (y + (s * 0.7)));
        vg_stroke(fb, &c0, (lw * 1.3), 92, 255, 160, 255);
        let cur: VPath = vg_path_new();
        vg_move_to(&cur, (x + (s * 0.52)), (y + (s * 0.7)));
        vg_line_to(&cur, (x + (s * 0.78)), (y + (s * 0.7)));
        vg_stroke(fb, &cur, (lw * 1.3), 220, 235, 230, 255);
        return;
    }
    if ((icon == wm_icon_files())) {
        let tab: VPath = vg_path_new();
        vg_rounded_rect(&tab, (x + (s * 0.18)), (y + (s * 0.24)), (s * 0.34), (s * 0.18), (s * 0.05));
        vg_fill(fb, &tab, 255, 224, 130, 255);
        let body: VPath = vg_path_new();
        vg_rounded_rect(&body, (x + (s * 0.16)), (y + (s * 0.34)), (s * 0.68), (s * 0.42), (s * 0.07));
        vg_fill(fb, &body, 255, 236, 170, 255);
        let crease: VPath = vg_path_new();
        vg_move_to(&crease, (x + (s * 0.16)), (y + (s * 0.45)));
        vg_line_to(&crease, (x + (s * 0.84)), (y + (s * 0.45)));
        vg_stroke(fb, &crease, (lw * 0.8), 214, 158, 40, 200);
        return;
    }
    if ((icon == wm_icon_home())) {
        let roof: VPath = vg_path_new();
        vg_move_to(&roof, (x + (s * 0.16)), (y + (s * 0.5)));
        vg_line_to(&roof, (x + (s * 0.5)), (y + (s * 0.2)));
        vg_line_to(&roof, (x + (s * 0.84)), (y + (s * 0.5)));
        vg_stroke(fb, &roof, (lw * 1.4), 255, 255, 255, 240);
        let bodyh: VPath = vg_path_new();
        vg_rounded_rect(&bodyh, (x + (s * 0.26)), (y + (s * 0.48)), (s * 0.48), (s * 0.32), (s * 0.04));
        vg_fill(fb, &bodyh, 255, 255, 255, 235);
        let door: VPath = vg_path_new();
        vg_rounded_rect(&door, (x + (s * 0.44)), (y + (s * 0.58)), (s * 0.12), (s * 0.22), (s * 0.03));
        vg_fill(fb, &door, rr, rg, rb, 255);
        return;
    }
    if ((icon == wm_icon_trash())) {
        let lid: VPath = vg_path_new();
        vg_move_to(&lid, (x + (s * 0.24)), (y + (s * 0.3)));
        vg_line_to(&lid, (x + (s * 0.76)), (y + (s * 0.3)));
        vg_stroke(fb, &lid, (lw * 1.3), 235, 238, 245, 240);
        let handle: VPath = vg_path_new();
        vg_move_to(&handle, (x + (s * 0.42)), (y + (s * 0.3)));
        vg_line_to(&handle, (x + (s * 0.45)), (y + (s * 0.22)));
        vg_line_to(&handle, (x + (s * 0.55)), (y + (s * 0.22)));
        vg_line_to(&handle, (x + (s * 0.58)), (y + (s * 0.3)));
        vg_stroke(fb, &handle, lw, 235, 238, 245, 240);
        let can: VPath = vg_path_new();
        vg_rounded_rect(&can, (x + (s * 0.3)), (y + (s * 0.36)), (s * 0.4), (s * 0.42), (s * 0.06));
        vg_fill(fb, &can, 235, 238, 245, 235);
        let s1: VPath = vg_path_new();
        vg_move_to(&s1, (x + (s * 0.42)), (y + (s * 0.42)));
        vg_line_to(&s1, (x + (s * 0.42)), (y + (s * 0.72)));
        vg_stroke(fb, &s1, (lw * 0.8), rr, rg, rb, 255);
        let s2: VPath = vg_path_new();
        vg_move_to(&s2, (x + (s * 0.58)), (y + (s * 0.42)));
        vg_line_to(&s2, (x + (s * 0.58)), (y + (s * 0.72)));
        vg_stroke(fb, &s2, (lw * 0.8), rr, rg, rb, 255);
        return;
    }
    if ((icon == wm_icon_settings())) {
        let cx: f32 = (x + (s * 0.5));
        let cy: f32 = (y + (s * 0.5));
        let ring: VPath = vg_path_new();
        vg_circle(&ring, cx, cy, (s * 0.2));
        vg_stroke(fb, &ring, (lw * 1.6), 255, 255, 255, 240);
        let t0: VPath = vg_path_new();
        vg_move_to(&t0, cx, (cy - (s * 0.34)));
        vg_line_to(&t0, cx, (cy - (s * 0.22)));
        vg_stroke(fb, &t0, (lw * 1.6), 255, 255, 255, 240);
        let t1: VPath = vg_path_new();
        vg_move_to(&t1, cx, (cy + (s * 0.22)));
        vg_line_to(&t1, cx, (cy + (s * 0.34)));
        vg_stroke(fb, &t1, (lw * 1.6), 255, 255, 255, 240);
        let t2: VPath = vg_path_new();
        vg_move_to(&t2, (cx - (s * 0.34)), cy);
        vg_line_to(&t2, (cx - (s * 0.22)), cy);
        vg_stroke(fb, &t2, (lw * 1.6), 255, 255, 255, 240);
        let t3: VPath = vg_path_new();
        vg_move_to(&t3, (cx + (s * 0.22)), cy);
        vg_line_to(&t3, (cx + (s * 0.34)), cy);
        vg_stroke(fb, &t3, (lw * 1.6), 255, 255, 255, 240);
        let t4: VPath = vg_path_new();
        vg_move_to(&t4, (cx - (s * 0.24)), (cy - (s * 0.24)));
        vg_line_to(&t4, (cx - (s * 0.16)), (cy - (s * 0.16)));
        vg_stroke(fb, &t4, (lw * 1.4), 255, 255, 255, 240);
        let t5: VPath = vg_path_new();
        vg_move_to(&t5, (cx + (s * 0.16)), (cy + (s * 0.16)));
        vg_line_to(&t5, (cx + (s * 0.24)), (cy + (s * 0.24)));
        vg_stroke(fb, &t5, (lw * 1.4), 255, 255, 255, 240);
        let t6: VPath = vg_path_new();
        vg_move_to(&t6, (cx + (s * 0.24)), (cy - (s * 0.24)));
        vg_line_to(&t6, (cx + (s * 0.16)), (cy - (s * 0.16)));
        vg_stroke(fb, &t6, (lw * 1.4), 255, 255, 255, 240);
        let t7: VPath = vg_path_new();
        vg_move_to(&t7, (cx - (s * 0.16)), (cy + (s * 0.16)));
        vg_line_to(&t7, (cx - (s * 0.24)), (cy + (s * 0.24)));
        vg_stroke(fb, &t7, (lw * 1.4), 255, 255, 255, 240);
        return;
    }
    if ((icon == wm_icon_browser())) {
        let cx: f32 = (x + (s * 0.5));
        let cy: f32 = (y + (s * 0.5));
        let rad: f32 = (s * 0.28);
        let globe: VPath = vg_path_new();
        vg_circle(&globe, cx, cy, rad);
        vg_stroke(fb, &globe, (lw * 1.3), 255, 255, 255, 240);
        let eq: VPath = vg_path_new();
        vg_move_to(&eq, (cx - rad), cy);
        vg_line_to(&eq, (cx + rad), cy);
        vg_stroke(fb, &eq, lw, 255, 255, 255, 200);
        let mer: VPath = vg_path_new();
        vg_move_to(&mer, cx, (cy - rad));
        vg_line_to(&mer, (cx - (rad * 0.45)), cy);
        vg_line_to(&mer, cx, (cy + rad));
        vg_line_to(&mer, (cx + (rad * 0.45)), cy);
        vg_close(&mer);
        vg_stroke(fb, &mer, (lw * 0.9), 255, 255, 255, 200);
        return;
    }
    if ((icon == wm_icon_linux())) {
        let scr: VPath = vg_path_new();
        vg_rounded_rect(&scr, (x + (s * 0.2)), (y + (s * 0.24)), (s * 0.6), (s * 0.4), (s * 0.05));
        vg_stroke(fb, &scr, (lw * 1.3), 40, 34, 8, 240);
        let inner: VPath = vg_path_new();
        vg_rounded_rect(&inner, (x + (s * 0.26)), (y + (s * 0.3)), (s * 0.48), (s * 0.28), (s * 0.03));
        vg_fill(fb, &inner, 40, 34, 8, 210);
        let stand: VPath = vg_path_new();
        vg_move_to(&stand, (x + (s * 0.5)), (y + (s * 0.64)));
        vg_line_to(&stand, (x + (s * 0.5)), (y + (s * 0.74)));
        vg_stroke(fb, &stand, (lw * 1.3), 40, 34, 8, 240);
        let foot: VPath = vg_path_new();
        vg_move_to(&foot, (x + (s * 0.36)), (y + (s * 0.76)));
        vg_line_to(&foot, (x + (s * 0.64)), (y + (s * 0.76)));
        vg_stroke(fb, &foot, (lw * 1.3), 40, 34, 8, 240);
        return;
    }
    if ((icon == wm_icon_windows())) {
        let vsep: VPath = vg_path_new();
        vg_move_to(&vsep, (x + (s * 0.5)), (y + (s * 0.22)));
        vg_line_to(&vsep, (x + (s * 0.5)), (y + (s * 0.78)));
        vg_stroke(fb, &vsep, (lw * 1.4), 255, 255, 255, 235);
        let hsep: VPath = vg_path_new();
        vg_move_to(&hsep, (x + (s * 0.22)), (y + (s * 0.5)));
        vg_line_to(&hsep, (x + (s * 0.78)), (y + (s * 0.5)));
        vg_stroke(fb, &hsep, (lw * 1.4), 255, 255, 255, 235);
        let frame: VPath = vg_path_new();
        vg_rounded_rect(&frame, (x + (s * 0.22)), (y + (s * 0.22)), (s * 0.56), (s * 0.56), (s * 0.04));
        vg_stroke(fb, &frame, (lw * 1.4), 255, 255, 255, 235);
        return;
    }
    let d: f32 = (s * 0.09);
    let g0: VPath = vg_path_new();
    vg_circle(&g0, (x + (s * 0.36)), (y + (s * 0.36)), d);
    vg_fill(fb, &g0, 255, 255, 255, 235);
    let g1: VPath = vg_path_new();
    vg_circle(&g1, (x + (s * 0.64)), (y + (s * 0.36)), d);
    vg_fill(fb, &g1, 255, 255, 255, 235);
    let g2: VPath = vg_path_new();
    vg_circle(&g2, (x + (s * 0.36)), (y + (s * 0.64)), d);
    vg_fill(fb, &g2, 255, 255, 255, 235);
    let g3: VPath = vg_path_new();
    vg_circle(&g3, (x + (s * 0.64)), (y + (s * 0.64)), d);
    vg_fill(fb, &g3, 255, 255, 255, 235);
}

fn wm_count_visible(wm: *WmState) i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < len[RayWindow](wm.*.windows))) {
        let w: RayWindow = get[RayWindow](wm.*.windows, i);
        if ((w.minimized == 0)) {
            n = (n + 1);
        }
        i = (i + 1);
    }
    return n;
}

fn desktop_icon_none() i32 {
    return -1;
}

fn desktop_icon_home() i32 {
    return 0;
}

fn desktop_icon_files() i32 {
    return 1;
}

fn desktop_icon_trash() i32 {
    return 2;
}

fn desktop_icon_tile() i32 {
    return 64;
}

struct DesktopIcon {
    id: i32,
    label: []u8,
    icon: i32,
    x: i32,
    y: i32,
}

struct DesktopState {
    screen_w: i32,
    screen_h: i32,
    icons: ArrayList[DesktopIcon],
}

fn desktop_new(w: i32, h: i32) DesktopState {
    let st: DesktopState = DesktopState{ .screen_w = w, .screen_h = h, .icons = make[DesktopIcon](4) };
    push[DesktopIcon](&st.icons, DesktopIcon{ .id = desktop_icon_home(), .label = "Home", .icon = wm_icon_home(), .x = 24, .y = 24 });
    push[DesktopIcon](&st.icons, DesktopIcon{ .id = desktop_icon_files(), .label = "Files", .icon = wm_icon_files(), .x = 24, .y = 104 });
    push[DesktopIcon](&st.icons, DesktopIcon{ .id = desktop_icon_trash(), .label = "Trash", .icon = wm_icon_trash(), .x = 24, .y = 184 });
    return st;
}

fn desktop_work_h(st: DesktopState, th: RayOsTheme) i32 {
    let wh: i32 = (st.screen_h - th.taskbar_h);
    if ((wh < 1)) {
        wh = 1;
    }
    return wh;
}

fn desktop_paint_wallpaper(st: DesktopState, fb: *SoftFb, th: RayOsTheme) void {
    let work_h: i32 = desktop_work_h(st, th);
    let bg: VPath = vg_path_new();
    vg_move_to(&bg, 0.0, 0.0);
    vg_line_to(&bg, (st.screen_w) as f32, 0.0);
    vg_line_to(&bg, (st.screen_w) as f32, (work_h) as f32);
    vg_line_to(&bg, 0.0, (work_h) as f32);
    vg_close(&bg);
    vg_fill_linear(fb, &bg, 0.0, 0.0, 0.0, (work_h) as f32, th.wall_r0, th.wall_g0, th.wall_b0, 255, th.wall_r1, th.wall_g1, th.wall_b1, 255);
    let i: i32 = 0;
    while ((i < 6)) {
        let cx: f32 = ((80 + (i * 140))) as f32;
        let cy: f32 = (((work_h - 60) - ((i % 3) * 40))) as f32;
        let orb: VPath = vg_path_new();
        vg_circle(&orb, cx, cy, (28.0 + ((i) as f32 * 4.0)));
        vg_fill(fb, &orb, th.base.acc2_r, th.base.acc2_g, th.base.acc2_b, (18 + (i * 4)));
        i = (i + 1);
    }
}

fn desktop_paint_icon_tile(st: DesktopState, fb: *SoftFb, ic: DesktopIcon, th: RayOsTheme) void {
    let x: f32 = (ic.x) as f32;
    let y: f32 = (ic.y) as f32;
    let tile: f32 = (desktop_icon_tile()) as f32;
    let sel: VPath = vg_path_new();
    vg_rounded_rect(&sel, (x - 4.0), (y - 4.0), (tile + 8.0), (tile + 22.0), 10.0);
    vg_fill(fb, &sel, 255, 255, 255, 24);
    wm_paint_taskbar_icon(fb, ic.icon, (x + 8.0), (y + 4.0), 48.0, th);
    let tw: f32 = vg_text_width(ic.label, 10.0);
    vg_text_vec(fb, (x + ((tile - tw) * 0.5)), ((y + tile) - 8.0), ic.label, 10.0, 0.55, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
}

fn desktop_paint(st: *DesktopState, fb: *SoftFb, wm: *WmState) void {
    let th: RayOsTheme = wm.*.theme;
    desktop_paint_wallpaper(st.*, fb, th);
    let i: i32 = 0;
    while ((i < len[DesktopIcon](st.*.icons))) {
        let ic: DesktopIcon = get[DesktopIcon](st.*.icons, i);
        desktop_paint_icon_tile(st.*, fb, ic, th);
        i = (i + 1);
    }
}

fn desktop_hit_test(st: DesktopState, wm: *WmState, x: i32, y: i32) i32 {
    let th: RayOsTheme = wm.*.theme;
    if ((y >= desktop_work_h(st, th))) {
        return desktop_icon_none();
    }
    let i: i32 = 0;
    while ((i < len[DesktopIcon](st.icons))) {
        let ic: DesktopIcon = get[DesktopIcon](st.icons, i);
        let tile: i32 = desktop_icon_tile();
        if (((((x >= ic.x) && (x < (ic.x + tile))) && (y >= ic.y)) && (y < ((ic.y + tile) + 16)))) {
            return ic.id;
        }
        i = (i + 1);
    }
    return desktop_icon_none();
}

fn desktop_icon_label(icon_id: i32) []u8 {
    if ((icon_id == desktop_icon_home())) {
        return "Home";
    }
    if ((icon_id == desktop_icon_files())) {
        return "Files";
    }
    if ((icon_id == desktop_icon_trash())) {
        return "Trash";
    }
    return "";
}

fn desktop_icon_kind(icon_id: i32) i32 {
    if ((icon_id == desktop_icon_home())) {
        return wm_icon_home();
    }
    if ((icon_id == desktop_icon_files())) {
        return wm_icon_files();
    }
    if ((icon_id == desktop_icon_trash())) {
        return wm_icon_trash();
    }
    return wm_icon_generic();
}

fn shell_hit_none() i32 {
    return 0;
}

fn shell_hit_logo() i32 {
    return 1;
}

fn shell_hit_start() i32 {
    return 2;
}

fn shell_hit_window() i32 {
    return 3;
}

fn shell_hit_tray_clock() i32 {
    return 4;
}

fn shell_hit_tray_net() i32 {
    return 5;
}

fn shell_hit_tray_vms() i32 {
    return 6;
}

struct ShellHit {
    kind: i32,
    id: i32,
}

struct ShellState {
    screen_w: i32,
    screen_h: i32,
    clock_secs: i64,
    network_up: i32,
    guest_vm_count: i32,
    win_btn_x: ArrayList[i32],
    win_btn_w: ArrayList[i32],
    win_btn_id: ArrayList[i32],
    tray_clock_x: i32,
    tray_clock_w: i32,
    tray_net_x: i32,
    tray_net_w: i32,
    tray_vm_x: i32,
    tray_vm_w: i32,
}

fn shell_new(w: i32, h: i32) ShellState {
    return ShellState{ .screen_w = w, .screen_h = h, .clock_secs = 0, .network_up = 1, .guest_vm_count = 0, .win_btn_x = make[i32](8), .win_btn_w = make[i32](8), .win_btn_id = make[i32](8), .tray_clock_x = 0, .tray_clock_w = 0, .tray_net_x = 0, .tray_net_w = 0, .tray_vm_x = 0, .tray_vm_w = 0 };
}

fn shell_set_clock(sh: *ShellState, secs: i64) void {
    sh.*.clock_secs = secs;
}

fn shell_set_network(sh: *ShellState, up: i32) void {
    sh.*.network_up = up;
}

fn shell_set_guest_vms(sh: *ShellState, count: i32) void {
    sh.*.guest_vm_count = count;
}

fn shell_taskbar_y(sh: ShellState, th: RayOsTheme) i32 {
    return (sh.screen_h - th.taskbar_h);
}

fn shell_layout_tray(sh: *ShellState) void {
    let vm_w: i32 = 0;
    if ((sh.*.guest_vm_count > 0)) {
        vm_w = rayos_vm_width(sh.*.guest_vm_count, 11.0);
    }
    let net_w: i32 = 0;
    if ((sh.*.network_up == 1)) {
        net_w = 28;
    }
    let clk_w: i32 = ((rayos_clock_width(12.0)) as i32 + 16);
    let margin: i32 = 10;
    let x: i32 = (sh.*.screen_w - margin);
    if ((vm_w > 0)) {
        x = (x - vm_w);
    }
    sh.*.tray_vm_x = x;
    sh.*.tray_vm_w = vm_w;
    if ((net_w > 0)) {
        x = ((x - net_w) - 8);
    }
    sh.*.tray_net_x = x;
    sh.*.tray_net_w = net_w;
    x = ((x - clk_w) - 8);
    sh.*.tray_clock_x = x;
    sh.*.tray_clock_w = clk_w;
}

fn shell_rebuild_win_buttons(sh: *ShellState, wm: *WmState) void {
    free[i32](&sh.*.win_btn_x);
    free[i32](&sh.*.win_btn_w);
    free[i32](&sh.*.win_btn_id);
    sh.*.win_btn_x = make[i32](8);
    sh.*.win_btn_w = make[i32](8);
    sh.*.win_btn_id = make[i32](8);
    let x: i32 = 148;
    let max_x: i32 = (sh.*.tray_clock_x - 12);
    let i: i32 = 0;
    let done: i32 = 0;
    while (((i < len[RayWindow](wm.*.windows)) && (done == 0))) {
        let win: RayWindow = get[RayWindow](wm.*.windows, i);
        let title_px: i32 = (win.title.len * 10);
        if ((title_px > 84)) {
            title_px = 84;
        }
        let btn_w: i32 = ((34 + title_px) + 10);
        if (((x + btn_w) > max_x)) {
            done = 1;
        } else {
            push[i32](&sh.*.win_btn_x, x);
            push[i32](&sh.*.win_btn_w, btn_w);
            push[i32](&sh.*.win_btn_id, win.id);
            x = ((x + btn_w) + 6);
            i = (i + 1);
        }
    }
}

fn shell_paint_taskbar_bg(sh: ShellState, fb: *SoftFb, th: RayOsTheme) void {
    let y: i32 = shell_taskbar_y(sh, th);
    softgpu_blend_vgrad_rect(fb, 0, y, sh.screen_w, (sh.screen_h - y), th.taskbar_r, th.taskbar_g, th.taskbar_b, th.base.bg2_r, th.base.bg2_g, th.base.bg2_b, th.taskbar_a);
    let line: VPath = vg_path_new();
    vg_move_to(&line, 0.0, (y) as f32);
    vg_line_to(&line, (sh.screen_w) as f32, (y) as f32);
    vg_stroke(fb, &line, 1.0, th.base.acc2_r, th.base.acc2_g, th.base.acc2_b, 80);
}

fn shell_paint_logo(sh: ShellState, fb: *SoftFb, th: RayOsTheme) void {
    let cy: f32 = ((shell_taskbar_y(sh, th) + (th.taskbar_h / 2))) as f32;
    rayos_paint_orb(fb, 24.0, cy, 14.0, th);
}

fn shell_paint_start(sh: ShellState, fb: *SoftFb, th: RayOsTheme) void {
    let y: i32 = (shell_taskbar_y(sh, th) + 8);
    rayos_paint_shadow(fb, 52.0, (y) as f32, 88.0, 32.0, 16.0, th);
    softgpu_blend_round_rect_vgrad(fb, 52, y, 88, 32, 16, th.base.acc2_r, th.base.acc2_g, th.base.acc2_b, th.base.acc_r, th.base.acc_g, th.base.acc_b, 255);
    vg_text_vec(fb, 68.0, ((y + 8)) as f32, "Start", 12.0, 0.65, 255, 255, 255, 255);
}

fn shell_paint_window_btn(sh: ShellState, fb: *SoftFb, win: RayWindow, bx: i32, bw: i32, th: RayOsTheme) void {
    let y: i32 = (shell_taskbar_y(sh, th) + 8);
    let xf: f32 = (bx) as f32;
    if ((win.focused == 1)) {
        softgpu_blend_round_rect(fb, bx, y, bw, 32, 14, th.base.acc2_r, th.base.acc2_g, th.base.acc2_b, 230);
    } else if ((win.minimized == 1)) {
        softgpu_blend_round_rect(fb, bx, y, bw, 32, 14, th.taskbar_r, th.taskbar_g, th.taskbar_b, 180);
    } else {
        softgpu_blend_round_rect(fb, bx, y, bw, 32, 14, 60, 62, 88, 210);
    }
    wm_paint_taskbar_icon(fb, wm_window_icon(win), (xf + 6.0), ((y + 6)) as f32, 20.0, th);
    let ink_r: i32 = th.base.ink_r;
    let ink_g: i32 = th.base.ink_g;
    let ink_b: i32 = th.base.ink_b;
    if ((win.minimized == 1)) {
        ink_r = th.base.mut_r;
        ink_g = th.base.mut_g;
        ink_b = th.base.mut_b;
    }
    rayos_paint_text_trunc(fb, (xf + 30.0), ((y + 8)) as f32, win.title, (bw - 38), 11.0, 0.55, ink_r, ink_g, ink_b, 255);
}

fn shell_paint_tray(sh: ShellState, fb: *SoftFb, th: RayOsTheme) void {
    let y: f32 = ((shell_taskbar_y(sh, th) + 10)) as f32;
    softgpu_blend_round_rect(fb, (sh.tray_clock_x - 6), (shell_taskbar_y(sh, th) + 8), ((sh.screen_w - sh.tray_clock_x) - 4), 30, 10, 0, 0, 0, 36);
    rayos_paint_clock(fb, ((sh.tray_clock_x + 6)) as f32, (y + 4.0), sh.clock_secs, 12.0, 0.6, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    if ((sh.tray_net_w > 0)) {
        let net_cx: f32 = ((sh.tray_net_x + (sh.tray_net_w / 2))) as f32;
        let net_cy: f32 = ((shell_taskbar_y(sh, th) + (th.taskbar_h / 2))) as f32;
        rayos_paint_status_dot(fb, net_cx, net_cy, 5.0, sh.network_up, th);
    }
    if ((sh.tray_vm_w > 0)) {
        rayos_paint_vm_count(fb, ((sh.tray_vm_x + 4)) as f32, (y + 4.0), sh.guest_vm_count, 11.0, 0.55, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    }
}

fn shell_paint(sh: *ShellState, fb: *SoftFb, wm: *WmState) void {
    let th: RayOsTheme = wm.*.theme;
    shell_layout_tray(sh);
    shell_rebuild_win_buttons(sh, wm);
    shell_paint_taskbar_bg(sh.*, fb, th);
    shell_paint_logo(sh.*, fb, th);
    shell_paint_start(sh.*, fb, th);
    let bi: i32 = 0;
    while ((bi < len[i32](sh.*.win_btn_id))) {
        let wid: i32 = get[i32](sh.*.win_btn_id, bi);
        let win: RayWindow = wm_get(wm, wid);
        if ((win.id >= 0)) {
            let bx: i32 = get[i32](sh.*.win_btn_x, bi);
            let bw: i32 = get[i32](sh.*.win_btn_w, bi);
            shell_paint_window_btn(sh.*, fb, win, bx, bw, th);
        }
        bi = (bi + 1);
    }
    shell_paint_tray(sh.*, fb, th);
}

fn shell_hit_test(sh: ShellState, wm: *WmState, x: i32, y: i32) ShellHit {
    let th: RayOsTheme = wm.*.theme;
    let miss: ShellHit = ShellHit{ .kind = shell_hit_none(), .id = 0 };
    if ((y < shell_taskbar_y(sh, th))) {
        return miss;
    }
    if (((x >= 10) && (x <= 38))) {
        return ShellHit{ .kind = shell_hit_logo(), .id = 0 };
    }
    if (((x >= 52) && (x <= 140))) {
        return ShellHit{ .kind = shell_hit_start(), .id = 0 };
    }
    let bi: i32 = 0;
    while ((bi < len[i32](sh.win_btn_id))) {
        let bx: i32 = get[i32](sh.win_btn_x, bi);
        let bw: i32 = get[i32](sh.win_btn_w, bi);
        if (((x >= bx) && (x < (bx + bw)))) {
            return ShellHit{ .kind = shell_hit_window(), .id = get[i32](sh.win_btn_id, bi) };
        }
        bi = (bi + 1);
    }
    if (((x >= sh.tray_clock_x) && (x < (sh.tray_clock_x + sh.tray_clock_w)))) {
        return ShellHit{ .kind = shell_hit_tray_clock(), .id = 0 };
    }
    if (((x >= sh.tray_net_x) && (x < (sh.tray_net_x + sh.tray_net_w)))) {
        return ShellHit{ .kind = shell_hit_tray_net(), .id = 0 };
    }
    if (((x >= sh.tray_vm_x) && (x < (sh.tray_vm_x + sh.tray_vm_w)))) {
        return ShellHit{ .kind = shell_hit_tray_vms(), .id = 0 };
    }
    return miss;
}

fn shell_taskbar_h() i32 {
    return rayos_taskbar_h();
}

fn launcher_app_none() i32 {
    return -1;
}

fn launcher_app_terminal() i32 {
    return 0;
}

fn launcher_app_settings() i32 {
    return 1;
}

fn launcher_app_linux() i32 {
    return 2;
}

fn launcher_app_windows() i32 {
    return 3;
}

fn launcher_app_files() i32 {
    return 4;
}

fn launcher_app_tasks() i32 {
    return 5;
}

fn launcher_app_browser() i32 {
    return 6;
}

fn launcher_hit_search() i32 {
    return 100;
}

fn launcher_hit_close() i32 {
    return 101;
}

fn launcher_panel_w() i32 {
    return 320;
}

fn launcher_panel_h() i32 {
    return 500;
}

struct LauncherState {
    open: i32,
    slide: f32,
    slide_target: f32,
    search_focus: i32,
    anchor_x: i32,
    screen_w: i32,
    screen_h: i32,
    cache_fb: i64,
    cache_key: i32,
    search: ArrayList[u8],
}

struct LauncherApp {
    id: i32,
    name: []u8,
    icon: i32,
}

fn launcher_new(screen_w: i32, screen_h: i32) LauncherState {
    return LauncherState{ .open = 0, .slide = 0.0, .slide_target = 0.0, .search_focus = 0, .anchor_x = 8, .screen_w = screen_w, .screen_h = screen_h, .cache_fb = 0, .cache_key = -1, .search = make[u8](16) };
}

fn launcher_open(st: *LauncherState) void {
    st.*.open = 1;
    st.*.slide_target = 1.0;
    st.*.search_focus = 1;
    st.*.search.len = 0;
}

fn launcher_close(st: *LauncherState) void {
    st.*.open = 0;
    st.*.slide_target = 0.0;
    st.*.search_focus = 0;
}

fn launcher_is_open(st: LauncherState) i32 {
    return st.open;
}

fn launcher_tick(st: *LauncherState) void {
    let delta: f32 = 0.14;
    if ((st.*.slide < st.*.slide_target)) {
        st.*.slide = (st.*.slide + delta);
        if ((st.*.slide > st.*.slide_target)) {
            st.*.slide = st.*.slide_target;
        }
    } else if ((st.*.slide > st.*.slide_target)) {
        st.*.slide = (st.*.slide - delta);
        if ((st.*.slide < st.*.slide_target)) {
            st.*.slide = st.*.slide_target;
        }
    }
}

fn launcher_panel_y(st: LauncherState, th: RayOsTheme) f32 {
    let bar_y: f32 = ((st.screen_h - th.taskbar_h)) as f32;
    let hidden: f32 = ((launcher_panel_h() + 16)) as f32;
    let shown: f32 = ((bar_y - (launcher_panel_h()) as f32) - 8.0);
    return (shown + (hidden * (1.0 - st.slide)));
}

fn launcher_app_count() i32 {
    return 7;
}

fn launcher_app_at(idx: i32) LauncherApp {
    if ((idx == 0)) {
        return LauncherApp{ .id = launcher_app_terminal(), .name = "RayTerminal", .icon = wm_icon_terminal() };
    }
    if ((idx == 1)) {
        return LauncherApp{ .id = launcher_app_settings(), .name = "Devices", .icon = wm_icon_settings() };
    }
    if ((idx == 2)) {
        return LauncherApp{ .id = launcher_app_linux(), .name = "Linux Guest", .icon = wm_icon_linux() };
    }
    if ((idx == 3)) {
        return LauncherApp{ .id = launcher_app_windows(), .name = "Windows Guest", .icon = wm_icon_windows() };
    }
    if ((idx == 4)) {
        return LauncherApp{ .id = launcher_app_files(), .name = "Files", .icon = wm_icon_files() };
    }
    if ((idx == 5)) {
        return LauncherApp{ .id = launcher_app_tasks(), .name = "Task Manager", .icon = wm_icon_settings() };
    }
    return LauncherApp{ .id = launcher_app_browser(), .name = "Ray Browser", .icon = wm_icon_browser() };
}

fn launcher_lower(c: u8) u8 {
    if (((c >= (65) as u8) && (c <= (90) as u8))) {
        return (c + 32);
    }
    return c;
}

fn launcher_match(name: []u8, query: []u8) i32 {
    if ((query.len < 1)) {
        return 1;
    }
    if ((name.len < query.len)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i <= (name.len - query.len))) {
        let j: i32 = 0;
        let hit: i32 = 1;
        while ((j < query.len)) {
            if ((launcher_lower(name[(i + j)]) != launcher_lower(query[j]))) {
                hit = 0;
                j = query.len;
            } else {
                j = (j + 1);
            }
        }
        if ((hit == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn launcher_query(st: *LauncherState) []u8 {
    return st.*.search.data[0..st.*.search.len];
}

fn launcher_filtered_count(st: *LauncherState) i32 {
    let q: []u8 = launcher_query(st);
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < launcher_app_count())) {
        if ((launcher_match(launcher_app_at(i).name, q) == 1)) {
            n = (n + 1);
        }
        i = (i + 1);
    }
    return n;
}

fn launcher_filtered_at(st: *LauncherState, idx: i32) LauncherApp {
    let q: []u8 = launcher_query(st);
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < launcher_app_count())) {
        let app: LauncherApp = launcher_app_at(i);
        if ((launcher_match(app.name, q) == 1)) {
            if ((n == idx)) {
                return app;
            }
            n = (n + 1);
        }
        i = (i + 1);
    }
    return LauncherApp{ .id = launcher_app_none(), .name = "", .icon = wm_icon_generic() };
}

fn launcher_key(st: *LauncherState, code: i32) i32 {
    if ((code == 27)) {
        return 3;
    }
    if ((code == 10)) {
        return 2;
    }
    if ((code == 8)) {
        if ((st.*.search.len > 0)) {
            st.*.search.len = (st.*.search.len - 1);
        }
        return 1;
    }
    if (((code >= 32) && (code <= 126))) {
        if ((st.*.search.len < 24)) {
            push[u8](&st.*.search, (code) as u8);
        }
        return 1;
    }
    return 0;
}

fn launcher_paint_search(st: LauncherState, fb: *SoftFb, x: f32, y: f32, w: f32, th: RayOsTheme) void {
    let h: f32 = 34.0;
    if ((st.search_focus == 1)) {
        softgpu_blend_round_rect(fb, (x) as i32, (y) as i32, (w) as i32, 34, 10, 255, 255, 255, 230);
        let ring: VPath = vg_path_new();
        vg_rounded_rect(&ring, (x + 0.5), (y + 0.5), (w - 1.0), (h - 1.0), 10.0);
        vg_stroke(fb, &ring, 1.5, th.base.acc2_r, th.base.acc2_g, th.base.acc2_b, 200);
    } else {
        softgpu_blend_round_rect(fb, (x) as i32, (y) as i32, (w) as i32, 34, 10, 255, 255, 255, 170);
    }
    let icon: VPath = vg_path_new();
    vg_circle(&icon, (x + 16.0), (y + (h * 0.5)), 6.0);
    vg_stroke(fb, &icon, 1.5, th.base.mut_r, th.base.mut_g, th.base.mut_b, 220);
    let stem: VPath = vg_path_new();
    vg_move_to(&stem, (x + 20.0), ((y + (h * 0.5)) + 4.0));
    vg_line_to(&stem, (x + 26.0), ((y + (h * 0.5)) + 10.0));
    vg_stroke(fb, &stem, 1.5, th.base.mut_r, th.base.mut_g, th.base.mut_b, 220);
    let q: []u8 = st.search.data[0..st.search.len];
    if ((q.len > 0)) {
        vg_text_vec(fb, (x + 34.0), (y + 10.0), q, 11.0, 0.6, 40, 42, 62, 255);
        let cx2: f32 = ((x + 34.0) + ((q.len) as f32 * rayos_glyph_advance(11.0)));
        softgpu_blend_rect(fb, (cx2) as i32, ((y + 8.0)) as i32, 2, 16, 40, 42, 62, 220);
    } else {
        vg_text_vec(fb, (x + 34.0), (y + 10.0), "Search apps", 11.0, 0.55, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    }
}

fn launcher_paint_tile(st: LauncherState, fb: *SoftFb, app: LauncherApp, x: f32, y: f32, th: RayOsTheme) void {
    let tile: f32 = 88.0;
    rayos_paint_shadow(fb, x, y, tile, (tile + 18.0), 12.0, th);
    softgpu_blend_round_rect(fb, (x) as i32, (y) as i32, 88, 88, 12, 255, 255, 255, 200);
    wm_paint_taskbar_icon(fb, app.icon, (x + 20.0), (y + 16.0), 48.0, th);
    vg_text_vec(fb, (x + 8.0), ((y + tile) + 2.0), app.name, 10.0, 0.55, 44, 46, 66, 255);
}

fn launcher_cache_state_key(st: *LauncherState) i32 {
    let key: i32 = (1 + st.*.search_focus);
    let i: i32 = 0;
    while ((i < st.*.search.len)) {
        key = ((key * 131) + (get[u8](st.*.search, i)) as i32);
        i = (i + 1);
    }
    return key;
}

fn launcher_build_cache(st: *LauncherState, screen_fb: *SoftFb, wm: *WmState) i64 {
    let key: i32 = launcher_cache_state_key(st);
    if (((st.*.cache_fb != 0) && (st.*.cache_key == key))) {
        return st.*.cache_fb;
    }
    let th: RayOsTheme = wm.*.theme;
    let w: i32 = launcher_panel_w();
    let h: i32 = launcher_panel_h();
    if ((st.*.cache_fb == 0)) {
        let raw: *i8 = _zag_malloc(@sizeOf[SoftFb]());
        let nfb: *SoftFb = (raw) as *SoftFb;
        nfb.* = softgpu_new(w, h);
        nfb.*.glyph_cache = vg_glyph_cache_block(screen_fb);
        st.*.cache_fb = (raw) as i64;
    }
    let fb: *SoftFb = (st.*.cache_fb) as *SoftFb;
    softgpu_blend_rect(fb, 0, 0, w, h, (th.chrome_body_r + 200), (th.chrome_body_g + 200), (th.chrome_body_b + 200), 255);
    let rim: VPath = vg_path_new();
    vg_rounded_rect(&rim, 0.5, 0.5, ((w) as f32 - 1.0), ((h) as f32 - 1.0), th.chrome_radius);
    vg_stroke(fb, &rim, 1.0, 255, 255, 255, 48);
    rayos_paint_orb(fb, 28.0, 28.0, 12.0, th);
    vg_text_vec(fb, 48.0, 16.0, "RayOS", 16.0, 0.7, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    vg_text_vec(fb, 48.0, 34.0, "Photon Desktop", 10.0, 0.5, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    launcher_paint_search(st.*, fb, 16.0, 56.0, ((w - 32)) as f32, th);
    let gx: f32 = 16.0;
    let gy: f32 = 104.0;
    let col: i32 = 0;
    let row: i32 = 0;
    let i: i32 = 0;
    let shown: i32 = launcher_filtered_count(st);
    while ((i < shown)) {
        let app: LauncherApp = launcher_filtered_at(st, i);
        let tx: f32 = (gx + ((col) as f32 * 96.0));
        let ty: f32 = (gy + ((row) as f32 * 108.0));
        launcher_paint_tile(st.*, fb, app, tx, ty, th);
        col = (col + 1);
        if ((col >= 3)) {
            col = 0;
            row = (row + 1);
        }
        i = (i + 1);
    }
    st.*.cache_key = key;
    return st.*.cache_fb;
}

fn launcher_paint(st: *LauncherState, fb: *SoftFb, wm: *WmState) void {
    if ((st.*.slide <= 0.001)) {
        return;
    }
    let th: RayOsTheme = wm.*.theme;
    let cache: i64 = launcher_build_cache(st, fb, wm);
    if ((cache == 0)) {
        return;
    }
    let x: i32 = st.*.anchor_x;
    let y: i32 = (launcher_panel_y(st.*, th)) as i32;
    rayos_paint_shadow(fb, (x) as f32, (y) as f32, (launcher_panel_w()) as f32, (launcher_panel_h()) as f32, th.chrome_radius, th);
    softgpu_compose_round_rect(fb, (cache) as *SoftFb, x, y, (th.chrome_radius) as i32);
}

fn launcher_hit_test(st: *LauncherState, wm: *WmState, x: i32, y: i32) i32 {
    if ((st.*.slide <= 0.01)) {
        return launcher_app_none();
    }
    let th: RayOsTheme = wm.*.theme;
    let px: f32 = (st.*.anchor_x) as f32;
    let py: f32 = launcher_panel_y(st.*, th);
    let pw: f32 = (launcher_panel_w()) as f32;
    let ph: f32 = (launcher_panel_h()) as f32;
    if ((((x) as f32 < px) || ((y) as f32 < py))) {
        return launcher_hit_close();
    }
    if ((((x) as f32 > (px + pw)) || ((y) as f32 > (py + ph)))) {
        return launcher_hit_close();
    }
    let sx: f32 = (px + 16.0);
    let sy: f32 = (py + 56.0);
    let sw: f32 = (pw - 32.0);
    let sh: f32 = 34.0;
    if ((((((x) as f32 >= sx) && ((x) as f32 < (sx + sw))) && ((y) as f32 >= sy)) && ((y) as f32 < (sy + sh)))) {
        return launcher_hit_search();
    }
    let gx: f32 = (px + 16.0);
    let gy: f32 = (py + 104.0);
    let shown: i32 = launcher_filtered_count(st);
    let i: i32 = 0;
    let col: i32 = 0;
    let row: i32 = 0;
    while ((i < shown)) {
        let tx: f32 = (gx + ((col) as f32 * 96.0));
        let ty: f32 = (gy + ((row) as f32 * 108.0));
        if ((((((x) as f32 >= tx) && ((x) as f32 < (tx + 88.0))) && ((y) as f32 >= ty)) && ((y) as f32 < (ty + 106.0)))) {
            return launcher_filtered_at(st, i).id;
        }
        col = (col + 1);
        if ((col >= 3)) {
            col = 0;
            row = (row + 1);
        }
        i = (i + 1);
    }
    return launcher_app_none();
}

fn launcher_app_title(app_id: i32) []u8 {
    if ((app_id == launcher_app_terminal())) {
        return "RayTerminal";
    }
    if ((app_id == launcher_app_settings())) {
        return "Devices";
    }
    if ((app_id == launcher_app_linux())) {
        return "Linux Guest";
    }
    if ((app_id == launcher_app_windows())) {
        return "Windows Guest";
    }
    if ((app_id == launcher_app_files())) {
        return "Files";
    }
    if ((app_id == launcher_app_tasks())) {
        return "Task Manager";
    }
    if ((app_id == launcher_app_browser())) {
        return "Ray Browser";
    }
    return "App";
}

fn launcher_app_icon(app_id: i32) i32 {
    if ((app_id == launcher_app_terminal())) {
        return wm_icon_terminal();
    }
    if ((app_id == launcher_app_settings())) {
        return wm_icon_settings();
    }
    if ((app_id == launcher_app_linux())) {
        return wm_icon_linux();
    }
    if ((app_id == launcher_app_windows())) {
        return wm_icon_windows();
    }
    if ((app_id == launcher_app_files())) {
        return wm_icon_files();
    }
    if ((app_id == launcher_app_browser())) {
        return wm_icon_browser();
    }
    return wm_icon_generic();
}

fn launcher_app_content_kind(app_id: i32) i32 {
    if (((app_id == launcher_app_linux()) || (app_id == launcher_app_windows()))) {
        return wm_content_guest();
    }
    if ((app_id == launcher_app_files())) {
        return wm_content_files();
    }
    if ((app_id == launcher_app_tasks())) {
        return wm_content_tasks();
    }
    if ((app_id == launcher_app_browser())) {
        return wm_content_browser();
    }
    if ((app_id == launcher_app_settings())) {
        return wm_content_devices();
    }
    if ((app_id == launcher_app_terminal())) {
        return wm_content_terminal();
    }
    return wm_content_native();
}

fn launcher_app_guest_id(app_id: i32) i32 {
    if ((app_id == launcher_app_windows())) {
        return 2;
    }
    if ((app_id == launcher_app_linux())) {
        return 1;
    }
    return 0;
}

fn task_ready() i64 {
    return 0;
}

fn task_running() i64 {
    return 1;
}

fn task_sleeping() i64 {
    return (0 - 1);
}

fn task_blocked() i64 {
    return 2;
}

