    if ((c == 67)) {
        return "10,3 7,0 3,0 0,3 0,11 3,14 7,14 10,11";
    }
    if ((c == 68)) {
        return "0,0 0,14;0,0 6,0 10,4 10,10 6,14 0,14";
    }
    if ((c == 69)) {
        return "10,0 0,0 0,14 10,14;0,7 7,7";
    }
    if ((c == 70)) {
