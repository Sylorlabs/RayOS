    return ((st.*.map_base + off)) as *i8;
}

fn hw_rt_backend_host() i32 {
    if ((hw_rt_ensure() != 0)) {
        return 1;
    }
    let st: *HwRtState = hw_rt_state_mut();
    if ((st.*.backend == 2)) {
        return 1;
    }
    return 0;
}

fn hw_fence() void {
    if ((hw_rt_ensure() != 0)) {
        return;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let probe: i32 = mmio_read32(st.*.virt_base);
    let _sink: i32 = (probe + 0);
}

fn SYSBUS_O_DIRECTORY() i64 {
    return 65536;
}

fn SYSBUS_DENTS_BUF() i32 {
    return 16384;
}

fn sysbus_listdir(path: []u8) []u8 {
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(path), SYSBUS_O_DIRECTORY(), 0, 0, 0, 0);
    if ((fd < 0)) {
        return "";
    }
    let buf: *i8 = _zag_malloc(SYSBUS_DENTS_BUF());
    let out: []u8 = "";
    let done: i32 = 0;
    while ((done == 0)) {
        let n: i64 = _zag_raw_syscall(217, fd, (buf) as i64, (SYSBUS_DENTS_BUF()) as i64, 0, 0, 0);
        if ((n <= 0)) {
            done = 1;
        } else {
            let at: i32 = 0;
            while (((at) as i64 < n)) {
                let reclen: i32 = (((buf[(at + 16)]) as u8) as i32 + (((buf[(at + 17)]) as u8) as i32 * 256));
                let ns: i32 = (at + 19);
                let ne: i32 = ns;
                while ((buf[ne] != (0) as i8)) {
                    ne = (ne + 1);
                }
                let bufu: *u8 = (buf) as *u8;
                let name: []u8 = bufu[ns..ne];
                if (((_zag_strcmp(name, ".") == 0) && (_zag_strcmp(name, "..") == 0))) {
                    if ((out.len > 0)) {
                        out = _zag_str_concat(out, "\n");
                    }
                    out = _zag_str_concat(out, name);
                }
                at = (at + reclen);
            }
        }
    }
    let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return out;
}

fn sysbus_exists(path: []u8) i32 {
    return _zag_file_exists(path);
}

fn sysbus_read_line(path: []u8) []u8 {
    if ((_zag_file_exists(path) == 0)) {
        return "";
    }
    let s: []u8 = _zag_read_file(path);
    if ((s.len < 1)) {
        return "";
    }
    let end: i32 = 0;
    while ((((end < s.len) && (s[end] != (10) as u8)) && (s[end] != (13) as u8))) {
        end = (end + 1);
    }
    while (((end > 0) && (s[(end - 1)] == (32) as u8))) {
        end = (end - 1);
    }
    return s[0..end];
}

fn sysbus_path2(a: []u8, b: []u8) []u8 {
    return _zag_str_concat(a, b);
}

fn sysbus_path3(a: []u8, b: []u8, c: []u8) []u8 {
    return _zag_str_concat(_zag_str_concat(a, b), c);
}

fn sysbus_contains(hay: []u8, needle: []u8) i32 {
    if ((needle.len < 1)) {
        return 1;
    }
    if ((hay.len < needle.len)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i <= (hay.len - needle.len))) {
        let j: i32 = 0;
        let hit: i32 = 1;
        while ((j < needle.len)) {
            if ((hay[(i + j)] != needle[j])) {
                hit = 0;
                j = needle.len;
            } else {
                j = (j + 1);
            }
        }
        if ((hit == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn sysbus_line_at(blob: []u8, idx: i32) []u8 {
    let line: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while ((i <= blob.len)) {
        if (((i == blob.len) || (blob[i] == (10) as u8))) {
            if ((line == idx)) {
                return blob[start..i];
            }
            line = (line + 1);
            start = (i + 1);
        }
        i = (i + 1);
    }
    return "";
}

fn sysbus_line_count(blob: []u8) i32 {
    if ((blob.len < 1)) {
        return 0;
    }
    let n: i32 = 1;
    let i: i32 = 0;
    while ((i < blob.len)) {
        if ((blob[i] == (10) as u8)) {
            n = (n + 1);
        }
        i = (i + 1);
    }
    return n;
}

fn devbus_row(report: []u8, bus: []u8, name: []u8, detail: []u8, state: []u8) []u8 {
    let r: []u8 = _zag_str_concat(report, bus);
    r = _zag_str_concat(r, "|");
    r = _zag_str_concat(r, name);
    r = _zag_str_concat(r, "|");
    r = _zag_str_concat(r, detail);
    r = _zag_str_concat(r, "|");
    r = _zag_str_concat(r, state);
    return _zag_str_concat(r, "\n");
}

fn devbus_scan_display(report: []u8) []u8 {
    let root: []u8 = "/sys/class/drm";
    let names: []u8 = sysbus_listdir(root);
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if (((sysbus_contains(name, "-") == 1) && (sysbus_contains(name, "card") == 1))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let status: []u8 = sysbus_read_line(sysbus_path2(base, "/status"));
            if ((status.len > 0)) {
                let bus: []u8 = "DISPLAY";
                if ((sysbus_contains(name, "HDMI") == 1)) {
                    bus = "HDMI";
                }
                if ((sysbus_contains(name, "-DP-") == 1)) {
                    bus = "DISPLAYPORT";
                }
                if ((sysbus_contains(name, "eDP") == 1)) {
                    bus = "DISPLAYPORT";
                }
                let mode: []u8 = sysbus_read_line(sysbus_path2(base, "/modes"));
                let detail: []u8 = "no signal";
                if ((mode.len > 0)) {
                    detail = mode;
                }
                report = devbus_row(report, bus, name, detail, status);
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_wifi_quality(iface: []u8) []u8 {
    let w: []u8 = _zag_read_file("/proc/net/wireless");
    if ((w.len < 1)) {
        return "";
    }
    let needle: []u8 = _zag_str_concat(iface, ":");
    let li: i32 = 0;
    let count: i32 = sysbus_line_count(w);
    while ((li < count)) {
        let line: []u8 = sysbus_line_at(w, li);
        if ((sysbus_contains(line, needle) == 1)) {
            let at: i32 = 0;
            while (((at < line.len) && (line[at] != (58) as u8))) {
                at = (at + 1);
            }
            at = (at + 1);
            let field: i32 = 0;
            while (((field < 2) && (at < line.len))) {
                while (((at < line.len) && (line[at] == (32) as u8))) {
                    at = (at + 1);
                }
                if ((field < 1)) {
                    while (((at < line.len) && (line[at] != (32) as u8))) {
                        at = (at + 1);
                    }
                }
                field = (field + 1);
            }
            let start: i32 = at;
            while ((((at < line.len) && (line[at] != (32) as u8)) && (line[at] != (46) as u8))) {
                at = (at + 1);
            }
            if ((at > start)) {
                return _zag_str_concat("link ", _zag_str_concat(line[start..at], "/70"));
            }
            return "";
        }
        li = (li + 1);
    }
    return "";
}

fn devbus_scan_net(report: []u8) []u8 {
    let root: []u8 = "/sys/class/net";
    let names: []u8 = sysbus_listdir(root);
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if ((name.len > 0)) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let state: []u8 = sysbus_read_line(sysbus_path2(base, "/operstate"));
            if ((state.len < 1)) {
                state = "unknown";
            }
            let mac: []u8 = sysbus_read_line(sysbus_path2(base, "/address"));
            let wireless: i32 = sysbus_exists(sysbus_path2(base, "/wireless"));
            if ((wireless == 0)) {
                wireless = sysbus_exists(sysbus_path2(base, "/phy80211"));
            }
            if ((wireless == 1)) {
                let q: []u8 = devbus_wifi_quality(name);
                let detail: []u8 = mac;
                if ((q.len > 0)) {
                    detail = _zag_str_concat(_zag_str_concat(mac, "  "), q);
                }
                report = devbus_row(report, "WIFI", name, detail, state);
            } else if ((_zag_strcmp(name, "lo") == 1)) {
                report = devbus_row(report, "ETHERNET", name, "loopback", state);
            } else {
                let speed: []u8 = sysbus_read_line(sysbus_path2(base, "/speed"));
                let detail2: []u8 = mac;
                if (((speed.len > 0) && (sysbus_contains(speed, "-") == 0))) {
                    detail2 = _zag_str_concat(_zag_str_concat(mac, "  "), _zag_str_concat(speed, " Mb/s"));
                }
                report = devbus_row(report, "ETHERNET", name, detail2, state);
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_scan_usb(report: []u8) []u8 {
    let root: []u8 = "/sys/bus/usb/devices";
    let names: []u8 = sysbus_listdir(root);
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if (((name.len > 0) && (sysbus_contains(name, ":") == 0))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let product: []u8 = sysbus_read_line(sysbus_path2(base, "/product"));
            if ((product.len > 0)) {
                let vid: []u8 = sysbus_read_line(sysbus_path2(base, "/idVendor"));
                let pid: []u8 = sysbus_read_line(sysbus_path2(base, "/idProduct"));
                let speed: []u8 = sysbus_read_line(sysbus_path2(base, "/speed"));
                let detail: []u8 = _zag_str_concat(_zag_str_concat(vid, ":"), _zag_str_concat(pid, _zag_str_concat("  ", _zag_str_concat(speed, " Mb/s"))));
                report = devbus_row(report, "USB", product, detail, "attached");
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_digit(ch: u8) i32 {
    if (((ch >= (48) as u8) && (ch <= (57) as u8))) {
        return 1;
    }
    return 0;
}

fn devbus_scan_audio(report: []u8) []u8 {
    let root: []u8 = "/sys/class/sound";
    let names: []u8 = sysbus_listdir(root);
    if ((names.len < 1)) {
        return report;
    }
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if ((((name.len > 4) && (sysbus_contains(name, "card") == 1)) && (devbus_digit(name[4]) == 1))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let id: []u8 = sysbus_read_line(sysbus_path2(base, "/id"));
            if ((id.len > 0)) {
                let suffix: []u8 = name[4..name.len];
                let pcm_tag: []u8 = _zag_str_concat("pcmC", suffix);
                let play: i32 = 0;
                let capt: i32 = 0;
                let j: i32 = 0;
                while ((j < n)) {
                    let other: []u8 = sysbus_line_at(names, j);
                    if ((sysbus_contains(other, pcm_tag) == 1)) {
                        if ((other[(other.len - 1)] == (112) as u8)) {
                            play = (play + 1);
                        }
                        if ((other[(other.len - 1)] == (99) as u8)) {
                            capt = (capt + 1);
                        }
                    }
                    j = (j + 1);
                }
                let detail: []u8 = _zag_str_concat(_zag_i64_to_str((play) as i64), " out / ");
                detail = _zag_str_concat(detail, _zag_i64_to_str((capt) as i64));
                detail = _zag_str_concat(detail, " in");
                report = devbus_row(report, "AUDIO", id, detail, "online");
            }
        }
        if (((name.len > 5) && (sysbus_contains(name, "midiC") == 1))) {
            report = devbus_row(report, "MIDI", name, "raw midi port", "online");
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_scan_thunderbolt(report: []u8) []u8 {
    let root: []u8 = "/sys/bus/thunderbolt/devices";
    let names: []u8 = sysbus_listdir(root);
    if ((names.len < 1)) {
        return report;
    }
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if ((name.len > 0)) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let dev: []u8 = sysbus_read_line(sysbus_path2(base, "/device_name"));
            if ((dev.len > 0)) {
                let vendor: []u8 = sysbus_read_line(sysbus_path2(base, "/vendor_name"));
                report = devbus_row(report, "THUNDERBOLT", dev, vendor, "online");
            } else if ((sysbus_contains(name, "domain") == 1)) {
                report = devbus_row(report, "THUNDERBOLT", name, "host domain", "online");
            }
        }
        i = (i + 1);
    }
    return report;
}

fn devbus_scan_typec(report: []u8) []u8 {
    let root: []u8 = "/sys/class/typec";
    let names: []u8 = sysbus_listdir(root);
    if ((names.len < 1)) {
        return report;
    }
    let n: i32 = sysbus_line_count(names);
    let i: i32 = 0;
    while ((i < n)) {
        let name: []u8 = sysbus_line_at(names, i);
        if (((name.len > 0) && (sysbus_contains(name, "partner") == 0))) {
            let base: []u8 = sysbus_path3(root, "/", name);
            let power: []u8 = sysbus_read_line(sysbus_path2(base, "/power_role"));
            let data: []u8 = sysbus_read_line(sysbus_path2(base, "/data_role"));
            let state: []u8 = "no device";
            if ((sysbus_exists(sysbus_path2(base, "-partner")) == 1)) {
                state = "connected";
            }
            let detail: []u8 = _zag_str_concat(power, _zag_str_concat("  ", data));
            report = devbus_row(report, "USB-C", name, detail, state);
        }
        i = (i + 1);
    }
    return report;
}

fn DEVICE_CHAMBER_MAGIC() i32 {
    return 1145391683;
}

fn DEVICE_REC_BASE() i32 {
    return 16;
}

fn DEVICE_REC_STRIDE() i32 {
    return 128;
}

fn DEVICE_F_BUS() i32 {
    return 0;
}

fn DEVICE_F_NAME() i32 {
    return 16;
}

fn DEVICE_F_DETAIL() i32 {
    return 72;
}

fn DEVICE_F_STATE() i32 {
    return 112;
}

fn DEVICE_BUS_CAP() i32 {
    return 16;
}

fn DEVICE_NAME_CAP() i32 {
    return 56;
}

fn DEVICE_DETAIL_CAP() i32 {
    return 40;
}

fn DEVICE_STATE_CAP() i32 {
    return 16;
}

fn device_chamber_max_records() i32 {
    return ((RAYOS_DEVICE_MMIO_BYTES() - DEVICE_REC_BASE()) / DEVICE_REC_STRIDE());
}

fn device_chamber_base() i64 {
    return RAYOS_DEVICE_MMIO_BASE();
}

fn device_chamber_init() i32 {
    if ((hw_rt_init() != 0)) {
        return (0 - 1);
    }
    let base: i64 = device_chamber_base();
    if ((mmio_read32(base) != DEVICE_CHAMBER_MAGIC())) {
        mmio_write32(base, DEVICE_CHAMBER_MAGIC());
        mmio_write32((base + 4), 0);
        mmio_write32((base + 8), 0);
    }
    return 0;
}

fn device_chamber_generation() i32 {
    return mmio_read32((device_chamber_base() + 4));
}

fn device_chamber_count() i32 {
    let n: i32 = mmio_read32((device_chamber_base() + 8));
    if ((n < 0)) {
        return 0;
    }
    if ((n > device_chamber_max_records())) {
        return device_chamber_max_records();
    }
    return n;
}

fn device_chamber_put_str(rec_off: i32, field_off: i32, cap: i32, s: []u8) void {
    let p: *i8 = hw_mmio_ptr((device_chamber_base() + ((rec_off + field_off)) as i64), cap);
    if ((p == null)) {
        return;
    }
    let n: i32 = s.len;
    if ((n > (cap - 1))) {
        n = (cap - 1);
    }
    let i: i32 = 0;
    while ((i < n)) {
        p[i] = (s[i]) as i8;
        i = (i + 1);
    }
    p[n] = (0) as i8;
}

fn device_chamber_get_str(rec_off: i32, field_off: i32, cap: i32) []u8 {
    let p: *i8 = hw_mmio_ptr((device_chamber_base() + ((rec_off + field_off)) as i64), cap);
    if ((p == null)) {
        return "";
    }
    let n: i32 = 0;
    while (((n < (cap - 1)) && (p[n] != (0) as i8))) {
        n = (n + 1);
    }
    let pu: *u8 = (p) as *u8;
    return pu[0..n];
}

fn device_chamber_row_field(line: []u8, idx: i32) []u8 {
    let field: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while ((i <= line.len)) {
        if (((i == line.len) || (line[i] == (124) as u8))) {
            if ((field == idx)) {
                return line[start..i];
            }
            field = (field + 1);
            start = (i + 1);
        }
        i = (i + 1);
    }
    return "";
}

fn device_chamber_publish(report: []u8) i32 {
    if ((device_chamber_init() != 0)) {
        return (0 - 1);
    }
    let base: i64 = device_chamber_base();
    let count: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (((i <= report.len) && (count < device_chamber_max_records()))) {
        if (((i == report.len) || (report[i] == (10) as u8))) {
            let line: []u8 = report[start..i];
            if ((line.len > 0)) {
                let rec: i32 = (DEVICE_REC_BASE() + (count * DEVICE_REC_STRIDE()));
                device_chamber_put_str(rec, DEVICE_F_BUS(), DEVICE_BUS_CAP(), device_chamber_row_field(line, 0));
                device_chamber_put_str(rec, DEVICE_F_NAME(), DEVICE_NAME_CAP(), device_chamber_row_field(line, 1));
                device_chamber_put_str(rec, DEVICE_F_DETAIL(), DEVICE_DETAIL_CAP(), device_chamber_row_field(line, 2));
                device_chamber_put_str(rec, DEVICE_F_STATE(), DEVICE_STATE_CAP(), device_chamber_row_field(line, 3));
                count = (count + 1);
            }
            start = (i + 1);
        }
        i = (i + 1);
    }
    mmio_write32((base + 8), count);
    mmio_write32((base + 4), (device_chamber_generation() + 1));
    hw_fence();
    return count;
}

fn device_chamber_report() []u8 {
    if ((device_chamber_init() != 0)) {
        return "";
    }
    let out: []u8 = "";
    let n: i32 = device_chamber_count();
    let i: i32 = 0;
    while ((i < n)) {
        let rec: i32 = (DEVICE_REC_BASE() + (i * DEVICE_REC_STRIDE()));
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_BUS(), DEVICE_BUS_CAP()));
        out = _zag_str_concat(out, "|");
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_NAME(), DEVICE_NAME_CAP()));
        out = _zag_str_concat(out, "|");
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_DETAIL(), DEVICE_DETAIL_CAP()));
        out = _zag_str_concat(out, "|");
        out = _zag_str_concat(out, device_chamber_get_str(rec, DEVICE_F_STATE(), DEVICE_STATE_CAP()));
        out = _zag_str_concat(out, "\n");
        i = (i + 1);
    }
    return out;
}

fn device_manager_seed_from_host() i32 {
    let report: []u8 = "";
    report = devbus_scan_display(report);
    report = devbus_scan_net(report);
    report = devbus_scan_usb(report);
    report = devbus_scan_audio(report);
    report = devbus_scan_thunderbolt(report);
    report = devbus_scan_typec(report);
    return device_chamber_publish(report);
}

fn device_manager_scan() []u8 {
    if ((hw_rt_backend_host() == 1)) {
        let _n: i32 = device_manager_seed_from_host();
    }
    return device_chamber_report();
}

fn RTC_CHAMBER_MAGIC() i32 {
    return 1381323587;
}

fn rtc_chamber_init() i32 {
    if ((hw_rt_init() != 0)) {
        return (0 - 1);
    }
    let base: i64 = RAYOS_RTC_MMIO_BASE();
    if ((mmio_read32(base) != RTC_CHAMBER_MAGIC())) {
        mmio_write32(base, RTC_CHAMBER_MAGIC());
        mmio_write32((base + 4), 0);
        mmio_write32((base + 8), 0);
    }
    return 0;
}

fn rtc_chamber_epoch_ptr() *i64 {
    let p: *i8 = hw_mmio_ptr((RAYOS_RTC_MMIO_BASE() + 16), 8);
    if ((p == null)) {
        return null;
    }
    return (p) as *i64;
}

fn RTC_SYS_READ() i64 {
    return 0;
}

fn RTC_SYS_OPEN() i64 {
    return 2;
}

fn RTC_SYS_CLOSE() i64 {
    return 3;
}

fn RTC_SYS_TIME() i64 {
    return 201;
}

fn RTC_TZFILE_MAX() i32 {
    return 65536;
}

fn RTC_TZIF_HEADER() i32 {
    return 44;
}

fn rtc_now_epoch() i64 {
    if ((rtc_chamber_init() != 0)) {
        return 0;
    }
    if (rtc_chamber_epoch_ptr()) |ep| {
        if ((hw_rt_backend_host() == 1)) {
            ep.* = _zag_raw_syscall(RTC_SYS_TIME(), 0, 0, 0, 0, 0, 0);
        }
        return ep.*;
    }
    return 0;
}

fn rtc_secs_of_day(local: i64) i64 {
    let s: i64 = (local % 86400);
    if ((s < 0)) {
        s = (s + 86400);
    }
    return s;
}

fn rtc_byte(buf: *i8, off: i32) i64 {
    return ((buf[off]) as u8) as i64;
}

fn rtc_be32u(buf: *i8, off: i32) i64 {
    let v: i64 = rtc_byte(buf, off);
