    vg_text_vec(fb, ((x + 16)) as f32, ((y + 82)) as f32, "PLACES", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    vg_text_vec(fb, ((x + 18)) as f32, ((y + 112)) as f32, "Home", 11.0, 0.6, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    vg_text_vec(fb, ((x + 18)) as f32, ((y + 144)) as f32, "Documents", 11.0, 0.6, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    vg_text_vec(fb, ((x + 18)) as f32, ((y + 176)) as f32, "Applications", 11.0, 0.6, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    let list_x: i32 = ((x + side_w) + 16);
    vg_text_vec(fb, (list_x) as f32, ((y + 78)) as f32, "NAME", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    vg_text_vec(fb, (((x + w) - 90)) as f32, ((y + 78)) as f32, "TRYTES", 9.0, 0.65, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    let row_y: i32 = (y + 98);
    let i: i32 = 0;
    while (((i < len[TriNode](c.*.filesystem.nodes)) && ((row_y + 38) < (y + h)))) {
        let node: TriNode = get[TriNode](c.*.filesystem.nodes, i);
        if (((node.state == trifs_alive()) && (node.inode != trifs_root_inode()))) {
            softgpu_blend_round_rect(fb, list_x, row_y, ((w - side_w) - 20), 36, 8, 255, 255, 255, 10);
            let ir: i32 = th.base.acc2_r;
            let ig: i32 = th.base.acc2_g;
            let ib: i32 = th.base.acc2_b;
            if ((node.kind == trifs_directory())) {
                ir = 255;
                ig = 181;
                ib = 64;
            }
            softgpu_blend_round_rect(fb, (list_x + 10), (row_y + 9), 20, 18, 5, ir, ig, ib, 255);
            rayos_paint_text_trunc(fb, ((list_x + 42)) as f32, ((row_y + 10)) as f32, node.name, ((w - side_w) - 150), 11.0, 0.58, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
            rayos_paint_u32(fb, (((x + w) - 78)) as f32, ((row_y + 10)) as f32, (node.size) as i32, 10.0, 0.55, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
            row_y = (row_y + 42);
        }
        i = (i + 1);
    }
}

fn comp_browser_parent_tag(c: *Compositor, node: HtmlNode) []u8 {
    if (((node.parent < 0) || ((node.parent) as i32 >= len[HtmlNode](c.*.browser_document.nodes)))) {
        return "";
    }
    return get[HtmlNode](c.*.browser_document.nodes, (node.parent) as i32).tag;
}

fn comp_browser_paint_wrapped(c: *Compositor, fb: *SoftFb, text: []u8, x: i32, y: i32, width: i32, size: f32, weight: f32, r: i32, g: i32, b: i32) i32 {
    let max_chars: i32 = (((width) as f32 / rayos_glyph_advance(size))) as i32;
    if ((max_chars < 1)) {
        return y;
    }
    let at: i32 = 0;
    let line_y: i32 = y;
    while ((at < text.len)) {
        while (((at < text.len) && (html_is_space(text[at]) == 1))) {
            at = (at + 1);
        }
        if ((at >= text.len)) {
            return line_y;
        }
        let end: i32 = (at + max_chars);
        if ((end > text.len)) {
            end = text.len;
        }
        if ((end < text.len)) {
            let split: i32 = end;
            while (((split > at) && (html_is_space(text[split]) == 0))) {
                split = (split - 1);
            }
            if ((split > at)) {
                end = split;
            }
        }
        vg_text_vec(fb, (x) as f32, (line_y) as f32, text[at..end], size, weight, r, g, b, 255);
        line_y = ((line_y + (size) as i32) + 7);
        at = end;
    }
    return line_y;
}

fn comp_paint_browser(c: *Compositor, fb: *SoftFb, x: i32, y: i32, w: i32, h: i32) void {
    let th: RayOsTheme = c.*.wm.theme;
    softgpu_blend_round_rect(fb, x, y, w, 54, 10, 31, 34, 55, 255);
    let back: VPath = vg_path_new();
    vg_circle(&back, ((x + 24)) as f32, ((y + 27)) as f32, 13.0);
    vg_fill(fb, &back, 255, 255, 255, 20);
    vg_text_vec(fb, ((x + 18)) as f32, ((y + 18)) as f32, "<", 11.0, 0.8, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
    softgpu_blend_round_rect(fb, (x + 48), (y + 10), (w - 62), 34, 12, 255, 255, 255, 18);
    rayos_paint_status_dot(fb, ((x + 66)) as f32, ((y + 27)) as f32, 4.0, 1, th);
    if ((c.*.browser_editing == 1)) {
        let addr: []u8 = c.*.browser_addr.data[0..c.*.browser_addr.len];
        rayos_paint_text_trunc(fb, ((x + 80)) as f32, ((y + 18)) as f32, addr, (w - 120), 11.0, 0.58, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
        let cxp: i32 = ((x + 80) + (((addr.len) as f32 * rayos_glyph_advance(11.0))) as i32);
        softgpu_blend_rect(fb, (cxp + 2), (y + 16), 2, 18, th.base.ink_r, th.base.ink_g, th.base.ink_b, 220);
    } else {
        rayos_paint_text_trunc(fb, ((x + 80)) as f32, ((y + 18)) as f32, c.*.browser_url, (w - 220), 11.0, 0.58, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
        rayos_paint_text_trunc(fb, (((x + w) - 130)) as f32, ((y + 18)) as f32, c.*.browser_status, 118, 9.0, 0.5, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
    }
    softgpu_blend_round_rect_vgrad(fb, x, (y + 62), w, (h - 62), 10, 24, 27, 45, 18, 21, 37, 255);
    let flow_y: i32 = (y + 88);
    let i: i32 = 1;
    while (((i < len[HtmlNode](c.*.browser_document.nodes)) && (flow_y < ((y + h) - 28)))) {
        let node: HtmlNode = get[HtmlNode](c.*.browser_document.nodes, i);
        if (((node.kind == html_node_element()) && (html_equal_fold(node.tag, "hr") == 1))) {
            let line: VPath = vg_path_new();
            vg_move_to(&line, ((x + 26)) as f32, (flow_y) as f32);
            vg_line_to(&line, (((x + w) - 26)) as f32, (flow_y) as f32);
            vg_stroke(fb, &line, 1.0, th.base.mut_r, th.base.mut_g, th.base.mut_b, 90);
            flow_y = (flow_y + 20);
        }
        if ((node.kind == html_node_text())) {
            let tag: []u8 = comp_browser_parent_tag(c, node);
            if (((html_equal_fold(tag, "script") == 0) && (html_equal_fold(tag, "style") == 0))) {
                let size: f32 = 13.0;
                let weight: f32 = 0.58;
                let rr: i32 = th.base.mut_r;
                let rg: i32 = th.base.mut_g;
                let rb: i32 = th.base.mut_b;
                if ((html_equal_fold(tag, "h1") == 1)) {
                    size = 25.0;
                    weight = 1.0;
                    rr = th.base.ink_r;
                    rg = th.base.ink_g;
                    rb = th.base.ink_b;
                } else if ((html_equal_fold(tag, "h2") == 1)) {
                    size = 18.0;
                    weight = 0.8;
                    rr = th.base.acc_r;
                    rg = th.base.acc_g;
                    rb = th.base.acc_b;
                }
                flow_y = comp_browser_paint_wrapped(c, fb, node.text, (x + 28), flow_y, (w - 56), size, weight, rr, rg, rb);
                flow_y = (flow_y + 8);
            }
        }
        i = (i + 1);
    }
}

fn comp_term_append(c: *Compositor, s: []u8) void {
    let i: i32 = 0;
    while ((i < s.len)) {
        push[u8](&c.*.term_buf, s[i]);
        i = (i + 1);
    }
}

fn comp_term_println(c: *Compositor, s: []u8) void {
    comp_term_append(c, s);
    push[u8](&c.*.term_buf, (10) as u8);
}

fn comp_term_input_text(c: *Compositor) []u8 {
    return c.*.term_input.data[0..c.*.term_input.len];
}

fn comp_term_arg(line: []u8) []u8 {
    let i: i32 = 0;
    while (((i < line.len) && (line[i] != (32) as u8))) {
        i = (i + 1);
    }
    while (((i < line.len) && (line[i] == (32) as u8))) {
        i = (i + 1);
    }
    return line[i..line.len];
}

fn comp_term_word(line: []u8) []u8 {
    let i: i32 = 0;
    while (((i < line.len) && (line[i] != (32) as u8))) {
        i = (i + 1);
    }
    return line[0..i];
}

fn comp_touch_content(c: *Compositor, content_kind: i32) void {
    let i: i32 = 0;
    while ((i < len[RayWindow](c.*.wm.windows))) {
        let win: RayWindow = get[RayWindow](c.*.wm.windows, i);
        if ((win.content_kind == content_kind)) {
            wm_touch(&c.*.wm, win.id);
        }
        i = (i + 1);
    }
}

fn comp_term_pwd(c: *Compositor) []u8 {
    let cur: i64 = c.*.term_cwd;
    if ((cur == trifs_root_inode())) {
        return "/";
    }
    let path: []u8 = "";
    let depth: i32 = 0;
    while (((cur != trifs_root_inode()) && (depth < 32))) {
        let node: TriNode = trifs_node(&c.*.filesystem, cur);
        if ((node.inode == trifs_no_inode())) {
            return "/";
        }
        path = _zag_str_concat("/", _zag_str_concat(node.name, path));
        cur = node.parent;
        depth = (depth + 1);
    }
    return path;
}

fn comp_term_resolve(c: *Compositor, path: []u8) i64 {
    let cur: i64 = c.*.term_cwd;
    let at: i32 = 0;
    if (((path.len > 0) && (path[0] == (47) as u8))) {
        cur = trifs_root_inode();
        at = 1;
    }
    while ((at <= path.len)) {
        let seg_start: i32 = at;
        while (((at < path.len) && (path[at] != (47) as u8))) {
            at = (at + 1);
        }
        let seg: []u8 = path[seg_start..at];
        at = (at + 1);
        if ((seg.len > 0)) {
            if ((_zag_strcmp(seg, ".") == 1)) {
            } else if ((_zag_strcmp(seg, "..") == 1)) {
                if ((cur != trifs_root_inode())) {
                    cur = trifs_node(&c.*.filesystem, cur).parent;
                }
            } else {
                let next: i64 = trifs_lookup(&c.*.filesystem, cur, seg);
                if ((next < 0)) {
                    return trifs_no_inode();
                }
                cur = next;
            }
        }
    }
    return cur;
}

fn comp_term_ls(c: *Compositor, arg: []u8) void {
    let parent: i64 = c.*.term_cwd;
    if ((arg.len > 0)) {
        parent = comp_term_resolve(c, arg);
        if ((parent == trifs_no_inode())) {
            comp_term_println(c, "ls: no such path");
            return;
        }
        let pn: TriNode = trifs_node(&c.*.filesystem, parent);
        if ((pn.kind == trifs_file())) {
            comp_term_println(c, pn.name);
            return;
        }
    }
    let count: i32 = 0;
    let i: i32 = 0;
    while ((i < len[TriNode](c.*.filesystem.nodes))) {
        let node: TriNode = get[TriNode](c.*.filesystem.nodes, i);
        if ((((node.state == trifs_alive()) && (node.parent == parent)) && (node.inode != parent))) {
            let line: []u8 = "f  ";
            if ((node.kind == trifs_directory())) {
                line = "d  ";
            }
            line = _zag_str_concat(line, _zag_i64_to_str((node.size) as i64));
            line = _zag_str_concat(line, "t  ");
            line = _zag_str_concat(line, node.name);
            if ((node.kind == trifs_directory())) {
                line = _zag_str_concat(line, "/");
            }
            comp_term_println(c, line);
            count = (count + 1);
        }
        i = (i + 1);
    }
    if ((count == 0)) {
        comp_term_println(c, "(empty)");
    }
}

fn comp_term_cd(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        c.*.term_cwd = trifs_root_inode();
        return;
    }
    let target: i64 = comp_term_resolve(c, arg);
    if ((target == trifs_no_inode())) {
        comp_term_println(c, "cd: no such directory");
        return;
    }
    let node: TriNode = trifs_node(&c.*.filesystem, target);
    if (((node.kind != trifs_directory()) && (target != trifs_root_inode()))) {
        comp_term_println(c, "cd: not a directory");
        return;
    }
    c.*.term_cwd = target;
}

fn comp_term_cat(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: cat <file>");
        return;
    }
    let inode: i64 = comp_term_resolve(c, arg);
    if ((inode == trifs_no_inode())) {
        comp_term_println(c, "cat: no such file");
        return;
    }
    let node: TriNode = trifs_node(&c.*.filesystem, inode);
    if ((node.kind != trifs_file())) {
        comp_term_println(c, "cat: is a directory");
        return;
    }
    if ((node.size < 1)) {
        comp_term_println(c, "(empty file)");
        return;
    }
    let i: i64 = 0;
    while ((i < node.size)) {
        let unit: i64 = 0;
        if ((trifs_read_unit(&c.*.filesystem, inode, i, &unit) == trifs_ok())) {
            let v: i32 = (unit) as i32;
            if (((v == 10) || ((v >= 32) && (v <= 126)))) {
                push[u8](&c.*.term_buf, (v) as u8);
            } else {
                push[u8](&c.*.term_buf, (63) as u8);
            }
        }
        i = (i + 1);
    }
    push[u8](&c.*.term_buf, (10) as u8);
}

fn comp_term_make(c: *Compositor, name: []u8, kind: i64) void {
    if ((name.len < 1)) {
        comp_term_println(c, "usage: mkdir|touch <name>");
        return;
    }
    let _tx: i32 = trifs_begin(&c.*.filesystem, c.*.filesystem_task);
    let made: i64 = trifs_create(&c.*.filesystem, c.*.filesystem_task, c.*.term_cwd, name, kind);
    let _cm: i32 = trifs_commit(&c.*.filesystem, c.*.filesystem_task);
    if ((made < 0)) {
        comp_term_println(c, "error: exists or invalid name");
        return;
    }
    comp_touch_content(c, wm_content_files());
}

fn comp_term_write(c: *Compositor, arg: []u8) void {
    let name: []u8 = comp_term_word(arg);
    let text: []u8 = comp_term_arg(arg);
    if ((name.len < 1)) {
        comp_term_println(c, "usage: write <file> <text>");
        return;
    }
    let _tx: i32 = trifs_begin(&c.*.filesystem, c.*.filesystem_task);
    let inode: i64 = trifs_lookup(&c.*.filesystem, c.*.term_cwd, name);
    if ((inode < 0)) {
        inode = trifs_create(&c.*.filesystem, c.*.filesystem_task, c.*.term_cwd, name, trifs_file());
    }
    if ((inode < 0)) {
        let _cm0: i32 = trifs_commit(&c.*.filesystem, c.*.filesystem_task);
        comp_term_println(c, "write: cannot create file");
        return;
    }
    let payload: ArrayList[i64] = make[i64]((text.len + 1));
    let i: i32 = 0;
    while ((i < text.len)) {
        push[i64](&payload, (text[i]) as i64);
        i = (i + 1);
    }
    let rc: i32 = trifs_write(&c.*.filesystem, c.*.filesystem_task, inode, 0, &payload);
    let _cm: i32 = trifs_commit(&c.*.filesystem, c.*.filesystem_task);
    free[i64](&payload);
    if ((rc < 0)) {
        comp_term_println(c, "write: failed");
        return;
    }
    comp_term_println(c, _zag_str_concat(_zag_i64_to_str((rc) as i64), " trytes written"));
    comp_touch_content(c, wm_content_files());
}

fn comp_term_rm(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: rm <name>");
        return;
    }
    let inode: i64 = comp_term_resolve(c, arg);
    if ((inode == trifs_no_inode())) {
        comp_term_println(c, "rm: no such file or directory");
        return;
    }
    let _tx: i32 = trifs_begin(&c.*.filesystem, c.*.filesystem_task);
    let rc: i32 = trifs_unlink(&c.*.filesystem, c.*.filesystem_task, inode);
    let _cm: i32 = trifs_commit(&c.*.filesystem, c.*.filesystem_task);
    if ((rc == trifs_err_not_empty())) {
        comp_term_println(c, "rm: directory not empty");
        return;
    }
    if ((rc != trifs_ok())) {
        comp_term_println(c, "rm: failed");
        return;
    }
    comp_touch_content(c, wm_content_files());
}

fn comp_term_mv(c: *Compositor, arg: []u8) void {
    let old: []u8 = comp_term_word(arg);
    let newname: []u8 = comp_term_arg(arg);
    if (((old.len < 1) || (newname.len < 1))) {
        comp_term_println(c, "usage: mv <old> <new>");
        return;
    }
    let inode: i64 = comp_term_resolve(c, old);
    if ((inode == trifs_no_inode())) {
        comp_term_println(c, "mv: no such file or directory");
        return;
    }
    let _tx: i32 = trifs_begin(&c.*.filesystem, c.*.filesystem_task);
    let rc: i32 = trifs_rename(&c.*.filesystem, c.*.filesystem_task, inode, c.*.term_cwd, newname);
    let _cm: i32 = trifs_commit(&c.*.filesystem, c.*.filesystem_task);
    if ((rc != trifs_ok())) {
        comp_term_println(c, "mv: failed");
        return;
    }
    comp_touch_content(c, wm_content_files());
}

fn comp_term_pad2(v: i64) []u8 {
    if ((v < 10)) {
        return _zag_str_concat("0", _zag_i64_to_str(v));
    }
    return _zag_i64_to_str(v);
}

fn comp_term_date(c: *Compositor) void {
    let epoch: i64 = (rtc_now_epoch() + rtc_utc_offset_secs(rtc_now_epoch()));
    let days: i64 = (epoch / 86400);
    let secs: i64 = (epoch % 86400);
    let z: i64 = (days + 719468);
    let era: i64 = (z / 146097);
    if ((z < 0)) {
        era = ((z - 146096) / 146097);
    }
    let doe: i64 = (z - (era * 146097));
    let yoe: i64 = ((((doe - (doe / 1460)) + (doe / 36524)) - (doe / 146096)) / 365);
    let y: i64 = (yoe + (era * 400));
    let doy: i64 = (doe - (((365 * yoe) + (yoe / 4)) - (yoe / 100)));
    let mp: i64 = (((5 * doy) + 2) / 153);
    let d: i64 = ((doy - (((153 * mp) + 2) / 5)) + 1);
    let m: i64 = (mp + 3);
    if ((mp >= 10)) {
        m = (mp - 9);
    }
    if ((m <= 2)) {
        y = (y + 1);
    }
    let line: []u8 = _zag_i64_to_str(y);
    line = _zag_str_concat(line, "-");
    line = _zag_str_concat(line, comp_term_pad2(m));
    line = _zag_str_concat(line, "-");
    line = _zag_str_concat(line, comp_term_pad2(d));
    line = _zag_str_concat(line, " ");
    line = _zag_str_concat(line, comp_term_pad2((secs / 3600)));
    line = _zag_str_concat(line, ":");
    line = _zag_str_concat(line, comp_term_pad2(((secs / 60) % 60)));
    line = _zag_str_concat(line, ":");
    line = _zag_str_concat(line, comp_term_pad2((secs % 60)));
    comp_term_println(c, line);
}

fn comp_term_ps(c: *Compositor) void {
    comp_term_println(c, "TASK        STATE     PRIO  RUNTIME");
    let i: i32 = 0;
    while ((i < len[RayTask](c.*.scheduler.tasks))) {
        let task: RayTask = get[RayTask](c.*.scheduler.tasks, i);
        let line: []u8 = task.name;
        let padn: i32 = (12 - task.name.len);
        while ((padn > 0)) {
            line = _zag_str_concat(line, " ");
            padn = (padn - 1);
        }
        line = _zag_str_concat(line, comp_task_state_text(task.state));
        line = _zag_str_concat(line, "   ");
        line = _zag_str_concat(line, _zag_i64_to_str(((task.priority + 8)) as i64));
        line = _zag_str_concat(line, "   ");
        line = _zag_str_concat(line, _zag_i64_to_str((task.runtime) as i64));
        comp_term_println(c, line);
        i = (i + 1);
    }
}

fn comp_term_top(c: *Compositor) void {
    let hdr: []u8 = "runnable ";
    hdr = _zag_str_concat(hdr, _zag_i64_to_str((scheduler_runnable_count(&c.*.scheduler)) as i64));
    hdr = _zag_str_concat(hdr, "  dispatches ");
    hdr = _zag_str_concat(hdr, _zag_i64_to_str((c.*.scheduler.dispatches) as i64));
    hdr = _zag_str_concat(hdr, "  epoch ");
    hdr = _zag_str_concat(hdr, _zag_i64_to_str((c.*.scheduler.clock) as i64));
    comp_term_println(c, hdr);
    comp_term_ps(c);
}

fn comp_term_devices(c: *Compositor) void {
    c.*.devices_report = device_manager_scan();
    let n: i32 = sysbus_line_count(c.*.devices_report);
    let i: i32 = 0;
    while ((i < n)) {
        let full: []u8 = sysbus_line_at(c.*.devices_report, i);
        if ((full.len > 0)) {
            let line: []u8 = comp_devices_field(full, 0);
            line = _zag_str_concat(line, "  ");
            line = _zag_str_concat(line, comp_devices_field(full, 1));
            line = _zag_str_concat(line, "  [");
            line = _zag_str_concat(line, comp_devices_field(full, 3));
            line = _zag_str_concat(line, "]");
            comp_term_println(c, line);
        }
        i = (i + 1);
    }
}

fn comp_term_history(c: *Compositor) void {
    let hist: []u8 = c.*.term_hist.data[0..c.*.term_hist.len];
    let n: i32 = sysbus_line_count(hist);
    let i: i32 = 0;
    while ((i < n)) {
        let line: []u8 = sysbus_line_at(hist, i);
        if ((line.len > 0)) {
            comp_term_append(c, "  ");
            comp_term_append(c, _zag_i64_to_str(((i + 1)) as i64));
            comp_term_append(c, "  ");
            comp_term_println(c, line);
        }
        i = (i + 1);
    }
}

fn comp_term_trits_of(v: i64) []u8 {
    if ((v == 0)) {
        return "0";
    }
    let out: []u8 = "";
    let n: i64 = v;
    while ((n != 0)) {
        let r: i64 = (((n % 3) + 3) % 3);
        if ((r == 2)) {
            out = _zag_str_concat("T", out);
            n = ((n + 1) / 3);
        } else if ((r == 1)) {
            out = _zag_str_concat("1", out);
            n = ((n - 1) / 3);
        } else {
            out = _zag_str_concat("0", out);
            n = (n / 3);
        }
    }
    return out;
}

fn comp_term_trit_width_name(digits: i32) []u8 {
    if ((digits <= 9)) {
        return "t9";
    }
    if ((digits <= 27)) {
        return "t27";
    }
    return "wide";
}

fn comp_term_trit(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: trit <decimal>   (1/0/T digits, LSB last)");
        return;
    }
    let v: i64 = _zag_str_to_i64(arg);
    let tr: []u8 = comp_term_trits_of(v);
    let line: []u8 = _zag_i64_to_str(v);
    line = _zag_str_concat(line, " = ");
    line = _zag_str_concat(line, tr);
    line = _zag_str_concat(line, "  (");
    line = _zag_str_concat(line, _zag_i64_to_str((tr.len) as i64));
    line = _zag_str_concat(line, " trits, ");
    line = _zag_str_concat(line, comp_term_trit_width_name(tr.len));
    line = _zag_str_concat(line, ")");
    comp_term_println(c, line);
}

fn comp_term_untrit(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: untrit <trits>   e.g. untrit 1TT0");
        return;
    }
    let v: i64 = 0;
    let i: i32 = 0;
    while ((i < arg.len)) {
        let ch: u8 = arg[i];
        if (((ch == (49) as u8) || (ch == (43) as u8))) {
            v = ((v * 3) + 1);
        } else if ((((ch == (84) as u8) || (ch == (116) as u8)) || (ch == (45) as u8))) {
            v = ((v * 3) - 1);
        } else if ((ch == (48) as u8)) {
            v = (v * 3);
        } else {
            comp_term_println(c, "untrit: digits are 1, 0, T");
            return;
        }
        i = (i + 1);
    }
    let line: []u8 = arg;
    line = _zag_str_concat(line, " = ");
    line = _zag_str_concat(line, _zag_i64_to_str(v));
    comp_term_println(c, line);
}

fn comp_term_trit_math(c: *Compositor, arg: []u8, mul: i32) void {
    let a_str: []u8 = comp_term_word(arg);
    let b_str: []u8 = comp_term_arg(arg);
    if (((a_str.len < 1) || (b_str.len < 1))) {
        comp_term_println(c, "usage: tadd|tmul <a> <b>");
        return;
    }
    let a: i64 = _zag_str_to_i64(a_str);
    let b: i64 = _zag_str_to_i64(b_str);
    let r: i64 = (a + b);
    let op: []u8 = " + ";
    if ((mul == 1)) {
        r = (a * b);
        op = " * ";
    }
    let line: []u8 = comp_term_trits_of(a);
    line = _zag_str_concat(line, op);
    line = _zag_str_concat(line, comp_term_trits_of(b));
    line = _zag_str_concat(line, " = ");
    line = _zag_str_concat(line, comp_term_trits_of(r));
    line = _zag_str_concat(line, "  (");
    line = _zag_str_concat(line, _zag_i64_to_str(r));
    line = _zag_str_concat(line, ")");
    comp_term_println(c, line);
}

fn comp_term_photon(c: *Compositor) void {
    comp_term_println(c, "photonic fabric");
    let line: []u8 = "  soh lattice   ";
    line = _zag_str_concat(line, _zag_i64_to_str((RAYOS_SOH_MMIO_TILES_X()) as i64));
    line = _zag_str_concat(line, " x ");
    line = _zag_str_concat(line, _zag_i64_to_str((RAYOS_SOH_MMIO_TILES_Y()) as i64));
    line = _zag_str_concat(line, " tiles @ ");
    line = _zag_str_concat(line, comp_term_hex32(RAYOS_SOH_MMIO_BASE()));
    comp_term_println(c, line);
    let cap: i64 = (((RAYOS_SOH_MMIO_TILES_X()) as i64 * (RAYOS_SOH_MMIO_TILES_Y()) as i64) * 64);
    comp_term_println(c, _zag_str_concat("  soh capacity  ", _zag_str_concat(_zag_i64_to_str(cap), " trits")));
    comp_term_println(c, "  polarization  H = -1   split = 0   V = +1");
    let sc: []u8 = "  scanout       ";
    sc = _zag_str_concat(sc, _zag_i64_to_str((mmio_read32(RAYOS_SCANOUT_MMIO_BASE())) as i64));
    sc = _zag_str_concat(sc, " x ");
    sc = _zag_str_concat(sc, _zag_i64_to_str((mmio_read32((RAYOS_SCANOUT_MMIO_BASE() + 4))) as i64));
    sc = _zag_str_concat(sc, " chamber frame ");
    sc = _zag_str_concat(sc, _zag_i64_to_str((scanout_frame_seq()) as i64));
    comp_term_println(c, sc);
}

fn comp_term_hex_digit(v: i64) []u8 {
    if ((v == 10)) {
        return "A";
    }
    if ((v == 11)) {
        return "B";
    }
    if ((v == 12)) {
        return "C";
    }
    if ((v == 13)) {
        return "D";
    }
    if ((v == 14)) {
        return "E";
    }
    if ((v == 15)) {
        return "F";
    }
    return _zag_i64_to_str(v);
}

fn comp_term_hex32(v: i64) []u8 {
    let out: []u8 = "";
    let i: i32 = 0;
    let n: i64 = v;
    while ((i < 8)) {
        out = _zag_str_concat(comp_term_hex_digit((((n % 16) + 16) % 16)), out);
        n = (n / 16);
        i = (i + 1);
    }
    return _zag_str_concat("0x", out);
}

fn comp_term_chamber_line(c: *Compositor, name: []u8, base: i64, live: i32) void {
    let line: []u8 = "  ";
    line = _zag_str_concat(line, name);
    let padn: i32 = (10 - name.len);
    while ((padn > 0)) {
        line = _zag_str_concat(line, " ");
        padn = (padn - 1);
    }
    line = _zag_str_concat(line, comp_term_hex32(base));
    if ((live == 1)) {
        line = _zag_str_concat(line, "  online");
    } else {
        line = _zag_str_concat(line, "  idle");
    }
    comp_term_println(c, line);
}

fn comp_term_chambers(c: *Compositor) void {
    comp_term_println(c, "MMIO chambers (64 KiB window @ 0xE0000000)");
    let disp: i32 = 0;
    if ((mmio_read32(RAYOS_SCANOUT_MMIO_BASE()) == 1280)) {
        disp = 1;
    }
    comp_term_chamber_line(c, "scanout", RAYOS_SCANOUT_MMIO_BASE(), disp);
    let inp: i32 = 0;
    if ((mmio_read32((RAYOS_INPUT_MMIO_BASE() + 8)) == 64)) {
        inp = 1;
    }
    comp_term_chamber_line(c, "input", RAYOS_INPUT_MMIO_BASE(), inp);
    let dev: i32 = 0;
    if ((mmio_read32(RAYOS_DEVICE_MMIO_BASE()) == DEVICE_CHAMBER_MAGIC())) {
        dev = 1;
    }
    comp_term_chamber_line(c, "devices", RAYOS_DEVICE_MMIO_BASE(), dev);
    let rtcv: i32 = 0;
    if ((mmio_read32(RAYOS_RTC_MMIO_BASE()) == RTC_CHAMBER_MAGIC())) {
        rtcv = 1;
    }
    comp_term_chamber_line(c, "rtc", RAYOS_RTC_MMIO_BASE(), rtcv);
    comp_term_chamber_line(c, "soh", RAYOS_SOH_MMIO_BASE(), 1);
    let backend: []u8 = "  backend   host bootstrap (sim window)";
    if ((hw_rt_backend_host() == 0)) {
        backend = "  backend   native /dev/mem trap";
    }
    comp_term_println(c, backend);
}

fn comp_term_net(c: *Compositor) void {
    let up: i32 = net_chamber_link_up();
    if ((up == 1)) {
        comp_term_println(c, "link      up");
    } else {
        comp_term_println(c, "link      idle (no active socket)");
    }
    comp_term_println(c, _zag_str_concat("nameserver ", net_ip_str(net_nameserver())));
    comp_term_println(c, _zag_str_concat("tx bytes  ", _zag_i64_to_str(net_chamber_tx_bytes())));
    comp_term_println(c, _zag_str_concat("rx bytes  ", _zag_i64_to_str(net_chamber_rx_bytes())));
    let backend: []u8 = "backend   host socket data plane";
    if ((hw_rt_backend_host() == 0)) {
        backend = "backend   native NIC offload";
    }
    comp_term_println(c, backend);
}

fn comp_term_dns(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: dns <host>");
        return;
    }
    let ip: i64 = net_dns_resolve(arg);
    if ((ip < 0)) {
        comp_term_println(c, "dns: resolution failed");
        return;
    }
    comp_term_println(c, _zag_str_concat(arg, _zag_str_concat("  ", net_ip_str(ip))));
}

fn comp_term_curl(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: curl <url>");
        return;
    }
    let url: []u8 = arg;
    if ((sysbus_contains(url, "://") == 0)) {
        url = _zag_str_concat("http://", url);
    }
    let r: HttpResponse = http_get(url);
    if ((r.ok == 0)) {
        comp_term_println(c, _zag_str_concat("curl: ", r.error));
        return;
    }
    comp_term_println(c, _zag_str_concat("HTTP ", _zag_i64_to_str((r.status) as i64)));
    comp_term_println(c, _zag_str_concat("  ", _zag_str_concat(_zag_i64_to_str((r.body.len) as i64), " bytes body")));
    let shown: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while (((i <= r.body.len) && (shown < 8))) {
        if (((i == r.body.len) || (r.body[i] == (10) as u8))) {
            let line: []u8 = r.body[start..i];
            if ((line.len > 120)) {
                line = line[0..120];
            }
            if ((line.len > 0)) {
                comp_term_println(c, line);
                shown = (shown + 1);
            }
            start = (i + 1);
        }
        i = (i + 1);
    }
}

fn comp_term_open(c: *Compositor, arg: []u8) void {
    if ((arg.len < 1)) {
        comp_term_println(c, "usage: open <url>");
        return;
    }
    let code: i32 = comp_browser_load(c, arg);
    if ((code < 0)) {
        comp_term_println(c, _zag_str_concat("open: ", c.*.browser_status));
        return;
    }
    comp_term_println(c, _zag_str_concat("loaded ", c.*.browser_url));
    comp_term_println(c, _zag_str_concat("  ", c.*.browser_status));
}

fn comp_term_exec(c: *Compositor, line: []u8) void {
    comp_term_append(c, comp_term_prompt(c));
    comp_term_println(c, line);
    let cmd: []u8 = comp_term_word(line);
    let arg: []u8 = comp_term_arg(line);
    if ((cmd.len < 1)) {
        return;
    }
    if ((_zag_strcmp(cmd, "help") == 1)) {
        comp_term_println(c, "files:   pwd cd ls cat mkdir touch write rm mv");
        comp_term_println(c, "system:  date uname whoami hostname ps top uptime history clear echo");
        comp_term_println(c, "network: net dns curl fetch open <url>");
        comp_term_println(c, "ternary: trit untrit tadd tmul photon chambers devices about");
        return;
    }
    if ((_zag_strcmp(cmd, "about") == 1)) {
        comp_term_println(c, "RayOS / RayTerminal");
        comp_term_println(c, "balanced-ternary OS on a photonic fabric, written in Flash.");
        comp_term_println(c, "t9/t27 deadline scheduler, TriFS trit payloads, chamber MMIO.");
        return;
    }
    if ((_zag_strcmp(cmd, "pwd") == 1)) {
        comp_term_println(c, comp_term_pwd(c));
        return;
    }
    if ((_zag_strcmp(cmd, "cd") == 1)) {
        comp_term_cd(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "ls") == 1)) {
        comp_term_ls(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "cat") == 1)) {
        comp_term_cat(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "mkdir") == 1)) {
        comp_term_make(c, arg, trifs_directory());
        return;
    }
    if ((_zag_strcmp(cmd, "touch") == 1)) {
        comp_term_make(c, arg, trifs_file());
        return;
    }
    if ((_zag_strcmp(cmd, "write") == 1)) {
        comp_term_write(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "rm") == 1)) {
        comp_term_rm(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "mv") == 1)) {
        comp_term_mv(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "date") == 1)) {
        comp_term_date(c);
        return;
    }
    if ((_zag_strcmp(cmd, "time") == 1)) {
        comp_term_date(c);
        return;
    }
    if ((_zag_strcmp(cmd, "uname") == 1)) {
        comp_term_println(c, "RayOS ternary-1 t27 photonic (Flash native)");
        return;
    }
    if ((_zag_strcmp(cmd, "whoami") == 1)) {
        comp_term_println(c, "ray");
        return;
    }
    if ((_zag_strcmp(cmd, "hostname") == 1)) {
        comp_term_println(c, "rayos");
        return;
    }
    if ((_zag_strcmp(cmd, "ps") == 1)) {
        comp_term_ps(c);
        return;
    }
    if ((_zag_strcmp(cmd, "tasks") == 1)) {
        comp_term_ps(c);
        return;
    }
    if ((_zag_strcmp(cmd, "top") == 1)) {
        comp_term_top(c);
        return;
    }
    if ((_zag_strcmp(cmd, "uptime") == 1)) {
        comp_term_println(c, _zag_str_concat(_zag_i64_to_str((c.*.scheduler.clock) as i64), " scheduler epochs"));
        return;
    }
    if ((_zag_strcmp(cmd, "history") == 1)) {
        comp_term_history(c);
        return;
    }
    if ((_zag_strcmp(cmd, "devices") == 1)) {
        comp_term_devices(c);
        return;
    }
    if ((_zag_strcmp(cmd, "net") == 1)) {
        comp_term_net(c);
        return;
    }
    if ((_zag_strcmp(cmd, "dns") == 1)) {
        comp_term_dns(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "curl") == 1)) {
        comp_term_curl(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "fetch") == 1)) {
        comp_term_curl(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "open") == 1)) {
        comp_term_open(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "echo") == 1)) {
        comp_term_println(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "clear") == 1)) {
        c.*.term_buf.len = 0;
        return;
    }
    if ((_zag_strcmp(cmd, "trit") == 1)) {
        comp_term_trit(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "untrit") == 1)) {
        comp_term_untrit(c, arg);
        return;
    }
    if ((_zag_strcmp(cmd, "tadd") == 1)) {
        comp_term_trit_math(c, arg, 0);
        return;
    }
    if ((_zag_strcmp(cmd, "tmul") == 1)) {
        comp_term_trit_math(c, arg, 1);
        return;
    }
    if ((_zag_strcmp(cmd, "photon") == 1)) {
        comp_term_photon(c);
        return;
    }
    if ((_zag_strcmp(cmd, "chambers") == 1)) {
        comp_term_chambers(c);
        return;
    }
    comp_term_println(c, _zag_str_concat(cmd, ": command not found (try help)"));
}

fn comp_term_prompt(c: *Compositor) []u8 {
    let p: []u8 = "ray:";
    p = _zag_str_concat(p, comp_term_pwd(c));
    return _zag_str_concat(p, "$ ");
}

fn comp_term_hist_count(c: *Compositor) i32 {
    return sysbus_line_count(c.*.term_hist.data[0..c.*.term_hist.len]);
}

fn comp_term_set_input(c: *Compositor, s: []u8) void {
    c.*.term_input.len = 0;
    let i: i32 = 0;
    while ((i < s.len)) {
        push[u8](&c.*.term_input, s[i]);
        i = (i + 1);
    }
}

fn comp_term_key(c: *Compositor, code: i32) i32 {
    if (((code >= 32) && (code <= 126))) {
        push[u8](&c.*.term_input, (code) as u8);
        c.*.term_hist_pos = -1;
        return 1;
    }
    if ((code == 8)) {
        if ((c.*.term_input.len > 0)) {
            c.*.term_input.len = (c.*.term_input.len - 1);
        }
        return 1;
    }
    if ((code == 130)) {
        let n: i32 = comp_term_hist_count(c);
        if ((n < 1)) {
            return 1;
        }
        if ((c.*.term_hist_pos < 0)) {
            c.*.term_hist_pos = (n - 1);
        } else if ((c.*.term_hist_pos > 0)) {
            c.*.term_hist_pos = (c.*.term_hist_pos - 1);
        }
        comp_term_set_input(c, sysbus_line_at(c.*.term_hist.data[0..c.*.term_hist.len], c.*.term_hist_pos));
        return 1;
    }
    if ((code == 131)) {
        let n2: i32 = comp_term_hist_count(c);
        if ((c.*.term_hist_pos < 0)) {
            return 1;
        }
        c.*.term_hist_pos = (c.*.term_hist_pos + 1);
        if ((c.*.term_hist_pos >= n2)) {
            c.*.term_hist_pos = -1;
            c.*.term_input.len = 0;
            return 1;
        }
        comp_term_set_input(c, sysbus_line_at(c.*.term_hist.data[0..c.*.term_hist.len], c.*.term_hist_pos));
        return 1;
    }
    if ((code == 10)) {
        let line: []u8 = _zag_strdup(comp_term_input_text(c));
        c.*.term_input.len = 0;
        c.*.term_hist_pos = -1;
        if ((line.len > 0)) {
            let i: i32 = 0;
            while ((i < line.len)) {
                push[u8](&c.*.term_hist, line[i]);
                i = (i + 1);
            }
            push[u8](&c.*.term_hist, (10) as u8);
        }
        comp_term_exec(c, line);
        return 1;
    }
    return 0;
}

fn comp_paint_terminal(c: *Compositor, fb: *SoftFb, x: i32, y: i32, w: i32, h: i32) void {
    let th: RayOsTheme = c.*.wm.theme;
    softgpu_blend_round_rect(fb, x, y, w, h, 8, 14, 18, 22, 255);
    let line_h: i32 = 16;
    let rows: i32 = ((h - 20) / line_h);
    if ((rows < 2)) {
        return;
    }
    let body_rows: i32 = (rows - 1);
    let buf: []u8 = c.*.term_buf.data[0..c.*.term_buf.len];
    let total_lines: i32 = 0;
    let i: i32 = 0;
    while ((i < buf.len)) {
        if ((buf[i] == (10) as u8)) {
            total_lines = (total_lines + 1);
        }
        i = (i + 1);
    }
    let skip: i32 = (total_lines - body_rows);
    if ((skip < 0)) {
        skip = 0;
    }
    let row: i32 = 0;
    let seen: i32 = 0;
    let start: i32 = 0;
    i = 0;
    while (((i < buf.len) && (row < body_rows))) {
        if ((buf[i] == (10) as u8)) {
            if ((seen >= skip)) {
                rayos_paint_text_trunc(fb, ((x + 10)) as f32, (((y + 10) + (row * line_h))) as f32, buf[start..i], (w - 20), 10.0, 0.55, 168, 230, 190, 255);
                row = (row + 1);
            }
            seen = (seen + 1);
            start = (i + 1);
        }
        i = (i + 1);
    }
    let py: i32 = ((y + 10) + (row * line_h));
    let prompt: []u8 = comp_term_prompt(c);
    vg_text_vec(fb, ((x + 10)) as f32, (py) as f32, prompt, 10.0, 0.7, 92, 255, 160, 255);
    let px2: i32 = (((x + 10) + (((prompt.len) as f32 * rayos_glyph_advance(10.0))) as i32) + 4);
    let input: []u8 = comp_term_input_text(c);
    rayos_paint_text_trunc(fb, (px2) as f32, (py) as f32, input, ((w - (px2 - x)) - 20), 10.0, 0.55, 235, 240, 238, 255);
    let cx2: i32 = (px2 + (((input.len) as f32 * rayos_glyph_advance(10.0))) as i32);
    softgpu_blend_rect(fb, (cx2 + 2), (py - 1), 7, 13, 120, 255, 170, 220);
}

fn comp_devices_bus_color(bus: []u8, th: RayOsTheme) i32 {
    if ((sysbus_contains(bus, "HDMI") == 1)) {
        return (((235 * 65536) + (120 * 256)) + 90);
    }
    if ((sysbus_contains(bus, "DISPLAYPORT") == 1)) {
        return (((90 * 65536) + (170 * 256)) + 235);
    }
    if ((sysbus_contains(bus, "WIFI") == 1)) {
        return (((120 * 65536) + (220 * 256)) + 160);
    }
    if ((sysbus_contains(bus, "ETHERNET") == 1)) {
        return (((200 * 65536) + (180 * 256)) + 90);
    }
    if ((sysbus_contains(bus, "THUNDERBOLT") == 1)) {
        return (((210 * 65536) + (130 * 256)) + 240);
    }
    if ((sysbus_contains(bus, "USB-C") == 1)) {
        return (((130 * 65536) + (220 * 256)) + 230);
    }
    if ((sysbus_contains(bus, "AUDIO") == 1)) {
        return (((240 * 65536) + (200 * 256)) + 120);
    }
    if ((sysbus_contains(bus, "MIDI") == 1)) {
        return (((235 * 65536) + (140 * 256)) + 200);
    }
    return (((th.base.acc2_r * 65536) + (th.base.acc2_g * 256)) + th.base.acc2_b);
}

fn comp_devices_field(line: []u8, idx: i32) []u8 {
    let field: i32 = 0;
    let start: i32 = 0;
    let i: i32 = 0;
    while ((i <= line.len)) {
        if (((i == line.len) || (line[i] == (124) as u8))) {
            if ((field == idx)) {
                return line[start..i];
            }
            field = (field + 1);
            start = (i + 1);
        }
        i = (i + 1);
    }
    return "";
}

fn comp_paint_devices(c: *Compositor, fb: *SoftFb, x: i32, y: i32, w: i32, h: i32) void {
    let th: RayOsTheme = c.*.wm.theme;
    comp_paint_content_header(c, fb, x, y, w, "Devices", "LIVE BUS TOPOLOGY / HOTPLUG STATE");
    let report: []u8 = c.*.devices_report;
    let n: i32 = sysbus_line_count(report);
    let row_y: i32 = (y + 70);
    let i: i32 = 0;
    while (((i < n) && ((row_y + 30) < (y + h)))) {
        let line: []u8 = comp_devices_field(sysbus_line_at(report, i), 0);
        let full: []u8 = sysbus_line_at(report, i);
        if ((full.len > 0)) {
            let bus: []u8 = comp_devices_field(full, 0);
            let name: []u8 = comp_devices_field(full, 1);
            let detail: []u8 = comp_devices_field(full, 2);
            let state: []u8 = comp_devices_field(full, 3);
            softgpu_blend_round_rect(fb, x, row_y, w, 26, 7, 255, 255, 255, 10);
            let on: i32 = 0;
            if ((sysbus_contains(state, "up") == 1)) {
                on = 1;
            }
            if (((sysbus_contains(state, "connected") == 1) && (sysbus_contains(state, "dis") == 0))) {
                on = 1;
            }
            if ((sysbus_contains(state, "attached") == 1)) {
                on = 1;
            }
            if ((sysbus_contains(state, "online") == 1)) {
                on = 1;
            }
            rayos_paint_status_dot(fb, ((x + 12)) as f32, ((row_y + 13)) as f32, 4.0, on, th);
            let packed: i32 = comp_devices_bus_color(bus, th);
            let cw2: i32 = ((bus.len * 8) + 12);
            softgpu_blend_round_rect(fb, (x + 24), (row_y + 5), cw2, 16, 6, (packed / 65536), ((packed / 256) % 256), (packed % 256), 60);
            vg_text_vec(fb, ((x + 30)) as f32, ((row_y + 8)) as f32, bus, 8.0, 0.6, (packed / 65536), ((packed / 256) % 256), (packed % 256), 255);
            rayos_paint_text_trunc(fb, ((x + 150)) as f32, ((row_y + 7)) as f32, name, (w - 470), 10.0, 0.58, th.base.ink_r, th.base.ink_g, th.base.ink_b, 255);
            rayos_paint_text_trunc(fb, (((x + w) - 320)) as f32, ((row_y + 8)) as f32, detail, 230, 9.0, 0.5, th.base.mut_r, th.base.mut_g, th.base.mut_b, 255);
            rayos_paint_text_trunc(fb, (((x + w) - 92)) as f32, ((row_y + 8)) as f32, state, 90, 9.0, 0.55, th.base.acc_r, th.base.acc_g, th.base.acc_b, 255);
            let _l: []u8 = line;
            row_y = (row_y + 30);
        }
        i = (i + 1);
    }
}

fn comp_browser_key(c: *Compositor, code: i32) i32 {
    if ((code == 27)) {
        c.*.browser_editing = 0;
        return 1;
    }
    if ((code == 10)) {
        let url: []u8 = _zag_strdup(c.*.browser_addr.data[0..c.*.browser_addr.len]);
        c.*.browser_editing = 0;
        if ((url.len > 0)) {
            let _r: i32 = comp_browser_load(c, url);
        }
        return 1;
    }
    if ((code == 8)) {
        if ((c.*.browser_editing == 0)) {
            return 1;
        }
        if ((c.*.browser_addr.len > 0)) {
            c.*.browser_addr.len = (c.*.browser_addr.len - 1);
        }
        return 1;
    }
    if (((code >= 32) && (code <= 126))) {
        if ((c.*.browser_editing == 0)) {
            c.*.browser_editing = 1;
            c.*.browser_addr.len = 0;
        }
        push[u8](&c.*.browser_addr, (code) as u8);
        return 1;
    }
    return 0;
}

fn comp_browser_load(c: *Compositor, url: []u8) i32 {
    let full: []u8 = url;
    if ((sysbus_contains(url, "://") == 0)) {
        full = _zag_str_concat("http://", url);
    }
    let r: HttpResponse = http_get(full);
    if ((r.ok == 0)) {
        c.*.browser_url = full;
        c.*.browser_status = r.error;
        comp_touch_content(c, wm_content_browser());
        return (0 - 1);
    }
    html_document_free(&c.*.browser_document);
    c.*.browser_document = html_parse(r.body);
    c.*.browser_url = full;
    c.*.browser_status = _zag_str_concat("HTTP ", _zag_i64_to_str((r.status) as i64));
    comp_touch_content(c, wm_content_browser());
    return r.status;
}

fn comp_paint_window_content(c: *Compositor, fb: *SoftFb, win: RayWindow) void {
    let th: RayOsTheme = c.*.wm.theme;
    let cx: i32 = 1;
    let cy: i32 = (wm_client_y(th) + 1);
    let cw: i32 = (win.w - 2);
    let ch: i32 = (wm_client_h(win, th) - 2);
    if (((cw < 1) || (ch < 1))) {
        return;
    }
    if ((win.content_kind == wm_content_guest())) {
        softgpu_blit_rect(fb, cx, cy, cw, ch, c.*.guest_pool, cw, ch, win.fb_offset);
        return;
    }
    if ((win.content_kind == wm_content_tasks())) {
        comp_paint_tasks(c, fb, (cx + 8), (cy + 8), (cw - 16), (ch - 16));
        return;
    }
    if ((win.content_kind == wm_content_files())) {
        comp_paint_files(c, fb, (cx + 8), (cy + 8), (cw - 16), (ch - 16));
        return;
    }
    if ((win.content_kind == wm_content_browser())) {
        comp_paint_browser(c, fb, (cx + 8), (cy + 8), (cw - 16), (ch - 16));
        return;
    }
    if ((win.content_kind == wm_content_terminal())) {
        comp_paint_terminal(c, fb, (cx + 8), (cy + 8), (cw - 16), (ch - 16));
        return;
    }
    if ((win.content_kind == wm_content_devices())) {
        if ((c.*.devices_report.len < 1)) {
            c.*.devices_report = device_manager_scan();
        }
        comp_paint_devices(c, fb, (cx + 8), (cy + 8), (cw - 16), (ch - 16));
        return;
    }
    softgpu_blend_round_rect_vgrad(fb, cx, cy, cw, ch, ((th.chrome_radius - 2.0)) as i32, 24, 26, 42, 18, 20, 36, 255);
}

fn comp_paint_window(c: *Compositor, id: i32) void {
    let win: RayWindow = wm_get(&c.*.wm, id);
    if (((win.id < 0) || (win.minimized == 1))) {
        return;
    }
    let th: RayOsTheme = c.*.wm.theme;
    if ((((win.cache_fb == 0) || (win.cache_w != win.w)) || (win.cache_h != win.h))) {
        wm_free_cache(&win);
        let raw: *i8 = _zag_malloc(@sizeOf[SoftFb]());
        let pfb: *SoftFb = (raw) as *SoftFb;
        pfb.* = softgpu_new(win.w, win.h);
        pfb.*.glyph_cache = vg_glyph_cache_block(&c.*.fb);
        win.cache_fb = (raw) as i64;
        win.cache_w = win.w;
        win.cache_h = win.h;
        win.cache_ver = (win.ver - 1);
        wm_set(&c.*.wm, id, win);
    }
    let pfb: *SoftFb = (win.cache_fb) as *SoftFb;
    if ((win.cache_ver != win.ver)) {
        wm_paint_chrome_cache(&c.*.wm, pfb, win);
        comp_paint_window_content(c, pfb, win);
        win.cache_ver = win.ver;
        wm_set(&c.*.wm, id, win);
    }
    rayos_paint_shadow(&c.*.fb, (win.x) as f32, (win.y) as f32, (win.w) as f32, (win.h) as f32, th.chrome_radius, th);
    softgpu_compose_round_rect(&c.*.fb, pfb, win.x, win.y, (th.chrome_radius) as i32);
}

fn comp_paint_windows_back_to_front(c: *Compositor) void {
    let z_cap: i32 = (c.*.wm.z_top + 1);
    let z: i32 = 0;
    while ((z <= z_cap)) {
        let i: i32 = 0;
        while ((i < len[RayWindow](c.*.wm.windows))) {
            let w: RayWindow = get[RayWindow](c.*.wm.windows, i);
            if (((w.minimized == 0) && (w.z == z))) {
                comp_paint_window(c, w.id);
            }
            i = (i + 1);
        }
        z = (z + 1);
    }
}

fn comp_paint_windows_in_rect(c: *Compositor, x0: i32, y0: i32, x1: i32, y1: i32) void {
    let z_cap: i32 = (c.*.wm.z_top + 1);
    let z: i32 = 0;
    while ((z <= z_cap)) {
        let i: i32 = 0;
        while ((i < len[RayWindow](c.*.wm.windows))) {
            let w: RayWindow = get[RayWindow](c.*.wm.windows, i);
            if (((w.minimized == 0) && (w.z == z))) {
                let pad: i32 = 12;
                let wx0: i32 = (w.x - pad);
                let wy0: i32 = (w.y - pad);
                let wx1: i32 = ((w.x + w.w) + pad);
                let wy1: i32 = ((w.y + w.h) + pad);
                if ((comp_rects_overlap(x0, y0, x1, y1, wx0, wy0, wx1, wy1) == 1)) {
                    comp_paint_window(c, w.id);
                }
            }
            i = (i + 1);
        }
        z = (z + 1);
    }
}

fn comp_render_full(c: *Compositor) void {
    softgpu_damage_reset(&c.*.fb);
    let bytes: i32 = ((c.*.desktop_w * c.*.desktop_h) * 3);
    if ((c.*.bg_valid == 0)) {
        comp_paint_wallpaper(c);
        softgpu_copy_bytes((c.*.bg.data) as *i8, (c.*.fb.pix.data) as *i8, bytes);
        c.*.bg_valid = 1;
    } else {
        softgpu_copy_bytes((c.*.fb.pix.data) as *i8, (c.*.bg.data) as *i8, bytes);
        softgpu_damage_mark_rect(&c.*.fb, 0, 0, (c.*.desktop_w - 1), (c.*.desktop_h - 1));
    }
    comp_paint_windows_back_to_front(c);
    comp_paint_shell(c);
    comp_paint_launcher(c);
    c.*.dirty = 0;
    c.*.dmg_x0 = 0;
    c.*.dmg_y0 = 0;
    c.*.dmg_x1 = -1;
    c.*.dmg_y1 = -1;
}

fn comp_mark_damage(c: *Compositor, x0: i32, y0: i32, x1: i32, y1: i32) void {
    if ((c.*.dirty == 0)) {
        c.*.dmg_x0 = x0;
        c.*.dmg_y0 = y0;
        c.*.dmg_x1 = x1;
        c.*.dmg_y1 = y1;
        c.*.dirty = 1;
        return;
    }
    if ((x0 < c.*.dmg_x0)) {
        c.*.dmg_x0 = x0;
    }
    if ((y0 < c.*.dmg_y0)) {
        c.*.dmg_y0 = y0;
    }
    if ((x1 > c.*.dmg_x1)) {
        c.*.dmg_x1 = x1;
    }
    if ((y1 > c.*.dmg_y1)) {
        c.*.dmg_y1 = y1;
    }
}

fn comp_render_damage(c: *Compositor, x0: i32, y0: i32, x1: i32, y1: i32) i32 {
    let rx0: i32 = comp_clamp_i(x0, 0, (c.*.desktop_w - 1));
    let ry0: i32 = comp_clamp_i(y0, 0, (c.*.desktop_h - 1));
    let rx1: i32 = comp_clamp_i(x1, 0, (c.*.desktop_w - 1));
    let ry1: i32 = comp_clamp_i(y1, 0, (c.*.desktop_h - 1));
    if (((rx1 < rx0) || (ry1 < ry0))) {
        return 0;
    }
    comp_mark_damage(c, rx0, ry0, rx1, ry1);
    softgpu_damage_reset(&c.*.fb);
    vg_set_clip(&c.*.fb, rx0, ry0, ((rx1 - rx0) + 1), ((ry1 - ry0) + 1));
    comp_paint_wallpaper_region(c, rx0, ry0, rx1, ry1);
    comp_paint_windows_in_rect(c, rx0, ry0, rx1, ry1);
    let th: RayOsTheme = c.*.wm.theme;
    if ((ry1 >= (c.*.desktop_h - th.taskbar_h))) {
        comp_paint_shell(c);
    }
    if ((launcher_is_open(c.*.launcher) == 1)) {
        comp_paint_launcher(c);
    }
    vg_clear_clip(&c.*.fb);
    let pixels: i32 = (((rx1 - rx0) + 1) * ((ry1 - ry0) + 1));
    return pixels;
}

fn comp_flush_damage(c: *Compositor) i32 {
    if ((c.*.dirty == 0)) {
        return 0;
    }
    let px: i32 = comp_render_damage(c, c.*.dmg_x0, c.*.dmg_y0, c.*.dmg_x1, c.*.dmg_y1);
    c.*.dirty = 0;
    c.*.dmg_x1 = -1;
    return px;
}

fn comp_present(c: *Compositor, dev: SoftGpuDevice) i32 {
    return softgpu_present(dev, &c.*.fb);
}

fn comp_checksum(c: *Compositor) i32 {
    return softgpu_checksum(&c.*.fb);
}

fn DISPLAY_REG_WIDTH() i32 {
    return 0;
}

fn DISPLAY_REG_HEIGHT() i32 {
    return 4;
}

fn DISPLAY_REG_PRESENT_FLAG() i32 {
    return 8;
}

fn DISPLAY_REG_FRAME_SEQ() i32 {
    return 12;
}

fn DISPLAY_REG_PIXEL_BYTES() i32 {
    return 16;
}

fn DISPLAY_REG_CHECKSUM() i32 {
    return 20;
}

fn DISPLAY_CHAMBER_MAGIC() i32 {
    return 1381259348;
}

struct DisplayChamberState {
    magic: i32,
    pid: i64,
    width: i32,
    height: i32,
    fb_ptr: i64,
    fb_bytes: i32,
    present_flag: i32,
    frame_seq: i32,
    ready: i32,
}

fn display_chamber_base() i64 {
    return (RAYOS_SCANOUT_MMIO_BASE()) as i64;
}

fn display_chamber_state_new() DisplayChamberState {
    return DisplayChamberState{ .magic = (DISPLAY_CHAMBER_MAGIC()) as i32, .pid = hw_rt_getpid(), .width = 0, .height = 0, .fb_ptr = 0, .fb_bytes = 0, .present_flag = 0, .frame_seq = 0, .ready = 0 };
}

fn display_chamber_mmio_ptr(reg: i32) *i8 {
    if ((hw_rt_ensure() != 0)) {
        return null;
    }
    let rt: *HwRtState = hw_rt_state_mut();
    let rel: i64 = ((display_chamber_base() - rt.*.virt_base) + (reg) as i64);
    if (((rel < 0) || ((rel + 1) > rt.*.map_size))) {
        return null;
    }
    return ((rt.*.map_base + rel)) as *i8;
}

fn display_chamber_mmio_store8(reg: i32, val: i8) void {
    if (display_chamber_mmio_ptr(reg)) |bp| {
        bp.* = val;
        hw_fence();
    }
}

fn display_chamber_mmio_load8(reg: i32) i32 {
    if (display_chamber_mmio_ptr(reg)) |bp| {
        let v: i64 = (bp.*) as i64;
        if ((v < 0)) {
            v = (v + 256);
        }
        return (v) as i32;
    }
    return 0;
}

fn display_chamber_state_mut() *DisplayChamberState {
    let st: *DisplayChamberState = ((hw_globals() + HW_GSLOT_DISPLAY())) as *DisplayChamberState;
    if ((st.*.magic != (DISPLAY_CHAMBER_MAGIC()) as i32)) {
        st.* = display_chamber_state_new();
    }
    return st;
}

fn display_chamber_state_from_cache() ?*DisplayChamberState {
    let st: *DisplayChamberState = display_chamber_state_mut();
    if ((st.*.ready == 0)) {
        return null;
    }
    return st;
}

fn display_chamber_fb_ptr(st: *DisplayChamberState) *i8 {
    if ((st.*.fb_ptr == 0)) {
        return null;
    }
    return (st.*.fb_ptr) as *i8;
}

fn display_chamber_init(w: i32, h: i32) i32 {
    if ((hw_rt_init() != 0)) {
        return (0 - 1);
    }
    if (((w < 1) || (h < 1))) {
        return (0 - 2);
    }
    let bytes: i32 = ((w * h) * 3);
    let st: *DisplayChamberState = display_chamber_state_mut();
    if (((st.*.fb_ptr != 0) && (st.*.fb_bytes != bytes))) {
        _zag_free((st.*.fb_ptr) as *i8);
        st.*.fb_ptr = 0;
        st.*.fb_bytes = 0;
    }
    if ((st.*.fb_ptr == 0)) {
        let raw: *i8 = _zag_malloc(bytes);
        if ((raw == null)) {
            return (0 - 3);
        }
        st.*.fb_ptr = (raw) as i64;
        st.*.fb_bytes = bytes;
    }
    st.*.pid = hw_rt_getpid();
    st.*.width = w;
    st.*.height = h;
    st.*.present_flag = 0;
    st.*.frame_seq = 0;
    st.*.ready = 1;
    let base: i64 = display_chamber_base();
    mmio_write32((base + (DISPLAY_REG_WIDTH()) as i64), w);
    mmio_write32((base + (DISPLAY_REG_HEIGHT()) as i64), h);
    mmio_write32((base + (DISPLAY_REG_PIXEL_BYTES()) as i64), bytes);
    mmio_write32((base + (DISPLAY_REG_CHECKSUM()) as i64), 0);
    display_chamber_mmio_store8(DISPLAY_REG_PRESENT_FLAG(), (0) as i8);
    display_chamber_mmio_store8(DISPLAY_REG_FRAME_SEQ(), (0) as i8);
    return 0;
}

fn scanout_fb_checksum(src: *SoftFb) i32 {
    let acc: i32 = 7;
    let n: i32 = ((src.*.w * src.*.h) * 3);
    let i: i32 = 0;
    while ((i < n)) {
        acc = (((acc * 131) + (get[u8](src.*.pix, i)) as i32) % 15485863);
        i = (i + 1);
    }
    return acc;
}

fn scanout_blit(src: *SoftFb) i32 {
    let st: *DisplayChamberState = display_chamber_state_mut();
    if ((st.*.ready == 0)) {
        return (0 - 1);
    }
    if (((src.*.w != st.*.width) || (src.*.h != st.*.height))) {
        return (0 - 2);
    }
    let dst: *i8 = display_chamber_fb_ptr(st);
    if ((dst == null)) {
        return (0 - 3);
    }
    softgpu_copy_bytes(dst, (src.*.pix.data) as *i8, st.*.fb_bytes);
    hw_fence();
    return 0;
}

fn scanout_blit_verified(src: *SoftFb) i32 {
    let rc: i32 = scanout_blit(src);
    if ((rc != 0)) {
        return rc;
    }
    let cks: i32 = scanout_fb_checksum(src);
    let base: i64 = display_chamber_base();
    mmio_write32((base + (DISPLAY_REG_CHECKSUM()) as i64), cks);
    hw_fence();
    return 0;
}

fn scanout_present() i32 {
    let st: *DisplayChamberState = display_chamber_state_mut();
    if ((st.*.ready == 0)) {
        return (0 - 1);
    }
    st.*.present_flag = 1;
    st.*.frame_seq = (st.*.frame_seq + 1);
    display_chamber_mmio_store8(DISPLAY_REG_PRESENT_FLAG(), (1) as i8);
    display_chamber_mmio_store8(DISPLAY_REG_FRAME_SEQ(), (st.*.frame_seq) as i8);
    return 0;
}

fn scanout_present_flag() i32 {
    let st: *DisplayChamberState = display_chamber_state_mut();
    if ((st.*.ready == 1)) {
        return st.*.present_flag;
    }
    return display_chamber_mmio_load8(DISPLAY_REG_PRESENT_FLAG());
}

fn scanout_frame_seq() i32 {
    let st: *DisplayChamberState = display_chamber_state_mut();
    if ((st.*.ready == 1)) {
        return st.*.frame_seq;
    }
    return display_chamber_mmio_load8(DISPLAY_REG_FRAME_SEQ());
}

fn scanout_clear_present_flag() void {
    let st: *DisplayChamberState = display_chamber_state_mut();
    st.*.present_flag = 0;
    display_chamber_mmio_store8(DISPLAY_REG_PRESENT_FLAG(), (0) as i8);
}

fn INPUT_REG_HEAD() i32 {
    return 0;
}

fn INPUT_REG_TAIL() i32 {
    return 4;
}

fn INPUT_REG_CAPACITY() i32 {
    return 8;
}

fn INPUT_EVENT_BASE() i32 {
    return 12;
}

fn INPUT_EVENT_STRIDE() i32 {
    return 16;
}

fn INPUT_RING_CAPACITY() i32 {
    return 64;
}

fn INPUT_KIND_MOVE() i32 {
    return 0;
}

fn INPUT_KIND_BUTTON() i32 {
    return 1;
}

fn INPUT_KIND_KEY() i32 {
    return 2;
}

fn input_chamber_base() i64 {
    return (RAYOS_INPUT_MMIO_BASE()) as i64;
}

fn input_chamber_event_addr(idx: i32) i64 {
    let base: i64 = input_chamber_base();
    let off: i64 = ((INPUT_EVENT_BASE() + (idx * INPUT_EVENT_STRIDE()))) as i64;
    return (base + off);
}

fn input_chamber_ring_index(idx: i32, cap: i32) i32 {
    if ((cap < 1)) {
        return 0;
    }
    return (idx % cap);
}

fn input_chamber_init() i32 {
    if ((hw_rt_init() != 0)) {
        return (0 - 1);
    }
    let base: i64 = input_chamber_base();
    mmio_write32((base + (INPUT_REG_HEAD()) as i64), 0);
    mmio_write32((base + (INPUT_REG_TAIL()) as i64), 0);
    mmio_write32((base + (INPUT_REG_CAPACITY()) as i64), (INPUT_RING_CAPACITY()) as i32);
    return 0;
}

fn input_chamber_ensure() i32 {
    if ((hw_rt_ensure() != 0)) {
        return (0 - 1);
    }
    let base: i64 = input_chamber_base();
    let cap: i32 = mmio_read32((base + (INPUT_REG_CAPACITY()) as i64));
    if ((cap != (INPUT_RING_CAPACITY()) as i32)) {
        return input_chamber_init();
    }
    return 0;
}

fn input_chamber_queue_len(head: i32, tail: i32, cap: i32) i32 {
    if ((tail >= head)) {
        return (tail - head);
    }
    return ((cap - head) + tail);
}

fn input_chamber_push_event(kind: i32, x: i32, y: i32, btn: i32) i32 {
    if ((input_chamber_ensure() != 0)) {
        return (0 - 1);
    }
    let base: i64 = input_chamber_base();
    let cap: i32 = mmio_read32((base + (INPUT_REG_CAPACITY()) as i64));
    if ((cap < 1)) {
        return (0 - 2);
    }
    let head: i32 = mmio_read32((base + (INPUT_REG_HEAD()) as i64));
    let tail: i32 = mmio_read32((base + (INPUT_REG_TAIL()) as i64));
    if ((input_chamber_queue_len(head, tail, cap) >= cap)) {
        return (0 - 3);
    }
    let slot: i32 = input_chamber_ring_index(tail, cap);
    let ev: i64 = input_chamber_event_addr(slot);
    mmio_write32((ev + 0), kind);
    mmio_write32((ev + 4), x);
    mmio_write32((ev + 8), y);
    mmio_write32((ev + 12), btn);
    let next: i32 = input_chamber_ring_index((tail + 1), cap);
    mmio_write32((base + (INPUT_REG_TAIL()) as i64), next);
    hw_fence();
    return 0;
}

fn input_chamber_poll_ev(kind: *i32, mx: *i32, my: *i32, btn: *i32) i32 {
    if ((input_chamber_ensure() != 0)) {
        return 0;
    }
    let base: i64 = input_chamber_base();
    let cap: i32 = mmio_read32((base + (INPUT_REG_CAPACITY()) as i64));
    if ((cap < 1)) {
        return 0;
    }
    let head: i32 = mmio_read32((base + (INPUT_REG_HEAD()) as i64));
    let tail: i32 = mmio_read32((base + (INPUT_REG_TAIL()) as i64));
    if ((head == tail)) {
        return 0;
    }
    let slot: i32 = input_chamber_ring_index(head, cap);
    let ev: i64 = input_chamber_event_addr(slot);
    kind.* = mmio_read32((ev + 0));
    mx.* = mmio_read32((ev + 4));
    my.* = mmio_read32((ev + 8));
    btn.* = mmio_read32((ev + 12));
    let next: i32 = input_chamber_ring_index((head + 1), cap);
    mmio_write32((base + (INPUT_REG_HEAD()) as i64), next);
    hw_fence();
    return 1;
}

fn input_chamber_poll(mx: *i32, my: *i32, btn: *i32) i32 {
    let kind: i32 = 0;
    return input_chamber_poll_ev(&kind, mx, my, btn);
}

fn input_chamber_inject_ev(kind: i32, x: i32, y: i32, btn: i32) void {
    let _rc: i32 = input_chamber_push_event(kind, x, y, btn);
}

fn input_chamber_inject(x: i32, y: i32, btn: i32) void {
    let kind: i32 = (INPUT_KIND_MOVE()) as i32;
    if ((btn != 0)) {
        kind = (INPUT_KIND_BUTTON()) as i32;
    }
    let _rc: i32 = input_chamber_push_event(kind, x, y, btn);
}

struct GuestFbSohState {
    pool: *ArrayList[u8],
    bound: i32,
}

fn GUEST_FB_SOH_MAGIC() i32 {
    return 1195989076;
}

fn guest_fb_soh_state_new() GuestFbSohState {
    return GuestFbSohState{ .pool = (0) as *ArrayList[u8], .bound = 0 };
}

fn guest_fb_soh_state_mut() *GuestFbSohState {
    let st: *GuestFbSohState = ((hw_globals() + HW_GSLOT_GUEST_FB_SOH())) as *GuestFbSohState;
    return st;
}

fn guest_fb_bind_pool(pool: *ArrayList[u8]) void {
    let st: *GuestFbSohState = guest_fb_soh_state_mut();
    st.*.pool = pool;
    st.*.bound = 1;
}

fn guest_fb_alloc(w: i32, h: i32) i32 {
    if ((w < 1)) {
        return (0 - 1);
    }
    if ((h < 1)) {
        return (0 - 2);
    }
    let st: *GuestFbSohState = guest_fb_soh_state_mut();
    if ((st.*.bound == 0)) {
        return (0 - 3);
    }
    if ((st.*.pool == (0) as *ArrayList[u8])) {
        return (0 - 4);
    }
    let bytes: i32 = ((w * h) * 3);
    let off: i32 = len[u8](st.*.pool.*);
    let i: i32 = 0;
    while ((i < bytes)) {
        push[u8](st.*.pool, 0);
        i = (i + 1);
    }
    return off;
}

fn guest_fb_fill(pool: ArrayList[u8], off: i32, w: i32, h: i32, r: i32, g: i32, b: i32) void {
    if ((w < 1)) {
        return;
    }
    if ((h < 1)) {
        return;
    }
    let y: i32 = 0;
    while ((y < h)) {
        let x: i32 = 0;
        while ((x < w)) {
            let di: i32 = (off + (((y * w) + x) * 3));
            if ((di >= 0)) {
                if (((di + 2) < len[u8](pool))) {
                    set[u8](&pool, di, (r) as u8);
                    set[u8](&pool, (di + 1), (g) as u8);
                    set[u8](&pool, (di + 2), (b) as u8);
                }
            }
            x = (x + 1);
        }
        y = (y + 1);
    }
}

fn display_dev_ppm(path: []u8) SoftGpuDevice {
    return SoftGpuDevice{ .kind = 0, .path = path };
}

fn display_dev_fb0() SoftGpuDevice {
    return SoftGpuDevice{ .kind = 1, .path = "/dev/fb0" };
}

fn display_present(fb: *SoftFb, dev: SoftGpuDevice) i32 {
    return softgpu_present(dev, fb);
}

fn display_skip_ws(s: []u8, i: i32) i32 {
    let at: i32 = i;
    while ((at < s.len)) {
        let c: u8 = s[at];
        if (((((c == 32) || (c == 9)) || (c == 10)) || (c == 13))) {
            at = (at + 1);
        } else {
            return at;
        }
    }
    return at;
}

fn display_read_int(s: []u8, i: i32) i32 {
    let at: i32 = display_skip_ws(s, i);
    let end: i32 = at;
    let done: i32 = 0;
    while (((end < s.len) && (done == 0))) {
        let c: u8 = s[end];
        if (((c >= 48) && (c <= 57))) {
            end = (end + 1);
        } else {
            done = 1;
        }
    }
    if ((end <= at)) {
        return 0;
    }
    return (_zag_str_to_i64(s[at..end])) as i32;
}

fn display_int_end(s: []u8, i: i32) i32 {
    let at: i32 = display_skip_ws(s, i);
    while ((at < s.len)) {
        let c: u8 = s[at];
        if (((c >= 48) && (c <= 57))) {
            at = (at + 1);
        } else {
            return at;
        }
    }
    return at;
}

fn display_poll_mouse(mx: *i32, my: *i32, btn: *i32) i32 {
    let raw: []u8 = _zag_read_file("/tmp/rayos_input.ev");
    if ((raw.len < 3)) {
        return 0;
    }
    let x: i32 = display_read_int(raw, 0);
    let at: i32 = display_skip_ws(raw, display_int_end(raw, 0));
    let y: i32 = display_read_int(raw, at);
    let at2: i32 = display_skip_ws(raw, display_int_end(raw, at));
    let b: i32 = display_read_int(raw, at2);
    mx.* = x;
    my.* = y;
    btn.* = b;
    _zag_write_file("/tmp/rayos_input.ev", "");
    return 1;
}

fn display_clear_input() void {
    _zag_write_file("/tmp/rayos_input.ev", "");
}

fn SCANOUT_LIVE_MAGIC() i32 {
    return 1381260116;
}

struct ScanoutLiveState {
    magic: i32,
    width: i32,
    height: i32,
    fb_ptr: i64,
    fb_bytes: i32,
    last_seq: i32,
    ready: i32,
    out_ptr: i64,
    out_hdr: i32,
}

fn scanout_live_state_new() ScanoutLiveState {
    return ScanoutLiveState{ .magic = (SCANOUT_LIVE_MAGIC()) as i32, .width = 0, .height = 0, .fb_ptr = 0, .fb_bytes = 0, .last_seq = 0, .ready = 0, .out_ptr = 0, .out_hdr = 0 };
}

fn scanout_live_state_mut() *ScanoutLiveState {
    let st: *ScanoutLiveState = ((hw_globals() + HW_GSLOT_SCANOUT_LIVE())) as *ScanoutLiveState;
    if ((st.*.magic != (SCANOUT_LIVE_MAGIC()) as i32)) {
        st.* = scanout_live_state_new();
    }
    return st;
}

fn scanout_live_spin_wait() void {
    hw_sleep_ms(2);
}

fn scanout_live_attach_chamber(w: i32, h: i32) i32 {
    if (display_chamber_state_from_cache()) |ch| {
        if (((ch.*.ready == 1) && (ch.*.fb_ptr != 0))) {
            if (((ch.*.width == w) && (ch.*.height == h))) {
                return 0;
            }
        }
    }
    return display_chamber_init(w, h);
}

fn scanout_live_setup_out(live: *ScanoutLiveState) i32 {
    if ((live.*.out_ptr != 0)) {
        return 0;
    }
    let hdr: []u8 = _zag_str_concat("P6\n", _zag_i64_to_str((live.*.width) as i64));
    hdr = _zag_str_concat(hdr, " ");
    hdr = _zag_str_concat(hdr, _zag_i64_to_str((live.*.height) as i64));
    hdr = _zag_str_concat(hdr, "\n255\n");
    let buf: *i8 = _zag_malloc((hdr.len + live.*.fb_bytes));
    if ((buf == null)) {
        return (0 - 1);
    }
    let i: i32 = 0;
    while ((i < hdr.len)) {
        buf[i] = (hdr[i]) as i8;
        i = (i + 1);
    }
    live.*.out_ptr = (buf) as i64;
    live.*.out_hdr = hdr.len;
    return 0;
}

fn scanout_live_init(w: i32, h: i32) i32 {
    if (((w < 1) || (h < 1))) {
        return (0 - 1);
    }
    if ((hw_rt_init() != 0)) {
        return (0 - 2);
    }
    if ((scanout_live_attach_chamber(w, h) != 0)) {
        return (0 - 3);
    }
    let ch: *DisplayChamberState = display_chamber_state_mut();
    if ((ch.*.fb_ptr == 0)) {
        return (0 - 4);
    }
    let live: *ScanoutLiveState = scanout_live_state_mut();
    if (((live.*.out_ptr != 0) && ((live.*.width != ch.*.width) || (live.*.height != ch.*.height)))) {
        _zag_free((live.*.out_ptr) as *i8);
        live.*.out_ptr = 0;
        live.*.out_hdr = 0;
    }
    live.*.width = ch.*.width;
    live.*.height = ch.*.height;
    live.*.fb_ptr = ch.*.fb_ptr;
    live.*.fb_bytes = ch.*.fb_bytes;
    live.*.last_seq = scanout_frame_seq();
    live.*.ready = 1;
    if ((scanout_live_setup_out(live) != 0)) {
        return (0 - 5);
    }
    return 0;
}

fn scanout_live_chamber_fb_ptr() *i8 {
    let live: *ScanoutLiveState = scanout_live_state_mut();
    if ((live.*.ready == 0)) {
        return null;
    }
    if ((live.*.fb_ptr == 0)) {
        return null;
    }
    return (live.*.fb_ptr) as *i8;
}

fn scanout_live_softfb_from_chamber() SoftFb {
    let live: *ScanoutLiveState = scanout_live_state_mut();
    let fb: SoftFb = softgpu_new(live.*.width, live.*.height);
    let src: *i8 = scanout_live_chamber_fb_ptr();
    if ((src == null)) {
        return fb;
    }
    softgpu_copy_bytes((fb.pix.data) as *i8, src, live.*.fb_bytes);
    return fb;
}

fn scanout_live_present_once(path: []u8) i32 {
    let live: *ScanoutLiveState = scanout_live_state_mut();
    if ((live.*.ready == 0)) {
        return (0 - 1);
    }
    if (((live.*.out_ptr == 0) || (live.*.fb_ptr == 0))) {
        return (0 - 2);
    }
    if ((path.len < 1)) {
        return (0 - 3);
    }
    softgpu_copy_bytes(((live.*.out_ptr + (live.*.out_hdr) as i64)) as *i8, (live.*.fb_ptr) as *i8, live.*.fb_bytes);
    let total: i32 = (live.*.out_hdr + live.*.fb_bytes);
    let tmp: []u8 = _zag_str_concat(path, ".tmp");
    let out: *u8 = (live.*.out_ptr) as *u8;
    let rc: i32 = _zag_write_file(tmp, out[0..total]);
    if ((rc == 0)) {
        rc = hw_rename(tmp, path);
    }
    live.*.last_seq = scanout_frame_seq();
    return rc;
}

fn scanout_live_present_loop(max_frames: i32) i32 {
    let live: *ScanoutLiveState = scanout_live_state_mut();
    if ((live.*.ready == 0)) {
        return (0 - 1);
    }
    let out_path: []u8 = "desktop/live_frame.ppm";
    let presented: i32 = 0;
    let last_seq: i32 = live.*.last_seq;
    while (((max_frames == 0) || (presented < max_frames))) {
        if ((scanout_present_flag() == 1)) {
            let seq: i32 = scanout_frame_seq();
            if ((seq != last_seq)) {
                let rc: i32 = scanout_live_present_once(out_path);
                if ((rc != 0)) {
                    return rc;
                }
                last_seq = seq;
                live.*.last_seq = seq;
                presented = (presented + 1);
            }
        }
        scanout_live_spin_wait();
    }
    return 0;
}

struct TritAddResult {
    sum: i8,
    carry: i8,
}

struct TritMulResult {
    product: i8,
}

fn balance_sum(raw: i32) TritAddResult {
    let result: i8 = 0;
    let carry: i8 = 0;
    if ((raw > 1)) {
        result = ((raw - 3)) as i8;
        carry = 1;
    } else if ((raw < (0 - 1))) {
        result = ((raw + 3)) as i8;
        carry = (0 - 1);
    } else {
        result = (raw) as i8;
        carry = 0;
    }
    return TritAddResult{ .sum = result, .carry = carry };
}

fn add(a: i8, b: i8, carry_in: i8) TritAddResult {
    let raw: i32 = (((a) as i32 + (b) as i32) + (carry_in) as i32);
    return balance_sum(raw);
}

fn mul(a: i8, b: i8) TritMulResult {
    let product: i8 = ((a * b)) as i8;
    return TritMulResult{ .product = product };
}

enum GeSnPolarization {
    TE, TM, Balanced,
}

enum WaveguideState {
    Free, Reserved, Latched,
}

struct ChamberCoord {
    x: i32,
    y: i32,
    z: i32,
}

fn chamber_coord(x: i32, y: i32, z: i32) ChamberCoord {
    return ChamberCoord{ .x = x, .y = y, .z = z };
}

fn chamber_in_bounds(c: ChamberCoord) i32 {
    if (((c.x < 0) || (c.x >= (RAYOS_CHAMBER_GRID_W()) as i32))) {
        return 0;
    }
    if (((c.y < 0) || (c.y >= (RAYOS_CHAMBER_GRID_H()) as i32))) {
        return 0;
    }
    if (((c.z < 0) || (c.z >= (RAYOS_CHAMBER_GRID_D()) as i32))) {
        return 0;
    }
    return 1;
}

fn chamber_linear_index(c: ChamberCoord) i32 {
    let w: i32 = (RAYOS_CHAMBER_GRID_W()) as i32;
    let h: i32 = (RAYOS_CHAMBER_GRID_H()) as i32;
    return ((((c.z * w) * h) + (c.y * w)) + c.x);
}

fn chamber_from_linear(idx: i32) ChamberCoord {
    let w: i32 = (RAYOS_CHAMBER_GRID_W()) as i32;
    let h: i32 = (RAYOS_CHAMBER_GRID_H()) as i32;
    let plane: i32 = (w * h);
    let z: i32 = (idx / plane);
    let rem: i32 = (idx - (z * plane));
    let y: i32 = (rem / w);
    let x: i32 = (rem - (y * w));
    return ChamberCoord{ .x = x, .y = y, .z = z };
}

fn chamber_id_valid(id: i32) i32 {
    if ((id >= 0)) {
        if ((id < (RAYOS_CHAMBER_COUNT()) as i32)) {
            return 1;
        }
    }
    return 0;
}

fn wdm_channel_valid(ch: i32) i32 {
    if ((ch >= 0)) {
        if ((ch < (RAYOS_WDM_CHANNELS()) as i32)) {
            return 1;
        }
    }
    return 0;
}

fn wdm_channel_freq_ghz(ch: i32) i32 {
    if ((wdm_channel_valid(ch) == 0)) {
        return 0;
    }
    return ((RAYOS_BASE_FREQ_GHZ()) as i32 + (ch * (RAYOS_WDM_SPACING_GHZ()) as i32));
}

struct GeSnWaveguide {
    slot_id: i32,
    state: WaveguideState,
    polarization: GeSnPolarization,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
    ge_fraction_x10: i32,
    width_nm: i32,
    depth_nm: i32,
    bend_radius_um: i32,
    length_um: i32,
    bend_count: i32,
    insertion_loss_db_x10: i32,
    latched: i32,
}

struct WaveguidePool {
    paths: *GeSnWaveguide,
    slot_count: i32,
    allocated: i32,
    latched: i32,
}

struct PathAllocationResult {
    slot_id: i32,
    loss_db_x10: i32,
}

fn wg_manhattan_chambers(src: i32, dst: i32) i32 {
    if (((chamber_id_valid(src) == 0) || (chamber_id_valid(dst) == 0))) {
        return 0;
    }
    let a: ChamberCoord = chamber_from_linear(src);
    let b: ChamberCoord = chamber_from_linear(dst);
    let dx: i32 = (a.x - b.x);
    if ((dx < 0)) {
        dx = (0 - dx);
    }
    let dy: i32 = (a.y - b.y);
    if ((dy < 0)) {
        dy = (0 - dy);
    }
    let dz: i32 = (a.z - b.z);
    if ((dz < 0)) {
        dz = (0 - dz);
    }
    return ((dx + dy) + dz);
}

fn wg_estimate_length_um(hop_count: i32) i32 {
    let chamber_pitch_um: i32 = 30000;
    let inter_run_um: i32 = 5000;
    if ((hop_count < 1)) {
        return (chamber_pitch_um / 10);
    }
    return ((hop_count * inter_run_um) + (chamber_pitch_um / 10));
}

fn wg_estimate_bends(hop_count: i32) i32 {
    if ((hop_count <= 1)) {
        return 0;
    }
    return (hop_count - 1);
}

fn wg_compute_loss_db_x10(length_um: i32, bend_count: i32) i32 {
    let prop: i32 = ((length_um * 3) / 1000);
    let bend: i32 = (bend_count * 5);
    return (prop + bend);
}

fn wg_trit_lane_valid(lane_trit: i8) i32 {
    if ((lane_trit == (PHASE_NEG()) as i8)) {
        return 1;
    }
    if ((lane_trit == (PHASE_ZERO()) as i8)) {
        return 1;
    }
    if ((lane_trit == (PHASE_POS()) as i8)) {
        return 1;
    }
    return 0;
}

fn wg_balance_channel_offset(base_ch: i32, trit_offset: i8) i32 {
    let raw: i32 = ((base_ch) as i32 + (trit_offset) as i32);
    let ch: i32 = raw;
    if ((raw > 1)) {
        ch = (raw - 3);
    }
    if ((raw < (0 - 1))) {
        ch = (raw + 3);
    }
    if ((ch < 0)) {
        ch = 0;
    }
    if ((ch >= (RAYOS_WDM_CHANNELS()) as i32)) {
        ch = ((RAYOS_WDM_CHANNELS()) as i32 - 1);
    }
    return ch;
}

fn wg_empty_guide() GeSnWaveguide {
    return GeSnWaveguide{ .slot_id = (0 - 1), .state = WaveguideState.Free, .polarization = GeSnPolarization.Balanced, .src_chamber = (0 - 1), .dst_chamber = (0 - 1), .channel_id = (0 - 1), .ge_fraction_x10 = 85, .width_nm = 450, .depth_nm = 220, .bend_radius_um = 50, .length_um = 0, .bend_count = 0, .insertion_loss_db_x10 = 0, .latched = 0 };
}

fn wg_pool_new() WaveguidePool {
    let count: i32 = (RAYOS_WAVEGUIDE_SLOTS()) as i32;
    let raw: *i8 = _zag_malloc((count * @sizeOf[GeSnWaveguide]()));
    let paths: *GeSnWaveguide = (raw) as *GeSnWaveguide;
    let i: i32 = 0;
    while ((i < count)) {
        let g: GeSnWaveguide = wg_empty_guide();
        g.slot_id = i;
        paths[i] = g;
        i = (i + 1);
    }
    return WaveguidePool{ .paths = paths, .slot_count = count, .allocated = 0, .latched = 0 };
}

fn wg_pool_free(p: *WaveguidePool) void {
    if ((p.*.paths != null)) {
        _zag_free((p.*.paths) as *i8);
    }
    p.*.paths = (null) as *GeSnWaveguide;
    p.*.slot_count = 0;
    p.*.allocated = 0;
    p.*.latched = 0;
}

fn wg_find_free_slot(p: WaveguidePool) i32 {
    let i: i32 = 0;
    while ((i < p.slot_count)) {
        if ((p.paths[i].state == WaveguideState.Free)) {
            return i;
        }
        i = (i + 1);
    }
    return (0 - 1);
}

fn wg_allocate_path(p: *WaveguidePool, src_chamber: i32, dst_chamber: i32, channel_id: i32) PathAllocationResult {
    let fail: PathAllocationResult = PathAllocationResult{ .slot_id = (0 - 1), .loss_db_x10 = 0 };
    if (((chamber_id_valid(src_chamber) == 0) || (chamber_id_valid(dst_chamber) == 0))) {
        return fail;
    }
    if ((wdm_channel_valid(channel_id) == 0)) {
        return fail;
    }
    let slot: i32 = wg_find_free_slot(p.*);
    if ((slot < 0)) {
        return fail;
    }
    let hops: i32 = wg_manhattan_chambers(src_chamber, dst_chamber);
    let length_um: i32 = wg_estimate_length_um(hops);
    let bends: i32 = wg_estimate_bends(hops);
    let loss: i32 = wg_compute_loss_db_x10(length_um, bends);
    p.*.paths[slot] = GeSnWaveguide{ .slot_id = slot, .state = WaveguideState.Reserved, .polarization = GeSnPolarization.Balanced, .src_chamber = src_chamber, .dst_chamber = dst_chamber, .channel_id = channel_id, .ge_fraction_x10 = 85, .width_nm = 450, .depth_nm = 220, .bend_radius_um = 50, .length_um = length_um, .bend_count = bends, .insertion_loss_db_x10 = loss, .latched = 0 };
    p.*.allocated = (p.*.allocated + 1);
    return PathAllocationResult{ .slot_id = slot, .loss_db_x10 = loss };
}

fn wg_release_path(p: *WaveguidePool, slot_id: i32) i32 {
    if (((slot_id < 0) || (slot_id >= p.*.slot_count))) {
        return 0;
    }
    if ((p.*.paths[slot_id].state == WaveguideState.Free)) {
        return 0;
    }
    if ((p.*.paths[slot_id].latched == 1)) {
        p.*.latched = (p.*.latched - 1);
    }
    if ((p.*.paths[slot_id].state != WaveguideState.Free)) {
        p.*.allocated = (p.*.allocated - 1);
    }
    let g: GeSnWaveguide = wg_empty_guide();
    g.slot_id = slot_id;
    p.*.paths[slot_id] = g;
    return 1;
}

fn wg_latch_path(p: *WaveguidePool, slot_id: i32) i32 {
    if (((slot_id < 0) || (slot_id >= p.*.slot_count))) {
        return 0;
    }
    if ((p.*.paths[slot_id].state != WaveguideState.Reserved)) {
        return 0;
    }
    p.*.paths[slot_id].state = WaveguideState.Latched;
    p.*.paths[slot_id].latched = 1;
    p.*.latched = (p.*.latched + 1);
    return 1;
}

fn wg_unlatch_path(p: *WaveguidePool, slot_id: i32) i32 {
    if (((slot_id < 0) || (slot_id >= p.*.slot_count))) {
        return 0;
    }
    if ((p.*.paths[slot_id].state != WaveguideState.Latched)) {
        return 0;
    }
    p.*.paths[slot_id].state = WaveguideState.Reserved;
    p.*.paths[slot_id].latched = 0;
    p.*.latched = (p.*.latched - 1);
    return 1;
}

fn wg_path_get(p: WaveguidePool, slot_id: i32) ?GeSnWaveguide {
    if (((slot_id < 0) || (slot_id >= p.slot_count))) {
        return null;
    }
    if ((p.paths[slot_id].state == WaveguideState.Free)) {
        return null;
    }
    return p.paths[slot_id];
}

fn wg_path_flowing(p: WaveguidePool, slot_id: i32) i32 {
    if (((slot_id < 0) || (slot_id >= p.slot_count))) {
        return 0;
    }
    if ((p.paths[slot_id].state == WaveguideState.Latched)) {
        return 1;
    }
    return 0;
}

fn wg_pool_summary(p: WaveguidePool) i32 {
    return p.allocated;
}

struct WaveguidePath {
    slot_id: i32,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
    hop_count: i32,
    freq_ghz: i32,
    loss_db_x10: i32,
    latched: i32,
}

struct WavelengthSlot {
    chamber_id: i32,
    channel_id: i32,
    occupied: i32,
    route_id: i32,
    binding_id: i32,
    freq_ghz: i32,
}

struct RouteEntry {
    route_id: i32,
    path: WaveguidePath,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
    active: i32,
    binding_id: i32,
}

struct ApplicationBinding {
    binding_id: i32,
    app_id: i32,
    route_id: i32,
    chamber_id: i32,
    channel_id: i32,
    path_slot: i32,
    active: i32,
}

struct RoutingTable {
    routes: *RouteEntry,
    route_count: i32,
    route_capacity: i32,
    wavelength_slots: *WavelengthSlot,
    wl_slot_count: i32,
    bindings: *ApplicationBinding,
    binding_count: i32,
    binding_capacity: i32,
    next_route_id: i32,
    next_binding_id: i32,
}

struct RoutingSummary {
    routes_active: i32,
    wavelengths_used: i32,
    bindings_active: i32,
}

fn wl_slot_index(chamber_id: i32, channel_id: i32) i32 {
    return ((chamber_id * (RAYOS_WDM_CHANNELS()) as i32) + channel_id);
}

fn wl_slot_chamber(slot_idx: i32) i32 {
    return (slot_idx / (RAYOS_WDM_CHANNELS()) as i32);
}

fn wl_slot_channel(slot_idx: i32) i32 {
    return (slot_idx - (wl_slot_chamber(slot_idx) * (RAYOS_WDM_CHANNELS()) as i32));
}

fn route_entry_empty(route_id: i32) RouteEntry {
    return RouteEntry{ .route_id = route_id, .path = WaveguidePath{ .slot_id = (0 - 1), .src_chamber = (0 - 1), .dst_chamber = (0 - 1), .channel_id = (0 - 1), .hop_count = 0, .freq_ghz = 0, .loss_db_x10 = 0, .latched = 0 }, .src_chamber = (0 - 1), .dst_chamber = (0 - 1), .channel_id = (0 - 1), .active = 0, .binding_id = (0 - 1) };
}

fn binding_empty(binding_id: i32) ApplicationBinding {
    return ApplicationBinding{ .binding_id = binding_id, .app_id = (0 - 1), .route_id = (0 - 1), .chamber_id = (0 - 1), .channel_id = (0 - 1), .path_slot = (0 - 1), .active = 0 };
}

fn routing_table_new() RoutingTable {
    let route_cap: i32 = (RAYOS_MAX_ROUTES()) as i32;
    let bind_cap: i32 = (RAYOS_MAX_BINDINGS()) as i32;
    let wl_count: i32 = (RAYOS_WAVELENGTH_SLOT_COUNT()) as i32;
    let routes_raw: *i8 = _zag_malloc((route_cap * @sizeOf[RouteEntry]()));
    let routes: *RouteEntry = (routes_raw) as *RouteEntry;
    let ri: i32 = 0;
    while ((ri < route_cap)) {
        routes[ri] = route_entry_empty((0 - 1));
        ri = (ri + 1);
    }
    let wl_raw: *i8 = _zag_malloc((wl_count * @sizeOf[WavelengthSlot]()));
    let wl: *WavelengthSlot = (wl_raw) as *WavelengthSlot;
    let wi: i32 = 0;
    while ((wi < wl_count)) {
        let ch_id: i32 = wl_slot_chamber(wi);
        let ch_ch: i32 = wl_slot_channel(wi);
        wl[wi] = WavelengthSlot{ .chamber_id = ch_id, .channel_id = ch_ch, .occupied = 0, .route_id = (0 - 1), .binding_id = (0 - 1), .freq_ghz = wdm_channel_freq_ghz(ch_ch) };
        wi = (wi + 1);
    }
    let bind_raw: *i8 = _zag_malloc((bind_cap * @sizeOf[ApplicationBinding]()));
    let bindings: *ApplicationBinding = (bind_raw) as *ApplicationBinding;
    let bi: i32 = 0;
    while ((bi < bind_cap)) {
        bindings[bi] = binding_empty((0 - 1));
        bi = (bi + 1);
    }
    return RoutingTable{ .routes = routes, .route_count = 0, .route_capacity = route_cap, .wavelength_slots = wl, .wl_slot_count = wl_count, .bindings = bindings, .binding_count = 0, .binding_capacity = bind_cap, .next_route_id = 1, .next_binding_id = 1 };
}

fn routing_table_free(rt: *RoutingTable) void {
    if ((rt.*.routes != null)) {
        _zag_free((rt.*.routes) as *i8);
    }
    if ((rt.*.wavelength_slots != null)) {
        _zag_free((rt.*.wavelength_slots) as *i8);
    }
    if ((rt.*.bindings != null)) {
        _zag_free((rt.*.bindings) as *i8);
    }
    rt.*.routes = (null) as *RouteEntry;
    rt.*.wavelength_slots = (null) as *WavelengthSlot;
    rt.*.bindings = (null) as *ApplicationBinding;
    rt.*.route_count = 0;
    rt.*.binding_count = 0;
}

fn rt_wavelength_get(rt: RoutingTable, chamber_id: i32, channel_id: i32) ?WavelengthSlot {
    if (((chamber_id_valid(chamber_id) == 0) || (wdm_channel_valid(channel_id) == 0))) {
        return null;
    }
    let idx: i32 = wl_slot_index(chamber_id, channel_id);
    if (((idx < 0) || (idx >= rt.wl_slot_count))) {
        return null;
    }
    return rt.wavelength_slots[idx];
}

fn rt_allocate_wavelength(rt: *RoutingTable, chamber_id: i32, channel_id: i32, route_id: i32) i32 {
    if (((chamber_id_valid(chamber_id) == 0) || (wdm_channel_valid(channel_id) == 0))) {
        return 0;
    }
    let idx: i32 = wl_slot_index(chamber_id, channel_id);
    if (((idx < 0) || (idx >= rt.*.wl_slot_count))) {
        return 0;
    }
    if ((rt.*.wavelength_slots[idx].occupied == 1)) {
        return 0;
    }
    rt.*.wavelength_slots[idx].occupied = 1;
    rt.*.wavelength_slots[idx].route_id = route_id;
    return 1;
}

fn rt_deallocate_wavelength(rt: *RoutingTable, chamber_id: i32, channel_id: i32) i32 {
    if (((chamber_id_valid(chamber_id) == 0) || (wdm_channel_valid(channel_id) == 0))) {
        return 0;
    }
    let idx: i32 = wl_slot_index(chamber_id, channel_id);
    if (((idx < 0) || (idx >= rt.*.wl_slot_count))) {
        return 0;
    }
    if ((rt.*.wavelength_slots[idx].occupied == 0)) {
        return 0;
    }
    rt.*.wavelength_slots[idx].occupied = 0;
    rt.*.wavelength_slots[idx].route_id = (0 - 1);
    rt.*.wavelength_slots[idx].binding_id = (0 - 1);
    return 1;
}

fn rt_find_free_wavelength(rt: RoutingTable, chamber_id: i32) i32 {
    if ((chamber_id_valid(chamber_id) == 0)) {
        return (0 - 1);
    }
    let ch: i32 = 0;
    while ((ch < (RAYOS_WDM_CHANNELS()) as i32)) {
        let idx: i32 = wl_slot_index(chamber_id, ch);
        if ((rt.wavelength_slots[idx].occupied == 0)) {
            return ch;
        }
        ch = (ch + 1);
    }
    return (0 - 1);
}

fn rt_find_free_route_slot(rt: RoutingTable) i32 {
    let i: i32 = 0;
    while ((i < rt.route_capacity)) {
        if ((rt.routes[i].active == 0)) {
            return i;
        }
        i = (i + 1);
    }
    return (0 - 1);
}

fn rt_path_from_slot(path_slot: i32, src_chamber: i32, dst_chamber: i32, channel_id: i32, loss_db_x10: i32, latched: i32) WaveguidePath {
    let hops: i32 = wg_manhattan_chambers(src_chamber, dst_chamber);
    return WaveguidePath{ .slot_id = path_slot, .src_chamber = src_chamber, .dst_chamber = dst_chamber, .channel_id = channel_id, .hop_count = hops, .freq_ghz = wdm_channel_freq_ghz(channel_id), .loss_db_x10 = loss_db_x10, .latched = latched };
}

fn rt_allocate_route(rt: *RoutingTable, src_chamber: i32, dst_chamber: i32, channel_id: i32, path_slot: i32, loss_db_x10: i32) i32 {
    if (((chamber_id_valid(src_chamber) == 0) || (chamber_id_valid(dst_chamber) == 0))) {
        return (0 - 1);
    }
    if ((wdm_channel_valid(channel_id) == 0)) {
        return (0 - 1);
    }
    if (((path_slot < 0) || (path_slot >= (RAYOS_WAVEGUIDE_SLOTS()) as i32))) {
        return (0 - 1);
    }
    let slot: i32 = rt_find_free_route_slot(rt.*);
    if ((slot < 0)) {
        return (0 - 1);
    }
    let route_id: i32 = rt.*.next_route_id;
    rt.*.next_route_id = (rt.*.next_route_id + 1);
    if ((rt_allocate_wavelength(rt, src_chamber, channel_id, route_id) == 0)) {
        return (0 - 1);
    }
    let path: WaveguidePath = rt_path_from_slot(path_slot, src_chamber, dst_chamber, channel_id, loss_db_x10, 0);
    rt.*.routes[slot] = RouteEntry{ .route_id = route_id, .path = path, .src_chamber = src_chamber, .dst_chamber = dst_chamber, .channel_id = channel_id, .active = 1, .binding_id = (0 - 1) };
    rt.*.route_count = (rt.*.route_count + 1);
    return route_id;
}

fn rt_deallocate_route(rt: *RoutingTable, route_id: i32) i32 {
    let i: i32 = 0;
    while ((i < rt.*.route_capacity)) {
        if (((rt.*.routes[i].active == 1) && (rt.*.routes[i].route_id == route_id))) {
            rt_deallocate_wavelength(rt, rt.*.routes[i].src_chamber, rt.*.routes[i].channel_id);
            rt.*.routes[i] = route_entry_empty((0 - 1));
            rt.*.route_count = (rt.*.route_count - 1);
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn rt_latch_route(rt: *RoutingTable, route_id: i32) i32 {
    let i: i32 = 0;
    while ((i < rt.*.route_capacity)) {
        if (((rt.*.routes[i].active == 1) && (rt.*.routes[i].route_id == route_id))) {
            rt.*.routes[i].path.latched = 1;
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn rt_lookup_route(rt: RoutingTable, route_id: i32) ?RouteEntry {
    let i: i32 = 0;
    while ((i < rt.route_capacity)) {
        if (((rt.routes[i].active == 1) && (rt.routes[i].route_id == route_id))) {
            return rt.routes[i];
        }
        i = (i + 1);
    }
    return null;
}

fn rt_lookup_route_by_endpoint(rt: RoutingTable, src_chamber: i32, dst_chamber: i32, channel_id: i32) ?RouteEntry {
    let i: i32 = 0;
    while ((i < rt.route_capacity)) {
        let r: RouteEntry = rt.routes[i];
        if (((((r.active == 1) && (r.src_chamber == src_chamber)) && (r.dst_chamber == dst_chamber)) && (r.channel_id == channel_id))) {
            return r;
        }
        i = (i + 1);
    }
    return null;
}

fn rt_lookup_route_by_path_slot(rt: RoutingTable, path_slot: i32) ?RouteEntry {
    let i: i32 = 0;
    while ((i < rt.route_capacity)) {
        if (((rt.routes[i].active == 1) && (rt.routes[i].path.slot_id == path_slot))) {
            return rt.routes[i];
        }
        i = (i + 1);
    }
    return null;
}

fn rt_find_free_binding_slot(rt: RoutingTable) i32 {
    let i: i32 = 0;
    while ((i < rt.binding_capacity)) {
        if ((rt.bindings[i].active == 0)) {
            return i;
        }
        i = (i + 1);
    }
    return (0 - 1);
}

fn rt_bind_application(rt: *RoutingTable, app_id: i32, route_id: i32, chamber_id: i32, channel_id: i32, path_slot: i32) i32 {
    if ((app_id < 0)) {
        return (0 - 1);
    }
    if ((chamber_id_valid(chamber_id) == 0)) {
        return (0 - 1);
    }
    let route_ok: i32 = 0;
    if (rt_lookup_route(rt.*, route_id)) |_| {
        route_ok = 1;
    }
    if ((route_ok == 0)) {
        return (0 - 1);
    }
    let slot: i32 = rt_find_free_binding_slot(rt.*);
    if ((slot < 0)) {
        return (0 - 1);
    }
    let binding_id: i32 = rt.*.next_binding_id;
    rt.*.next_binding_id = (rt.*.next_binding_id + 1);
    rt.*.bindings[slot] = ApplicationBinding{ .binding_id = binding_id, .app_id = app_id, .route_id = route_id, .chamber_id = chamber_id, .channel_id = channel_id, .path_slot = path_slot, .active = 1 };
    rt.*.binding_count = (rt.*.binding_count + 1);
    let ri: i32 = 0;
    let done: i32 = 0;
    while (((ri < rt.*.route_capacity) && (done == 0))) {
        if (((rt.*.routes[ri].active == 1) && (rt.*.routes[ri].route_id == route_id))) {
            rt.*.routes[ri].binding_id = binding_id;
            let wl_idx: i32 = wl_slot_index(chamber_id, channel_id);
            if (((wl_idx >= 0) && (wl_idx < rt.*.wl_slot_count))) {
                rt.*.wavelength_slots[wl_idx].binding_id = binding_id;
            }
            done = 1;
        }
        ri = (ri + 1);
    }
    return binding_id;
}

fn rt_unbind_application(rt: *RoutingTable, binding_id: i32) i32 {
    let i: i32 = 0;
    while ((i < rt.*.binding_capacity)) {
        if (((rt.*.bindings[i].active == 1) && (rt.*.bindings[i].binding_id == binding_id))) {
            let wl_idx: i32 = wl_slot_index(rt.*.bindings[i].chamber_id, rt.*.bindings[i].channel_id);
            if (((wl_idx >= 0) && (wl_idx < rt.*.wl_slot_count))) {
                rt.*.wavelength_slots[wl_idx].binding_id = (0 - 1);
            }
            rt.*.bindings[i] = binding_empty((0 - 1));
            rt.*.binding_count = (rt.*.binding_count - 1);
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn rt_lookup_binding(rt: RoutingTable, binding_id: i32) ?ApplicationBinding {
    let i: i32 = 0;
    while ((i < rt.binding_capacity)) {
        if (((rt.bindings[i].active == 1) && (rt.bindings[i].binding_id == binding_id))) {
            return rt.bindings[i];
        }
        i = (i + 1);
    }
    return null;
}

fn rt_lookup_binding_by_app(rt: RoutingTable, app_id: i32) ?ApplicationBinding {
    let i: i32 = 0;
    while ((i < rt.binding_capacity)) {
        if (((rt.bindings[i].active == 1) && (rt.bindings[i].app_id == app_id))) {
            return rt.bindings[i];
        }
        i = (i + 1);
    }
    return null;
}

fn routing_table_summary(rt: RoutingTable) RoutingSummary {
    let wl_used: i32 = 0;
    let wi: i32 = 0;
    while ((wi < rt.wl_slot_count)) {
        if ((rt.wavelength_slots[wi].occupied == 1)) {
            wl_used = (wl_used + 1);
        }
        wi = (wi + 1);
    }
    return RoutingSummary{ .routes_active = rt.route_count, .wavelengths_used = wl_used, .bindings_active = rt.binding_count };
}

struct SwitchboardCrosspoint {
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
    path_slot: i32,
    latched: i32,
}

struct ResolvedRoute {
    route_id: i32,
    binding_id: i32,
    path_slot: i32,
    src_chamber: i32,
    dst_chamber: i32,
    channel_id: i32,
    freq_ghz: i32,
    hop_count: i32,
    loss_db_x10: i32,
    flowing: i32,
}

struct FabricSummary {
    chambers: i32,
    wdm_channels: i32,
    waveguide_slots: i32,
    paths_allocated: i32,
    paths_flowing: i32,
    routes_active: i32,
    bindings_active: i32,
}

struct SpatialRoutingFabric {
    waveguides: WaveguidePool,
    routing: RoutingTable,
    crosspoints: *SwitchboardCrosspoint,
    cross_count: i32,
    cross_capacity: i32,
}

fn fabric_new() SpatialRoutingFabric {
    let cross_cap: i32 = (RAYOS_WAVEGUIDE_SLOTS()) as i32;
    let raw: *i8 = _zag_malloc((cross_cap * @sizeOf[SwitchboardCrosspoint]()));
    let xs: *SwitchboardCrosspoint = (raw) as *SwitchboardCrosspoint;
    let i: i32 = 0;
    while ((i < cross_cap)) {
        xs[i] = SwitchboardCrosspoint{ .src_chamber = (0 - 1), .dst_chamber = (0 - 1), .channel_id = (0 - 1), .path_slot = (0 - 1), .latched = 0 };
        i = (i + 1);
    }
    return SpatialRoutingFabric{ .waveguides = wg_pool_new(), .routing = routing_table_new(), .crosspoints = xs, .cross_count = 0, .cross_capacity = cross_cap };
}

fn fabric_free(f: *SpatialRoutingFabric) void {
    wg_pool_free(&f.*.waveguides);
    routing_table_free(&f.*.routing);
    if ((f.*.crosspoints != null)) {
        _zag_free((f.*.crosspoints) as *i8);
    }
    f.*.crosspoints = (null) as *SwitchboardCrosspoint;
    f.*.cross_count = 0;
}

fn fabric_find_crosspoint(f: SpatialRoutingFabric, path_slot: i32) i32 {
    let i: i32 = 0;
    while ((i < f.cross_count)) {
        if ((f.crosspoints[i].path_slot == path_slot)) {
            return i;
        }
        i = (i + 1);
    }
    return (0 - 1);
}

fn fabric_latch_crosspoint(f: *SpatialRoutingFabric, src_chamber: i32, dst_chamber: i32, channel_id: i32, path_slot: i32) i32 {
    if ((f.*.cross_count >= f.*.cross_capacity)) {
        return 0;
    }
    let idx: i32 = f.*.cross_count;
    f.*.crosspoints[idx] = SwitchboardCrosspoint{ .src_chamber = src_chamber, .dst_chamber = dst_chamber, .channel_id = channel_id, .path_slot = path_slot, .latched = 1 };
    f.*.cross_count = (f.*.cross_count + 1);
    return 1;
}

fn fabric_unlatch_crosspoint(f: *SpatialRoutingFabric, path_slot: i32) i32 {
    let i: i32 = 0;
    while ((i < f.*.cross_count)) {
        if ((f.*.crosspoints[i].path_slot == path_slot)) {
            let last: i32 = (f.*.cross_count - 1);
            if ((i < last)) {
                f.*.crosspoints[i] = f.*.crosspoints[last];
            }
            f.*.crosspoints[last] = SwitchboardCrosspoint{ .src_chamber = (0 - 1), .dst_chamber = (0 - 1), .channel_id = (0 - 1), .path_slot = (0 - 1), .latched = 0 };
            f.*.cross_count = (f.*.cross_count - 1);
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn fabric_crosspoint_flowing(f: SpatialRoutingFabric, path_slot: i32) i32 {
    let idx: i32 = fabric_find_crosspoint(f, path_slot);
    if ((idx < 0)) {
        return 0;
    }
    return f.crosspoints[idx].latched;
}

fn fabric_bind_application(f: *SpatialRoutingFabric, app_id: i32, src_chamber: i32, dst_chamber: i32, channel_id: i32) i32 {
    if ((app_id < 0)) {
        return (0 - 1);
    }
    if (((chamber_id_valid(src_chamber) == 0) || (chamber_id_valid(dst_chamber) == 0))) {
        return (0 - 1);
    }
    let ch: i32 = channel_id;
    if ((wdm_channel_valid(ch) == 0)) {
        ch = rt_find_free_wavelength(f.*.routing, src_chamber);
        if ((ch < 0)) {
            return (0 - 1);
        }
    }
    if (rt_lookup_route_by_endpoint(f.*.routing, src_chamber, dst_chamber, ch)) |_| {
        return (0 - 1);
    }
    let alloc: PathAllocationResult = wg_allocate_path(&f.*.waveguides, src_chamber, dst_chamber, ch);
    if ((alloc.slot_id < 0)) {
        return (0 - 1);
    }
    let route_id: i32 = rt_allocate_route(&f.*.routing, src_chamber, dst_chamber, ch, alloc.slot_id, alloc.loss_db_x10);
    if ((route_id < 0)) {
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return (0 - 1);
    }
    let binding_id: i32 = rt_bind_application(&f.*.routing, app_id, route_id, src_chamber, ch, alloc.slot_id);
    if ((binding_id < 0)) {
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return (0 - 1);
    }
    if ((wg_latch_path(&f.*.waveguides, alloc.slot_id) == 0)) {
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return (0 - 1);
    }
    if ((rt_latch_route(&f.*.routing, route_id) == 0)) {
        wg_unlatch_path(&f.*.waveguides, alloc.slot_id);
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return (0 - 1);
    }
    if ((fabric_latch_crosspoint(f, src_chamber, dst_chamber, ch, alloc.slot_id) == 0)) {
        wg_unlatch_path(&f.*.waveguides, alloc.slot_id);
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, alloc.slot_id);
        return (0 - 1);
    }
    return binding_id;
}

fn fabric_release(f: *SpatialRoutingFabric, binding_id: i32) i32 {
    if (rt_lookup_binding(f.*.routing, binding_id)) |bind| {
        let path_slot: i32 = bind.path_slot;
        let route_id: i32 = bind.route_id;
        fabric_unlatch_crosspoint(f, path_slot);
        wg_unlatch_path(&f.*.waveguides, path_slot);
        rt_unbind_application(&f.*.routing, binding_id);
        rt_deallocate_route(&f.*.routing, route_id);
        wg_release_path(&f.*.waveguides, path_slot);
        return 1;
    }
    return 0;
}

fn fabric_release_by_app(f: *SpatialRoutingFabric, app_id: i32) i32 {
    if (rt_lookup_binding_by_app(f.*.routing, app_id)) |bind| {
        return fabric_release(f, bind.binding_id);
    }
    return 0;
}

fn fabric_resolve_route(f: SpatialRoutingFabric, src_chamber: i32, dst_chamber: i32, channel_id: i32) ?ResolvedRoute {
    if (rt_lookup_route_by_endpoint(f.routing, src_chamber, dst_chamber, channel_id)) |entry| {
        let flowing: i32 = 0;
        if (((entry.path.latched == 1) && (wg_path_flowing(f.waveguides, entry.path.slot_id) == 1))) {
            flowing = 1;
        }
        return ResolvedRoute{ .route_id = entry.route_id, .binding_id = entry.binding_id, .path_slot = entry.path.slot_id, .src_chamber = entry.src_chamber, .dst_chamber = entry.dst_chamber, .channel_id = entry.channel_id, .freq_ghz = entry.path.freq_ghz, .hop_count = entry.path.hop_count, .loss_db_x10 = entry.path.loss_db_x10, .flowing = flowing };
    }
    return null;
}

fn fabric_resolve_by_binding(f: SpatialRoutingFabric, binding_id: i32) ?ResolvedRoute {
    if (rt_lookup_binding(f.routing, binding_id)) |bind| {
        if (rt_lookup_route(f.routing, bind.route_id)) |entry| {
            return fabric_resolve_route(f, entry.src_chamber, entry.dst_chamber, entry.channel_id);
        }
    }
    return null;
}

fn fabric_resolve_by_app(f: SpatialRoutingFabric, app_id: i32) ?ResolvedRoute {
    if (rt_lookup_binding_by_app(f.routing, app_id)) |bind| {
        if (rt_lookup_route(f.routing, bind.route_id)) |entry| {
            return fabric_resolve_route(f, entry.src_chamber, entry.dst_chamber, entry.channel_id);
        }
    }
    return null;
}

fn fabric_bind_application_trit(f: *SpatialRoutingFabric, app_id: i32, src_chamber: i32, dst_chamber: i32, base_channel: i32, lane_trit: i8) i32 {
    if ((wg_trit_lane_valid(lane_trit) == 0)) {
        return (0 - 1);
    }
    let ch: i32 = wg_balance_channel_offset(base_channel, lane_trit);
    return fabric_bind_application(f, app_id, src_chamber, dst_chamber, ch);
}

fn fabric_summary(f: SpatialRoutingFabric) FabricSummary {
    let rs: RoutingSummary = routing_table_summary(f.routing);
    return FabricSummary{ .chambers = (RAYOS_CHAMBER_COUNT()) as i32, .wdm_channels = (RAYOS_WDM_CHANNELS()) as i32, .waveguide_slots = (RAYOS_WAVEGUIDE_SLOTS()) as i32, .paths_allocated = f.waveguides.allocated, .paths_flowing = f.waveguides.latched, .routes_active = rs.routes_active, .bindings_active = rs.bindings_active };
}

struct SOHTileCoord {
    x: i32,
    y: i32,
}

struct SOHSlotRef {
    tile: SOHTileCoord,
    slot: i32,
}

struct SOHMatrix {
    tiles_x: i32,
    tiles_y: i32,
    slots_per_tile: i32,
    trits: *i8,
    capacity: i32,
}

fn soh_tile_coord(x: i32, y: i32) SOHTileCoord {
    return SOHTileCoord{ .x = x, .y = y };
}

fn soh_slot_ref(tile_x: i32, tile_y: i32, slot: i32) SOHSlotRef {
    return SOHSlotRef{ .tile = soh_tile_coord(tile_x, tile_y), .slot = slot };
}

fn soh_flat_index(m: SOHMatrix, tile_x: i32, tile_y: i32, slot: i32) i32 {
    if (((tile_x < 0) || (tile_y < 0))) {
        return (0 - 1);
    }
    if (((tile_x >= m.tiles_x) || (tile_y >= m.tiles_y))) {
        return (0 - 1);
    }
    if (((slot < 0) || (slot >= m.slots_per_tile))) {
        return (0 - 2);
    }
    let tile_idx: i32 = ((tile_y * m.tiles_x) + tile_x);
    return ((tile_idx * m.slots_per_tile) + slot);
}

fn soh_new(tiles_x: i32, tiles_y: i32) *SOHMatrix {
    let tx: i32 = tiles_x;
    let ty: i32 = tiles_y;
    if ((tx < 1)) {
        tx = (SOH_DEFAULT_TILES_X()) as i32;
    }
    if ((ty < 1)) {
        ty = (SOH_DEFAULT_TILES_Y()) as i32;
    }
    let spt: i32 = (SOH_SLOTS_PER_TILE()) as i32;
    let cap: i32 = ((tx * ty) * spt);
    let raw: *i8 = _zag_malloc(cap);
    let i: i32 = 0;
    while ((i < cap)) {
        raw[i] = (PHASE_ZERO()) as i8;
        i = (i + 1);
    }
    let heap: *i8 = _zag_malloc(@sizeOf[SOHMatrix]());
    let m: *SOHMatrix = (heap) as *SOHMatrix;
    m.* = SOHMatrix{ .tiles_x = tx, .tiles_y = ty, .slots_per_tile = spt, .trits = raw, .capacity = cap };
    return m;
}

fn soh_free(m: *SOHMatrix) void {
    if ((m.*.trits != (null) as *i8)) {
        _zag_free(m.*.trits);
    }
    m.*.trits = (null) as *i8;
    m.*.capacity = 0;
    _zag_free((m) as *i8);
}

fn soh_write_trit_checked(m: *SOHMatrix, tile_x: i32, tile_y: i32, slot: i32, t: i8) i32 {
    if (((tile_x < 0) || (tile_y < 0))) {
        return 1;
    }
    if (((tile_x >= m.*.tiles_x) || (tile_y >= m.*.tiles_y))) {
        return 1;
    }
    if (((slot < 0) || (slot >= m.*.slots_per_tile))) {
        return 2;
    }
    let tile_idx: i32 = ((tile_y * m.*.tiles_x) + tile_x);
    let idx: i32 = ((tile_idx * m.*.slots_per_tile) + slot);
    m.*.trits[idx] = t;
    return 0;
}

fn soh_read_trit(m: SOHMatrix, tile_x: i32, tile_y: i32, slot: i32) i8 {
    let idx: i32 = soh_flat_index(m, tile_x, tile_y, slot);
    if ((idx < 0)) {
        return (PHASE_ZERO()) as i8;
    }
    return m.trits[idx];
}

fn soh_store_u64_checked(m: *SOHMatrix, base: SOHSlotRef, val: u64) i32 {
    let end_slot: i32 = ((base.slot + (SOH_TRITS_PER_U64()) as i32) - 1);
    if (((base.tile.x < 0) || (base.tile.y < 0))) {
        return 1;
    }
    if (((base.tile.x >= m.*.tiles_x) || (base.tile.y >= m.*.tiles_y))) {
        return 1;
    }
    if (((base.slot < 0) || (end_slot >= m.*.slots_per_tile))) {
        return 2;
    }
    let tile_idx: i32 = ((base.tile.y * m.*.tiles_x) + base.tile.x);
    let base_idx: i32 = ((tile_idx * m.*.slots_per_tile) + base.slot);
    let bit: i32 = 0;
    while ((bit < (SOH_TRITS_PER_U64()) as i32)) {
        let shift: i32 = (63 - bit);
        let shifted: u64 = val;
        let i: i32 = 0;
        while ((i < shift)) {
            shifted = (shifted / 2);
            i = (i + 1);
        }
        let tr: i8 = (PHASE_NEG()) as i8;
        if (((shifted % 2) != 0)) {
            tr = (PHASE_POS()) as i8;
        }
        m.*.trits[(base_idx + bit)] = tr;
        bit = (bit + 1);
    }
    return 0;
}

fn soh_load_u64_checked(m: *SOHMatrix, base: SOHSlotRef) u64 {
    let out: u64 = 0;
    let end_slot: i32 = ((base.slot + (SOH_TRITS_PER_U64()) as i32) - 1);
    if (((base.tile.x < 0) || (base.tile.y < 0))) {
        return 0;
    }
    if (((base.tile.x >= m.*.tiles_x) || (base.tile.y >= m.*.tiles_y))) {
        return 0;
    }
    if (((base.slot < 0) || (end_slot >= m.*.slots_per_tile))) {
        return 0;
    }
    let tile_idx: i32 = ((base.tile.y * m.*.tiles_x) + base.tile.x);
    let base_idx: i32 = ((tile_idx * m.*.slots_per_tile) + base.slot);
    let bit: i32 = 0;
    while ((bit < (SOH_TRITS_PER_U64()) as i32)) {
        let tr: i8 = m.*.trits[(base_idx + bit)];
        let one: u64 = 1;
        let shift: i32 = (63 - bit);
        if ((tr == (PHASE_POS()) as i8)) {
            let i: i32 = 0;
            let acc: u64 = one;
            while ((i < shift)) {
                acc = (acc * 2);
                i = (i + 1);
            }
            out = (out + acc);
        }
        bit = (bit + 1);
    }
    return out;
}

fn TEKUM_MAX_TRITS() i32 {
    return 27;
}

fn TEKUM_MIN_TRITS() i32 {
    return 9;
}

fn TEKUM_DIGIT_CAP() i32 {
    return 27;
}

fn TRIT_NEG() i8 {
    return (0 - 1);
}

fn TRIT_ZERO() i8 {
    return 0;
}

fn TRIT_POS() i8 {
    return 1;
}

struct TekumDigits {
    t00: i8,
    t01: i8,
    t02: i8,
    t03: i8,
    t04: i8,
    t05: i8,
    t06: i8,
    t07: i8,
    t08: i8,
    t09: i8,
    t10: i8,
    t11: i8,
    t12: i8,
    t13: i8,
    t14: i8,
    t15: i8,
    t16: i8,
    t17: i8,
    t18: i8,
    t19: i8,
    t20: i8,
    t21: i8,
    t22: i8,
    t23: i8,
    t24: i8,
    t25: i8,
    t26: i8,
}

struct TekumValue {
    width: i32,
    host: i64,
    digits: TekumDigits,
}

struct TekumRippleResult {
    value: TekumValue,
    final_carry: i8,
}

fn tekum_digits_zero() TekumDigits {
    return TekumDigits{ .t00 = 0, .t01 = 0, .t02 = 0, .t03 = 0, .t04 = 0, .t05 = 0, .t06 = 0, .t07 = 0, .t08 = 0, .t09 = 0, .t10 = 0, .t11 = 0, .t12 = 0, .t13 = 0, .t14 = 0, .t15 = 0, .t16 = 0, .t17 = 0, .t18 = 0, .t19 = 0, .t20 = 0, .t21 = 0, .t22 = 0, .t23 = 0, .t24 = 0, .t25 = 0, .t26 = 0 };
}

fn tekum_trit_wire(d: i8) i8 {
    let u: i32 = (d) as i32;
    if ((u == 255)) {
        return (TRIT_NEG()) as i32;
    }
    if ((u == (TRIT_NEG()) as i32)) {
        return (TRIT_NEG()) as i32;
    }
    if ((u == (TRIT_POS()) as i32)) {
        return (TRIT_POS()) as i32;
    }
    return (TRIT_ZERO()) as i32;
}

fn tekum_digit_get(d: TekumDigits, idx: i32) i8 {
    let raw: i8 = switch (idx) { .0 => d.t00, .1 => d.t01, .2 => d.t02, .3 => d.t03, .4 => d.t04, .5 => d.t05, .6 => d.t06, .7 => d.t07, .8 => d.t08, .9 => d.t09, .10 => d.t10, .11 => d.t11, .12 => d.t12, .13 => d.t13, .14 => d.t14, .15 => d.t15, .16 => d.t16, .17 => d.t17, .18 => d.t18, .19 => d.t19, .20 => d.t20, .21 => d.t21, .22 => d.t22, .23 => d.t23, .24 => d.t24, .25 => d.t25, .26 => d.t26, else => (TRIT_ZERO()) as i32, };
    return tekum_trit_wire(raw);
}

fn tekum_digit_set(d: *TekumDigits, idx: i32, v: i8) void {
    let wire: i8 = tekum_trit_wire(v);
    if ((idx == 0)) {
        d.*.t00 = wire;
        return;
    }
    if ((idx == 1)) {
        d.*.t01 = wire;
        return;
    }
    if ((idx == 2)) {
        d.*.t02 = wire;
        return;
    }
    if ((idx == 3)) {
        d.*.t03 = wire;
        return;
    }
    if ((idx == 4)) {
        d.*.t04 = wire;
        return;
    }
    if ((idx == 5)) {
        d.*.t05 = wire;
        return;
    }
    if ((idx == 6)) {
        d.*.t06 = wire;
        return;
    }
    if ((idx == 7)) {
        d.*.t07 = wire;
        return;
    }
    if ((idx == 8)) {
        d.*.t08 = wire;
        return;
    }
    if ((idx == 9)) {
        d.*.t09 = wire;
        return;
    }
    if ((idx == 10)) {
        d.*.t10 = wire;
        return;
    }
    if ((idx == 11)) {
        d.*.t11 = wire;
        return;
    }
    if ((idx == 12)) {
        d.*.t12 = wire;
        return;
    }
    if ((idx == 13)) {
        d.*.t13 = wire;
        return;
    }
    if ((idx == 14)) {
        d.*.t14 = wire;
        return;
    }
    if ((idx == 15)) {
        d.*.t15 = wire;
        return;
    }
    if ((idx == 16)) {
        d.*.t16 = wire;
        return;
    }
    if ((idx == 17)) {
        d.*.t17 = wire;
        return;
    }
    if ((idx == 18)) {
        d.*.t18 = wire;
        return;
    }
    if ((idx == 19)) {
        d.*.t19 = wire;
        return;
    }
    if ((idx == 20)) {
        d.*.t20 = wire;
        return;
    }
    if ((idx == 21)) {
        d.*.t21 = wire;
        return;
    }
    if ((idx == 22)) {
        d.*.t22 = wire;
        return;
    }
    if ((idx == 23)) {
        d.*.t23 = wire;
        return;
    }
    if ((idx == 24)) {
        d.*.t24 = wire;
        return;
    }
    if ((idx == 25)) {
        d.*.t25 = wire;
        return;
    }
    if ((idx == 26)) {
        d.*.t26 = wire;
        return;
    }
}

fn tekum_copy_digits(src: TekumDigits) TekumDigits {
    let d: TekumDigits = tekum_digits_zero();
    let i: i32 = 0;
    while ((i < (TEKUM_DIGIT_CAP()) as i32)) {
        tekum_digit_set(&d, i, tekum_digit_get(src, i));
        i = (i + 1);
    }
    return d;
}

fn tekum_balance_carry(raw: i32) TritAddResult {
    return balance_sum(raw);
}

fn tekum_abs_i64(v: i64) i64 {
    if ((v < 0)) {
        return (0 - v);
    }
    return v;
}

fn tekum_trit_to_i64(d: i8) i64 {
    let wire: i8 = tekum_trit_wire(d);
    if ((wire == (TRIT_NEG()) as i32)) {
        return (0 - 1);
    }
    if ((wire == (TRIT_POS()) as i32)) {
        return 1;
    }
    return 0;
}

fn tekum_pow3(exp: i32) i64 {
    if ((exp <= 0)) {
        return 1;
    }
    let r: i64 = 1;
    let i: i32 = 0;
    while ((i < exp)) {
        r = (r * 3);
        i = (i + 1);
    }
    return r;
}

fn tekum_balanced_digit(rem: i64) i8 {
    let r: i64 = (rem % 3);
    if ((r < 0)) {
        r = (r + 3);
    }
    if ((r > 1)) {
        return (TRIT_NEG()) as i32;
    }
    if ((r == 1)) {
        return (TRIT_POS()) as i32;
    }
    return (TRIT_ZERO()) as i32;
}

fn tekum_regime_trits(host: i64) i32 {
    let mag: i64 = tekum_abs_i64(host);
    if ((mag < 3)) {
        return 0;
    }
    let regime: i32 = 0;
    let bound: i64 = 3;
    while (((bound <= mag) && (regime < (TEKUM_MAX_TRITS()) as i32))) {
        bound = (bound * 3);
        regime = (regime + 1);
    }
    return regime;
}

fn tekum_taper_width_for_host(host: i64) i32 {
    let regime: i32 = tekum_regime_trits(host);
    let w: i32 = ((TEKUM_MAX_TRITS()) as i32 - regime);
    if ((w < (TEKUM_MIN_TRITS()) as i32)) {
        w = (TEKUM_MIN_TRITS()) as i32;
    }
    if ((w > (TEKUM_MAX_TRITS()) as i32)) {
        w = (TEKUM_MAX_TRITS()) as i32;
    }
    return w;
}

fn tekum_significant_trits(d: TekumDigits, cap: i32) i32 {
    let i: i32 = (cap - 1);
    while ((i >= 0)) {
        if ((tekum_digit_get(d, i) != 0)) {
            return (i + 1);
        }
        i = (i - 1);
    }
    return 1;
}

fn tekum_from_i64(v: i64) TekumValue {
    let rem: i64 = v;
    let digits: TekumDigits = tekum_digits_zero();
    let i: i32 = 0;
    let guard: i32 = 0;
    while ((((rem != 0) || (i == 0)) && (guard < (TEKUM_DIGIT_CAP()) as i32))) {
        let digit: i8 = tekum_balanced_digit(rem);
        tekum_digit_set(&digits, i, digit);
        rem = ((rem - tekum_trit_to_i64(digit)) / 3);
        i = (i + 1);
        guard = (guard + 1);
    }
    let width: i32 = tekum_taper_width_for_host(v);
    let sig: i32 = tekum_significant_trits(digits, i);
    if ((sig > width)) {
        width = sig;
    }
    if ((width > (TEKUM_MAX_TRITS()) as i32)) {
        width = (TEKUM_MAX_TRITS()) as i32;
    }
    return TekumValue{ .width = width, .host = v, .digits = digits };
}

fn tekum_to_i64(v: TekumValue) i64 {
    let acc: i64 = 0;
    let pow: i64 = 1;
    let i: i32 = 0;
    while ((i < v.width)) {
        let d: i8 = tekum_digit_get(v.digits, i);
        acc = (acc + (tekum_trit_to_i64(d) * pow));
        pow = (pow * 3);
        i = (i + 1);
    }
    return acc;
}

fn tekum_zero() TekumValue {
    return tekum_from_i64(0);
}

fn tekum_sync_host(v: *TekumValue) void {
    v.*.host = tekum_to_i64(v.*);
}

fn tekum_taper(v: TekumValue) TekumValue {
    let target: i32 = tekum_taper_width_for_host(v.host);
    let sig: i32 = tekum_significant_trits(v.digits, (TEKUM_DIGIT_CAP()) as i32);
    if ((sig > target)) {
        target = sig;
    }
    if ((target > (TEKUM_MAX_TRITS()) as i32)) {
        target = (TEKUM_MAX_TRITS()) as i32;
    }
    if ((target < (TEKUM_MIN_TRITS()) as i32)) {
        target = (TEKUM_MIN_TRITS()) as i32;
    }
    let trimmed: TekumDigits = tekum_copy_digits(v.digits);
    let i: i32 = target;
    while ((i < (TEKUM_DIGIT_CAP()) as i32)) {
        tekum_digit_set(&trimmed, i, 0);
        i = (i + 1);
    }
    let host0: i64 = tekum_to_i64(TekumValue{ .width = target, .host = v.host, .digits = trimmed });
    let width0: i32 = tekum_taper_width_for_host(host0);
    let sig2: i32 = tekum_significant_trits(trimmed, (TEKUM_DIGIT_CAP()) as i32);
    let width1: i32 = width0;
    if ((sig2 > width1)) {
        width1 = sig2;
    }
    return TekumValue{ .width = width1, .host = host0, .digits = trimmed };
}

fn tekum_add_ripple(a: TekumValue, b: TekumValue, carry_in: i8) TekumRippleResult {
    let n: i32 = a.width;
    if ((b.width > n)) {
        n = b.width;
    }
    if ((n < (TEKUM_MIN_TRITS()) as i32)) {
        n = (TEKUM_MIN_TRITS()) as i32;
    }
    if ((n > (TEKUM_MAX_TRITS()) as i32)) {
        n = (TEKUM_MAX_TRITS()) as i32;
    }
    let digits: TekumDigits = tekum_copy_digits(a.digits);
    let carry: i8 = carry_in;
    let i: i32 = 0;
    while ((i < n)) {
        let da: i8 = 0;
        if ((i < a.width)) {
            da = tekum_digit_get(a.digits, i);
        }
        let db: i8 = 0;
        if ((i < b.width)) {
            db = tekum_digit_get(b.digits, i);
        }
        let step: TritAddResult = add(da, db, carry);
        tekum_digit_set(&digits, i, step.sum);
        carry = step.carry;
        i = (i + 1);
    }
    let out_width: i32 = n;
    if (((carry != 0) && (out_width < (TEKUM_MAX_TRITS()) as i32))) {
        tekum_digit_set(&digits, out_width, carry);
        out_width = (out_width + 1);
    }
    let raw_out: TekumValue = TekumValue{ .width = out_width, .host = 0, .digits = digits };
    let synced: TekumValue = TekumValue{ .width = raw_out.width, .host = tekum_to_i64(raw_out), .digits = tekum_copy_digits(raw_out.digits) };
    let tapered: TekumValue = tekum_taper(synced);
    return TekumRippleResult{ .value = tapered, .final_carry = carry };
}

fn tekum_add(a: TekumValue, b: TekumValue) TekumValue {
    let res: TekumRippleResult = tekum_add_ripple(a, b, 0);
    return res.value;
}

fn tekum_mul_digit(a: TekumValue, trit: i8) TekumValue {
    if ((trit == 0)) {
        return tekum_zero();
    }
    let digits: TekumDigits = tekum_digits_zero();
    let carry: i8 = 0;
    let i: i32 = 0;
    while ((i < a.width)) {
        let da: i8 = tekum_digit_get(a.digits, i);
        let prod: TritMulResult = mul(da, trit);
        let step: TritAddResult = add(prod.product, 0, carry);
        tekum_digit_set(&digits, i, step.sum);
        carry = step.carry;
        i = (i + 1);
    }
    let width: i32 = a.width;
    if (((carry != 0) && (width < (TEKUM_MAX_TRITS()) as i32))) {
        tekum_digit_set(&digits, width, carry);
        width = (width + 1);
    }
    return TekumValue{ .width = width, .host = tekum_to_i64(TekumValue{ .width = width, .host = 0, .digits = digits }), .digits = digits };
}

fn tekum_shift_left(v: TekumValue, places: i32) TekumValue {
    if ((places <= 0)) {
        return v;
    }
    let digits: TekumDigits = tekum_digits_zero();
    let i: i32 = 0;
    while ((i < (TEKUM_DIGIT_CAP()) as i32)) {
        let src: i32 = (i - places);
        if (((src >= 0) && (src < v.width))) {
            tekum_digit_set(&digits, i, tekum_digit_get(v.digits, src));
        }
        i = (i + 1);
    }
    let width: i32 = (v.width + places);
    if ((width > (TEKUM_MAX_TRITS()) as i32)) {
        width = (TEKUM_MAX_TRITS()) as i32;
    }
    return TekumValue{ .width = width, .host = tekum_to_i64(TekumValue{ .width = width, .host = 0, .digits = digits }), .digits = digits };
}

fn tekum_mul(a: TekumValue, b: TekumValue) TekumValue {
    let acc0: TekumValue = tekum_zero();
    let j: i32 = 0;
    let acc_cur: TekumValue = acc0;
    while ((j < b.width)) {
        let tr: i8 = tekum_digit_get(b.digits, j);
        if ((tr != 0)) {
            let partial: TekumValue = tekum_mul_digit(a, tr);
            let shifted: TekumValue = tekum_shift_left(partial, j);
            acc_cur = tekum_add(acc_cur, shifted);
        }
        j = (j + 1);
    }
    let host_prod: i64 = (a.host * b.host);
    let merged: TekumValue = TekumValue{ .width = acc_cur.width, .host = host_prod, .digits = tekum_copy_digits(acc_cur.digits) };
    return tekum_taper(merged);
}

fn FLASH_NANO_VOXELS_EDGE() i32 {
    return 8;
}

fn FLASH_VOXELS_PER_CHAMBER() i32 {
    let e: i32 = (FLASH_NANO_VOXELS_EDGE()) as i64;
    return ((e * e) * e);
}

fn FLASH_SOH_FACE_COUNT() i32 {
    return 4;
}

fn FLASH_DEFAULT_CHANNELS() i32 {
    return 4;
}

fn FLASH_SOH_TILE_TRITS() i32 {
    return (TEKUM_MIN_TRITS()) as i32;
}

fn FLASH_CHAMBER_STRIDE_TRITS() i32 {
    return (FLASH_VOXELS_PER_CHAMBER()) as i32;
}

fn FLASH_CHANNEL_STRIDE_TRITS() i32 {
    return 1;
}

fn FLASH_SOH_FACE_STRIDE_TRITS() i32 {
    return (FLASH_SOH_TILE_TRITS()) as i32;
}

struct FlashChamberAddr {
    x: i32,
    y: i32,
    z: i32,
}

struct FlashOffsetSlot {
    chamber: FlashChamberAddr,
    channel: i32,
    soh_face: i32,
    offset: TekumValue,
}

struct FlashOffsetLoopState {
    base: TekumValue,
    grid_w: i32,
    grid_h: i32,
    grid_d: i32,
    channel_count: i32,
    soh_faces: i32,
    cursor: i32,
    total: i32,
}

fn flash_chamber_linear(w: i32, h: i32, c: FlashChamberAddr) i32 {
    return ((((c.z * w) * h) + (c.y * w)) + c.x);
}

fn flash_chamber_from_linear(w: i32, h: i32, idx: i32) FlashChamberAddr {
    let plane: i32 = (w * h);
    let z: i32 = (idx / plane);
    let rem: i32 = (idx - (z * plane));
    let y: i32 = (rem / w);
    let x: i32 = (rem - (y * w));
    return FlashChamberAddr{ .x = x, .y = y, .z = z };
}

fn flash_offset_compute(base: TekumValue, stride: TekumValue, index: i32) TekumValue {
    let idx_val: TekumValue = tekum_from_i64((index) as i64);
    let product: TekumValue = tekum_mul(stride, idx_val);
    let sum: TekumValue = tekum_add(base, product);
    return tekum_taper(sum);
}

fn flash_offset_compute_i64(base: i64, stride: i64, index: i32) i64 {
    return tekum_to_i64(flash_offset_compute(tekum_from_i64(base), tekum_from_i64(stride), index));
}

fn flash_soh_tile_offset(base: TekumValue, chamber_idx: i32, channel: i32, soh_face: i32) TekumValue {
    let chamber_stride: TekumValue = tekum_from_i64((FLASH_CHAMBER_STRIDE_TRITS()) as i64);
    let channel_stride: TekumValue = tekum_from_i64((FLASH_CHANNEL_STRIDE_TRITS()) as i64);
    let face_stride: TekumValue = tekum_from_i64((FLASH_SOH_FACE_STRIDE_TRITS()) as i64);
    let off0: TekumValue = flash_offset_compute(base, chamber_stride, chamber_idx);
    let off1: TekumValue = flash_offset_compute(off0, channel_stride, channel);
    let off2: TekumValue = flash_offset_compute(off1, face_stride, soh_face);
    return tekum_taper(off2);
}

fn flash_offset_loop_init(base: TekumValue, grid_w: i32, grid_h: i32, grid_d: i32, channel_count: i32, soh_faces: i32) FlashOffsetLoopState {
    let gw: i32 = grid_w;
    let gh: i32 = grid_h;
    let gd: i32 = grid_d;
    if ((gw < 1)) {
        gw = 1;
    }
    if ((gh < 1)) {
        gh = 1;
    }
    if ((gd < 1)) {
        gd = 1;
    }
    let ch: i32 = channel_count;
    if ((ch < 1)) {
        ch = (FLASH_DEFAULT_CHANNELS()) as i32;
    }
    let faces: i32 = soh_faces;
    if ((faces < 1)) {
        faces = (FLASH_SOH_FACE_COUNT()) as i32;
    }
    let chambers: i32 = ((gw * gh) * gd);
    return FlashOffsetLoopState{ .base = base, .grid_w = gw, .grid_h = gh, .grid_d = gd, .channel_count = ch, .soh_faces = faces, .cursor = 0, .total = ((chambers * ch) * faces) };
}

fn flash_offset_loop_step(st: *FlashOffsetLoopState, out: *FlashOffsetSlot) i32 {
    if ((st.*.cursor >= st.*.total)) {
        return 0;
    }
    let slots_per_chamber: i32 = (st.*.channel_count * st.*.soh_faces);
    let chamber_idx: i32 = (st.*.cursor / slots_per_chamber);
    let rem: i32 = (st.*.cursor - (chamber_idx * slots_per_chamber));
    let channel: i32 = (rem / st.*.soh_faces);
    let soh_face: i32 = (rem - (channel * st.*.soh_faces));
    let addr: FlashChamberAddr = flash_chamber_from_linear(st.*.grid_w, st.*.grid_h, chamber_idx);
    let offset: TekumValue = flash_soh_tile_offset(st.*.base, chamber_idx, channel, soh_face);
    out.* = FlashOffsetSlot{ .chamber = addr, .channel = channel, .soh_face = soh_face, .offset = offset };
    st.*.cursor = (st.*.cursor + 1);
    return 1;
}

fn flash_offset_loop(base: TekumValue, grid_w: i32, grid_h: i32, grid_d: i32, channel_count: i32, soh_faces: i32, out_slots: *FlashOffsetSlot, max_out: i32) i32 {
    let st: FlashOffsetLoopState = flash_offset_loop_init(base, grid_w, grid_h, grid_d, channel_count, soh_faces);
    let written: i32 = 0;
    let slot: FlashOffsetSlot = FlashOffsetSlot{ .chamber = FlashChamberAddr{ .x = 0, .y = 0, .z = 0 }, .channel = 0, .soh_face = 0, .offset = tekum_zero() };
    let mut_st: FlashOffsetLoopState = st;
    let done: i32 = 0;
    while (((written < max_out) && (done == 0))) {
        if ((flash_offset_loop_step(&mut_st, &slot) == 0)) {
            done = 1;
        } else {
            out_slots[written] = slot;
            written = (written + 1);
        }
    }
    return written;
}

fn flash_offset_loop_total(grid_w: i32, grid_h: i32, grid_d: i32, channel_count: i32, soh_faces: i32) i32 {
    let st: FlashOffsetLoopState = flash_offset_loop_init(tekum_zero(), grid_w, grid_h, grid_d, channel_count, soh_faces);
    return st.total;
}

enum GuestArch {
    X86_64, ARM64,
}

enum GuestRegId {
    R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12, R13, R14, R15, Flags, Pc,
}

struct GuestRegisterFile {
    gpr: *u64,
    flags: u64,
    pc: u64,
    arch: GuestArch,
}

struct SOHRegisterMap {
    slots: *SOHSlotRef,
    count: i32,
    arch: GuestArch,
}

fn guest_reg_id_to_index(id: GuestRegId) i32 {
    if ((id == GuestRegId.Flags)) {
        return (GUEST_REG_FLAGS()) as i32;
    }
    if ((id == GuestRegId.Pc)) {
        return (GUEST_REG_PC()) as i32;
    }
    return switch (id) { .R0 => 0, .R1 => 1, .R2 => 2, .R3 => 3, .R4 => 4, .R5 => 5, .R6 => 6, .R7 => 7, .R8 => 8, .R9 => 9, .R10 => 10, .R11 => 11, .R12 => 12, .R13 => 13, .R14 => 14, .R15 => 15, .Flags => (GUEST_REG_FLAGS()) as i32, .Pc => (GUEST_REG_PC()) as i32, };
}

fn grf_new(arch: GuestArch) GuestRegisterFile {
    let n: i32 = (GUEST_GPR_COUNT()) as i32;
    let raw: *i8 = _zag_malloc((n * 8));
    let gpr: *u64 = (raw) as *u64;
    let i: i32 = 0;
    while ((i < n)) {
        gpr[i] = 0;
        i = (i + 1);
    }
    return GuestRegisterFile{ .gpr = gpr, .flags = 0, .pc = 0, .arch = arch };
}

fn grf_free(grf: *GuestRegisterFile) void {
    if ((grf.*.gpr != (null) as *u64)) {
        _zag_free((grf.*.gpr) as *i8);
    }
    grf.*.gpr = (null) as *u64;
}

fn grf_get(grf: GuestRegisterFile, id: GuestRegId) u64 {
    let idx: i32 = guest_reg_id_to_index(id);
    if ((idx == (GUEST_REG_FLAGS()) as i32)) {
        return grf.flags;
    }
    if ((idx == (GUEST_REG_PC()) as i32)) {
        return grf.pc;
    }
    return grf.gpr[idx];
}

fn grf_set(grf: *GuestRegisterFile, id: GuestRegId, val: u64) void {
    let idx: i32 = guest_reg_id_to_index(id);
    if ((idx == (GUEST_REG_FLAGS()) as i32)) {
        grf.*.flags = val;
        return;
    }
    if ((idx == (GUEST_REG_PC()) as i32)) {
        grf.*.pc = val;
        return;
    }
    grf.*.gpr[idx] = val;
}

fn soh_map_new(arch: GuestArch) SOHRegisterMap {
    let n: i32 = (GUEST_REG_FILE_LEN()) as i32;
    let raw: *i8 = _zag_malloc((n * @sizeOf[SOHSlotRef]()));
    let slots: *SOHSlotRef = (raw) as *SOHSlotRef;
    let i: i32 = 0;
    while ((i < n)) {
        slots[i] = soh_slot_ref((0 - 1), (0 - 1), (0 - 1));
        i = (i + 1);
    }
    return SOHRegisterMap{ .slots = slots, .count = n, .arch = arch };
}

fn soh_map_free(map: *SOHRegisterMap) void {
    if ((map.*.slots != (null) as *SOHSlotRef)) {
        _zag_free((map.*.slots) as *i8);
    }
    map.*.slots = (null) as *SOHSlotRef;
    map.*.count = 0;
}

fn soh_map_default(arch: GuestArch) SOHRegisterMap {
    let map: SOHRegisterMap = soh_map_new(arch);
    let reg: i32 = 0;
    while ((reg < (GUEST_REG_FILE_LEN()) as i32)) {
        let tile_x: i32 = (reg % 6);
        let tile_y: i32 = (reg / 6);
        map.slots[reg] = soh_slot_ref(tile_x, tile_y, 0);
        reg = (reg + 1);
    }
    return map;
}

fn soh_map_link(map: *SOHRegisterMap, id: GuestRegId, tile_x: i32, tile_y: i32, slot: i32) i32 {
    let idx: i32 = guest_reg_id_to_index(id);
    if (((idx < 0) || (idx >= map.*.count))) {
        return 1;
    }
    map.*.slots[idx] = soh_slot_ref(tile_x, tile_y, slot);
    return 0;
}

fn soh_map_slot_unchecked(map: SOHRegisterMap, id: GuestRegId) SOHSlotRef {
    let idx: i32 = guest_reg_id_to_index(id);
    return map.slots[idx];
}

fn soh_map_flush_guest(map: SOHRegisterMap, grf: GuestRegisterFile, matrix: *SOHMatrix) i32 {
    if ((map.arch != grf.arch)) {
        return 3;
    }
    let reg: i32 = 0;
    while ((reg < (GUEST_REG_FILE_LEN()) as i32)) {
        let base: SOHSlotRef = map.slots[reg];
        let val: u64 = 0;
        if ((reg == (GUEST_REG_FLAGS()) as i32)) {
            val = grf.flags;
        } else if ((reg == (GUEST_REG_PC()) as i32)) {
            val = grf.pc;
        } else {
            val = grf.gpr[reg];
        }
        let st: i32 = soh_store_u64_checked(matrix, base, val);
        if ((st == 1)) {
            return 1;
        }
        if ((st == 2)) {
            return 2;
        }
        reg = (reg + 1);
    }
    return 0;
}

fn soh_map_capture_guest(map: SOHRegisterMap, grf: *GuestRegisterFile, matrix: *SOHMatrix) i32 {
    if ((map.arch != grf.*.arch)) {
        return 3;
    }
    let reg: i32 = 0;
    while ((reg < (GUEST_REG_FILE_LEN()) as i32)) {
        let base: SOHSlotRef = map.slots[reg];
        let val: u64 = soh_load_u64_checked(matrix, base);
        if ((reg == (GUEST_REG_FLAGS()) as i32)) {
            grf.*.flags = val;
        } else if ((reg == (GUEST_REG_PC()) as i32)) {
            grf.*.pc = val;
        } else {
            grf.*.gpr[reg] = val;
        }
        reg = (reg + 1);
    }
    return 0;
}

enum InsnClass {
    Unknown, Nop, Mov, Add, Sub, Jmp, Call, Ret, Load, Store, Sys, Push, Pop, Xor, Hlt,
}

struct DecodedInsn {
    arch: GuestArch,
    pc: u64,
    len: i32,
    klass: InsnClass,
    opcode: u8,
    modrm: u8,
    imm: u32,
    raw: *u8,
    raw_len: i32,
}

fn x86_mod_field(modrm: u8) u8 {
    return (modrm / 64);
}

fn x86_reg_field(modrm: u8) u8 {
    return ((modrm / 8) % 8);
}

fn x86_rm_field(modrm: u8) u8 {
    return (modrm % 8);
}

fn x86_is_segment_prefix(b: u8) i32 {
    if (((((((b == 38) || (b == 46)) || (b == 54)) || (b == 62)) || (b == 100)) || (b == 101))) {
        return 1;
    }
    return 0;
}

fn x86_is_rex_prefix(b: u8) i32 {
    if ((b >= 64)) {
        if ((b <= 79)) {
            return 1;
        }
    }
    return 0;
}

fn x86_is_legacy_prefix(b: u8) i32 {
    if (((b == 102) || (b == 103))) {
        return 1;
    }
    if ((b >= 240)) {
        if ((b <= 243)) {
            return 1;
        }
    }
    if ((x86_is_segment_prefix(b) == 1)) {
        return 1;
    }
    if ((x86_is_rex_prefix(b) == 1)) {
        return 1;
    }
    return 0;
}

fn x86_apply_prefix(b: u8, op_sz_16: *i32, addr_sz_32: *i32, rex_w: *i32) void {
    if ((b == 102)) {
        op_sz_16.* = 1;
        return;
    }
    if ((b == 103)) {
        addr_sz_32.* = 1;
        return;
    }
    if ((x86_is_rex_prefix(b) == 1)) {
        if ((((b / 8) % 2) == 1)) {
            rex_w.* = 1;
        }
    }
}

fn x86_skip_prefixes(bytes: []u8, pos: *i32, op_sz_16: *i32, addr_sz_32: *i32, rex_w: *i32) i32 {
    pos.* = 0;
    op_sz_16.* = 0;
    addr_sz_32.* = 0;
    rex_w.* = 0;
    let done: i32 = 0;
    while (((pos.* < bytes.len) && (done == 0))) {
        let b: u8 = bytes[pos.*];
        if ((x86_is_legacy_prefix(b) == 1)) {
            x86_apply_prefix(b, op_sz_16, addr_sz_32, rex_w);
            pos.* = (pos.* + 1);
        } else {
            done = 1;
        }
    }
    if ((pos.* >= bytes.len)) {
        return (0 - 2);
    }
    return 0;
}

fn x86_modrm_tail_len(bytes: []u8, pos: i32, modrm: u8, addr_sz_32: i32) i32 {
    let mod: u8 = x86_mod_field(modrm);
    let rm: u8 = x86_rm_field(modrm);
    let tail: i32 = 0;
    let cursor: i32 = pos;
    if (((mod != 3) && (rm == 4))) {
        if ((cursor >= bytes.len)) {
            return (0 - 2);
        }
        let sib: u8 = bytes[cursor];
        cursor = (cursor + 1);
        tail = (tail + 1);
        let base: u8 = (sib % 8);
        if (((mod == 0) && (base == 5))) {
            if (((cursor + 4) > bytes.len)) {
                return (0 - 2);
            }
            return (tail + 4);
        }
        rm = base;
    }
    if (((mod == 0) && (rm == 5))) {
        if (((cursor + 4) > bytes.len)) {
            return (0 - 2);
        }
        return (tail + 4);
    }
    if ((mod == 1)) {
        if (((cursor + 1) > bytes.len)) {
            return (0 - 2);
        }
        return (tail + 1);
    }
    if ((mod == 2)) {
        if ((addr_sz_32 == 1)) {
            if (((cursor + 4) > bytes.len)) {
                return (0 - 2);
            }
            return (tail + 4);
        }
        if (((cursor + 4) > bytes.len)) {
            return (0 - 2);
        }
        return (tail + 4);
    }
    return tail;
}

fn x86_read_u32_le(bytes: []u8, pos: i32) u32 {
    return ((((bytes[pos]) as u32 + ((bytes[(pos + 1)]) as u32 * 256)) + ((bytes[(pos + 2)]) as u32 * 65536)) + ((bytes[(pos + 3)]) as u32 * 16777216));
}

fn x86_grp1_imm_len(op_sz_16: i32) i32 {
    if ((op_sz_16 == 1)) {
        return 2;
    }
    return 4;
}

fn x86_decode_insn(pc: u64, bytes: []u8) DecodedInsn {
    let dec: DecodedInsn = DecodedInsn{ .arch = GuestArch.X86_64, .pc = pc, .len = 0, .klass = InsnClass.Unknown, .opcode = 0, .modrm = 0, .imm = 0, .raw = (null) as *u8, .raw_len = 0 };
    if ((bytes.len == 0)) {
        return dec;
    }
    let start: i32 = 0;
    let pos: i32 = 0;
    let op_sz_16: i32 = 0;
    let addr_sz_32: i32 = 0;
    let rex_w: i32 = 0;
    let pf: i32 = x86_skip_prefixes(bytes, &pos, &op_sz_16, &addr_sz_32, &rex_w);
    if ((pf != 0)) {
        return dec;
    }
    let op: u8 = bytes[pos];
    dec.opcode = op;
    pos = (pos + 1);
    if ((op == 144)) {
        dec.klass = InsnClass.Nop;
        dec.len = (pos - start);
        return dec;
    }
    if ((op == 195)) {
        dec.klass = InsnClass.Ret;
        dec.len = (pos - start);
        return dec;
    }
    if ((op == 194)) {
        if (((pos + 2) > bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Ret;
        dec.imm = ((bytes[pos]) as u32 + ((bytes[(pos + 1)]) as u32 * 256));
        dec.len = ((pos + 2) - start);
        return dec;
    }
    if ((op == 235)) {
        if (((pos + 1) > bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Jmp;
        dec.imm = (bytes[pos]) as u32;
        dec.len = ((pos + 1) - start);
        return dec;
    }
    if ((op == 233)) {
        if (((pos + 4) > bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Jmp;
        dec.imm = x86_read_u32_le(bytes, pos);
        dec.len = ((pos + 4) - start);
        return dec;
    }
    if ((op == 232)) {
        if (((pos + 4) > bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Call;
        dec.imm = x86_read_u32_le(bytes, pos);
        dec.len = ((pos + 4) - start);
        return dec;
    }
    if ((op == 205)) {
        if (((pos + 1) > bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Sys;
        dec.imm = (bytes[pos]) as u32;
        dec.len = ((pos + 1) - start);
        return dec;
    }
    if (((op >= 80) && (op <= 87))) {
        dec.klass = InsnClass.Push;
        dec.len = (pos - start);
        return dec;
    }
    if (((op >= 88) && (op <= 95))) {
        dec.klass = InsnClass.Pop;
        dec.len = (pos - start);
        return dec;
    }
    if ((op == 244)) {
        dec.klass = InsnClass.Hlt;
        dec.len = (pos - start);
        return dec;
    }
    if ((op == 104)) {
        if (((pos + 4) > bytes.len)) {
            return dec;
        }
        dec.imm = x86_read_u32_le(bytes, pos);
        dec.len = ((pos + 4) - start);
        return dec;
    }
    if ((op == 106)) {
        if (((pos + 1) > bytes.len)) {
            return dec;
        }
        dec.imm = (bytes[pos]) as u32;
        dec.len = ((pos + 1) - start);
        return dec;
    }
    if (((op >= 136) && (op <= 139))) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Mov;
        dec.modrm = bytes[pos];
        let tail: i32 = x86_modrm_tail_len(bytes, (pos + 1), dec.modrm, addr_sz_32);
        if ((tail < 0)) {
            return dec;
        }
        dec.len = (((pos + 1) + tail) - start);
        return dec;
    }
    if (((op == 49) || (op == 51))) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Xor;
        dec.modrm = bytes[pos];
        let tail: i32 = x86_modrm_tail_len(bytes, (pos + 1), dec.modrm, addr_sz_32);
        if ((tail < 0)) {
            return dec;
        }
        dec.len = (((pos + 1) + tail) - start);
        return dec;
    }
    if (((op == 1) || (op == 3))) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Add;
        dec.modrm = bytes[pos];
        let tail: i32 = x86_modrm_tail_len(bytes, (pos + 1), dec.modrm, addr_sz_32);
        if ((tail < 0)) {
            return dec;
        }
        dec.len = (((pos + 1) + tail) - start);
        return dec;
    }
    if ((op == 129)) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        dec.modrm = bytes[pos];
        if ((x86_reg_field(dec.modrm) == 0)) {
            dec.klass = InsnClass.Add;
        }
        let tail: i32 = x86_modrm_tail_len(bytes, (pos + 1), dec.modrm, addr_sz_32);
        if ((tail < 0)) {
            return dec;
        }
        let imm_len: i32 = x86_grp1_imm_len(op_sz_16);
        if (((((pos + 1) + tail) + imm_len) > bytes.len)) {
            return dec;
        }
        if ((imm_len == 2)) {
            dec.imm = ((bytes[((pos + 1) + tail)]) as u32 + ((bytes[((pos + 2) + tail)]) as u32 * 256));
        } else {
            dec.imm = x86_read_u32_le(bytes, ((pos + 1) + tail));
        }
        dec.len = ((((pos + 1) + tail) + imm_len) - start);
        return dec;
    }
    if ((op == 131)) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        dec.modrm = bytes[pos];
        if ((x86_reg_field(dec.modrm) == 0)) {
            dec.klass = InsnClass.Add;
        }
        if ((x86_reg_field(dec.modrm) == 5)) {
            dec.klass = InsnClass.Sub;
        }
        let tail: i32 = x86_modrm_tail_len(bytes, (pos + 1), dec.modrm, addr_sz_32);
        if ((tail < 0)) {
            return dec;
        }
        if (((((pos + 1) + tail) + 1) > bytes.len)) {
            return dec;
        }
        dec.imm = (bytes[((pos + 1) + tail)]) as u32;
        dec.len = ((((pos + 1) + tail) + 1) - start);
        return dec;
    }
    if ((op == 199)) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        dec.modrm = bytes[pos];
        if ((x86_reg_field(dec.modrm) == 0)) {
            dec.klass = InsnClass.Mov;
        }
        let tail: i32 = x86_modrm_tail_len(bytes, (pos + 1), dec.modrm, addr_sz_32);
        if ((tail < 0)) {
            return dec;
        }
        let imm_len: i32 = x86_grp1_imm_len(op_sz_16);
        if (((((pos + 1) + tail) + imm_len) > bytes.len)) {
            return dec;
        }
        if ((imm_len == 2)) {
            dec.imm = ((bytes[((pos + 1) + tail)]) as u32 + ((bytes[((pos + 2) + tail)]) as u32 * 256));
        } else {
            dec.imm = x86_read_u32_le(bytes, ((pos + 1) + tail));
        }
        dec.len = ((((pos + 1) + tail) + imm_len) - start);
        return dec;
    }
    if (((op >= 184) && (op <= 191))) {
        if (((pos + 4) > bytes.len)) {
            return dec;
        }
        dec.klass = InsnClass.Mov;
        dec.modrm = ((op - 184)) as u8;
        dec.imm = x86_read_u32_le(bytes, pos);
        dec.len = ((pos + 4) - start);
        return dec;
    }
    if ((op == 15)) {
        if ((pos >= bytes.len)) {
            return dec;
        }
        let op2: u8 = bytes[pos];
        dec.imm = (op2) as u32;
        dec.opcode = 15;
        if ((op2 == 162)) {
            dec.klass = InsnClass.Sys;
            dec.len = ((pos + 1) - start);
            return dec;
        }
        if ((op2 == 49)) {
            dec.klass = InsnClass.Sys;
            dec.len = ((pos + 1) - start);
            return dec;
        }
        dec.len = ((pos + 1) - start);
        return dec;
    }
    dec.len = (pos - start);
    return dec;
}

struct PhaseBuffer {
    trits: *i8,
    len: i32,
    cap: i32,
}

struct TranslatedBlock {
    start_pc: u64,
    insn_count: i32,
    phase_len: i32,
    phases: PhaseBuffer,
    total_insn_bytes: i32,
}

fn phase_buf_new() PhaseBuffer {
    let cap: i32 = (JIT_PHASE_BUF_LEN()) as i32;
    let raw: *i8 = _zag_malloc(cap);
    let i: i32 = 0;
    while ((i < cap)) {
        raw[i] = (PHASE_ZERO()) as i8;
        i = (i + 1);
    }
    return PhaseBuffer{ .trits = raw, .len = 0, .cap = cap };
}

fn phase_buf_free(buf: *PhaseBuffer) void {
    if ((buf.*.trits != (null) as *i8)) {
        _zag_free(buf.*.trits);
    }
    buf.*.trits = (null) as *i8;
    buf.*.len = 0;
    buf.*.cap = 0;
}

fn decoded_insn_free(dec: *DecodedInsn) void {
    if ((dec.*.raw != (null) as *u8)) {
        _zag_free(dec.*.raw);
    }
    dec.*.raw = (null) as *u8;
    dec.*.raw_len = 0;
}

fn bit_to_phase(bit: u8) i8 {
    if (((bit % 2) != 0)) {
        return (PHASE_POS()) as i8;
    }
    return (PHASE_NEG()) as i8;
}

fn phase_neutral() i8 {
    return (PHASE_ZERO()) as i8;
}

fn byte_to_phases(byte: u8, out: *PhaseBuffer) void {
    let bit: i32 = 7;
    while ((bit >= 0)) {
        let shift: i32 = bit;
        let shifted: u8 = byte;
        let i: i32 = 0;
        while ((i < shift)) {
            shifted = (shifted / 2);
            i = (i + 1);
        }
        if ((out.*.len < out.*.cap)) {
            out.*.trits[out.*.len] = bit_to_phase(shifted);
            out.*.len = (out.*.len + 1);
        }
        bit = (bit - 1);
    }
}

fn bytes_to_phases(bytes: []u8) PhaseBuffer {
    let buf: PhaseBuffer = phase_buf_new();
    let i: i32 = 0;
    while ((i < bytes.len)) {
        byte_to_phases(bytes[i], &buf);
        if ((((i + 1) < bytes.len) && (buf.len < buf.cap))) {
            buf.trits[buf.len] = phase_neutral();
            buf.len = (buf.len + 1);
        }
        i = (i + 1);
    }
    return buf;
}

fn phase_buf_push(buf: *PhaseBuffer, t: i8) void {
    if ((buf.*.len < buf.*.cap)) {
        buf.*.trits[buf.*.len] = t;
        buf.*.len = (buf.*.len + 1);
    }
}

fn phase_buf_append(dst: *PhaseBuffer, src: PhaseBuffer) void {
    let i: i32 = 0;
    while ((i < src.len)) {
        phase_buf_push(dst, src.trits[i]);
        i = (i + 1);
    }
}

fn phase_combine(a: i8, b: i8) i8 {
    let r: TritAddResult = add(a, b, (PHASE_ZERO()) as i8);
    return r.sum;
}

fn phase_reduce(buf: PhaseBuffer) i8 {
    let acc: i8 = phase_neutral();
    let i: i32 = 0;
    while ((i < buf.len)) {
        acc = phase_combine(acc, buf.trits[i]);
        i = (i + 1);
    }
    return acc;
}

fn decode_copy_raw(out: *DecodedInsn, bytes: []u8) void {
    let n: i32 = bytes.len;
    if ((n > (INSN_MAX_BYTES()) as i32)) {
        n = (INSN_MAX_BYTES()) as i32;
    }
    if ((out.*.raw != (null) as *u8)) {
        _zag_free(out.*.raw);
    }
    out.*.raw = _zag_malloc(n);
    let i: i32 = 0;
    while ((i < n)) {
        out.*.raw[i] = bytes[i];
        i = (i + 1);
    }
    out.*.raw_len = n;
}

fn decode_x86_64(pc: u64, bytes: []u8, out: *DecodedInsn) i32 {
    if ((bytes.len == 0)) {
        return (0 - 1);
    }
    let dec: DecodedInsn = x86_decode_insn(pc, bytes);
    if ((dec.len == 0)) {
        return (0 - 2);
    }
    if ((dec.len > bytes.len)) {
        return (0 - 2);
    }
    out.*.arch = dec.arch;
    out.*.pc = dec.pc;
    out.*.len = dec.len;
    out.*.klass = dec.klass;
    out.*.opcode = dec.opcode;
    out.*.modrm = dec.modrm;
    out.*.imm = dec.imm;
    decode_copy_raw(out, bytes[0..dec.len]);
    return 0;
}

fn decode_arm64(pc: u64, bytes: []u8, out: *DecodedInsn) i32 {
    if ((bytes.len < 4)) {
        return (0 - 2);
    }
    let word: u32 = 0;
    word = ((((bytes[0]) as u32 + ((bytes[1]) as u32 * 256)) + ((bytes[2]) as u32 * 65536)) + ((bytes[3]) as u32 * 16777216));
    out.*.arch = GuestArch.ARM64;
    out.*.pc = pc;
    out.*.len = 4;
    out.*.klass = InsnClass.Unknown;
    out.*.opcode = ((word % 256)) as u8;
    out.*.modrm = 0;
    out.*.imm = 0;
    decode_copy_raw(out, bytes[0..4]);
    let hi: u32 = (word / 67108864);
    if ((hi == 210)) {
        out.*.klass = InsnClass.Sys;
    }
    if ((out.*.klass == InsnClass.Unknown)) {
        let op_hi: u32 = (word / 2097152);
        if ((op_hi == 512)) {
            out.*.klass = InsnClass.Add;
        } else if ((op_hi == 584)) {
            out.*.klass = InsnClass.Sub;
        } else if ((op_hi == 360)) {
            out.*.klass = InsnClass.Load;
        } else if ((op_hi == 688)) {
            out.*.klass = InsnClass.Store;
        }
    }
    return 0;
}

fn decode_insn_stub_x86(pc: u64, bytes: []u8, out: *DecodedInsn) i32 {
    return decode_x86_64(pc, bytes, out);
}

fn decode_insn_stub_arm(pc: u64, bytes: []u8, out: *DecodedInsn) i32 {
    return decode_arm64(pc, bytes, out);
}

fn klass_tag_phase(klass: InsnClass) i8 {
    if ((klass == InsnClass.Nop)) {
        return (PHASE_ZERO()) as i8;
    }
    if ((klass == InsnClass.Mov)) {
        return (PHASE_POS()) as i8;
    }
    if ((klass == InsnClass.Add)) {
        return (PHASE_POS()) as i8;
    }
    if ((klass == InsnClass.Sub)) {
        return (PHASE_NEG()) as i8;
    }
    if ((klass == InsnClass.Jmp)) {
        return (PHASE_ZERO()) as i8;
    }
    if ((klass == InsnClass.Call)) {
        return (PHASE_POS()) as i8;
    }
    if ((klass == InsnClass.Ret)) {
        return (PHASE_NEG()) as i8;
    }
    if ((klass == InsnClass.Load)) {
        return (PHASE_POS()) as i8;
    }
    if ((klass == InsnClass.Store)) {
        return (PHASE_NEG()) as i8;
    }
    if ((klass == InsnClass.Push)) {
        return (PHASE_NEG()) as i8;
    }
    if ((klass == InsnClass.Pop)) {
        return (PHASE_POS()) as i8;
    }
    if ((klass == InsnClass.Xor)) {
        return (PHASE_ZERO()) as i8;
    }
    if ((klass == InsnClass.Hlt)) {
        return (PHASE_ZERO()) as i8;
    }
    return phase_neutral();
}

fn insn_to_phases(dec: DecodedInsn) PhaseBuffer {
    let raw_slice: []u8 = dec.raw[0..dec.raw_len];
    let body: PhaseBuffer = bytes_to_phases(raw_slice);
    let buf: PhaseBuffer = phase_buf_new();
    phase_buf_push(&buf, klass_tag_phase(dec.klass));
    phase_buf_push(&buf, phase_neutral());
    phase_buf_append(&buf, body);
    phase_buf_free(&body);
    return buf;
}

fn translate_insn_x86(pc: u64, bytes: []u8, out_phases: *PhaseBuffer) i32 {
    let dec: DecodedInsn = DecodedInsn{ .arch = GuestArch.X86_64, .pc = pc, .len = 0, .klass = InsnClass.Unknown, .opcode = 0, .modrm = 0, .imm = 0, .raw = (null) as *u8, .raw_len = 0 };
    let st: i32 = decode_x86_64(pc, bytes, &dec);
    if ((st != 0)) {
        return st;
    }
    out_phases.* = insn_to_phases(dec);
    decoded_insn_free(&dec);
    return 0;
}

fn translate_insn_arm(pc: u64, bytes: []u8, out_phases: *PhaseBuffer) i32 {
    let dec: DecodedInsn = DecodedInsn{ .arch = GuestArch.ARM64, .pc = pc, .len = 0, .klass = InsnClass.Unknown, .opcode = 0, .modrm = 0, .imm = 0, .raw = (null) as *u8, .raw_len = 0 };
    let st: i32 = decode_arm64(pc, bytes, &dec);
    if ((st != 0)) {
        return st;
    }
    out_phases.* = insn_to_phases(dec);
    decoded_insn_free(&dec);
    return 0;
}

fn GUEST_RAM_FAULT_MMIO() i32 {
    return (0 - 1);
}

fn GUEST_RAM_FAULT_OOB() i32 {
    return (0 - 2);
}

fn guest_ram_new(size: i32) ArrayList[u8] {
    let ram: ArrayList[u8] = make[u8](0);
    let i: i32 = 0;
    while ((i < size)) {
        push[u8](&ram, 0);
        i = (i + 1);
    }
    return ram;
}

fn guest_ram_new_default() ArrayList[u8] {
    return guest_ram_new((GUEST_RAM_DEFAULT_BYTES()) as i32);
}

fn guest_ram_ensure(guest_ram: *ArrayList[u8], end: i32) i32 {
    if ((end < 0)) {
        return 0;
    }
    while ((len[u8](guest_ram.*) < end)) {
        push[u8](guest_ram, 0);
    }
    return 1;
}

fn guest_ram_ensure_span(guest_ram: *ArrayList[u8], gpa: i32, nbytes: i32) i32 {
    if ((gpa < 0)) {
        return (0 - 1);
    }
    let end: i32 = (gpa + nbytes);
    if ((guest_ram_ensure(guest_ram, end) == 0)) {
        return (0 - 1);
    }
    return 0;
}

fn guest_ram_gpa_in_virtio_block(gpa: i32) i32 {
    let base: i32 = GPA_VIRTIO_MMIO_BASE();
    let end: i32 = (base + GPA_VIRTIO_MMIO_BYTES());
    if ((gpa >= base)) {
        if ((gpa < end)) {
            return 1;
        }
    }
    return 0;
}

fn guest_ram_gpa_in_virtio_net(gpa: i32) i32 {
    let base: i32 = GPA_VIRTIO_NET_BASE();
    let end: i32 = (base + GPA_VIRTIO_MMIO_BYTES());
    if ((gpa >= base)) {
        if ((gpa < end)) {
            return 1;
        }
    }
    return 0;
}

fn guest_ram_gpa_in_virtio_gpu(gpa: i32) i32 {
    let base: i32 = GPA_VIRTIO_GPU_BASE();
    let end: i32 = (base + GPA_VIRTIO_MMIO_BYTES());
    if ((gpa >= base)) {
        if ((gpa < end)) {
            return 1;
        }
    }
    return 0;
}

fn guest_ram_is_virtio_mmio(gpa: i32) i32 {
    if ((guest_ram_gpa_in_virtio_block(gpa) == 1)) {
        return 1;
    }
    if ((guest_ram_gpa_in_virtio_net(gpa) == 1)) {
        return 1;
    }
    if ((guest_ram_gpa_in_virtio_gpu(gpa) == 1)) {
        return 1;
    }
    return 0;
}

fn guest_ram_mmio_trap(gpa: i32, is_write: i32, val: i32) i32 {
    if ((guest_ram_gpa_in_virtio_block(gpa) == 1)) {
        let off: i32 = (gpa - GPA_VIRTIO_MMIO_BASE());
        if ((is_write == 1)) {
            virtio_guest_mmio_write32(off, val);
            return 0;
        }
        return virtio_guest_mmio_read32(off);
    }
    if ((guest_ram_gpa_in_virtio_net(gpa) == 1)) {
        let off: i32 = (gpa - GPA_VIRTIO_NET_BASE());
        if ((is_write == 1)) {
            virtio_net_guest_mmio_write32(off, val);
            return 0;
        }
        return virtio_net_guest_mmio_read32(off);
    }
    if ((guest_ram_gpa_in_virtio_gpu(gpa) == 1)) {
        let off: i32 = (gpa - GPA_VIRTIO_GPU_BASE());
        if ((is_write == 1)) {
            virtio_gpu_guest_mmio_write32(off, val);
            return 0;
        }
        return virtio_gpu_guest_mmio_read32(off);
    }
    return 0;
}

fn guest_ram_read8(ram: ArrayList[u8], gpa: i32) u8 {
    if ((guest_ram_is_virtio_mmio(gpa) == 1)) {
        return 0;
    }
    if (((gpa < 0) || (gpa >= len[u8](ram)))) {
        return 0;
    }
    return get[u8](&ram, gpa);
}

fn guest_ram_read32(ram: *ArrayList[u8], gpa: i32) i64 {
    if ((virtio_gpu_guest_fb_gpa_in_range(gpa) == 1)) {
        return virtio_gpu_guest_fb_read32(gpa);
    }
    if ((guest_ram_is_virtio_mmio(gpa) == 1)) {
        return (GUEST_RAM_FAULT_MMIO()) as i64;
    }
    if ((guest_ram_ensure_span(ram, gpa, 4) != 0)) {
        return (GUEST_RAM_FAULT_OOB()) as i64;
    }
    let b0: u8 = get[u8](ram, gpa);
    let b1: u8 = get[u8](ram, (gpa + 1));
    let b2: u8 = get[u8](ram, (gpa + 2));
    let b3: u8 = get[u8](ram, (gpa + 3));
    let v: u32 = ((((b0) as u32 + ((b1) as u32 * 256)) + ((b2) as u32 * 65536)) + ((b3) as u32 * 16777216));
    return (v) as i64;
}

fn guest_ram_write8(ram: *ArrayList[u8], gpa: i32, v: u8) void {
    if ((guest_ram_is_virtio_mmio(gpa) == 1)) {
        return;
    }
    if ((guest_ram_ensure_span(ram, gpa, 1) != 0)) {
        return;
    }
    set[u8](ram, gpa, v);
}

fn guest_ram_write32(ram: *ArrayList[u8], gpa: i32, val: u32) i32 {
    if ((virtio_gpu_guest_fb_gpa_in_range(gpa) == 1)) {
        return virtio_gpu_guest_fb_write32(gpa, val);
    }
    if ((guest_ram_is_virtio_mmio(gpa) == 1)) {
        return GUEST_RAM_FAULT_MMIO();
    }
    if ((guest_ram_ensure_span(ram, gpa, 4) != 0)) {
        return GUEST_RAM_FAULT_OOB();
    }
    set[u8](ram, gpa, ((val % 256)) as u8);
    set[u8](ram, (gpa + 1), (((val / 256) % 256)) as u8);
    set[u8](ram, (gpa + 2), (((val / 65536) % 256)) as u8);
    set[u8](ram, (gpa + 3), (((val / 16777216) % 256)) as u8);
    return 0;
}

fn guest_ram_write_u32_le(guest_ram: *ArrayList[u8], gpa: i32, val: i32) i32 {
    let pack: u32 = (val) as u32;
    if ((val < 0)) {
        pack = (((val) as i64 + 4294967296)) as u32;
    }
    return guest_ram_write32(guest_ram, gpa, pack);
}

fn guest_ram_write_u8(guest_ram: *ArrayList[u8], gpa: i32, val: u8) i32 {
    guest_ram_write8(guest_ram, gpa, val);
    return 0;
}

fn guest_ram_read_u8(guest_ram: ArrayList[u8], gpa: i32) u8 {
    return guest_ram_read8(guest_ram, gpa);
}

fn guest_ram_read_u16_le(guest_ram: ArrayList[u8], gpa: i32) i32 {
    let lo: u8 = guest_ram_read_u8(guest_ram, gpa);
    let hi: u8 = guest_ram_read_u8(guest_ram, (gpa + 1));
    return (((hi) as i32 * 256) + (lo) as i32);
}

fn guest_ram_write_u16_le(guest_ram: *ArrayList[u8], gpa: i32, val: i32) i32 {
    let lo: u8 = ((val - ((val / 256) * 256))) as u8;
    let hi: u8 = ((val / 256)) as u8;
    if ((guest_ram_write_u8(guest_ram, gpa, lo) != 0)) {
        return (0 - 1);
    }
    if ((guest_ram_write_u8(guest_ram, (gpa + 1), hi) != 0)) {
        return (0 - 1);
    }
    return 0;
}

fn guest_ram_copy(guest_ram: *ArrayList[u8], gpa: i32, src: []u8, nbytes: i32) i32 {
    let end: i32 = (gpa + nbytes);
    if ((guest_ram_ensure(guest_ram, end) == 0)) {
        return (0 - 1);
    }
    let i: i32 = 0;
    while ((i < nbytes)) {
        set[u8](guest_ram, (gpa + i), src[i]);
        i = (i + 1);
    }
    return 0;
}

fn guest_ram_slice(ram: ArrayList[u8], gpa: i32, nbytes: i32) []u8 {
    let end: i32 = (gpa + nbytes);
    let tmp: ArrayList[u8] = ram;
    guest_ram_ensure(&tmp, end);
    if ((gpa < 0)) {
        return ram.data[0..0];
    }
    if ((end > len[u8](ram))) {
        return ram.data[0..0];
    }
    return ram.data[gpa..end];
}

fn guest_ram_vga_attr_rgb(attr: u8, ch: u8, pc_mix: i32, r: *i32, g: *i32, b: *i32) void {
    let fg: i32 = ((attr % 16)) as i32;
    let pal_r: i32 = 0;
    let pal_g: i32 = 0;
    let pal_b: i32 = 0;
    if ((fg == 0)) {
        pal_r = 0;
        pal_g = 0;
        pal_b = 0;
    }
    if ((fg == 1)) {
        pal_r = 0;
        pal_g = 0;
        pal_b = 170;
    }
    if ((fg == 2)) {
        pal_r = 0;
        pal_g = 170;
        pal_b = 0;
    }
    if ((fg == 3)) {
        pal_r = 0;
        pal_g = 170;
        pal_b = 170;
    }
    if ((fg == 4)) {
        pal_r = 170;
        pal_g = 0;
        pal_b = 0;
    }
    if ((fg == 5)) {
        pal_r = 170;
        pal_g = 0;
        pal_b = 170;
    }
    if ((fg == 6)) {
        pal_r = 170;
        pal_g = 85;
        pal_b = 0;
    }
    if ((fg == 7)) {
        pal_r = 170;
        pal_g = 170;
        pal_b = 170;
    }
    if ((fg == 8)) {
        pal_r = 85;
        pal_g = 85;
        pal_b = 85;
    }
    if ((fg == 9)) {
        pal_r = 85;
        pal_g = 85;
        pal_b = 255;
    }
    if ((fg == 10)) {
        pal_r = 85;
        pal_g = 255;
        pal_b = 85;
    }
    if ((fg == 11)) {
        pal_r = 85;
        pal_g = 255;
        pal_b = 255;
    }
    if ((fg == 12)) {
        pal_r = 255;
        pal_g = 85;
        pal_b = 85;
    }
    if ((fg == 13)) {
        pal_r = 255;
        pal_g = 85;
        pal_b = 255;
    }
    if ((fg == 14)) {
        pal_r = 255;
        pal_g = 255;
        pal_b = 85;
    }
    if ((fg == 15)) {
        pal_r = 255;
        pal_g = 255;
        pal_b = 255;
    }
    let ch_boost: i32 = ((ch) as i32 % 64);
    r.* = ((pal_r + ch_boost) + (pc_mix % 48));
    g.* = (pal_g + ((pc_mix / 3) % 48));
    b.* = (pal_b + ((pc_mix / 7) % 48));
    if ((r.* > 255)) {
        r.* = 255;
    }
    if ((g.* > 255)) {
        g.* = 255;
    }
    if ((b.* > 255)) {
        b.* = 255;
    }
}

fn guest_ram_seed_vga_line(guest_ram: *ArrayList[u8], row: i32, text: []u8, attr: u8) void {
    if (((row < 0) || (row >= VGA_TEXT_ROWS()))) {
        return;
    }
    let base: i32 = (GPA_VGA_TEXT() + ((row * VGA_TEXT_COLS()) * 2));
    guest_ram_ensure_span(guest_ram, base, (VGA_TEXT_COLS() * 2));
    let col: i32 = 0;
    while ((col < VGA_TEXT_COLS())) {
        let ch: u8 = 32;
        if ((col < text.len)) {
            ch = text[col];
        }
        set[u8](guest_ram, (base + (col * 2)), ch);
        set[u8](guest_ram, ((base + (col * 2)) + 1), attr);
        col = (col + 1);
    }
}

fn guest_ram_seed_vga_demo(guest_ram: *ArrayList[u8]) void {
    guest_ram_seed_vga_line(guest_ram, 0, "RayOS Linux Guest", 15);
    guest_ram_seed_vga_line(guest_ram, 2, "BTM stepping via SOH matrix", 11);
    guest_ram_seed_vga_line(guest_ram, 4, "VGA 0xB8000 text mode", 10);
}

fn virtio_net_guest_mmio_read32(gpa_off: i32) i32 {
    let _off: i32 = gpa_off;
    return 0;
}

fn virtio_net_guest_mmio_write32(gpa_off: i32, val: i32) void {
    let _off: i32 = gpa_off;
    let _val: i32 = val;
}

struct WaveChannel {
    lane: i32,
    phase_acc: i8,
    brute_mask: u64,
    symbol: i64,
    active: i32,
}

struct BinaryTranslationMatrix {
    matrix: *SOHMatrix,
    guest: GuestRegisterFile,
    reg_map: SOHRegisterMap,
    channel: WaveChannel,
    attached: i32,
    steps: i64,
    last_phase_len: i32,
    guest_ram_ptr: i64,
    halted: i32,
}

fn wave_channel_new() WaveChannel {
    return WaveChannel{ .lane = 0, .phase_acc = (PHASE_ZERO()) as i8, .brute_mask = 0, .symbol = 0, .active = 1 };
}

fn wave_brute_fold(mask: u64, phase: i8) u64 {
    let bit: i32 = 0;
    let out: u64 = mask;
    while ((bit < (WAVE_BRUTE_LANES()) as i32)) {
        let one: u64 = 1;
        let shift: i32 = bit;
        let acc: u64 = one;
        let i: i32 = 0;
        while ((i < shift)) {
            acc = (acc * 2);
            i = (i + 1);
        }
        if ((phase == (PHASE_POS()) as i8)) {
            if ((((out / acc) % 2) == 0)) {
                out = (out + acc);
            }
        } else if ((phase == (PHASE_NEG()) as i8)) {
            if ((((out / acc) % 2) == 1)) {
                out = (out - acc);
            }
        }
        bit = (bit + 1);
    }
    return out;
}

fn wave_apply_phases(ch: *WaveChannel, phases: PhaseBuffer) void {
    let i: i32 = 0;
    while ((i < phases.len)) {
        let t: i8 = phases.trits[i];
        ch.*.phase_acc = phase_combine(ch.*.phase_acc, t);
        ch.*.brute_mask = wave_brute_fold(ch.*.brute_mask, t);
        i = (i + 1);
    }
    ch.*.symbol = (ch.*.symbol + 1);
}

fn btm_new() *BinaryTranslationMatrix {
    let matrix: *SOHMatrix = soh_new((SOH_DEFAULT_TILES_X()) as i32, (SOH_DEFAULT_TILES_Y()) as i32);
    let heap: *i8 = _zag_malloc(@sizeOf[BinaryTranslationMatrix]());
    let m: *BinaryTranslationMatrix = (heap) as *BinaryTranslationMatrix;
    m.* = BinaryTranslationMatrix{ .matrix = matrix, .guest = grf_new(GuestArch.X86_64), .reg_map = soh_map_new(GuestArch.X86_64), .channel = wave_channel_new(), .attached = 0, .steps = 0, .last_phase_len = 0, .guest_ram_ptr = 0, .halted = 0 };
    return m;
}

fn btm_free(m: *BinaryTranslationMatrix) void {
    grf_free(&m.*.guest);
    soh_map_free(&m.*.reg_map);
    soh_free(m.*.matrix);
    _zag_free((m) as *i8);
}

fn btm_attach_guest(m: *BinaryTranslationMatrix, arch: GuestArch) void {
    grf_free(&m.*.guest);
    soh_map_free(&m.*.reg_map);
    m.*.guest = grf_new(arch);
    m.*.reg_map = soh_map_default(arch);
    m.*.channel = wave_channel_new();
    m.*.attached = 1;
    m.*.steps = 0;
    m.*.last_phase_len = 0;
    m.*.guest_ram_ptr = 0;
    m.*.halted = 0;
}

fn btm_bind_guest_ram(m: *BinaryTranslationMatrix, ram: *ArrayList[u8]) void {
    m.*.guest_ram_ptr = (ram) as i64;
}

fn btm_map_register(m: *BinaryTranslationMatrix, id: GuestRegId, tile_x: i32, tile_y: i32, slot: i32) i32 {
    if ((m.*.attached == 0)) {
        return (0 - 1);
    }
    return soh_map_link(&m.*.reg_map, id, tile_x, tile_y, slot);
}

fn btm_x86_reg_from_reg(modrm: u8) GuestRegId {
    let reg: i32 = (((modrm / 8) % 8)) as i32;
    return btm_x86_reg_from_index(reg);
}

fn btm_x86_reg_from_rm(modrm: u8) GuestRegId {
    let rm: i32 = ((modrm % 8)) as i32;
    if ((rm == 0)) {
        return GuestRegId.R0;
    }
    if ((rm == 1)) {
        return GuestRegId.R1;
    }
    if ((rm == 2)) {
        return GuestRegId.R2;
    }
    if ((rm == 3)) {
        return GuestRegId.R3;
    }
    if ((rm == 4)) {
        return GuestRegId.R4;
    }
    if ((rm == 5)) {
        return GuestRegId.R5;
    }
    if ((rm == 6)) {
        return GuestRegId.R6;
    }
    return GuestRegId.R7;
}

fn btm_x86_reg_from_index(idx: i32) GuestRegId {
    if ((idx == 0)) {
        return GuestRegId.R0;
    }
    if ((idx == 1)) {
        return GuestRegId.R1;
    }
    if ((idx == 2)) {
        return GuestRegId.R2;
    }
    if ((idx == 3)) {
        return GuestRegId.R3;
    }
    if ((idx == 4)) {
        return GuestRegId.R4;
    }
    if ((idx == 5)) {
        return GuestRegId.R5;
    }
    if ((idx == 6)) {
        return GuestRegId.R6;
    }
    return GuestRegId.R7;
}

fn btm_sign_extend_imm8(imm: u32) i64 {
    if ((imm >= 128)) {
        return ((imm) as i64 - 256);
    }
    return (imm) as i64;
}

fn btm_sign_extend_imm32(imm: u32) i64 {
    if ((imm >= 2147483648)) {
        return ((imm) as i64 - 4294967296);
    }
    return (imm) as i64;
}

fn btm_x86_push_u32(m: *BinaryTranslationMatrix, val: u32) void {
    let esp: u64 = grf_get(m.*.guest, GuestRegId.R4);
    let new_esp: u64 = (esp - 4);
    grf_set(&m.*.guest, GuestRegId.R4, new_esp);
    if ((m.*.guest_ram_ptr != 0)) {
        let ram: *ArrayList[u8] = (m.*.guest_ram_ptr) as *ArrayList[u8];
        let _wr: i32 = guest_ram_write32(ram, (new_esp) as i32, val);
    }
}

fn btm_x86_pop_u32(m: *BinaryTranslationMatrix) u32 {
    let esp: u64 = grf_get(m.*.guest, GuestRegId.R4);
    let val: u32 = 0;
    if ((m.*.guest_ram_ptr != 0)) {
        let ram: *ArrayList[u8] = (m.*.guest_ram_ptr) as *ArrayList[u8];
        let rd: i64 = guest_ram_read32(ram, (esp) as i32);
        if ((rd >= 0)) {
            val = (rd) as u32;
        }
    }
    grf_set(&m.*.guest, GuestRegId.R4, (esp + 4));
    return val;
}

fn btm_read_u32_le(raw: *u8, off: i32) u32 {
    return ((((raw[off]) as u32 + ((raw[(off + 1)]) as u32 * 256)) + ((raw[(off + 2)]) as u32 * 65536)) + ((raw[(off + 3)]) as u32 * 16777216));
}

fn btm_flags_clear_carry(m: *BinaryTranslationMatrix) void {
    let flags: u64 = grf_get(m.*.guest, GuestRegId.Flags);
    let cleared: u64 = ((flags / 2) * 2);
    grf_set(&m.*.guest, GuestRegId.Flags, cleared);
}

fn btm_cpuid_edx_pattern() u64 {
    return 126614527;
}

fn btm_apply_x86_effects(m: *BinaryTranslationMatrix, dec: DecodedInsn, pc: u64) void {
    if ((dec.arch != GuestArch.X86_64)) {
        return;
    }
    if ((dec.klass == InsnClass.Jmp)) {
        if ((dec.opcode == 235)) {
            let rel: i64 = btm_sign_extend_imm8(dec.imm);
            let target: u64 = ((pc + (dec.len) as u64) + (rel) as u64);
            grf_set(&m.*.guest, GuestRegId.Pc, target);
            return;
        }
        if ((dec.opcode == 233)) {
            let rel: i64 = btm_sign_extend_imm32(dec.imm);
            let target: u64 = ((pc + (dec.len) as u64) + (rel) as u64);
            grf_set(&m.*.guest, GuestRegId.Pc, target);
            return;
        }
        return;
    }
    if ((dec.klass == InsnClass.Call)) {
        if ((dec.opcode == 232)) {
            let ret_addr: u32 = ((pc + (dec.len) as u64)) as u32;
            btm_x86_push_u32(m, ret_addr);
            let rel: i64 = btm_sign_extend_imm32(dec.imm);
            let target: u64 = ((pc + (dec.len) as u64) + (rel) as u64);
            grf_set(&m.*.guest, GuestRegId.Pc, target);
            return;
        }
        return;
    }
    if ((dec.klass == InsnClass.Mov)) {
        if (((dec.opcode >= 184) && (dec.opcode <= 191))) {
            let dst: GuestRegId = btm_x86_reg_from_index((dec.modrm) as i32);
            grf_set(&m.*.guest, dst, (dec.imm) as u64);
            return;
        }
        if ((dec.opcode == 137)) {
            let mod: i32 = (dec.modrm / 64);
            if ((mod == 3)) {
                let dst: GuestRegId = btm_x86_reg_from_rm(dec.modrm);
                let src: GuestRegId = btm_x86_reg_from_reg(dec.modrm);
                grf_set(&m.*.guest, dst, grf_get(m.*.guest, src));
            }
            return;
        }
        if ((dec.opcode == 139)) {
            let mod: i32 = (dec.modrm / 64);
            if ((mod == 3)) {
                let dst: GuestRegId = btm_x86_reg_from_reg(dec.modrm);
                let src: GuestRegId = btm_x86_reg_from_rm(dec.modrm);
                grf_set(&m.*.guest, dst, grf_get(m.*.guest, src));
            }
            return;
        }
        if ((dec.opcode == 199)) {
            let mod: i32 = (dec.modrm / 64);
            let reg: i32 = ((dec.modrm / 8) % 8);
            let rm: i32 = (dec.modrm % 8);
            if ((((mod == 0) && (reg == 0)) && (rm == 5))) {
                if (((m.*.guest_ram_ptr != 0) && (dec.raw_len >= 10))) {
                    let disp: i32 = (btm_read_u32_le(dec.raw, 2)) as i32;
                    let ram: *ArrayList[u8] = (m.*.guest_ram_ptr) as *ArrayList[u8];
                    let _wr: i32 = guest_ram_write32(ram, disp, dec.imm);
                }
            }
            return;
        }
        return;
    }
    if ((dec.klass == InsnClass.Push)) {
        let reg_idx: i32 = (dec.opcode - 80);
        let src: GuestRegId = btm_x86_reg_from_index(reg_idx);
        let val: u32 = (grf_get(m.*.guest, src)) as u32;
        btm_x86_push_u32(m, val);
        return;
    }
    if ((dec.klass == InsnClass.Pop)) {
        let reg_idx: i32 = (dec.opcode - 88);
        let dst: GuestRegId = btm_x86_reg_from_index(reg_idx);
        let val: u32 = btm_x86_pop_u32(m);
        grf_set(&m.*.guest, dst, (val) as u64);
        return;
    }
    if ((dec.klass == InsnClass.Xor)) {
        if (((dec.opcode == 49) || (dec.opcode == 51))) {
            let mod: i32 = (dec.modrm / 64);
            if ((mod == 3)) {
                let reg_field: i32 = ((dec.modrm / 8) % 8);
                let rm_field: i32 = (dec.modrm % 8);
                if ((reg_field == rm_field)) {
                    let dst: GuestRegId = btm_x86_reg_from_index(rm_field);
                    grf_set(&m.*.guest, dst, 0);
                }
            }
        }
        return;
    }
    if ((dec.klass == InsnClass.Sub)) {
        if ((dec.opcode == 131)) {
            let mod: i32 = (dec.modrm / 64);
            if ((mod == 3)) {
                let reg_field: i32 = ((dec.modrm / 8) % 8);
                if ((reg_field == 5)) {
                    let dst: GuestRegId = btm_x86_reg_from_rm(dec.modrm);
                    let cur: u64 = grf_get(m.*.guest, dst);
                    let delta: i64 = btm_sign_extend_imm8(dec.imm);
                    grf_set(&m.*.guest, dst, (((cur) as i64 - delta)) as u64);
                }
            }
        }
        return;
    }
    if ((dec.klass == InsnClass.Hlt)) {
        m.*.halted = 1;
        return;
    }
    if ((dec.klass == InsnClass.Sys)) {
        if ((dec.opcode == 205)) {
            if ((dec.imm == 16)) {
                return;
            }
            if ((dec.imm == 22)) {
                return;
            }
            if ((dec.imm == 21)) {
                btm_flags_clear_carry(m);
                return;
            }
            return;
        }
        if ((dec.opcode == 15)) {
            if ((dec.imm == 162)) {
                grf_set(&m.*.guest, GuestRegId.R0, 1);
                grf_set(&m.*.guest, GuestRegId.R1, 0);
                grf_set(&m.*.guest, GuestRegId.R2, 0);
                grf_set(&m.*.guest, GuestRegId.R3, btm_cpuid_edx_pattern());
                return;
            }
            if ((dec.imm == 49)) {
                let steps: u64 = m.*.steps;
                grf_set(&m.*.guest, GuestRegId.R0, (steps % 4294967296));
                grf_set(&m.*.guest, GuestRegId.R2, (steps / 4294967296));
                return;
            }
        }
        return;
    }
    if ((dec.klass != InsnClass.Add)) {
        return;
    }
    if ((dec.opcode == 5)) {
        let cur: u64 = grf_get(m.*.guest, GuestRegId.R0);
        grf_set(&m.*.guest, GuestRegId.R0, (cur + (dec.imm) as u64));
        return;
    }
    if ((dec.opcode == 131)) {
        let mod: i32 = (dec.modrm / 64);
        if ((mod != 3)) {
            return;
        }
        let dst: GuestRegId = btm_x86_reg_from_rm(dec.modrm);
        let cur: u64 = grf_get(m.*.guest, dst);
        grf_set(&m.*.guest, dst, (cur + (dec.imm) as u64));
    }
}

fn btm_step_apply(m: *BinaryTranslationMatrix, pc: u64, dec: DecodedInsn, phases: PhaseBuffer) i32 {
    let insn_len: i32 = dec.len;
    m.*.last_phase_len = phases.len;
    wave_apply_phases(&m.*.channel, phases);
    btm_apply_x86_effects(m, dec, pc);
    let advance_pc: i32 = 1;
    if ((dec.klass == InsnClass.Jmp)) {
        advance_pc = 0;
    }
    if ((dec.klass == InsnClass.Call)) {
        advance_pc = 0;
    }
    if ((dec.klass == InsnClass.Hlt)) {
        advance_pc = 0;
    }
    if ((advance_pc == 1)) {
        grf_set(&m.*.guest, GuestRegId.Pc, (pc + (insn_len) as u64));
    }
    let pc_ref: SOHSlotRef = soh_map_slot_unchecked(m.*.reg_map, GuestRegId.Pc);
    let wr: i32 = soh_write_trit_checked(m.*.matrix, pc_ref.tile.x, pc_ref.tile.y, pc_ref.slot, m.*.channel.phase_acc);
    decoded_insn_free(&dec);
    phase_buf_free(&phases);
    if ((wr != 0)) {
        return (0 - wr);
    }
    let pc_val: u64 = grf_get(m.*.guest, GuestRegId.Pc);
    let pc_slot: SOHSlotRef = soh_map_slot_unchecked(m.*.reg_map, GuestRegId.Pc);
    let st: i32 = soh_store_u64_checked(m.*.matrix, pc_slot, pc_val);
    if ((st != 0)) {
        return (0 - st);
    }
    m.*.steps = (m.*.steps + 1);
    return insn_len;
}

fn btm_step_x86(m: *BinaryTranslationMatrix, guest_bytes: []u8) i32 {
    let pc: u64 = m.*.guest.pc;
    let off: i32 = (pc) as i32;
    if (((off < 0) || (off >= guest_bytes.len))) {
        return (0 - 3);
    }
    let at_pc: []u8 = guest_bytes[off..guest_bytes.len];
    let dec: DecodedInsn = DecodedInsn{ .arch = GuestArch.X86_64, .pc = pc, .len = 0, .klass = InsnClass.Unknown, .opcode = 0, .modrm = 0, .imm = 0, .raw = (null) as *u8, .raw_len = 0 };
    let dst: DecodedInsn = dec;
    let st: i32 = decode_insn_stub_x86(pc, at_pc, &dst);
    if ((st != 0)) {
        return (0 - 10);
    }
    if ((dst.len < 1)) {
        return (0 - 11);
    }
    let phases: PhaseBuffer = insn_to_phases(dst);
    return btm_step_apply(m, pc, dst, phases);
}

fn btm_step_arm(m: *BinaryTranslationMatrix, guest_bytes: []u8) i32 {
    let pc: u64 = m.*.guest.pc;
    let off: i32 = (pc) as i32;
    if (((off < 0) || (off >= guest_bytes.len))) {
        return (0 - 3);
    }
    let at_pc: []u8 = guest_bytes[off..guest_bytes.len];
    let dec: DecodedInsn = DecodedInsn{ .arch = GuestArch.ARM64, .pc = pc, .len = 0, .klass = InsnClass.Unknown, .opcode = 0, .modrm = 0, .imm = 0, .raw = (null) as *u8, .raw_len = 0 };
    let st: i32 = decode_insn_stub_arm(pc, at_pc, &dec);
    if ((st != 0)) {
        return (0 - 10);
    }
    let phases: PhaseBuffer = insn_to_phases(dec);
    return btm_step_apply(m, pc, dec, phases);
}

fn btm_step(m: *BinaryTranslationMatrix, guest_bytes: []u8) i32 {
    if ((m.*.attached == 0)) {
        return (0 - 1);
    }
    if ((m.*.halted == 1)) {
        return (0 - 20);
    }
    if ((guest_bytes.len == 0)) {
        return (0 - 2);
    }
    if ((m.*.guest.arch == GuestArch.X86_64)) {
        return btm_step_x86(m, guest_bytes);
    }
    return btm_step_arm(m, guest_bytes);
}

fn btm_guest_pc(m: BinaryTranslationMatrix) u64 {
    return m.guest.pc;
}

fn btm_guest_reg(m: BinaryTranslationMatrix, id: GuestRegId) u64 {
    return grf_get(m.guest, id);
}

fn btm_phase_acc(m: BinaryTranslationMatrix) i8 {
    return m.channel.phase_acc;
}

fn btm_arch(m: BinaryTranslationMatrix) GuestArch {
    return m.guest.arch;
}

fn btm_halted(m: BinaryTranslationMatrix) i32 {
    return m.halted;
}

fn guest_boot_attach(btm: *BinaryTranslationMatrix, guest_ram: ArrayList[u8]) void {
    let _ram_len: i32 = len[u8](guest_ram);
    let _boot_off: i32 = (GPA_BOOT_SECTOR()) as i32;
    btm_attach_guest(btm, GuestArch.X86_64);
    grf_set(&btm.*.guest, GuestRegId.Pc, (GPA_BOOT_SECTOR()) as u64);
    let _flush: i32 = soh_map_flush_guest(btm.*.reg_map, btm.*.guest, btm.*.matrix);
}

fn guest_boot_step_n(btm: *BinaryTranslationMatrix, guest_ram: ArrayList[u8], n: i32) i32 {
    let done: i32 = 0;
    let i: i32 = 0;
    let ram_len: i32 = len[u8](guest_ram);
    let code: []u8 = guest_ram.data[0..ram_len];
    while ((i < n)) {
        let pc: u64 = btm.*.guest.pc;
        let off: i32 = (pc) as i32;
        if (((off < 0) || (off >= ram_len))) {
            return (0 - 3);
        }
        let step: i32 = btm_step(btm, code);
        if ((step < 0)) {
            return step;
        }
        done = (done + 1);
        i = (i + 1);
    }
    return done;
}

fn guest_boot_pc(btm: *BinaryTranslationMatrix) u64 {
    return btm.*.guest.pc;
}

struct LinuxBootImageInfo {
    setup_sects: i32,
    syssize: i32,
    boot_flag: i32,
    hdr_ok: i32,
    kernel_file_off: i32,
    kernel_gpa: i32,
    image_bytes: i32,
}

fn linux_boot_read_u16_le(raw: []u8, off: i32) i32 {
    if (((off < 0) || ((off + 1) >= raw.len))) {
        return 0;
    }
    let lo: i32 = (raw[off]) as i32;
    let hi: i32 = (raw[(off + 1)]) as i32;
    return ((hi * 256) + lo);
}

fn linux_boot_read_u8(raw: []u8, off: i32) u8 {
    if (((off < 0) || (off >= raw.len))) {
        return 0;
    }
    return raw[off];
}

fn linux_boot_hdr_signature_ok(raw: []u8) i32 {
    if ((raw.len < ((LINUX_OFF_HDR_SIG()) as i32 + 4))) {
        return 0;
    }
    let off: i32 = (LINUX_OFF_HDR_SIG()) as i32;
    if ((raw[(off + 0)] != 72)) {
        return 0;
    }
    if ((raw[(off + 1)] != 100)) {
        return 0;
    }
    if ((raw[(off + 2)] != 114)) {
        return 0;
    }
    if ((raw[(off + 3)] != 83)) {
        return 0;
    }
    return 1;
}

fn linux_boot_parse_header(raw: []u8) LinuxBootImageInfo {
    let info: LinuxBootImageInfo = LinuxBootImageInfo{ .setup_sects = 0, .syssize = 0, .boot_flag = 0, .hdr_ok = 0, .kernel_file_off = 0, .kernel_gpa = (GPA_LINUX_KERNEL()) as i32, .image_bytes = (raw.len) as i32 };
    if ((raw.len < (LINUX_BOOT_SECTOR_BYTES()) as i32)) {
        return info;
    }
    let setup: i32 = (linux_boot_read_u8(raw, (LINUX_OFF_SETUP_SECTS()) as i32)) as i32;
    if ((setup < 1)) {
        setup = 4;
    }
    info.setup_sects = setup;
    info.syssize = linux_boot_read_u16_le(raw, (LINUX_OFF_SYSSIZE()) as i32);
    info.boot_flag = linux_boot_read_u16_le(raw, (LINUX_OFF_BOOT_FLAG()) as i32);
    info.kernel_file_off = ((LINUX_BOOT_SECTOR_BYTES()) as i32 + (setup * (LINUX_BOOT_SECTOR_BYTES()) as i32));
    if ((linux_boot_hdr_signature_ok(raw) == 1)) {
        info.hdr_ok = 1;
    }
    return info;
}

fn linux_boot_kernel_gpa(_setup_sects: i32, _syssize: i32) i32 {
    return (GPA_LINUX_KERNEL_LOAD()) as i32;
}

fn linux_boot_milestone_pc(steps: i32) u64 {
    let boot_pc: u64 = (GPA_BOOT_SECTOR()) as u64;
    if ((steps < 1)) {
        return boot_pc;
    }
    return boot_pc;
}

fn linux_boot_seed_vga_boot(guest_ram: *ArrayList[u8]) void {
    guest_ram_seed_vga_line(guest_ram, 0, "RayOS Linux", 15);
}

fn linux_boot_synth_bzimage() ArrayList[u8] {
    let setup_sects: i32 = 4;
    let sector: i32 = (LINUX_BOOT_SECTOR_BYTES()) as i32;
    let kernel_paragraphs: i32 = 64;
    let kernel_bytes: i32 = (kernel_paragraphs * 16);
    let file_len: i32 = ((sector + (setup_sects * sector)) + kernel_bytes);
    let img: ArrayList[u8] = make[u8](0);
    let i: i32 = 0;
    while ((i < file_len)) {
        push[u8](&img, 0);
        i = (i + 1);
    }
    set[u8](&img, 0, 235);
    set[u8](&img, 1, 254);
    set[u8](&img, (LINUX_OFF_SETUP_SECTS()) as i32, (setup_sects) as u8);
    set[u8](&img, ((LINUX_OFF_SYSSIZE()) as i32 + 0), 64);
    set[u8](&img, ((LINUX_OFF_SYSSIZE()) as i32 + 1), 0);
    set[u8](&img, ((LINUX_OFF_BOOT_FLAG()) as i32 + 0), 85);
    set[u8](&img, ((LINUX_OFF_BOOT_FLAG()) as i32 + 1), 170);
    set[u8](&img, (sector - 2), 85);
    set[u8](&img, (sector - 1), 170);
    set[u8](&img, ((LINUX_OFF_HDR_SIG()) as i32 + 0), 72);
    set[u8](&img, ((LINUX_OFF_HDR_SIG()) as i32 + 1), 100);
    set[u8](&img, ((LINUX_OFF_HDR_SIG()) as i32 + 2), 114);
    set[u8](&img, ((LINUX_OFF_HDR_SIG()) as i32 + 3), 83);
    set[u8](&img, ((LINUX_OFF_HDR_VERSION()) as i32 + 0), 14);
    set[u8](&img, ((LINUX_OFF_HDR_VERSION()) as i32 + 1), 2);
    let koff: i32 = (sector + (setup_sects * sector));
    set[u8](&img, (koff + 0), 144);
    set[u8](&img, (koff + 1), 144);
    set[u8](&img, (koff + 2), 131);
    return img;
}

fn linux_boot_params_write(guest_ram: *ArrayList[u8], info: LinuxBootImageInfo) i32 {
    let base: i32 = (GPA_LINUX_BOOT_PARAMS()) as i32;
    let hdr_base: i32 = (base + (LINUX_BOOT_PARAMS_HDR_OFF()) as i32);
    if ((guest_ram_ensure(guest_ram, (base + 4096)) == 0)) {
        return (0 - 1);
    }
    if ((guest_ram_write_u8(guest_ram, (hdr_base + 0), (info.setup_sects) as u8) != 0)) {
        return (0 - 2);
    }
    if ((guest_ram_write_u16_le(guest_ram, (hdr_base + 1), 0) != 0)) {
        return (0 - 3);
    }
    if ((guest_ram_write_u16_le(guest_ram, (hdr_base + 3), info.syssize) != 0)) {
        return (0 - 4);
    }
    if ((guest_ram_write_u16_le(guest_ram, (hdr_base + 11), (LINUX_BOOT_FLAG_MAGIC()) as i32) != 0)) {
        return (0 - 5);
    }
    if ((guest_ram_write_u32_le(guest_ram, (hdr_base + 17), 1400005704) != 0)) {
        return (0 - 6);
    }
    if ((guest_ram_write_u16_le(guest_ram, (hdr_base + 21), 526) != 0)) {
        return (0 - 7);
    }
    if ((guest_ram_write_u8(guest_ram, (hdr_base + 23), 255) != 0)) {
        return (0 - 8);
    }
    if ((guest_ram_write_u32_le(guest_ram, (hdr_base + 25), info.kernel_gpa) != 0)) {
        return (0 - 9);
    }
    let virtio_lo: i32 = (RAYOS_VIRTIO_MMIO_GPA()) as i32;
    if ((guest_ram_write_u32_le(guest_ram, (base + 592), virtio_lo) != 0)) {
        return (0 - 10);
    }
    return 0;
}

fn linux_boot_seed_kernel_stub(guest_ram: *ArrayList[u8]) void {
    let load: i32 = (GPA_LINUX_KERNEL_LOAD()) as i32;
    guest_ram_write8(guest_ram, (load + 0), 144);
    guest_ram_write8(guest_ram, (load + 1), 144);
    guest_ram_write8(guest_ram, (load + 2), 131);
}

fn linux_boot_load_image_bytes(guest_ram: *ArrayList[u8], raw: []u8) i32 {
    let info: LinuxBootImageInfo = linux_boot_parse_header(raw);
    if ((info.boot_flag != (LINUX_BOOT_FLAG_MAGIC()) as i32)) {
        let sig_lo: i32 = linux_boot_read_u16_le(raw, ((LINUX_BOOT_SECTOR_BYTES()) as i32 - 2));
        if ((sig_lo != (LINUX_BOOT_FLAG_MAGIC()) as i32)) {
            return (0 - 1);
        }
    }
    let boot_gpa: i32 = (GPA_BOOT_SECTOR()) as i32;
    let sector: i32 = (LINUX_BOOT_SECTOR_BYTES()) as i32;
    if ((guest_ram_copy(guest_ram, boot_gpa, raw[0..sector], sector) != 0)) {
        return (0 - 2);
    }
    let setup_bytes: i32 = (info.setup_sects * sector);
    let setup_off: i32 = sector;
    if ((raw.len < (setup_off + setup_bytes))) {
        return (0 - 3);
    }
    if ((guest_ram_copy(guest_ram, (GPA_LINUX_SETUP()) as i32, raw[setup_off..(setup_off + setup_bytes)], setup_bytes) != 0)) {
        return (0 - 4);
    }
    let kfile: i32 = info.kernel_file_off;
    let kremain: i32 = ((raw.len) as i32 - kfile);
    if ((kremain > 0)) {
        let kgpa: i32 = linux_boot_kernel_gpa(info.setup_sects, info.syssize);
        if ((guest_ram_copy(guest_ram, kgpa, raw[kfile..raw.len], kremain) != 0)) {
            return (0 - 5);
        }
    }
    if ((linux_boot_params_write(guest_ram, info) != 0)) {
        return (0 - 6);
    }
    linux_boot_seed_kernel_stub(guest_ram);
    linux_boot_seed_vga_boot(guest_ram);
    return 0;
}

fn linux_boot_load_real(path: []u8, guest_ram: *ArrayList[u8]) i32 {
    let raw: []u8 = _zag_read_file(path);
    if ((raw.len < (LINUX_BOOT_SECTOR_BYTES()) as i32)) {
        return (0 - 1);
    }
    let info: LinuxBootImageInfo = linux_boot_parse_header(raw);
    if ((info.boot_flag != (LINUX_BOOT_FLAG_MAGIC()) as i32)) {
        let sig: i32 = linux_boot_read_u16_le(raw, ((LINUX_BOOT_SECTOR_BYTES()) as i32 - 2));
        if ((sig != (LINUX_BOOT_FLAG_MAGIC()) as i32)) {
            return (0 - 2);
        }
    }
    if ((info.setup_sects < 1)) {
        return (0 - 3);
    }
    let sector: i32 = (LINUX_BOOT_SECTOR_BYTES()) as i32;
    let need: i32 = (sector + (info.setup_sects * sector));
    if ((raw.len < need)) {
        return (0 - 4);
    }
    return linux_boot_load_image_bytes(guest_ram, raw);
}

fn linux_boot_load_bzimage(path: []u8, guest_ram: *ArrayList[u8]) i32 {
    let raw: []u8 = _zag_read_file(path);
    if ((raw.len < (LINUX_BOOT_SECTOR_BYTES()) as i32)) {
        let synth: ArrayList[u8] = linux_boot_synth_bzimage();
        let rc: i32 = linux_boot_load_image_bytes(guest_ram, synth.data[0..len[u8](synth)]);
        free[u8](&synth);
        return rc;
    }
    return linux_boot_load_image_bytes(guest_ram, raw);
}

fn linux_boot_params_valid(guest_ram: ArrayList[u8]) i32 {
    let flag: i32 = guest_ram_read_u16_le(guest_ram, (((GPA_LINUX_BOOT_PARAMS()) as i32 + (LINUX_BOOT_PARAMS_HDR_OFF()) as i32) + 11));
    if ((flag != (LINUX_BOOT_FLAG_MAGIC()) as i32)) {
        return 0;
    }
    return 1;
}

fn linux_boot_magic_at_boot_sector(guest_ram: ArrayList[u8]) i32 {
    let off: i32 = (((GPA_BOOT_SECTOR()) as i32 + (LINUX_BOOT_SECTOR_BYTES()) as i32) - 2);
    return guest_ram_read_u16_le(guest_ram, off);
}

fn linux_boot_seed_guest(guest_ram: *ArrayList[u8]) void {
    let magic: i32 = linux_boot_magic_at_boot_sector(guest_ram.*);
    if ((magic != (LINUX_BOOT_FLAG_MAGIC()) as i32)) {
        let _rc: i32 = linux_boot_load_bzimage("", guest_ram);
        return;
    }
    linux_boot_seed_kernel_stub(guest_ram);
    linux_boot_seed_vga_boot(guest_ram);
}

fn linux_boot_attach(btm: *BinaryTranslationMatrix, guest_ram: *ArrayList[u8]) void {
    linux_boot_seed_guest(guest_ram);
    linux_boot_seed_vga_boot(guest_ram);
    btm_attach_guest(btm, GuestArch.X86_64);
    btm_bind_guest_ram(btm, guest_ram);
    grf_set(&btm.*.guest, GuestRegId.Pc, (GPA_BOOT_SECTOR()) as u64);
    grf_set(&btm.*.guest, GuestRegId.R2, 128);
    grf_set(&btm.*.guest, GuestRegId.R3, (GPA_LINUX_BOOT_PARAMS()) as u64);
    grf_set(&btm.*.guest, GuestRegId.R6, (GPA_LINUX_SETUP()) as u64);
    grf_set(&btm.*.guest, GuestRegId.R4, 40959);
    let _flush: i32 = soh_map_flush_guest(btm.*.reg_map, btm.*.guest, btm.*.matrix);
}

fn linux_boot_step_n(btm: *BinaryTranslationMatrix, guest_ram: ArrayList[u8], n: i32) i32 {
    let done: i32 = 0;
    let i: i32 = 0;
    let ram_len: i32 = len[u8](guest_ram);
    let code: []u8 = guest_ram.data[0..ram_len];
    while ((i < n)) {
        let pc: u64 = btm.*.guest.pc;
        let off: i32 = (pc) as i32;
        if (((off < 0) || (off >= ram_len))) {
            return (0 - 3);
        }
        let step: i32 = btm_step(btm, code);
        if ((step < 0)) {
            return step;
        }
        done = (done + 1);
        i = (i + 1);
    }
    return done;
}

fn linux_boot_pc(btm: *BinaryTranslationMatrix) u64 {
    return btm.*.guest.pc;
}

struct RayOSBootStats {
    fabric_bindings: i32,
    soh_tiles: i32,
    soh_capacity: i32,
    tekum_width: i32,
    offset_probe: i64,
    btm_attached: i32,
}

struct RayOS {
    fabric: SpatialRoutingFabric,
    btm: *BinaryTranslationMatrix,
    soh: *SOHMatrix,
    boot: RayOSBootStats,
    ready: i32,
}

fn rayos_chamber_count() i32 {
    return (RAYOS_CHAMBER_COUNT()) as i32;
}

fn rayos_wdm_channels() i32 {
    return (RAYOS_WDM_CHANNELS()) as i32;
}

fn rayos_waveguide_slots() i32 {
    return (RAYOS_WAVEGUIDE_SLOTS()) as i32;
}

fn rayos_probe_offset() i64 {
    let base: TekumValue = tekum_from_i64(0);
    let stride: TekumValue = tekum_from_i64((FLASH_CHAMBER_STRIDE_TRITS()) as i32);
    let off: TekumValue = flash_offset_compute(base, stride, 3);
    return tekum_to_i64(off);
}

fn rayos_init() RayOS {
    let f: SpatialRoutingFabric = fabric_new();
    let sys_bind: i32 = fabric_bind_application(&f, 0, 0, 1, 0);
    let matrix: *SOHMatrix = soh_new((SOH_DEFAULT_TILES_X()) as i32, (SOH_DEFAULT_TILES_Y()) as i32);
    let hv: *BinaryTranslationMatrix = btm_new();
    btm_attach_guest(hv, GuestArch.X86_64);
    let probe: i64 = rayos_probe_offset();
    let tw: TekumValue = tekum_from_i64(probe);
    let binds: i32 = 0;
    if ((sys_bind >= 0)) {
        binds = 1;
    }
    return RayOS{ .fabric = f, .btm = hv, .soh = matrix, .boot = RayOSBootStats{ .fabric_bindings = binds, .soh_tiles = (matrix.*.tiles_x * matrix.*.tiles_y), .soh_capacity = matrix.*.capacity, .tekum_width = tw.width, .offset_probe = probe, .btm_attached = 1 }, .ready = 1 };
}

fn rayos_shutdown(sys: *RayOS) void {
    if ((sys.*.ready == 0)) {
        return;
    }
    fabric_free(&sys.*.fabric);
    btm_free(sys.*.btm);
    soh_free(sys.*.soh);
    sys.*.btm = null;
    sys.*.soh = null;
    sys.*.ready = 0;
}

fn rayos_bind_app(sys: *RayOS, app_id: i32, src_chamber: i32, dst_chamber: i32, channel_id: i32) i32 {
    return fabric_bind_application(&sys.*.fabric, app_id, src_chamber, dst_chamber, channel_id);
}

fn rayos_release_app(sys: *RayOS, app_id: i32) i32 {
    return fabric_release_by_app(&sys.*.fabric, app_id);
}

fn rayos_guest_step(sys: *RayOS, guest_bytes: []u8) i32 {
    return btm_step(sys.*.btm, guest_bytes);
}

fn soh_mmio_tile_index(tile_x: i32, tile_y: i32) i32 {
    if (((tile_x < 0) || (tile_y < 0))) {
        return (0 - 1);
    }
    if (((tile_x >= (RAYOS_SOH_MMIO_TILES_X()) as i32) || (tile_y >= (RAYOS_SOH_MMIO_TILES_Y()) as i32))) {
        return (0 - 1);
    }
    return ((tile_y * (RAYOS_SOH_MMIO_TILES_X()) as i32) + tile_x);
}

fn soh_mmio_slot_offset(tile_x: i32, tile_y: i32, slot: i32) i64 {
    let tile_idx: i32 = soh_mmio_tile_index(tile_x, tile_y);
    if ((tile_idx < 0)) {
        return (0 - 1);
    }
    if (((slot < 0) || (slot >= (SOH_SLOTS_PER_TILE()) as i32))) {
        return (0 - 2);
    }
    let base: i64 = (RAYOS_SOH_MMIO_BASE()) as i64;
    let slots: i64 = (SOH_SLOTS_PER_TILE()) as i64;
    return ((base + ((tile_idx) as i64 * slots)) + (slot) as i64);
}

fn soh_mmio_write_trit(tile_x: i32, tile_y: i32, slot: i32, trit: i8) i32 {
    let off: i64 = soh_mmio_slot_offset(tile_x, tile_y, slot);
    if ((off < 0)) {
        return 1;
    }
    if ((hw_rt_ensure() != 0)) {
        return 2;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let rel: i64 = (off - st.*.virt_base);
    if (((rel < 0) || ((rel + 1) > st.*.map_size))) {
        return 3;
    }
    let byte_ptr: *i8 = ((st.*.map_base + rel)) as *i8;
    byte_ptr.* = trit;
    hw_fence();
    return 0;
}

fn soh_mmio_read_trit(tile_x: i32, tile_y: i32, slot: i32) i8 {
    let off: i64 = soh_mmio_slot_offset(tile_x, tile_y, slot);
    if ((off < 0)) {
        return (PHASE_ZERO()) as i8;
    }
    if ((hw_rt_ensure() != 0)) {
        return (PHASE_ZERO()) as i8;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let rel: i64 = (off - st.*.virt_base);
    if (((rel < 0) || ((rel + 1) > st.*.map_size))) {
        return (PHASE_ZERO()) as i8;
    }
    let byte_ptr: *i8 = ((st.*.map_base + rel)) as *i8;
    return byte_ptr.*;
}

fn soh_mmio_store_u64(tile_x: i32, tile_y: i32, slot: i32, val: u64) i32 {
    let end_slot: i32 = ((slot + (SOH_TRITS_PER_U64()) as i32) - 1);
    if ((soh_mmio_tile_index(tile_x, tile_y) < 0)) {
        return 1;
    }
    if (((slot < 0) || (end_slot >= (SOH_SLOTS_PER_TILE()) as i32))) {
        return 2;
    }
    let bit: i32 = 0;
    while ((bit < (SOH_TRITS_PER_U64()) as i32)) {
        let shift: i32 = (63 - bit);
        let shifted: u64 = val;
        let i: i32 = 0;
        while ((i < shift)) {
            shifted = (shifted / 2);
            i = (i + 1);
        }
        let tr: i8 = (PHASE_NEG()) as i8;
        if (((shifted % 2) != 0)) {
            tr = (PHASE_POS()) as i8;
        }
        let rc: i32 = soh_mmio_write_trit(tile_x, tile_y, (slot + bit), tr);
        if ((rc != 0)) {
            return rc;
        }
        bit = (bit + 1);
    }
    return 0;
}

fn soh_mmio_load_u64(tile_x: i32, tile_y: i32, slot: i32) u64 {
    let end_slot: i32 = ((slot + (SOH_TRITS_PER_U64()) as i32) - 1);
    if ((soh_mmio_tile_index(tile_x, tile_y) < 0)) {
        return 0;
    }
    if (((slot < 0) || (end_slot >= (SOH_SLOTS_PER_TILE()) as i32))) {
        return 0;
    }
    let out: u64 = 0;
    let bit: i32 = 0;
    while ((bit < (SOH_TRITS_PER_U64()) as i32)) {
        let tr: i8 = soh_mmio_read_trit(tile_x, tile_y, (slot + bit));
        let one: u64 = 1;
        let shift: i32 = (63 - bit);
        if ((tr == (PHASE_POS()) as i8)) {
            let i: i32 = 0;
            let acc: u64 = one;
            while ((i < shift)) {
                acc = (acc * 2);
                i = (i + 1);
            }
            out = (out + acc);
        }
        bit = (bit + 1);
    }
    return out;
}

fn SOH_BLOCK_SIZE() i32 {
    return 512;
}

fn SOH_BLOCK_BOOT_ID() i32 {
    return 0;
}

fn soh_block_plane_slots() i32 {
    let tx: i32 = (RAYOS_SOH_MMIO_TILES_X()) as i32;
    let ty: i32 = (RAYOS_SOH_MMIO_TILES_Y()) as i32;
    let spt: i32 = (SOH_SLOTS_PER_TILE()) as i32;
    return ((tx * ty) * spt);
}

fn soh_block_max_blocks() i32 {
    return (soh_block_plane_slots() / (SOH_BLOCK_SIZE()) as i32);
}

fn soh_block_megatryte_offset(block_id: i32) i64 {
    let base: TekumValue = tekum_from_i64(0);
    let stride: TekumValue = tekum_from_i64((SOH_BLOCK_SIZE()) as i64);
    let off: TekumValue = flash_offset_compute(base, stride, block_id);
    return tekum_to_i64(off);
}

struct SOHBlockCoord {
    tile_x: i32,
    tile_y: i32,
    slot: i32,
}

fn soh_block_flat_to_coord(flat: i32) SOHBlockCoord {
    let tiles_x: i32 = (RAYOS_SOH_MMIO_TILES_X()) as i32;
    let spt: i32 = (SOH_SLOTS_PER_TILE()) as i32;
    let tile_idx: i32 = (flat / spt);
    let slot: i32 = (flat - (tile_idx * spt));
    let tile_x: i32 = (tile_idx - ((tile_idx / tiles_x) * tiles_x));
    let tile_y: i32 = (tile_idx / tiles_x);
    return SOHBlockCoord{ .tile_x = tile_x, .tile_y = tile_y, .slot = slot };
}

fn soh_block_coord(block_id: i32, byte_idx: i32) SOHBlockCoord {
    let base_off: i64 = soh_block_megatryte_offset(block_id);
    let flat: i32 = ((base_off) as i32 + byte_idx);
    return soh_block_flat_to_coord(flat);
}

fn soh_block_id_valid(block_id: i32) i32 {
    if ((block_id < 0)) {
        return 0;
    }
    if ((block_id >= soh_block_max_blocks())) {
        return 0;
    }
    return 1;
}

fn soh_block_write(block_id: i32, data: []u8) i32 {
    if ((soh_block_id_valid(block_id) == 0)) {
        return (0 - 1);
    }
    if ((data.len != (SOH_BLOCK_SIZE()) as i32)) {
        return (0 - 2);
    }
    let i: i32 = 0;
    while ((i < (SOH_BLOCK_SIZE()) as i32)) {
        let coord: SOHBlockCoord = soh_block_coord(block_id, i);
        let tr: i8 = (data[i]) as i8;
        let rc: i32 = soh_mmio_write_trit(coord.tile_x, coord.tile_y, coord.slot, tr);
        if ((rc != 0)) {
            return (0 - 3);
        }
        i = (i + 1);
    }
    return 0;
}

fn soh_block_read(block_id: i32, out: *ArrayList[u8]) i32 {
    if ((soh_block_id_valid(block_id) == 0)) {
        return (0 - 1);
    }
    while ((len[u8](out.*) < (SOH_BLOCK_SIZE()) as i32)) {
        push[u8](out, 0);
    }
    let i: i32 = 0;
    while ((i < (SOH_BLOCK_SIZE()) as i32)) {
        let coord: SOHBlockCoord = soh_block_coord(block_id, i);
        let tr: i8 = soh_mmio_read_trit(coord.tile_x, coord.tile_y, coord.slot);
        set[u8](out, i, (tr) as u8);
        i = (i + 1);
    }
    return 0;
}

fn LINUX_IMAGE_DEFAULT_PATH() []u8 {
    return "vm/linux.bin";
}

fn LINUX_IMAGE_VMLINUZ_PATH() []u8 {
    return "vm/vmlinuz";
}

fn linux_image_resolve_path() []u8 {
    let linux_bin: []u8 = LINUX_IMAGE_DEFAULT_PATH();
    if ((_zag_file_exists(linux_bin) == 1)) {
        return linux_bin;
    }
    let vmlinuz: []u8 = LINUX_IMAGE_VMLINUZ_PATH();
    if ((_zag_file_exists(vmlinuz) == 1)) {
        return vmlinuz;
    }
    return "";
}

fn linux_image_load_bzimage(guest_ram: *ArrayList[u8]) i32 {
    let path: []u8 = linux_image_resolve_path();
    if ((path.len < 1)) {
        return linux_boot_load_bzimage("", guest_ram);
    }
    return linux_boot_load_real(path, guest_ram);
}

fn linux_image_load(path: []u8, guest_ram: *ArrayList[u8]) i32 {
    if ((path.len < 1)) {
        return linux_image_load_bzimage(guest_ram);
    }
    let raw: []u8 = _zag_read_file(path);
    if ((raw.len < (LINUX_BOOT_SECTOR_BYTES()) as i32)) {
        return linux_boot_load_bzimage(path, guest_ram);
    }
    return linux_boot_load_real(path, guest_ram);
}

