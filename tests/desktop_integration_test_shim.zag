        sel25519(a, b, r);
        sel25519(c, d, r);
        bit = (bit - 1);
    }
    inv25519(c, c);
    M(a, a, c);
    pack25519(q, a);
}

fn hmac_sha256(key: *i8, keylen: i32, msg: *i8, msglen: i32, out: *i8) void {
    let k: *i8 = _zag_malloc(64);
    let i: i32 = 0;
    if ((keylen > 64)) {
        let kh: *i8 = _zag_malloc(32);
        sha256(key, keylen, kh);
        while ((i < 32)) {
            k[i] = kh[i];
            i = (i + 1);
        }
        while ((i < 64)) {
            k[i] = (0) as i8;
            i = (i + 1);
        }
    } else {
        while ((i < keylen)) {
            k[i] = key[i];
            i = (i + 1);
        }
        while ((i < 64)) {
            k[i] = (0) as i8;
            i = (i + 1);
        }
    }
    let ipad: *i8 = _zag_malloc((64 + msglen));
    i = 0;
    while ((i < 64)) {
        ipad[i] = ((((k[i]) as u8) as i64 ^ 54)) as i8;
        i = (i + 1);
    }
    i = 0;
    while ((i < msglen)) {
        ipad[(64 + i)] = msg[i];
        i = (i + 1);
    }
    let inner: *i8 = _zag_malloc(32);
    sha256(ipad, (64 + msglen), inner);
    let opad: *i8 = _zag_malloc(96);
    i = 0;
    while ((i < 64)) {
        opad[i] = ((((k[i]) as u8) as i64 ^ 92)) as i8;
        i = (i + 1);
    }
    i = 0;
    while ((i < 32)) {
        opad[(64 + i)] = inner[i];
        i = (i + 1);
    }
    sha256(opad, 96, out);
}

fn hkdf_extract(salt: *i8, saltlen: i32, ikm: *i8, ikmlen: i32, prk: *i8) void {
    hmac_sha256(salt, saltlen, ikm, ikmlen, prk);
}

fn hkdf_expand(prk: *i8, info: *i8, infolen: i32, outlen: i32, out: *i8) void {
    let t: *i8 = _zag_malloc(32);
    let tlen: i32 = 0;
    let done: i32 = 0;
    let ctr: i32 = 1;
    while ((done < outlen)) {
        let buf: *i8 = _zag_malloc(((32 + infolen) + 1));
        let bl: i32 = 0;
        let j: i32 = 0;
        while ((j < tlen)) {
            buf[bl] = t[j];
            bl = (bl + 1);
            j = (j + 1);
        }
        j = 0;
        while ((j < infolen)) {
            buf[bl] = info[j];
            bl = (bl + 1);
            j = (j + 1);
        }
        buf[bl] = (ctr) as i8;
        bl = (bl + 1);
        hmac_sha256(prk, 32, buf, bl, t);
        tlen = 32;
        let k: i32 = 0;
        while (((k < 32) && (done < outlen))) {
            out[done] = t[k];
            done = (done + 1);
            k = (k + 1);
        }
        ctr = (ctr + 1);
    }
}

fn hkdf_expand_label(secret: *i8, label: []u8, ctx: *i8, ctxlen: i32, outlen: i32, out: *i8) void {
    let info: *i8 = _zag_malloc(((16 + label.len) + ctxlen));
    let n: i32 = 0;
    info[n] = (((outlen >> 8) & 255)) as i8;
    n = (n + 1);
    info[n] = ((outlen & 255)) as i8;
    n = (n + 1);
    info[n] = ((6 + label.len)) as i8;
    n = (n + 1);
    let pfx: []u8 = "tls13 ";
    let i: i32 = 0;
    while ((i < 6)) {
        info[n] = (pfx[i]) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    i = 0;
    while ((i < label.len)) {
        info[n] = (label[i]) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    info[n] = (ctxlen) as i8;
    n = (n + 1);
    i = 0;
    while ((i < ctxlen)) {
        info[n] = ctx[i];
        n = (n + 1);
        i = (i + 1);
    }
    hkdf_expand(secret, info, n, outlen, out);
}

fn chacha20_xor(key: *i8, nonce: *i8, counter: i64, data: *i8, dlen: i32, out: *i8) void {
    let ks: *i8 = _zag_malloc(64);
    let i: i32 = 0;
    while ((i < dlen)) {
        if (((i % 64) == 0)) {
            chacha_block(key, nonce, (counter + ((i / 64)) as i64), ks);
        }
        out[i] = ((((data[i]) as u8) as i64 ^ ((ks[(i % 64)]) as u8) as i64)) as i8;
        i = (i + 1);
    }
}

fn aead_pad16(n: i32) i32 {
    let r: i32 = (n % 16);
    if ((r == 0)) {
        return 0;
    }
    return (16 - r);
}

fn aead_mac_data(aad: *i8, aadlen: i32, ct: *i8, ctlen: i32, out: *i8) i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < aadlen)) {
        out[n] = aad[i];
        n = (n + 1);
        i = (i + 1);
    }
    let p: i32 = aead_pad16(aadlen);
    i = 0;
    while ((i < p)) {
        out[n] = (0) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    i = 0;
    while ((i < ctlen)) {
        out[n] = ct[i];
        n = (n + 1);
        i = (i + 1);
    }
    p = aead_pad16(ctlen);
    i = 0;
    while ((i < p)) {
        out[n] = (0) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    let a: i64 = (aadlen) as i64;
    i = 0;
    while ((i < 8)) {
        out[n] = (((a >> (i * 8)) & 255)) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    let c: i64 = (ctlen) as i64;
    i = 0;
    while ((i < 8)) {
        out[n] = (((c >> (i * 8)) & 255)) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    return n;
}

fn aead_seal(key: *i8, nonce: *i8, aad: *i8, aadlen: i32, pt: *i8, dlen: i32, out: *i8) void {
    let polykey: *i8 = _zag_malloc(64);
    chacha_block(key, nonce, 0, polykey);
    chacha20_xor(key, nonce, 1, pt, dlen, out);
    let md: *i8 = _zag_malloc(((aadlen + dlen) + 64));
    let mdlen: i32 = aead_mac_data(aad, aadlen, out, dlen, md);
    poly1305(md, mdlen, polykey, (((out) as i64 + (dlen) as i64)) as *i8);
}

fn aead_open(key: *i8, nonce: *i8, aad: *i8, aadlen: i32, ct: *i8, ctlen: i32, out: *i8) i32 {
    if ((ctlen < 16)) {
        return 0;
    }
    let clen: i32 = (ctlen - 16);
    let polykey: *i8 = _zag_malloc(64);
    chacha_block(key, nonce, 0, polykey);
    let md: *i8 = _zag_malloc(((aadlen + clen) + 64));
    let mdlen: i32 = aead_mac_data(aad, aadlen, ct, clen, md);
    let tag: *i8 = _zag_malloc(16);
    poly1305(md, mdlen, polykey, tag);
    let i: i32 = 0;
    let diff: i32 = 0;
    while ((i < 16)) {
        if ((((tag[i]) as u8) as i32 != ((ct[(clen + i)]) as u8) as i32)) {
            diff = 1;
        }
        i = (i + 1);
    }
    if ((diff == 1)) {
        return 0;
    }
    chacha20_xor(key, nonce, 1, ct, clen, out);
    return 1;
}

fn crypto_random(out: *i8, n: i32) i32 {
    let path: []u8 = "/dev/urandom";
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(path), 0, 0, 0, 0, 0);
    if ((fd < 0)) {
        return (0 - 1);
    }
    let got: i32 = 0;
    while ((got < n)) {
        let r: i64 = _zag_raw_syscall(0, fd, ((out) as i64 + (got) as i64), ((n - got)) as i64, 0, 0, 0);
        if ((r <= 0)) {
            let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
            return (0 - 2);
        }
        got = (got + (r) as i32);
    }
    let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return 0;
}

fn x25519_base(pub: *i8, priv: *i8) void {
    let base: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        base[i] = (0) as i8;
        i = (i + 1);
    }
    base[0] = (9) as i8;
    scalarmult(pub, priv, base);
}

fn x25519_shared(out: *i8, priv: *i8, peer: *i8) void {
    scalarmult(out, priv, peer);
}

struct TlsConn {
    fd: i64,
    priv: *i8,
    transcript: *i8,
    tlen: i32,
    hs_secret: *i8,
    c_hs: *i8,
    s_hs_key: *i8,
    s_hs_iv: *i8,
    c_hs_key: *i8,
    c_hs_iv: *i8,
    s_ap_key: *i8,
    s_ap_iv: *i8,
    c_ap_key: *i8,
    c_ap_iv: *i8,
    s_seq: i64,
    c_seq: i64,
    err: i32,
}

fn tls_ok() i32 {
    return 0;
}

fn tls_last_authenticated() i32 {
    return 0;
}

fn tls_put8(b: *i8, at: i32, v: i32) i32 {
    b[at] = ((v & 255)) as i8;
    return (at + 1);
}

fn tls_put16(b: *i8, at: i32, v: i32) i32 {
    b[at] = (((v >> 8) & 255)) as i8;
    b[(at + 1)] = ((v & 255)) as i8;
    return (at + 2);
}

fn tls_put24(b: *i8, at: i32, v: i32) i32 {
    b[at] = (((v >> 16) & 255)) as i8;
    b[(at + 1)] = (((v >> 8) & 255)) as i8;
    b[(at + 2)] = ((v & 255)) as i8;
    return (at + 3);
}

fn tls_putbytes(b: *i8, at: i32, src: *i8, n: i32) i32 {
    let i: i32 = 0;
    while ((i < n)) {
        b[(at + i)] = src[i];
        i = (i + 1);
    }
    return (at + n);
}

fn tls_putstr(b: *i8, at: i32, s: []u8) i32 {
    let i: i32 = 0;
    while ((i < s.len)) {
        b[(at + i)] = (s[i]) as i8;
        i = (i + 1);
    }
    return (at + s.len);
}

fn tls_rd16(b: *i8, at: i32) i32 {
    return ((((b[at]) as u8) as i32 * 256) + ((b[(at + 1)]) as u8) as i32);
}

fn tls_rd24(b: *i8, at: i32) i32 {
    return (((((b[at]) as u8) as i32 * 65536) + (((b[(at + 1)]) as u8) as i32 * 256)) + ((b[(at + 2)]) as u8) as i32);
}

fn tls_nonce(iv: *i8, seq: i64, out: *i8) void {
    let i: i32 = 0;
    while ((i < 12)) {
        out[i] = iv[i];
        i = (i + 1);
    }
    let s: i64 = seq;
    let j: i32 = 0;
    while ((j < 8)) {
        let sb: i64 = ((s >> ((7 - j) * 8)) & 255);
        out[(4 + j)] = ((((out[(4 + j)]) as u8) as i64 ^ sb)) as i8;
        j = (j + 1);
    }
}

fn tls_transcript_add(c: *TlsConn, msg: *i8, n: i32) void {
    let i: i32 = 0;
    while ((i < n)) {
        c.*.transcript[(c.*.tlen + i)] = msg[i];
        i = (i + 1);
    }
    c.*.tlen = (c.*.tlen + n);
}

fn tls_transcript_hash(c: *TlsConn, out: *i8) void {
    sha256(c.*.transcript, c.*.tlen, out);
}

fn tls_build_client_hello(c: *TlsConn, host: []u8, pub: *i8, out: *i8) i32 {
    let p: i32 = 4;
    p = tls_put16(out, p, 771);
    let rnd: *i8 = _zag_malloc(32);
    let _r: i32 = crypto_random(rnd, 32);
    p = tls_putbytes(out, p, rnd, 32);
    p = tls_put8(out, p, 32);
    let sid: *i8 = _zag_malloc(32);
    let _s: i32 = crypto_random(sid, 32);
    p = tls_putbytes(out, p, sid, 32);
    p = tls_put16(out, p, 2);
    p = tls_put16(out, p, 4867);
    p = tls_put8(out, p, 1);
    p = tls_put8(out, p, 0);
    let ext_len_pos: i32 = p;
    p = (p + 2);
    let ext_start: i32 = p;
    p = tls_put16(out, p, 0);
    p = tls_put16(out, p, (host.len + 5));
    p = tls_put16(out, p, (host.len + 3));
    p = tls_put8(out, p, 0);
    p = tls_put16(out, p, host.len);
    p = tls_putstr(out, p, host);
    p = tls_put16(out, p, 10);
    p = tls_put16(out, p, 4);
    p = tls_put16(out, p, 2);
    p = tls_put16(out, p, 29);
    p = tls_put16(out, p, 13);
    p = tls_put16(out, p, 8);
    p = tls_put16(out, p, 6);
    p = tls_put16(out, p, 1027);
    p = tls_put16(out, p, 2052);
    p = tls_put16(out, p, 1025);
    p = tls_put16(out, p, 43);
    p = tls_put16(out, p, 3);
    p = tls_put8(out, p, 2);
    p = tls_put16(out, p, 772);
    p = tls_put16(out, p, 51);
    p = tls_put16(out, p, 38);
    p = tls_put16(out, p, 36);
    p = tls_put16(out, p, 29);
    p = tls_put16(out, p, 32);
    p = tls_putbytes(out, p, pub, 32);
    let _fix: i32 = tls_put16(out, ext_len_pos, (p - ext_start));
    let _h1: i32 = tls_put8(out, 0, 1);
    let _h2: i32 = tls_put24(out, 1, (p - 4));
    return p;
}

fn tls_derive_traffic_keys(secret: *i8, key: *i8, iv: *i8) void {
    hkdf_expand_label(secret, "key", (0) as *i8, 0, 32, key);
    hkdf_expand_label(secret, "iv", (0) as *i8, 0, 12, iv);
}

fn tls_key_schedule(c: *TlsConn, server_pub: *i8) void {
    let zeros: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        zeros[i] = (0) as i8;
        i = (i + 1);
    }
    let empty_hash: *i8 = _zag_malloc(32);
    sha256(zeros, 0, empty_hash);
    let early: *i8 = _zag_malloc(32);
    hkdf_extract(zeros, 32, zeros, 32, early);
    let derived: *i8 = _zag_malloc(32);
    hkdf_expand_label(early, "derived", empty_hash, 32, 32, derived);
    let shared: *i8 = _zag_malloc(32);
    x25519_shared(shared, c.*.priv, server_pub);
    hkdf_extract(derived, 32, shared, 32, c.*.hs_secret);
    let th: *i8 = _zag_malloc(32);
    tls_transcript_hash(c, th);
    hkdf_expand_label(c.*.hs_secret, "c hs traffic", th, 32, 32, c.*.c_hs);
    let s_hs: *i8 = _zag_malloc(32);
    hkdf_expand_label(c.*.hs_secret, "s hs traffic", th, 32, 32, s_hs);
    tls_derive_traffic_keys(c.*.c_hs, c.*.c_hs_key, c.*.c_hs_iv);
    tls_derive_traffic_keys(s_hs, c.*.s_hs_key, c.*.s_hs_iv);
    c.*.s_seq = 0;
    c.*.c_seq = 0;
}

fn tls_app_schedule(c: *TlsConn) void {
    let zeros: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        zeros[i] = (0) as i8;
        i = (i + 1);
    }
    let empty_hash: *i8 = _zag_malloc(32);
    sha256(zeros, 0, empty_hash);
    let derived2: *i8 = _zag_malloc(32);
    hkdf_expand_label(c.*.hs_secret, "derived", empty_hash, 32, 32, derived2);
    let master: *i8 = _zag_malloc(32);
    hkdf_extract(derived2, 32, zeros, 32, master);
    let th: *i8 = _zag_malloc(32);
    tls_transcript_hash(c, th);
    let c_ap: *i8 = _zag_malloc(32);
    let s_ap: *i8 = _zag_malloc(32);
    hkdf_expand_label(master, "c ap traffic", th, 32, 32, c_ap);
    hkdf_expand_label(master, "s ap traffic", th, 32, 32, s_ap);
    tls_derive_traffic_keys(c_ap, c.*.c_ap_key, c.*.c_ap_iv);
    tls_derive_traffic_keys(s_ap, c.*.s_ap_key, c.*.s_ap_iv);
}

fn tls_read_record(c: *TlsConn, rtype: *i32, buf: *i8) i32 {
    let hdr: *i8 = _zag_malloc(5);
    if ((net_tcp_recv_n(c.*.fd, hdr, 5) < 0)) {
        return (0 - 1);
    }
    rtype.* = ((hdr[0]) as u8) as i32;
    let len: i32 = tls_rd16(hdr, 3);
    if (((len < 0) || (len > 20000))) {
        return (0 - 2);
    }
    if ((net_tcp_recv_n(c.*.fd, buf, len) < 0)) {
        return (0 - 3);
    }
    return len;
}

fn tls_send_plain(c: *TlsConn, payload: *i8, n: i32) i64 {
    let rec: *i8 = _zag_malloc((n + 5));
    let p: i32 = tls_put8(rec, 0, 22);
    p = tls_put16(rec, p, 771);
    p = tls_put16(rec, p, n);
    p = tls_putbytes(rec, p, payload, n);
    return net_tcp_send_raw(c.*.fd, rec, p);
}

fn tls_send_encrypted(c: *TlsConn, key: *i8, iv: *i8, seq: i64, inner_type: i32, data: *i8, n: i32) i64 {
    let inner: *i8 = _zag_malloc((n + 1));
    let i: i32 = 0;
    while ((i < n)) {
        inner[i] = data[i];
        i = (i + 1);
    }
    inner[n] = (inner_type) as i8;
    let inner_len: i32 = (n + 1);
    let ctlen: i32 = (inner_len + 16);
    let aad: *i8 = _zag_malloc(5);
    let _a: i32 = tls_put8(aad, 0, 23);
    let _a2: i32 = tls_put16(aad, 1, 771);
    let _a3: i32 = tls_put16(aad, 3, ctlen);
    let nonce: *i8 = _zag_malloc(12);
    tls_nonce(iv, seq, nonce);
    let ct: *i8 = _zag_malloc(ctlen);
    aead_seal(key, nonce, aad, 5, inner, inner_len, ct);
    let rec: *i8 = _zag_malloc((ctlen + 5));
    let p: i32 = tls_putbytes(rec, 0, aad, 5);
    p = tls_putbytes(rec, p, ct, ctlen);
    return net_tcp_send_raw(c.*.fd, rec, p);
}

fn tls_decrypt_record(key: *i8, iv: *i8, seq: i64, ct: *i8, ctlen: i32, out: *i8, outlen: *i32) i32 {
    let aad: *i8 = _zag_malloc(5);
    let _a: i32 = tls_put8(aad, 0, 23);
    let _a2: i32 = tls_put16(aad, 1, 771);
    let _a3: i32 = tls_put16(aad, 3, ctlen);
    let nonce: *i8 = _zag_malloc(12);
    tls_nonce(iv, seq, nonce);
    if ((aead_open(key, nonce, aad, 5, ct, ctlen, out) == 0)) {
        return (0 - 1);
    }
    let plen: i32 = (ctlen - 16);
    while (((plen > 0) && (out[(plen - 1)] == (0) as i8))) {
        plen = (plen - 1);
    }
    if ((plen < 1)) {
        return (0 - 2);
    }
    let itype: i32 = ((out[(plen - 1)]) as u8) as i32;
    outlen.* = (plen - 1);
    return itype;
}

fn tls_alloc_conn() *TlsConn {
    let c: *TlsConn = (_zag_malloc(@sizeOf[TlsConn]())) as *TlsConn;
    c.*.priv = _zag_malloc(32);
    c.*.transcript = _zag_malloc(20000);
    c.*.tlen = 0;
    c.*.hs_secret = _zag_malloc(32);
    c.*.c_hs = _zag_malloc(32);
    c.*.s_hs_key = _zag_malloc(32);
    c.*.s_hs_iv = _zag_malloc(12);
    c.*.c_hs_key = _zag_malloc(32);
    c.*.c_hs_iv = _zag_malloc(12);
    c.*.s_ap_key = _zag_malloc(32);
    c.*.s_ap_iv = _zag_malloc(12);
    c.*.c_ap_key = _zag_malloc(32);
    c.*.c_ap_iv = _zag_malloc(12);
    c.*.err = 0;
    return c;
}

fn tls_parse_server_hello(sh: *i8, shlen: i32, server_pub: *i8) i32 {
    if ((((sh[0]) as u8) as i32 != 2)) {
        return (0 - 1);
    }
    let p: i32 = 4;
    p = (p + 2);
    p = (p + 32);
    let sidlen: i32 = ((sh[p]) as u8) as i32;
    p = ((p + 1) + sidlen);
    p = (p + 2);
    p = (p + 1);
    let ext_total: i32 = tls_rd16(sh, p);
    p = (p + 2);
    let ext_end: i32 = (p + ext_total);
    while (((p + 4) <= ext_end)) {
        let etype: i32 = tls_rd16(sh, p);
        p = (p + 2);
        let elen: i32 = tls_rd16(sh, p);
        p = (p + 2);
        if ((etype == 51)) {
            let keylen: i32 = tls_rd16(sh, (p + 2));
            let i: i32 = 0;
            while (((i < keylen) && (i < 32))) {
                server_pub[i] = sh[((p + 4) + i)];
                i = (i + 1);
            }
            return 0;
        }
        p = (p + elen);
    }
    return (0 - 2);
}

fn tls_https_get(host: []u8, port: i32, path: []u8, out: *i8, cap: i32) i32 {
    let ip: i64 = net_dns_resolve(host);
    if ((ip < 0)) {
        return (0 - 10);
    }
    let fd: i64 = net_tcp_connect(ip, port);
    if ((fd < 0)) {
        return (0 - 11);
    }
    let c: *TlsConn = tls_alloc_conn();
    c.*.fd = fd;
    let _r: i32 = crypto_random(c.*.priv, 32);
    let pub: *i8 = _zag_malloc(32);
    x25519_base(pub, c.*.priv);
    let ch: *i8 = _zag_malloc(1024);
    let chlen: i32 = tls_build_client_hello(c, host, pub, ch);
    tls_transcript_add(c, ch, chlen);
    let _w: i64 = tls_send_plain(c, ch, chlen);
    let rbuf: *i8 = _zag_malloc(20000);
    let rtype: i32 = 0;
    let rlen: i32 = tls_read_record(c, &rtype, rbuf);
    while (((rlen > 0) && (rtype == 20))) {
        rlen = tls_read_record(c, &rtype, rbuf);
    }
    if (((rlen < 0) || (rtype != 22))) {
        net_tcp_close(fd);
        return (0 - 12);
    }
    tls_transcript_add(c, rbuf, rlen);
    let server_pub: *i8 = _zag_malloc(32);
    if ((tls_parse_server_hello(rbuf, rlen, server_pub) != 0)) {
        net_tcp_close(fd);
        return (0 - 13);
    }
    tls_key_schedule(c, server_pub);
    let hs_stream: *i8 = _zag_malloc(20000);
    let hs_len: i32 = 0;
    let saw_finished: i32 = 0;
    let dec: *i8 = _zag_malloc(20000);
    let guard: i32 = 0;
    while (((saw_finished == 0) && (guard < 32))) {
        rlen = tls_read_record(c, &rtype, rbuf);
        if ((rlen < 0)) {
            net_tcp_close(fd);
            return (0 - 14);
        }
        if ((rtype == 20)) {
            guard = (guard + 1);
        }
        if ((rtype == 23)) {
            let plen: i32 = 0;
            let itype: i32 = tls_decrypt_record(c.*.s_hs_key, c.*.s_hs_iv, c.*.s_seq, rbuf, rlen, dec, &plen);
            c.*.s_seq = (c.*.s_seq + 1);
            if ((itype < 0)) {
                net_tcp_close(fd);
                return (0 - 15);
            }
            if ((itype == 22)) {
                let i: i32 = 0;
                while ((i < plen)) {
                    hs_stream[(hs_len + i)] = dec[i];
                    i = (i + 1);
                }
                hs_len = (hs_len + plen);
                let q: i32 = 0;
                while (((q + 4) <= hs_len)) {
                    let mtype: i32 = ((hs_stream[q]) as u8) as i32;
                    let mlen: i32 = tls_rd24(hs_stream, (q + 1));
                    if ((((q + 4) + mlen) > hs_len)) {
                        q = hs_len;
                    } else {
                        if ((mtype == 20)) {
                            saw_finished = 1;
                        }
                        q = ((q + 4) + mlen);
                    }
                }
            }
        }
        guard = (guard + 1);
    }
    if ((saw_finished == 0)) {
        net_tcp_close(fd);
        return (0 - 16);
    }
    tls_transcript_add(c, hs_stream, hs_len);
    let th_sf: *i8 = _zag_malloc(32);
    tls_transcript_hash(c, th_sf);
    let fin_key: *i8 = _zag_malloc(32);
    hkdf_expand_label(c.*.c_hs, "finished", (0) as *i8, 0, 32, fin_key);
    let verify: *i8 = _zag_malloc(32);
    hmac_sha256(fin_key, 32, th_sf, 32, verify);
    let finmsg: *i8 = _zag_malloc(36);
    let fp: i32 = tls_put8(finmsg, 0, 20);
    fp = tls_put24(finmsg, 1, 32);
    fp = tls_putbytes(finmsg, fp, verify, 32);
    let _cf: i64 = tls_send_encrypted(c, c.*.c_hs_key, c.*.c_hs_iv, c.*.c_seq, 22, finmsg, fp);
    c.*.c_seq = (c.*.c_seq + 1);
    tls_app_schedule(c);
    c.*.s_seq = 0;
    let c_app_seq: i64 = 0;
    let req: []u8 = _zag_str_concat("GET ", path);
    req = _zag_str_concat(req, " HTTP/1.0\r\nHost: ");
    req = _zag_str_concat(req, host);
    req = _zag_str_concat(req, "\r\nUser-Agent: RayBrowser/0.1 (RayOS)\r\nConnection: close\r\n\r\n");
    let reqbuf: *i8 = _zag_malloc(req.len);
    let i: i32 = 0;
    while ((i < req.len)) {
        reqbuf[i] = (req[i]) as i8;
        i = (i + 1);
    }
    let _hr: i64 = tls_send_encrypted(c, c.*.c_ap_key, c.*.c_ap_iv, c_app_seq, 23, reqbuf, req.len);
    c_app_seq = (c_app_seq + 1);
    let total: i32 = 0;
    let reading: i32 = 1;
    while (((reading == 1) && (total < cap))) {
        rlen = tls_read_record(c, &rtype, rbuf);
        if ((rlen < 0)) {
            reading = 0;
        } else if ((rtype == 23)) {
            let plen: i32 = 0;
            let itype: i32 = tls_decrypt_record(c.*.s_ap_key, c.*.s_ap_iv, c.*.s_seq, rbuf, rlen, dec, &plen);
            c.*.s_seq = (c.*.s_seq + 1);
            if ((itype < 0)) {
                reading = 0;
            } else if ((itype == 23)) {
                let k: i32 = 0;
                while (((k < plen) && (total < cap))) {
                    out[total] = dec[k];
                    total = (total + 1);
                    k = (k + 1);
                }
            } else if ((itype == 21)) {
                reading = 0;
            }
        } else if ((rtype == 21)) {
            reading = 0;
        }
    }
    net_tcp_close(fd);
    return total;
}

struct HttpUrl {
    ok: i32,
    secure: i32,
    host: []u8,
    port: i32,
    path: []u8,
}

struct HttpResponse {
    ok: i32,
    status: i32,
    secure: i32,
    ip: i64,
    headers: []u8,
    body: []u8,
    error: []u8,
}

fn http_lower(c: u8) u8 {
    if (((c >= (65) as u8) && (c <= (90) as u8))) {
        return (c + 32);
    }
    return c;
}

fn http_ci_contains(hay: []u8, needle: []u8) i32 {
    if ((needle.len < 1)) {
        return 1;
    }
    if ((hay.len < needle.len)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i <= (hay.len - needle.len))) {
        let j: i32 = 0;
        let hit: i32 = 1;
        while ((j < needle.len)) {
            if ((http_lower(hay[(i + j)]) != http_lower(needle[j]))) {
                hit = 0;
                j = needle.len;
            } else {
                j = (j + 1);
            }
        }
        if ((hit == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn http_header(headers: []u8, name: []u8) []u8 {
    let n: i32 = 0;
    let start: i32 = 0;
    while ((n <= headers.len)) {
        if (((n == headers.len) || (headers[n] == (10) as u8))) {
            let line: []u8 = headers[start..n];
            if ((line.len > (name.len + 1))) {
                let match: i32 = 1;
                let k: i32 = 0;
                while ((k < name.len)) {
                    if ((http_lower(line[k]) != http_lower(name[k]))) {
                        match = 0;
                        k = name.len;
                    } else {
                        k = (k + 1);
                    }
                }
                if (((match == 1) && (line[name.len] == (58) as u8))) {
                    let v: i32 = (name.len + 1);
                    while (((v < line.len) && ((line[v] == (32) as u8) || (line[v] == (9) as u8)))) {
                        v = (v + 1);
                    }
                    let e: i32 = line.len;
                    while (((e > v) && ((line[(e - 1)] == (13) as u8) || (line[(e - 1)] == (32) as u8)))) {
                        e = (e - 1);
                    }
                    return line[v..e];
                }
            }
            start = (n + 1);
        }
        n = (n + 1);
    }
    return "";
}

fn http_parse_url(url: []u8) HttpUrl {
    let bad: HttpUrl = HttpUrl{ .ok = 0, .secure = 0, .host = "", .port = 80, .path = "/" };
    let at: i32 = 0;
    let scheme_end: i32 = (0 - 1);
    let i: i32 = 0;
    while (((i + 2) < url.len)) {
        if ((((url[i] == (58) as u8) && (url[(i + 1)] == (47) as u8)) && (url[(i + 2)] == (47) as u8))) {
            scheme_end = i;
            i = url.len;
        } else {
            i = (i + 1);
        }
    }
    let secure: i32 = 0;
    let port: i32 = 80;
    if ((scheme_end >= 0)) {
        if ((scheme_end == 5)) {
            secure = 1;
            port = 443;
        }
        at = (scheme_end + 3);
    }
    let hstart: i32 = at;
    while ((((at < url.len) && (url[at] != (47) as u8)) && (url[at] != (58) as u8))) {
        at = (at + 1);
    }
    let host: []u8 = url[hstart..at];
    if ((host.len < 1)) {
        return bad;
    }
    if (((at < url.len) && (url[at] == (58) as u8))) {
        at = (at + 1);
        let pstart: i32 = at;
        while (((at < url.len) && (url[at] != (47) as u8))) {
            at = (at + 1);
        }
        port = (_zag_str_to_i64(url[pstart..at])) as i32;
    }
    let path: []u8 = "/";
    if ((at < url.len)) {
        path = url[at..url.len];
    }
    return HttpUrl{ .ok = 1, .secure = secure, .host = host, .port = port, .path = path };
}

fn http_parse_status(resp: []u8) i32 {
    let i: i32 = 0;
    while (((i < resp.len) && (resp[i] != (32) as u8))) {
        i = (i + 1);
    }
    while (((i < resp.len) && (resp[i] == (32) as u8))) {
        i = (i + 1);
    }
    let code: i32 = 0;
    while ((((i < resp.len) && (resp[i] >= (48) as u8)) && (resp[i] <= (57) as u8))) {
        code = ((code * 10) + ((resp[i]) as i32 - (48) as i32));
        i = (i + 1);
    }
    return code;
}

fn http_body_offset(resp: []u8) i32 {
    let i: i32 = 0;
    while (((i + 3) < resp.len)) {
        if (((((resp[i] == (13) as u8) && (resp[(i + 1)] == (10) as u8)) && (resp[(i + 2)] == (13) as u8)) && (resp[(i + 3)] == (10) as u8))) {
            return (i + 4);
        }
        i = (i + 1);
    }
    i = 0;
    while (((i + 1) < resp.len)) {
        if (((resp[i] == (10) as u8) && (resp[(i + 1)] == (10) as u8))) {
            return (i + 2);
        }
        i = (i + 1);
    }
    return resp.len;
}

fn http_hexval(c: u8) i32 {
    if (((c >= (48) as u8) && (c <= (57) as u8))) {
        return ((c) as i32 - (48) as i32);
    }
    if (((c >= (97) as u8) && (c <= (102) as u8))) {
        return (((c) as i32 - (97) as i32) + 10);
    }
    if (((c >= (65) as u8) && (c <= (70) as u8))) {
        return (((c) as i32 - (65) as i32) + 10);
    }
    return (0 - 1);
}

fn http_dechunk(body: []u8) []u8 {
    let out: *i8 = _zag_malloc((body.len + 1));
    let n: i32 = 0;
    let at: i32 = 0;
    let go: i32 = 1;
    while (((go == 1) && (at < body.len))) {
        let sz: i32 = 0;
        let any: i32 = 0;
        while (((at < body.len) && (http_hexval(body[at]) >= 0))) {
            sz = ((sz * 16) + http_hexval(body[at]));
            at = (at + 1);
            any = (any + 1);
        }
        while (((at < body.len) && (body[at] != (10) as u8))) {
            at = (at + 1);
        }
        at = (at + 1);
        if (((any == 0) || (sz == 0))) {
            go = 0;
        } else {
            let k: i32 = 0;
            while (((k < sz) && (at < body.len))) {
                out[n] = (body[at]) as i8;
                n = (n + 1);
                at = (at + 1);
                k = (k + 1);
            }
            while (((at < body.len) && ((body[at] == (13) as u8) || (body[at] == (10) as u8)))) {
                at = (at + 1);
            }
        }
    }
    let ou: *u8 = (out) as *u8;
    return ou[0..n];
}

fn http_err(msg: []u8) HttpResponse {
    return HttpResponse{ .ok = 0, .status = 0, .secure = 0, .ip = (0 - 1), .headers = "", .body = "", .error = msg };
}

fn http_fetch_once(url: []u8) HttpResponse {
    let u: HttpUrl = http_parse_url(url);
    if ((u.ok == 0)) {
        return http_err("bad url");
    }
    let resp: []u8 = "";
    if ((u.secure == 1)) {
        let cap: i32 = 524288;
        let out: *i8 = _zag_malloc(cap);
        let n: i32 = tls_https_get(u.host, u.port, u.path, out, cap);
        if ((n < 0)) {
            return http_err("tls handshake failed");
        }
        let ou: *u8 = (out) as *u8;
        resp = ou[0..n];
    } else {
        let ip: i64 = net_dns_resolve(u.host);
        if ((ip < 0)) {
            return http_err("dns resolution failed");
        }
        let fd: i64 = net_tcp_connect(ip, u.port);
        if ((fd < 0)) {
            return http_err("connect failed");
        }
        let req: []u8 = _zag_str_concat("GET ", u.path);
        req = _zag_str_concat(req, " HTTP/1.1\r\nHost: ");
        req = _zag_str_concat(req, u.host);
        req = _zag_str_concat(req, "\r\nUser-Agent: RayBrowser/0.1 (RayOS)\r\nConnection: close\r\n\r\n");
        let w: i64 = net_tcp_send(fd, req);
        if ((w < 0)) {
            net_tcp_close(fd);
            return http_err("send failed");
        }
        resp = net_tcp_recv_all(fd, 524288);
        net_tcp_close(fd);
    }
    if ((resp.len < 12)) {
        return http_err("empty response");
    }
    let status: i32 = http_parse_status(resp);
    let boff: i32 = http_body_offset(resp);
    let headers: []u8 = resp[0..boff];
    let body: []u8 = resp[boff..resp.len];
    if ((http_ci_contains(http_header(headers, "transfer-encoding"), "chunked") == 1)) {
        body = http_dechunk(body);
    }
    return HttpResponse{ .ok = 1, .status = status, .secure = u.secure, .ip = 0, .headers = headers, .body = body, .error = "" };
}

fn http_resolve_location(base: []u8, loc: []u8) []u8 {
    if ((loc.len < 1)) {
        return base;
    }
    let i: i32 = 0;
    while (((i + 2) < loc.len)) {
        if ((((loc[i] == (58) as u8) && (loc[(i + 1)] == (47) as u8)) && (loc[(i + 2)] == (47) as u8))) {
            return loc;
        }
        i = (i + 1);
    }
    let bu: HttpUrl = http_parse_url(base);
    let scheme: []u8 = "http://";
    if ((bu.secure == 1)) {
        scheme = "https://";
    }
    let origin: []u8 = _zag_str_concat(scheme, bu.host);
    if ((loc[0] == (47) as u8)) {
        return _zag_str_concat(origin, loc);
    }
    return _zag_str_concat(origin, _zag_str_concat("/", loc));
}

fn http_get(url: []u8) HttpResponse {
    let current: []u8 = url;
    let hops: i32 = 0;
    let r: HttpResponse = http_fetch_once(current);
    while ((((r.ok == 1) && (hops < 5)) && (((((r.status == 301) || (r.status == 302)) || (r.status == 303)) || (r.status == 307)) || (r.status == 308)))) {
        let loc: []u8 = http_header(r.headers, "location");
        if ((loc.len < 1)) {
            hops = 5;
        } else {
            current = http_resolve_location(current, loc);
            r = http_fetch_once(current);
            hops = (hops + 1);
        }
    }
    return r;
}

struct Compositor {
    fb: SoftFb,
    wm: WmState,
    desktop: DesktopState,
    shell: ShellState,
    launcher: LauncherState,
    desktop_w: i32,
    desktop_h: i32,
    wall_r0: i32,
    wall_g0: i32,
    wall_b0: i32,
    wall_r1: i32,
    wall_g1: i32,
    wall_b1: i32,
    guest_pool: ArrayList[u8],
    bg: ArrayList[u8],
    bg_valid: i32,
    devices_report: []u8,
    term_buf: ArrayList[u8],
    term_input: ArrayList[u8],
    term_cwd: i64,
    term_hist: ArrayList[u8],
    term_hist_pos: i32,
    scheduler: RayScheduler,
    filesystem: TriFs,
    browser_document: HtmlDocument,
    browser_url: []u8,
    browser_status: []u8,
    browser_addr: ArrayList[u8],
    browser_editing: i32,
    compositor_task: i64,
    filesystem_task: i64,
    dirty: i32,
    dmg_x0: i32,
    dmg_y0: i32,
    dmg_x1: i32,
    dmg_y1: i32,
}

fn comp_clamp_i(v: i32, lo: i32, hi: i32) i32 {
    if ((v < lo)) {
        return lo;
    }
    if ((v > hi)) {
        return hi;
    }
    return v;
}

fn comp_rects_overlap(ax0: i32, ay0: i32, ax1: i32, ay1: i32, bx0: i32, by0: i32, bx1: i32, by1: i32) i32 {
    if (((((ax1 < bx0) || (bx1 < ax0)) || (ay1 < by0)) || (by1 < ay0))) {
        return 0;
    }
    return 1;
}

fn softgpu_blit_rect(dst: *SoftFb, dx: i32, dy: i32, dw: i32, dh: i32, src: ArrayList[u8], src_w: i32, src_h: i32, src_off: i32) void {
    if (((((dw < 1) || (dh < 1)) || (src_w < 1)) || (src_h < 1))) {
        return;
    }
    let y: i32 = 0;
    while ((y < dh)) {
        let sy: i32 = ((y * src_h) / dh);
        let x: i32 = 0;
        while ((x < dw)) {
            let sx: i32 = ((x * src_w) / dw);
            let si: i32 = (src_off + (((sy * src_w) + sx) * 3));
            if (((si >= 0) && ((si + 2) < len[u8](src)))) {
                let px: i32 = (dx + x);
                let py: i32 = (dy + y);
                softgpu_pixel(dst, px, py, (get[u8](src, si)) as i32, (get[u8](src, (si + 1))) as i32, (get[u8](src, (si + 2))) as i32);
            }
            x = (x + 1);
        }
        y = (y + 1);
    }
    softgpu_damage_mark_rect(dst, dx, dy, ((dx + dw) - 1), ((dy + dh) - 1));
}

fn comp_new(w: i32, h: i32) Compositor {
    let th: RayOsTheme = rayos_theme();
    let fb: SoftFb = softgpu_new(w, h);
    softgpu_damage_on(&fb);
    let scheduler: RayScheduler = scheduler_new();
    let compositor_task: i64 = scheduler_spawn(&scheduler, 0, "compositor", 6);
    let filesystem_task: i64 = scheduler_spawn(&scheduler, 0, "trifs", 3);
    let _input_task: i64 = scheduler_spawn(&scheduler, 0, "input", 5);
    let _network_task: i64 = scheduler_spawn(&scheduler, 0, "network", 2);
    let _index_task: i64 = scheduler_spawn(&scheduler, filesystem_task, "indexer", (0 - 4));
    let filesystem: TriFs = trifs_new();
    let _tx: i32 = trifs_begin(&filesystem, filesystem_task);
    let home: i64 = trifs_create(&filesystem, filesystem_task, trifs_root_inode(), "home", trifs_directory());
    let docs: i64 = trifs_create(&filesystem, filesystem_task, home, "Documents", trifs_directory());
    let _welcome: i64 = trifs_create(&filesystem, filesystem_task, docs, "Welcome.tri", trifs_file());
    let _apps: i64 = trifs_create(&filesystem, filesystem_task, trifs_root_inode(), "Applications", trifs_directory());
    let _commit: i32 = trifs_commit(&filesystem, filesystem_task);
    let browser_document: HtmlDocument = html_parse("<!doctype html><html><body><h1>Welcome to RayOS</h1><p>Ray Browser parses and renders this document in Flash.</p><h2>Balanced ternary by design</h2><p>No external browser engine is embedded. Web content stays inside a bounded inert DOM.</p><hr><p>Networking and CSS are the next conformance layers.</p></body></html>");
    return Compositor{ .fb = fb, .wm = wm_new(), .desktop = desktop_new(w, h), .shell = shell_new(w, h), .launcher = launcher_new(w, h), .desktop_w = w, .desktop_h = h, .wall_r0 = th.wall_r0, .wall_g0 = th.wall_g0, .wall_b0 = th.wall_b0, .wall_r1 = th.wall_r1, .wall_g1 = th.wall_g1, .wall_b1 = th.wall_b1, .guest_pool = make[u8](((w * h) * 3)), .bg = make[u8](((w * h) * 3)), .bg_valid = 0, .devices_report = "", .term_buf = make[u8](512), .term_input = make[u8](64), .term_cwd = trifs_root_inode(), .term_hist = make[u8](256), .term_hist_pos = -1, .scheduler = scheduler, .filesystem = filesystem, .browser_document = browser_document, .browser_url = "rayos://welcome", .browser_status = "internal page", .browser_addr = make[u8](64), .browser_editing = 0, .compositor_task = compositor_task, .filesystem_task = filesystem_task, .dirty = 0, .dmg_x0 = 0, .dmg_y0 = 0, .dmg_x1 = -1, .dmg_y1 = -1 };
}

fn comp_free(c: *Compositor) void {
    let wi: i32 = 0;
    while ((wi < len[RayWindow](c.*.wm.windows))) {
        let cw: RayWindow = get[RayWindow](c.*.wm.windows, wi);
        wm_free_cache(&cw);
        set[RayWindow](&c.*.wm.windows, wi, cw);
        wi = (wi + 1);
    }
    free[u8](&c.*.fb.pix);
    free[u8](&c.*.fb.mask);
    free[u8](&c.*.fb.acc);
    free[RayWindow](&c.*.wm.windows);
    free[DesktopIcon](&c.*.desktop.icons);
    free[i32](&c.*.shell.win_btn_x);
    free[i32](&c.*.shell.win_btn_w);
    free[i32](&c.*.shell.win_btn_id);
    free[u8](&c.*.guest_pool);
    free[u8](&c.*.bg);
    free[u8](&c.*.term_buf);
    free[u8](&c.*.term_input);
    free[u8](&c.*.term_hist);
    free[u8](&c.*.browser_addr);
    scheduler_free(&c.*.scheduler);
    trifs_free(&c.*.filesystem);
    html_document_free(&c.*.browser_document);
}

fn comp_work_h(c: *Compositor) i32 {
    let th: RayOsTheme = c.*.wm.theme;
    let wh: i32 = (c.*.desktop_h - th.taskbar_h);
    if ((wh < 1)) {
        wh = 1;
    }
    return wh;
}

fn comp_paint_wallpaper_region(c: *Compositor, x0: i32, y0: i32, x1: i32, y1: i32) void {
    let fb: *SoftFb = &c.*.fb;
    let work_h: i32 = comp_work_h(c);
    let rx0: i32 = comp_clamp_i(x0, 0, (c.*.desktop_w - 1));
    let ry0: i32 = comp_clamp_i(y0, 0, (c.*.desktop_h - 1));
    let rx1: i32 = comp_clamp_i(x1, 0, (c.*.desktop_w - 1));
    let ry1: i32 = comp_clamp_i(y1, 0, (c.*.desktop_h - 1));
    if (((rx1 < rx0) || (ry1 < ry0))) {
        return;
    }
    vg_set_clip(fb, rx0, ry0, ((rx1 - rx0) + 1), ((ry1 - ry0) + 1));
    let bg: VPath = vg_path_new();
    vg_move_to(&bg, (rx0) as f32, (ry0) as f32);
    vg_line_to(&bg, ((rx1 + 1)) as f32, (ry0) as f32);
    vg_line_to(&bg, ((rx1 + 1)) as f32, ((ry1 + 1)) as f32);
    vg_line_to(&bg, (rx0) as f32, ((ry1 + 1)) as f32);
    vg_close(&bg);
    vg_fill_linear(fb, &bg, 0.0, 0.0, 0.0, (work_h) as f32, c.*.wall_r0, c.*.wall_g0, c.*.wall_b0, 255, c.*.wall_r1, c.*.wall_g1, c.*.wall_b1, 255);
    vg_clear_clip(fb);
}

