            let di: i32 = (fb_off + (((y * w) + x) * 3));
            if (((di >= 0) && ((di + 2) < len[u8](guest_pool.*)))) {
                set[u8](guest_pool, di, (rr) as u8);
                set[u8](guest_pool, (di + 1), (gg) as u8);
                set[u8](guest_pool, (di + 2), (bb) as u8);
            }
            x = (x + 1);
        }
        y = (y + 1);
    }
}

fn guest_linux_step_frame(btm: *BinaryTranslationMatrix, guest_ram: ArrayList[u8], guest_pool: *ArrayList[u8], fb_off: i32, w: i32, h: i32) void {
    let _steps: i32 = guest_linux_step_n(btm, guest_ram, GUEST_LINUX_STEPS_PER_FRAME());
    guest_linux_render_fb(btm, guest_ram, guest_pool, fb_off, w, h);
}

struct GuestLinuxHost {
    btm: *BinaryTranslationMatrix,
    ram: ArrayList[u8],
    ready: i32,
}

fn guest_linux_host_cache_path() []u8 {
    let pid: []u8 = _zag_i64_to_str(hw_rt_getpid());
    return _zag_str_concat(_zag_str_concat("/tmp/rayos_guest_linux_host.", pid), ".ptr");
}

fn guest_linux_host_from_cache() ?*GuestLinuxHost {
    let path: []u8 = guest_linux_host_cache_path();
    if ((_zag_file_exists(path) == 0)) {
        return null;
    }
    let text: []u8 = _zag_read_file(path);
    if ((text.len < 1)) {
        return null;
    }
    let addr: i64 = _zag_str_to_i64(text);
    if ((addr == 0)) {
        return null;
    }
    return (addr) as *GuestLinuxHost;
}

fn guest_linux_host_to_cache(host: *GuestLinuxHost) void {
    let path: []u8 = guest_linux_host_cache_path();
    let text: []u8 = _zag_i64_to_str((host) as i64);
    _zag_write_file(path, text);
}

fn guest_linux_host_mut() *GuestLinuxHost {
    if (guest_linux_host_from_cache()) |cached| {
        return cached;
    }
    let raw: *i8 = _zag_malloc(@sizeOf[GuestLinuxHost]());
    let host: *GuestLinuxHost = (raw) as *GuestLinuxHost;
    host.* = GuestLinuxHost{ .btm = (null) as *BinaryTranslationMatrix, .ram = make[u8](0), .ready = 0 };
    guest_linux_host_to_cache(host);
    return host;
}

fn guest_linux_host_ensure() void {
    let host: *GuestLinuxHost = guest_linux_host_mut();
    if ((host.*.ready == 1)) {
        return;
    }
    host.*.btm = btm_new();
    host.*.ram = guest_ram_new_default();
    let _vg: i32 = virtio_gpu_guest_init();
    guest_linux_attach(host.*.btm, &host.*.ram);
    host.*.ready = 1;
}

fn virtio_gpu_available() i32 {
    if (virtio_gpu_guest_state_from_cache()) |st| {
        if ((st.*.ready == 1)) {
            return 1;
        }
    }
    return 0;
}

fn virtio_gpu_blit(guest_pool: *ArrayList[u8], fb_off: i32, w: i32, h: i32) void {
    let host: *GuestLinuxHost = guest_linux_host_mut();
    virtio_gpu_blit_from_guest_ram(&host.*.ram, guest_pool, fb_off, w, h);
}

fn guest_linux_host_step_guest_pool(guest_pool: *ArrayList[u8], fb_off: i32, w: i32, h: i32) void {
    guest_linux_host_ensure();
    let host: *GuestLinuxHost = guest_linux_host_mut();
    if ((virtio_gpu_available() == 1)) {
        let _steps: i32 = guest_linux_step_n(host.*.btm, host.*.ram, GUEST_LINUX_STEPS_PER_FRAME());
        virtio_gpu_blit(guest_pool, fb_off, w, h);
        return;
    }
    guest_linux_step_frame(host.*.btm, host.*.ram, guest_pool, fb_off, w, h);
}

fn guest_linux_host_pc() u64 {
    guest_linux_host_ensure();
    let host: *GuestLinuxHost = guest_linux_host_mut();
    return guest_linux_pc(host.*.btm);
}

fn RAYOS_DESKTOP_W() i32 {
    return 1280;
}

fn RAYOS_DESKTOP_H() i32 {
    return 800;
}

struct RayOsDesktopDrag {
    active: i32,
    win_id: i32,
    off_x: i32,
    off_y: i32,
}

fn rayos_desktop_drag_new() RayOsDesktopDrag {
    return RayOsDesktopDrag{ .active = 0, .win_id = -1, .off_x = 0, .off_y = 0 };
}

fn rayos_desktop_spin_wait() void {
    hw_sleep_ms(1);
}

fn rayos_desktop_taskbar_y(comp: *Compositor) i32 {
    let th: RayOsTheme = comp.*.wm.theme;
    return (comp.*.desktop_h - th.taskbar_h);
}

fn rayos_desktop_in_taskbar(comp: *Compositor, my: i32) i32 {
    if ((my >= rayos_desktop_taskbar_y(comp))) {
        return 1;
    }
    return 0;
}

fn rayos_desktop_spawn_guest_window_at(comp: *Compositor, title: []u8, guest_id: i32, x: i32, y: i32, gw: i32, gh: i32, r: i32, g: i32, b: i32) i32 {
    guest_fb_bind_pool(&comp.*.guest_pool);
    let off: i32 = guest_fb_alloc(gw, gh);
    if ((guest_id != 1)) {
        guest_fb_fill(comp.*.guest_pool, off, gw, gh, r, g, b);
    }
    return wm_add_window(&comp.*.wm, title, x, y, (gw + 2), (gh + 34), wm_content_guest(), guest_id, off);
}

fn rayos_desktop_spawn_guest_window(comp: *Compositor) i32 {
    return rayos_desktop_spawn_guest_window_at(comp, "GUEST-LINUX", 1, 140, 100, 480, 320, 48, 180, 64);
}

fn rayos_desktop_spawn_native_window(comp: *Compositor, title: []u8, content_kind: i32, x: i32, y: i32, w: i32, h: i32) i32 {
    return wm_add_window(&comp.*.wm, title, x, y, w, h, content_kind, 0, 0);
}

fn rayos_desktop_spawn_launcher_app(comp: *Compositor, app_id: i32) void {
    if ((app_id < 0)) {
        return;
    }
    let title: []u8 = launcher_app_title(app_id);
    let kind: i32 = launcher_app_content_kind(app_id);
    if ((kind == wm_content_guest())) {
        let gid: i32 = launcher_app_guest_id(app_id);
        let rr: i32 = 48;
        let rg: i32 = 180;
        let rb: i32 = 64;
        if ((gid == 2)) {
            rr = 32;
            rg = 96;
            rb = 200;
        }
        let _id: i32 = rayos_desktop_spawn_guest_window_at(comp, title, gid, 180, 120, 520, 340, rr, rg, rb);
        comp_set_guest_vms(comp, wm_count_visible(&comp.*.wm));
        return;
    }
    let win_w: i32 = 520;
    let win_h: i32 = 360;
    if ((kind == wm_content_tasks())) {
        win_w = 720;
        win_h = 460;
    }
    if ((kind == wm_content_files())) {
        win_w = 680;
        win_h = 440;
    }
    if ((kind == wm_content_browser())) {
        win_w = 820;
        win_h = 560;
    }
    let _id2: i32 = rayos_desktop_spawn_native_window(comp, title, kind, 200, 120, win_w, win_h);
}

fn rayos_desktop_spawn_desktop_icon(comp: *Compositor, icon_id: i32) void {
    if ((icon_id == desktop_icon_none())) {
        return;
    }
    let title: []u8 = desktop_icon_label(icon_id);
    let kind: i32 = wm_content_native();
    if ((icon_id == desktop_icon_files())) {
        kind = wm_content_files();
    }
    let _id: i32 = rayos_desktop_spawn_native_window(comp, title, kind, 220, 140, 620, 400);
}

fn rayos_desktop_handle_shell(comp: *Compositor, drag: *RayOsDesktopDrag, mx: i32, my: i32, btn: i32) i32 {
    let sh: ShellHit = shell_hit_test(comp.*.shell, &comp.*.wm, mx, my);
    if ((btn != 0)) {
        if ((sh.kind == shell_hit_start())) {
            comp_launcher_open(comp);
            return 1;
        }
        if (((sh.kind == shell_hit_window()) && (sh.id >= 0))) {
            wm_focus(&comp.*.wm, sh.id);
            return 1;
        }
        if ((sh.kind == shell_hit_logo())) {
            comp_launcher_close(comp);
            return 1;
        }
    }
    return 0;
}

fn rayos_desktop_handle_launcher(comp: *Compositor, mx: i32, my: i32, btn: i32) i32 {
    if (((launcher_is_open(comp.*.launcher) == 0) && (comp.*.launcher.slide <= 0.001))) {
        return 0;
    }
    let hit: i32 = launcher_hit_test(&comp.*.launcher, &comp.*.wm, mx, my);
    if ((btn != 0)) {
        if ((hit == launcher_hit_close())) {
            comp_launcher_close(comp);
            return 1;
        }
        if ((hit == launcher_hit_search())) {
            return 1;
        }
        if ((hit >= 0)) {
            rayos_desktop_spawn_launcher_app(comp, hit);
            comp_launcher_close(comp);
            return 1;
        }
    }
    return 1;
}

fn rayos_desktop_handle_desktop(comp: *Compositor, mx: i32, my: i32, btn: i32) i32 {
    if ((btn == 0)) {
        return 0;
    }
    let icon_id: i32 = desktop_hit_test(comp.*.desktop, &comp.*.wm, mx, my);
    if ((icon_id != desktop_icon_none())) {
        rayos_desktop_spawn_desktop_icon(comp, icon_id);
        return 1;
    }
    return 0;
}

fn rayos_desktop_handle_window_press(comp: *Compositor, drag: *RayOsDesktopDrag, mx: i32, my: i32) void {
    let hit: i32 = wm_hit_test(&comp.*.wm, mx, my);
    let win_id: i32 = wm_hit_test_window(&comp.*.wm, mx, my);
    if ((win_id < 0)) {
        return;
    }
    if ((hit == wm_hit_close())) {
        wm_close(&comp.*.wm, win_id);
        drag.*.active = 0;
        drag.*.win_id = -1;
        return;
    }
    if ((hit == wm_hit_min())) {
        wm_minimize(&comp.*.wm, win_id);
        drag.*.active = 0;
        drag.*.win_id = -1;
        return;
    }
    if ((hit == wm_hit_max())) {
        wm_toggle_maximize(&comp.*.wm, win_id, comp.*.desktop_w, comp_work_h(comp));
        drag.*.active = 0;
        drag.*.win_id = -1;
        return;
    }
    if ((hit == wm_hit_titlebar())) {
        let win: RayWindow = wm_get(&comp.*.wm, win_id);
        drag.*.active = 1;
        drag.*.win_id = win_id;
        drag.*.off_x = (mx - win.x);
        drag.*.off_y = (my - win.y);
        wm_focus(&comp.*.wm, win_id);
        return;
    }
    wm_focus(&comp.*.wm, win_id);
}

fn rayos_desktop_handle_key(comp: *Compositor, code: i32) void {
    if ((launcher_is_open(comp.*.launcher) == 1)) {
        let rc: i32 = launcher_key(&comp.*.launcher, code);
        if ((rc == 2)) {
            let app: LauncherApp = launcher_filtered_at(&comp.*.launcher, 0);
            if ((app.id >= 0)) {
                rayos_desktop_spawn_launcher_app(comp, app.id);
            }
            comp_launcher_close(comp);
            return;
        }
        if ((rc == 3)) {
            comp_launcher_close(comp);
            return;
        }
        if ((rc == 1)) {
            return;
        }
        return;
    }
    let win: RayWindow = wm_get(&comp.*.wm, comp.*.wm.focused_id);
    if ((win.id < 0)) {
        return;
    }
    if ((win.content_kind == wm_content_terminal())) {
        if ((comp_term_key(comp, code) == 1)) {
            wm_touch(&comp.*.wm, win.id);
        }
        return;
    }
    if ((win.content_kind == wm_content_devices())) {
        if ((code == (114) as i32)) {
            comp.*.devices_report = device_manager_scan();
            wm_touch(&comp.*.wm, win.id);
        }
        return;
    }
    if ((win.content_kind == wm_content_browser())) {
        if ((comp_browser_key(comp, code) == 1)) {
            wm_touch(&comp.*.wm, win.id);
        }
        return;
    }
}

fn rayos_desktop_handle_input(comp: *Compositor, drag: *RayOsDesktopDrag, kind: i32, mx: i32, my: i32, btn: i32) void {
    if ((kind == INPUT_KIND_KEY())) {
        if ((btn == 1)) {
            rayos_desktop_handle_key(comp, mx);
        }
        return;
    }
    if ((kind == INPUT_KIND_MOVE())) {
        if (((drag.*.active == 1) && (drag.*.win_id >= 0))) {
            wm_move(&comp.*.wm, drag.*.win_id, (mx - drag.*.off_x), (my - drag.*.off_y));
        }
        return;
    }
    if ((btn == 0)) {
        drag.*.active = 0;
        drag.*.win_id = -1;
        return;
    }
    if ((rayos_desktop_handle_launcher(comp, mx, my, btn) == 1)) {
        return;
    }
    if ((rayos_desktop_in_taskbar(comp, my) == 1)) {
        let _sh: i32 = rayos_desktop_handle_shell(comp, drag, mx, my, btn);
        return;
    }
    let win_id: i32 = wm_hit_test_window(&comp.*.wm, mx, my);
    if ((win_id < 0)) {
        if ((rayos_desktop_handle_desktop(comp, mx, my, btn) == 1)) {
            return;
        }
        return;
    }
    rayos_desktop_handle_window_press(comp, drag, mx, my);
}

fn rayos_desktop_guest_linux_tick(comp: *Compositor) void {
    let th: RayOsTheme = comp.*.wm.theme;
    let i: i32 = 0;
    while ((i < len[RayWindow](comp.*.wm.windows))) {
        let win: RayWindow = get[RayWindow](comp.*.wm.windows, i);
        if ((win.minimized == 0)) {
            if ((win.content_kind == wm_content_guest())) {
                if ((win.guest_id == 1)) {
                    let gw: i32 = (win.w - 2);
                    let gh: i32 = (wm_client_h(win, th) - 2);
                    if (((gw > 0) && (gh > 0))) {
                        guest_linux_host_step_guest_pool(&comp.*.guest_pool, win.fb_offset, gw, gh);
                    }
                }
                wm_touch(&comp.*.wm, win.id);
            }
        }
        i = (i + 1);
    }
}

fn rayos_desktop_count_windows_of(comp: *Compositor, content_kind: i32) i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < len[RayWindow](comp.*.wm.windows))) {
        let win: RayWindow = get[RayWindow](comp.*.wm.windows, i);
        if ((win.content_kind == content_kind)) {
            n = (n + 1);
        }
        i = (i + 1);
    }
    return n;
}

fn rayos_desktop_count_guest_vms(comp: *Compositor) i32 {
    return rayos_desktop_count_windows_of(comp, wm_content_guest());
}

fn rayos_desktop_touch_windows_of(comp: *Compositor, content_kind: i32) void {
    let i: i32 = 0;
    while ((i < len[RayWindow](comp.*.wm.windows))) {
        let win: RayWindow = get[RayWindow](comp.*.wm.windows, i);
        if ((win.content_kind == content_kind)) {
            wm_touch(&comp.*.wm, win.id);
        }
        i = (i + 1);
    }
}

fn rayos_desktop_frame_at(comp: *Compositor, drag: *RayOsDesktopDrag, frame: i32, clock_secs: i64) void {
    comp_set_clock(comp, clock_secs);
    comp_launcher_tick(comp);
    let _scheduled: i64 = scheduler_tick(&comp.*.scheduler, 1);
    rayos_desktop_touch_windows_of(comp, wm_content_tasks());
    rayos_desktop_guest_linux_tick(comp);
    let kind: i32 = 0;
    let mx: i32 = 0;
    let my: i32 = 0;
    let btn: i32 = 0;
    let got: i32 = input_chamber_poll_ev(&kind, &mx, &my, &btn);
    if ((got == 1)) {
        rayos_desktop_handle_input(comp, drag, kind, mx, my, btn);
    }
    comp_render_full(comp);
    let _blit: i32 = scanout_blit(&comp.*.fb);
    let _pres: i32 = scanout_present();
}

fn rayos_desktop_frame(comp: *Compositor, drag: *RayOsDesktopDrag, frame: i32) void {
    let clock_secs: i64 = (((14 * 3600) + (frame * 2))) as i64;
    rayos_desktop_frame_at(comp, drag, frame, clock_secs);
}

fn rayos_desktop_dump_ppm(comp: *Compositor, path: []u8) i32 {
    if ((path.len < 1)) {
        return 0;
    }
    let dev: SoftGpuDevice = SoftGpuDevice{ .kind = 0, .path = path };
    return comp_present(comp, dev);
}

fn rayos_desktop_run_dump(max_frames: i32, ppm_path: []u8) i32 {
    if ((input_chamber_init() != 0)) {
        return (0 - 1);
    }
    if ((display_chamber_init(RAYOS_DESKTOP_W(), RAYOS_DESKTOP_H()) != 0)) {
        return (0 - 2);
    }
    let comp: Compositor = comp_new(RAYOS_DESKTOP_W(), RAYOS_DESKTOP_H());
    let _guest: i32 = rayos_desktop_spawn_guest_window(&comp);
    comp_set_guest_vms(&comp, 1);
    comp_set_network(&comp, 1);
    let drag: RayOsDesktopDrag = rayos_desktop_drag_new();
    let frame: i32 = 0;
    while (((max_frames == 0) || (frame < max_frames))) {
        rayos_desktop_frame(&comp, &drag, frame);
        if (((ppm_path.len > 0) && (frame == (max_frames - 1)))) {
            let _dump: i32 = rayos_desktop_dump_ppm(&comp, ppm_path);
        }
        rayos_desktop_spin_wait();
        frame = (frame + 1);
    }
    comp_free(&comp);
    return 0;
}

fn rayos_desktop_run(max_frames: i32) i32 {
    return rayos_desktop_run_dump(max_frames, "");
}

fn rayos_desktop_run_live(max_frames: i32) i32 {
    if ((scanout_live_init(RAYOS_DESKTOP_W(), RAYOS_DESKTOP_H()) != 0)) {
        return (0 - 10);
    }
    if ((input_chamber_init() != 0)) {
        return (0 - 1);
    }
    if ((display_chamber_init(RAYOS_DESKTOP_W(), RAYOS_DESKTOP_H()) != 0)) {
        return (0 - 2);
    }
    let comp: Compositor = comp_new(RAYOS_DESKTOP_W(), RAYOS_DESKTOP_H());
    let tz_off: i64 = rtc_utc_offset_secs(rtc_now_epoch());
    let drag: RayOsDesktopDrag = rayos_desktop_drag_new();
    let frame: i32 = 0;
    let live_path: []u8 = "/tmp/rayos_live_frame.ppm";
    let last_clock: i64 = (0 - 1);
    let last_minute: i64 = (0 - 1);
    let last_slide: f32 = (0.0 - 1.0);
    while (((max_frames == 0) || (frame < max_frames))) {
        let dirty: i32 = 0;
        if ((frame == 0)) {
            dirty = 1;
        }
        let kind: i32 = 0;
        let mx: i32 = 0;
        let my: i32 = 0;
        let btn: i32 = 0;
        while ((input_chamber_poll_ev(&kind, &mx, &my, &btn) == 1)) {
            let dragging: i32 = drag.active;
            rayos_desktop_handle_input(&comp, &drag, kind, mx, my, btn);
            if ((((kind == INPUT_KIND_BUTTON()) || (kind == INPUT_KIND_KEY())) || (dragging == 1))) {
                dirty = 1;
            }
        }
        comp_launcher_tick(&comp);
        if ((comp.launcher.slide != last_slide)) {
            last_slide = comp.launcher.slide;
            dirty = 1;
        }
        let clock_secs: i64 = rtc_secs_of_day((rtc_now_epoch() + tz_off));
        if ((clock_secs != last_clock)) {
            last_clock = clock_secs;
            let _scheduled: i64 = scheduler_tick(&comp.scheduler, 1);
            rayos_desktop_touch_windows_of(&comp, wm_content_tasks());
            if ((rayos_desktop_count_windows_of(&comp, wm_content_tasks()) > 0)) {
                dirty = 1;
            }
            if ((rayos_desktop_count_windows_of(&comp, wm_content_devices()) > 0)) {
                if (((clock_secs % 2) == 0)) {
                    comp.devices_report = device_manager_scan();
                    rayos_desktop_touch_windows_of(&comp, wm_content_devices());
                    dirty = 1;
                }
            }
            if (((clock_secs / 60) != last_minute)) {
                last_minute = (clock_secs / 60);
                dirty = 1;
            }
        }
        let vms: i32 = rayos_desktop_count_guest_vms(&comp);
        if ((vms > 0)) {
            rayos_desktop_guest_linux_tick(&comp);
            dirty = 1;
        }
        if ((dirty == 1)) {
            comp_set_clock(&comp, clock_secs);
            comp_set_guest_vms(&comp, vms);
            comp_set_network(&comp, 0);
            comp_render_full(&comp);
            let _blit: i32 = scanout_blit(&comp.fb);
            let _pres: i32 = scanout_present();
            let _live: i32 = scanout_live_present_once(live_path);
        }
        hw_sleep_ms(4);
        frame = (frame + 1);
    }
    comp_free(&comp);
    return 0;
}

fn main() i32 {
    _zag_println("desktop_integration_test: running");
    scanout_clear_present_flag();
    input_chamber_inject(640, 400, 1);
    let rc: i32 = rayos_desktop_run(1);
    if ((rc != 0)) {
        _zag_print("desktop_integration_test: FAIL desktop rc=");
        _zag_println(_zag_i64_to_str((rc) as i64));
        return 1;
    }
    if ((scanout_present_flag() != 1)) {
        _zag_println("desktop_integration_test: FAIL present_flag");
        return 1;
    }
    _zag_println("desktop_integration_test: ok");
    return 0;
}

