    }
    if ((c == 95)) {
        return "0,14 10,14";
    }
    if ((c == 44)) {
        return "5,12 4,16";
    }
    if ((c == 40)) {
        return "8,0 4,2 2,7 4,12 8,14";
    }
    if ((c == 41)) {
        return "2,0 6,2 8,7 6,12 2,14";
    }
    if ((c == 60)) {
        return "9,2 2,7 9,12";
    }
    if ((c == 62)) {
        return "1,2 8,7 1,12";
    }
    return "";
}

fn vg_font_read_int(s: []u8, at: i32) i32 {
    let i: i32 = at;
    let v: i32 = 0;
    while ((i < s.len)) {
        let c: i32 = (s[i]) as i32;
        if (((c >= 48) && (c <= 57))) {
            v = ((v * 10) + (c - 48));
            i = (i + 1);
        } else {
            return v;
        }
    }
    return v;
}

fn vg_font_int_end(s: []u8, at: i32) i32 {
    let i: i32 = at;
    while ((i < s.len)) {
        let c: i32 = (s[i]) as i32;
        if (((c >= 48) && (c <= 57))) {
            i = (i + 1);
        } else {
            return i;
        }
    }
    return i;
}

fn vg_font_build(p: *VPath, spec: []u8) void {
    let at: i32 = 0;
    let pen_down: i32 = 0;
    while ((at < spec.len)) {
        let x: i32 = vg_font_read_int(spec, at);
        at = (vg_font_int_end(spec, at) + 1);
        let y: i32 = vg_font_read_int(spec, at);
        at = vg_font_int_end(spec, at);
        if ((pen_down == 0)) {
            vg_move_to(p, (x) as f32, (y) as f32);
            pen_down = 1;
        } else {
            vg_line_to(p, (x) as f32, (y) as f32);
        }
        if ((at < spec.len)) {
            if ((spec[at] == 59)) {
                pen_down = 0;
            }
            at = (at + 1);
        }
    }
}

fn vg_text_width(s: []u8, size: f32) f32 {
    return (((s.len) as f32 * 13.0) * (size / 14.0));
}

fn VG_GLYPH_SLOTS() i32 {
    return 1024;
}

struct VgGlyphEnt {
    key: i32,
    w: i32,
    h: i32,
    ox: i32,
    oy: i32,
    pad: i32,
    mask: i64,
}

fn vg_glyph_cache_block(fb: *SoftFb) i64 {
    if ((fb.*.glyph_cache == 0)) {
        let bytes: i32 = (VG_GLYPH_SLOTS() * @sizeOf[VgGlyphEnt]());
        let raw: *i8 = _zag_malloc(bytes);
        if ((raw == null)) {
            return 0;
        }
        let i: i32 = 0;
        while ((i < bytes)) {
            raw[i] = (0) as i8;
            i = (i + 1);
        }
        fb.*.glyph_cache = (raw) as i64;
    }
    return fb.*.glyph_cache;
}

fn vg_glyph_slot(block: i64, key: i32) ?*VgGlyphEnt {
    let slot: i32 = (key % VG_GLYPH_SLOTS());
    if ((slot < 0)) {
        slot = (slot + VG_GLYPH_SLOTS());
    }
    let probe: i32 = 0;
    while ((probe < VG_GLYPH_SLOTS())) {
        let e: *VgGlyphEnt = ((block + ((slot * @sizeOf[VgGlyphEnt]())) as i64)) as *VgGlyphEnt;
        if (((e.*.key == key) || (e.*.key == 0))) {
            return e;
        }
        slot = (slot + 1);
        if ((slot >= VG_GLYPH_SLOTS())) {
            slot = 0;
        }
        probe = (probe + 1);
    }
    return null;
}

fn vg_glyph_build(e: *VgGlyphEnt, key: i32, c: i32, size: f32, weight: f32) void {
    e.*.key = key;
    e.*.w = 0;
    e.*.h = 0;
    e.*.ox = 0;
    e.*.oy = 0;
    e.*.mask = 0;
    let spec: []u8 = vg_font_glyph(c);
    if ((spec.len < 1)) {
        return;
    }
    let sc: f32 = (size / 14.0);
    let m: i32 = ((weight) as i32 + 3);
    let gw: i32 = (((13.0 * sc)) as i32 + (m * 2));
    let gh: i32 = (((18.0 * sc)) as i32 + (m * 2));
    if (((gw < 1) || (gh < 1))) {
        return;
    }
    let scratch: SoftFb = softgpu_new(gw, gh);
    let p: VPath = vg_path_new();
    vg_font_build(&p, spec);
    let xf: VgXf = vg_xf_mul(vg_xf_translate((m) as f32, (m) as f32), vg_xf_scale(sc, sc));
    vg_path_transform(&p, xf);
    vg_stroke_ex(&scratch, &p, weight, vg_cap_round(), vg_join_round(), 255, 255, 255, 255);
    let n: i32 = (gw * gh);
    let mask: *i8 = _zag_malloc(n);
    if ((mask == null)) {
        free[u8](&scratch.pix);
        free[u8](&scratch.mask);
        free[u8](&scratch.acc);
        return;
    }
    let i: i32 = 0;
    while ((i < n)) {
        mask[i] = (get[u8](scratch.pix, (i * 3))) as i8;
        i = (i + 1);
    }
    free[u8](&scratch.pix);
    free[u8](&scratch.mask);
    free[u8](&scratch.acc);
    e.*.w = gw;
    e.*.h = gh;
    e.*.ox = m;
    e.*.oy = m;
    e.*.mask = (mask) as i64;
}

fn vg_glyph_blit(fb: *SoftFb, e: *VgGlyphEnt, ox: f32, oy: f32, r: i32, g: i32, b: i32, a: i32) void {
    let gw: i32 = e.*.w;
    let gh: i32 = e.*.h;
    if ((((gw < 1) || (gh < 1)) || (e.*.mask == 0))) {
        return;
    }
    let mask: *i8 = (e.*.mask) as *i8;
    let bx: i32 = ((ox) as i32 - e.*.ox);
    let by: i32 = ((oy) as i32 - e.*.oy);
    let gx0: i32 = 0;
    let gy0: i32 = 0;
    let gx1: i32 = gw;
    let gy1: i32 = gh;
    if ((bx < 0)) {
        gx0 = (0 - bx);
    }
    if ((by < 0)) {
        gy0 = (0 - by);
    }
    if (((bx + gx1) > fb.*.w)) {
        gx1 = (fb.*.w - bx);
    }
    if (((by + gy1) > fb.*.h)) {
        gy1 = (fb.*.h - by);
    }
    if ((fb.*.clip_on == 1)) {
        if (((bx + gx0) < fb.*.clip_x0)) {
            gx0 = (fb.*.clip_x0 - bx);
        }
        if (((by + gy0) < fb.*.clip_y0)) {
            gy0 = (fb.*.clip_y0 - by);
        }
        if (((bx + gx1) > (fb.*.clip_x1 + 1))) {
            gx1 = ((fb.*.clip_x1 + 1) - bx);
        }
        if (((by + gy1) > (fb.*.clip_y1 + 1))) {
            gy1 = ((fb.*.clip_y1 + 1) - by);
        }
    }
    if (((gx1 <= gx0) || (gy1 <= gy0))) {
        return;
    }
    let d: *i8 = (fb.*.pix.data) as *i8;
    let gy: i32 = gy0;
    while ((gy < gy1)) {
        let mrow: i32 = ((gy * gw) + gx0);
        let o: i32 = (((((by + gy) * fb.*.w) + bx) + gx0) * 3);
        let gx: i32 = gx0;
        while ((gx < gx1)) {
            let ma: i32 = ((mask[mrow]) as u8) as i32;
            if ((ma > 0)) {
                let ea: i32 = ((ma * a) / 255);
                let inv: i32 = (255 - ea);
                d[o] = ((((((d[o]) as u8) as i32 * inv) + (r * ea)) / 255)) as i8;
                d[(o + 1)] = ((((((d[(o + 1)]) as u8) as i32 * inv) + (g * ea)) / 255)) as i8;
                d[(o + 2)] = ((((((d[(o + 2)]) as u8) as i32 * inv) + (b * ea)) / 255)) as i8;
            }
            mrow = (mrow + 1);
            o = (o + 3);
            gx = (gx + 1);
        }
        gy = (gy + 1);
    }
    softgpu_damage_mark_rect(fb, (bx + gx0), (by + gy0), ((bx + gx1) - 1), ((by + gy1) - 1));
}

fn vg_text_vec_char_direct(fb: *SoftFb, x: f32, y: f32, c: i32, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    let spec: []u8 = vg_font_glyph(c);
    if ((spec.len < 1)) {
        return;
    }
    let sc: f32 = (size / 14.0);
    let p: VPath = vg_path_new();
    vg_font_build(&p, spec);
    let m: VgXf = vg_xf_mul(vg_xf_translate(x, y), vg_xf_scale(sc, sc));
    vg_path_transform(&p, m);
    vg_stroke_ex(fb, &p, weight, vg_cap_round(), vg_join_round(), r, g, b, a);
}

fn vg_text_vec(fb: *SoftFb, x: f32, y: f32, s: []u8, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    let sc: f32 = (size / 14.0);
    let block: i64 = vg_glyph_cache_block(fb);
    let i: i32 = 0;
    while ((i < s.len)) {
        let c: i32 = (s[i]) as i32;
        let cx: f32 = (x + (((i) as f32 * 13.0) * sc));
        if ((block == 0)) {
            vg_text_vec_char_direct(fb, cx, y, c, size, weight, r, g, b, a);
        } else {
            let key: i32 = (((c * 1000000) + (((size * 10.0)) as i32 * 100)) + ((weight * 10.0)) as i32);
            if (vg_glyph_slot(block, key)) |e| {
                if ((e.*.key == 0)) {
                    vg_glyph_build(e, key, c, size, weight);
                }
                vg_glyph_blit(fb, e, cx, y, r, g, b, a);
            } else {
                vg_text_vec_char_direct(fb, cx, y, c, size, weight, r, g, b, a);
            }
        }
        i = (i + 1);
    }
}

fn vg_path_append(dst: *VPath, src: *VPath) void {
    let i: i32 = 0;
    while ((i < len[f32](src.*.vx))) {
        push[f32](&dst.*.vx, get[f32](src.*.vx, i));
        push[f32](&dst.*.vy, get[f32](src.*.vy, i));
        i = (i + 1);
    }
    let j: i32 = 0;
    while ((j < len[i32](src.*.verbs))) {
        push[i32](&dst.*.verbs, get[i32](src.*.verbs, j));
        j = (j + 1);
    }
}

fn vg_text_outline(x: f32, y: f32, s: []u8, size: f32, weight: f32, cap: i32, join: i32) VPath {
    let sc: f32 = (size / 14.0);
    let q: VPath = vg_path_new();
    let i: i32 = 0;
    while ((i < s.len)) {
        let spec: []u8 = vg_font_glyph((s[i]) as i32);
        if ((spec.len > 0)) {
            let p: VPath = vg_path_new();
            vg_font_build(&p, spec);
            let m: VgXf = vg_xf_mul(vg_xf_translate((x + (((i) as f32 * 13.0) * sc)), y), vg_xf_scale(sc, sc));
            vg_path_transform(&p, m);
            let o: VPath = vg_stroke_outline(&p, weight, cap, join);
            vg_path_append(&q, &o);
        }
        i = (i + 1);
    }
    return q;
}

fn vg_text_face(fb: *SoftFb, x: f32, y: f32, s: []u8, size: f32, weight: f32, paint: *VgPaint) void {
    let q: VPath = vg_text_outline(x, y, s, size, weight, vg_cap_square(), vg_join_miter());
    vg_stroke_fill_outline_paint(fb, &q, paint);
}

fn vg_text_face_solid(fb: *SoftFb, x: f32, y: f32, s: []u8, size: f32, weight: f32, r: i32, g: i32, b: i32, a: i32) void {
    let paint: VgPaint = vg_paint_base(0, r, g, b, a);
    vg_text_face(fb, x, y, s, size, weight, &paint);
}

