    let h: u64 = (hi) as u64;
    if ((hi < 0)) {
        h = (h + 4294967296);
    }
    let shifted: u64 = h;
    let i: i32 = 0;
    while ((i < 32)) {
        shifted = (shifted + shifted);
        i = (i + 1);
    }
    return (shifted + l);
}

fn virtio_guest_ram_len() i32 {
    if (virtio_guest_ram_ptr()) |ram| {
