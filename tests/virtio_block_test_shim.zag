fn virtio_guest_cache_path() []u8 {
    let pid: []u8 = _zag_i64_to_str(hw_rt_getpid());
    return _zag_str_concat(_zag_str_concat("/tmp/rayos_virtio_guest_v2.", pid), ".ptr");
}

fn virtio_guest_state_new() VirtioGuestState {
    return VirtioGuestState{ .magic = (VIRTIO_GUEST_MAGIC()) as i32, .pid = hw_rt_getpid(), .ready = 0, .guest_ram_ptr = 0, .queue_num = (VIRTIO_QUEUE_NUM_DEFAULT()) as i32, .queue_ready = 0, .queue_desc_lo = 0, .queue_desc_hi = 0, .queue_driver_lo = 0, .queue_driver_hi = 0, .queue_device_lo = 0, .queue_device_hi = 0, .device_features_sel = 0, .driver_features_sel = 0, .driver_features = 0, .status = 0, .interrupt_status = 0, .avail_seen = 0, .used_idx = 0 };
}

fn virtio_guest_state_from_cache() ?*VirtioGuestState {
    let path: []u8 = virtio_guest_cache_path();
    if ((_zag_file_exists(path) == 0)) {
        return null;
