fn virtio_guest_flag_has(flags: i32, bit: i32) i32 {
    let div: i32 = 1;
    let i: i32 = 0;
    while ((i < bit)) {
        div = (div * 2);
        i = (i + 1);
    }
    let shifted: i32 = (flags / div);
    if (((shifted - ((shifted / 2) * 2)) != 0)) {
