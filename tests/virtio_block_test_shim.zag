fn virtio_guest_ram_load32_le(gpa: i32) i32 {
    let out: i64 = 0;
    let i: i32 = 0;
    while ((i < 4)) {
        let limb: i64 = (virtio_guest_ram_load8((gpa + i))) as i64;
        let j: i32 = 0;
        while ((j < i)) {
            limb = (limb * 256);
            j = (j + 1);
        }
        out = (out + limb);
        i = (i + 1);
    }
    if ((out >= 2147483648)) {
        out = (out - 4294967296);
    }
    return (out) as i32;
