// virtio_gpu_fb_test.flash — guest linear FB write + RGB24 blit to compositor pool.

@import("../core/constants.flash")
@import("../math/trit_core.flash")
@import("../math/tekum.flash")
@import("../math/offset_loop.flash")
@import("../driver/hw_rt.flash")
@import("../driver/virtio_block_mmio_nop.flash")
@import("../driver/virtio_net_mmio_nop.flash")
@import("../driver/virtio_gpu_guest.flash")
@import("../hypervisor/guest_ram.flash")

fn test_fail(msg: []u8) void {
    _zag_print("virtio_gpu_fb_test FAIL: ");
    _zag_println(msg);
    _zag_exit(1);
}

fn virtio_gpu_test_expect_u8(pool: *ArrayList[u8], idx: i32, want: u8, msg: []u8) void {
    if (idx < 0) { test_fail(msg); }
    if (idx >= len[u8](pool.*)) { test_fail(msg); }
    if (get[u8](pool, idx) != want) { test_fail(msg); }
}

fn main() i32 {
    _zag_println("virtio_gpu_fb_test: running");

    if (hw_rt_init() != 0) { test_fail("hw_rt_init"); }
    if (virtio_gpu_guest_init() != 0) { test_fail("virtio_gpu_guest_init"); }

    let guest_ram: ArrayList[u8] = make[u8](0);
    let guest_pool: ArrayList[u8] = make[u8](0);

    let magic: i32 = guest_ram_mmio_trap((GPA_VIRTIO_GPU_BASE() as i32), 0, 0);
    if (magic != 1952805748) { test_fail("virtio gpu magic"); }

    let dev_id: i32 = guest_ram_mmio_trap((GPA_VIRTIO_GPU_BASE() as i32) + 8, 0, 0);
    if (dev_id != 16) { test_fail("device_id gpu"); }

    let red_px: u32 = 255 * 65536;                              // 0x00FF0000 ARGB LE -> R=255
    let green_px: u32 = 255 * 256;                              // 0x0000FF00 ARGB LE -> G=255
    if (guest_ram_write32(&guest_ram, (GPA_VIRTIO_GPU_FB() as i32), red_px) != 0) {
        test_fail("write red pixel");
    }
    if (guest_ram_write32(
        &guest_ram,
        (GPA_VIRTIO_GPU_FB() as i32) + (VIRTIO_GPU_FB_WIDTH() as i32) * 4,
        green_px,
    ) != 0) {
        test_fail("write green pixel");
    }

    let fb_off: i32 = 0;
    let dst_w: i32 = (VIRTIO_GPU_FB_WIDTH() as i32);
    let dst_h: i32 = (VIRTIO_GPU_FB_HEIGHT() as i32);
    let pool_bytes: i32 = dst_w * dst_h * 3;
    let i: i32 = 0;
    while (i < pool_bytes) {
        push[u8](&guest_pool, 0);
        i = i + 1;
    }

    virtio_gpu_blit_from_guest_ram(&guest_ram, &guest_pool, fb_off, dst_w, dst_h);

    virtio_gpu_test_expect_u8(&guest_pool, fb_off + 0, 255, "blit red R");
    virtio_gpu_test_expect_u8(&guest_pool, fb_off + 1, 0, "blit red G");
    virtio_gpu_test_expect_u8(&guest_pool, fb_off + 2, 0, "blit red B");

    let row1_off: i32 = fb_off + dst_w * 3;
    virtio_gpu_test_expect_u8(&guest_pool, row1_off + 0, 0, "blit green R");
    virtio_gpu_test_expect_u8(&guest_pool, row1_off + 1, 255, "blit green G");
    virtio_gpu_test_expect_u8(&guest_pool, row1_off + 2, 0, "blit green B");

    free[u8](&guest_ram);
    free[u8](&guest_pool);

    _zag_println("virtio_gpu_fb_test: ok");
    return 0;
}