// virtio_block_test.flash — virtio-mmio block IN from SOH boot sector.

@import("../core/constants.flash")
@import("../math/trit_core.flash")
@import("../math/tekum.flash")
@import("../math/offset_loop.flash")
@import("../driver/hw_rt.flash")
@import("../driver/soh_mmio.flash")
@import("../storage/soh_block.flash")
@import("../driver/virtio_guest.flash")
@import("../driver/virtio_net_mmio_nop.flash")
@import("../driver/virtio_gpu_mmio_nop.flash")
@import("../hypervisor/guest_ram.flash")

fn VIRTIO_TEST_RAM_BYTES() i32 { return 24576; }            // 0x6000

fn VIRTIO_TEST_DESC_GPA() i32 { return 8192; }             // 0x2000
fn VIRTIO_TEST_AVAIL_GPA() i32 { return 12288; }           // 0x3000
fn VIRTIO_TEST_USED_GPA() i32 { return 16384; }             // 0x4000
fn VIRTIO_TEST_HDR_GPA() i32 { return 20480; }             // 0x5000
fn VIRTIO_TEST_DATA_GPA() i32 { return 20736; }            // 0x5100
fn VIRTIO_TEST_STATUS_GPA() i32 { return 21248; }          // 0x5300

fn test_fail(msg: []u8) void {
    _zag_print("virtio_block_test FAIL: ");
    _zag_println(msg);
    _zag_exit(1);
}

fn virtio_test_make_boot_sector() ArrayList[u8] {
    let sector: ArrayList[u8] = make[u8]((SOH_BLOCK_SIZE() as i32));
    let i: i32 = 0;
    while (i < (SOH_BLOCK_SIZE() as i32)) {
        push[u8](&sector, 0);
        i = i + 1;
    }
    set[u8](&sector, 0, 235);
    set[u8](&sector, 1, 254);
    set[u8](&sector, 2, 144);
    set[u8](&sector, 3, 250);
    set[u8](&sector, 510, 85);
    set[u8](&sector, 511, 170);
    return sector;
}

fn virtio_test_ram_fit(ram: *ArrayList[u8], end: i32) void {
    while (len[u8](ram.*) < end) {
        push[u8](ram, 0);
    }
}

fn virtio_test_store32(ram: *ArrayList[u8], gpa: i32, val: i32) void {
    virtio_test_ram_fit(ram, gpa + 4);
    let pack: i64 = val as i64;
    if (pack < 0) { pack = pack + 4294967296; }
    let shift: i64 = pack;
    let i: i32 = 0;
    while (i < 4) {
        let limb: i64 = shift - ((shift / 256) * 256);
        set[u8](ram, gpa + i, limb as u8);
        shift = shift / 256;
        i = i + 1;
    }
}

fn virtio_test_store16(ram: *ArrayList[u8], gpa: i32, val: i32) void {
    virtio_test_ram_fit(ram, gpa + 2);
    let pack: i32 = val;
    if (pack < 0) { pack = pack + 65536; }
    set[u8](ram, gpa, (pack - (pack / 256) * 256) as u8);
    set[u8](ram, gpa + 1, (pack / 256) as u8);
}

fn virtio_test_store_desc(
    ram: *ArrayList[u8],
    idx: i32,
    addr: i32,
    dlen: i32,
    flags: i32,
    next: i32,
) void {
    let base: i32 = (VIRTIO_TEST_DESC_GPA() as i32) + idx * 16;
    virtio_test_store32(ram, base, addr);
    virtio_test_store32(ram, base + 4, 0);
    virtio_test_store32(ram, base + 8, dlen);
    virtio_test_store16(ram, base + 12, flags);
    virtio_test_store16(ram, base + 14, next);
}

fn virtio_test_setup_queue(ram: *ArrayList[u8]) void {
    virtio_test_ram_fit(ram, (VIRTIO_TEST_RAM_BYTES() as i32));

    virtio_test_store_desc(ram, 0, (VIRTIO_TEST_HDR_GPA() as i32), 16, 1, 1);
    virtio_test_store_desc(ram, 1, (VIRTIO_TEST_DATA_GPA() as i32), 512, 3, 2);
    virtio_test_store_desc(ram, 2, (VIRTIO_TEST_STATUS_GPA() as i32), 1, 2, 0);

    virtio_test_store32(ram, (VIRTIO_TEST_HDR_GPA() as i32), 0);
    virtio_test_store32(ram, (VIRTIO_TEST_HDR_GPA() as i32) + 4, 0);
    virtio_test_store32(ram, (VIRTIO_TEST_HDR_GPA() as i32) + 8, 0);
    virtio_test_store32(ram, (VIRTIO_TEST_HDR_GPA() as i32) + 12, 0);

    virtio_test_store16(ram, (VIRTIO_TEST_AVAIL_GPA() as i32), 0);
    virtio_test_store16(ram, (VIRTIO_TEST_AVAIL_GPA() as i32) + 2, 1);
    virtio_test_store16(ram, (VIRTIO_TEST_AVAIL_GPA() as i32) + 4, 0);

    virtio_test_store16(ram, (VIRTIO_TEST_USED_GPA() as i32), 0);
    virtio_test_store16(ram, (VIRTIO_TEST_USED_GPA() as i32) + 2, 0);
}

fn virtio_test_mmio_write(gpa: i32, val: i32) void {
    let _sink: i32 = guest_ram_mmio_trap(gpa, 1, val);
}

fn virtio_test_mmio_read(gpa: i32) i32 {
    return guest_ram_mmio_trap(gpa, 0, 0);
}

fn virtio_test_program_virtio() void {
    virtio_test_mmio_write((GPA_VIRTIO_MMIO_BASE() as i32) + 48, 8);
    virtio_test_mmio_write((GPA_VIRTIO_MMIO_BASE() as i32) + 96, (VIRTIO_TEST_DESC_GPA() as i32));
    virtio_test_mmio_write((GPA_VIRTIO_MMIO_BASE() as i32) + 112, (VIRTIO_TEST_AVAIL_GPA() as i32));
    virtio_test_mmio_write((GPA_VIRTIO_MMIO_BASE() as i32) + 128, (VIRTIO_TEST_USED_GPA() as i32));
    virtio_test_mmio_write((GPA_VIRTIO_MMIO_BASE() as i32) + 52, 1);
}

fn virtio_test_expect_byte(ram: *ArrayList[u8], idx: i32, want: u8, msg: []u8) void {
    if (get[u8](ram, idx) != want) { test_fail(msg); }
}

fn main() i32 {
    _zag_println("virtio_block_test: running");

    if (hw_rt_init() != 0) { test_fail("hw_rt_init"); }

    let sector: ArrayList[u8] = virtio_test_make_boot_sector();
    if (soh_block_write((SOH_BLOCK_BOOT_ID() as i32), sector.data[0..(SOH_BLOCK_SIZE() as i32)]) != 0) {
        test_fail("soh_block_write");
    }
    free[u8](&sector);

    if (virtio_guest_init() != 0) { test_fail("virtio_guest_init"); }

    let guest_ram: ArrayList[u8] = make[u8](0);
    virtio_guest_attach_guest_ram(&guest_ram);
    virtio_test_setup_queue(&guest_ram);
    virtio_test_program_virtio();

    let magic: i32 = virtio_test_mmio_read((GPA_VIRTIO_MMIO_BASE() as i32));
    if (magic != 1952805748) { test_fail("virtio magic"); }

    virtio_test_mmio_write((GPA_VIRTIO_MMIO_BASE() as i32) + 56, 0);

    virtio_test_expect_byte(&guest_ram, (VIRTIO_TEST_DATA_GPA() as i32) + 0, 235, "data byte0");
    virtio_test_expect_byte(&guest_ram, (VIRTIO_TEST_DATA_GPA() as i32) + 1, 254, "data byte1");
    virtio_test_expect_byte(&guest_ram, (VIRTIO_TEST_DATA_GPA() as i32) + 2, 144, "data byte2");
    virtio_test_expect_byte(&guest_ram, (VIRTIO_TEST_DATA_GPA() as i32) + 3, 250, "data byte3");
    virtio_test_expect_byte(&guest_ram, (VIRTIO_TEST_DATA_GPA() as i32) + 510, 85, "data sig_lo");
    virtio_test_expect_byte(&guest_ram, (VIRTIO_TEST_DATA_GPA() as i32) + 511, 170, "data sig_hi");

    let irq: i32 = virtio_test_mmio_read((GPA_VIRTIO_MMIO_BASE() as i32) + 68);
    if (irq != 1) { test_fail("interrupt_status"); }

    free[u8](&guest_ram);

    _zag_println("virtio_block_test: ok");
    return 0;
}