}

fn ec_double(X: *i64, Y: *i64, Z: *i64, oX: *i64, oY: *i64, oZ: *i64, p: *i64, L: i32) void {
    if ((pt_is_inf(Z, L) == 1)) {
        bn_zero(oZ);
        return;
    }
    let A: *i64 = bn_new();
    bn_modmul(A, Y, Y, p, L);
    let t: *i64 = bn_new();
    bn_modmul(t, X, A, p, L);
    let B: *i64 = bn_new();
    bn_modadd(B, t, t, p, L);
    bn_modadd(B, B, B, p, L);
    let A2: *i64 = bn_new();
    bn_modmul(A2, A, A, p, L);
    let C: *i64 = bn_new();
    bn_modadd(C, A2, A2, p, L);
    bn_modadd(C, C, C, p, L);
    bn_modadd(C, C, C, p, L);
    let ZZ: *i64 = bn_new();
    bn_modmul(ZZ, Z, Z, p, L);
    let xm: *i64 = bn_new();
    bn_modsub(xm, X, ZZ, p, L);
    let xp: *i64 = bn_new();
    bn_modadd(xp, X, ZZ, p, L);
    let D: *i64 = bn_new();
    bn_modmul(D, xm, xp, p, L);
    let D3: *i64 = bn_new();
    bn_modadd(D3, D, D, p, L);
    bn_modadd(D3, D3, D, p, L);
    let D2: *i64 = bn_new();
    bn_modmul(D2, D3, D3, p, L);
    let twoB: *i64 = bn_new();
    bn_modadd(twoB, B, B, p, L);
    let nX: *i64 = bn_new();
    bn_modsub(nX, D2, twoB, p, L);
    let bx: *i64 = bn_new();
    bn_modsub(bx, B, nX, p, L);
    let dbx: *i64 = bn_new();
    bn_modmul(dbx, D3, bx, p, L);
    let nY: *i64 = bn_new();
    bn_modsub(nY, dbx, C, p, L);
    let yz: *i64 = bn_new();
    bn_modmul(yz, Y, Z, p, L);
    let nZ: *i64 = bn_new();
    bn_modadd(nZ, yz, yz, p, L);
    let k: i32 = 0;
    while ((k < L)) {
        oX[k] = nX[k];
        oY[k] = nY[k];
        oZ[k] = nZ[k];
        k = (k + 1);
    }
}

fn ec_add(X1: *i64, Y1: *i64, Z1: *i64, X2: *i64, Y2: *i64, Z2: *i64, oX: *i64, oY: *i64, oZ: *i64, p: *i64, L: i32) void {
    if ((pt_is_inf(Z1, L) == 1)) {
        let k: i32 = 0;
        while ((k < L)) {
            oX[k] = X2[k];
            oY[k] = Y2[k];
            oZ[k] = Z2[k];
            k = (k + 1);
        }
        return;
    }
    if ((pt_is_inf(Z2, L) == 1)) {
        let k: i32 = 0;
        while ((k < L)) {
            oX[k] = X1[k];
            oY[k] = Y1[k];
            oZ[k] = Z1[k];
            k = (k + 1);
        }
        return;
    }
    let Z1Z1: *i64 = bn_new();
    bn_modmul(Z1Z1, Z1, Z1, p, L);
    let Z2Z2: *i64 = bn_new();
    bn_modmul(Z2Z2, Z2, Z2, p, L);
    let U1: *i64 = bn_new();
    bn_modmul(U1, X1, Z2Z2, p, L);
    let U2: *i64 = bn_new();
    bn_modmul(U2, X2, Z1Z1, p, L);
    let t1: *i64 = bn_new();
    bn_modmul(t1, Z2, Z2Z2, p, L);
    let S1: *i64 = bn_new();
    bn_modmul(S1, Y1, t1, p, L);
    let t2: *i64 = bn_new();
    bn_modmul(t2, Z1, Z1Z1, p, L);
    let S2: *i64 = bn_new();
    bn_modmul(S2, Y2, t2, p, L);
    if ((bn_cmp(U1, U2, L) == 0)) {
        if ((bn_cmp(S1, S2, L) == 0)) {
            ec_double(X1, Y1, Z1, oX, oY, oZ, p, L);
            return;
        }
        bn_zero(oZ);
        return;
    }
    let H: *i64 = bn_new();
    bn_modsub(H, U2, U1, p, L);
    let twoH: *i64 = bn_new();
    bn_modadd(twoH, H, H, p, L);
    let I: *i64 = bn_new();
    bn_modmul(I, twoH, twoH, p, L);
    let J: *i64 = bn_new();
    bn_modmul(J, H, I, p, L);
    let ds: *i64 = bn_new();
    bn_modsub(ds, S2, S1, p, L);
    let rr: *i64 = bn_new();
    bn_modadd(rr, ds, ds, p, L);
    let V: *i64 = bn_new();
    bn_modmul(V, U1, I, p, L);
    let rr2: *i64 = bn_new();
    bn_modmul(rr2, rr, rr, p, L);
    let twoV: *i64 = bn_new();
    bn_modadd(twoV, V, V, p, L);
    let nX: *i64 = bn_new();
    bn_modsub(nX, rr2, J, p, L);
    bn_modsub(nX, nX, twoV, p, L);
    let vx: *i64 = bn_new();
    bn_modsub(vx, V, nX, p, L);
    let rvx: *i64 = bn_new();
    bn_modmul(rvx, rr, vx, p, L);
    let s1j: *i64 = bn_new();
    bn_modmul(s1j, S1, J, p, L);
    bn_modadd(s1j, s1j, s1j, p, L);
    let nY: *i64 = bn_new();
    bn_modsub(nY, rvx, s1j, p, L);
    let z1z2: *i64 = bn_new();
    bn_modadd(z1z2, Z1, Z2, p, L);
    let zz: *i64 = bn_new();
    bn_modmul(zz, z1z2, z1z2, p, L);
    bn_modsub(zz, zz, Z1Z1, p, L);
    bn_modsub(zz, zz, Z2Z2, p, L);
    let nZ: *i64 = bn_new();
    bn_modmul(nZ, zz, H, p, L);
    let k: i32 = 0;
    while ((k < L)) {
        oX[k] = nX[k];
        oY[k] = nY[k];
        oZ[k] = nZ[k];
        k = (k + 1);
    }
}

fn ec_mul(k: *i64, X: *i64, Y: *i64, oX: *i64, oY: *i64, oZ: *i64, p: *i64, L: i32) void {
    let rX: *i64 = bn_new();
    let rY: *i64 = bn_new();
    let rZ: *i64 = bn_new();
    bn_zero(rZ);
    let bits: i32 = bn_bits(k, L);
    let i: i32 = (bits - 1);
    while ((i >= 0)) {
        let dX: *i64 = bn_new();
        let dY: *i64 = bn_new();
        let dZ: *i64 = bn_new();
        ec_double(rX, rY, rZ, dX, dY, dZ, p, L);
        let k2: i32 = 0;
        while ((k2 < L)) {
            rX[k2] = dX[k2];
            rY[k2] = dY[k2];
            rZ[k2] = dZ[k2];
            k2 = (k2 + 1);
        }
        if ((bn_getbit(k, i) == 1)) {
            let one: *i64 = bn_new();
            one[0] = 1;
            let aX: *i64 = bn_new();
            let aY: *i64 = bn_new();
            let aZ: *i64 = bn_new();
            ec_add(rX, rY, rZ, X, Y, one, aX, aY, aZ, p, L);
            let k3: i32 = 0;
            while ((k3 < L)) {
                rX[k3] = aX[k3];
                rY[k3] = aY[k3];
                rZ[k3] = aZ[k3];
                k3 = (k3 + 1);
            }
        }
        i = (i - 1);
    }
    let kk: i32 = 0;
    while ((kk < L)) {
        oX[kk] = rX[kk];
        oY[kk] = rY[kk];
        oZ[kk] = rZ[kk];
        kk = (kk + 1);
    }
}

fn ecdsa_verify_curve(p: *i64, n: *i64, gx: *i64, gy: *i64, L: i32, Qx: *i64, Qy: *i64, hash: *i64, r: *i64, s: *i64) i32 {
    let zero: *i64 = bn_new();
    if ((bn_cmp(r, zero, L) == 0)) {
        return 0;
    }
    if ((bn_cmp(s, zero, L) == 0)) {
        return 0;
    }
    if ((bn_cmp(r, n, L) >= 0)) {
        return 0;
    }
    if ((bn_cmp(s, n, L) >= 0)) {
        return 0;
    }
    let w: *i64 = bn_new();
    bn_modinv(w, s, n, L);
    let hn: *i64 = bn_new();
    bn_mod(hn, hash, n, L);
    let u1: *i64 = bn_new();
    bn_modmul(u1, hn, w, n, L);
    let u2: *i64 = bn_new();
    bn_modmul(u2, r, w, n, L);
    let aX: *i64 = bn_new();
    let aY: *i64 = bn_new();
    let aZ: *i64 = bn_new();
    ec_mul(u1, gx, gy, aX, aY, aZ, p, L);
    let bX: *i64 = bn_new();
    let bY: *i64 = bn_new();
    let bZ: *i64 = bn_new();
    ec_mul(u2, Qx, Qy, bX, bY, bZ, p, L);
    let RX: *i64 = bn_new();
    let RY: *i64 = bn_new();
    let RZ: *i64 = bn_new();
    ec_add(aX, aY, aZ, bX, bY, bZ, RX, RY, RZ, p, L);
    if ((pt_is_inf(RZ, L) == 1)) {
        return 0;
    }
    let z2: *i64 = bn_new();
    bn_modmul(z2, RZ, RZ, p, L);
    let zi: *i64 = bn_new();
    bn_modinv(zi, z2, p, L);
    let x: *i64 = bn_new();
    bn_modmul(x, RX, zi, p, L);
    let xn: *i64 = bn_new();
    bn_mod(xn, x, n, L);
    if ((bn_cmp(xn, r, L) == 0)) {
        return 1;
    }
    return 0;
}

fn ecdsa_verify_p256(Qx: *i64, Qy: *i64, hash: *i64, r: *i64, s: *i64) i32 {
    return ecdsa_verify_curve(p256_p(), p256_n(), p256_gx(), p256_gy(), 16, Qx, Qy, hash, r, s);
}

fn ecdsa_verify_p384(Qx: *i64, Qy: *i64, hash: *i64, r: *i64, s: *i64) i32 {
    return ecdsa_verify_curve(p384_p(), p384_n(), p384_gx(), p384_gy(), 24, Qx, Qy, hash, r, s);
}

fn bn_from_be(a: *i64, buf: *i8, off: i32, n: i32, L: i32) void {
    bn_zero(a);
    let i: i32 = 0;
    while ((i < n)) {
        let byteval: i64 = ((buf[(((off + n) - 1) - i)]) as u8) as i64;
        let limb: i32 = (i / 2);
        if (((i % 2) == 0)) {
            a[limb] = (a[limb] + byteval);
        } else {
            a[limb] = (a[limb] + (byteval << 8));
        }
        i = (i + 1);
    }
    let _l: i32 = L;
}

fn X509_HASH_SHA256() i32 {
    return 256;
}

fn X509_HASH_SHA384() i32 {
    return 384;
}

fn X509_CURVE_NONE() i32 {
    return 0;
}

fn X509_CURVE_P256() i32 {
    return 256;
}

fn X509_CURVE_P384() i32 {
    return 384;
}

fn der_byte(b: *i8, i: i32) i32 {
    return ((b[i]) as u8) as i32;
}

fn der_hdr(b: *i8, pos: i32) i32 {
    let l: i32 = der_byte(b, (pos + 1));
    if ((l < 128)) {
        return 2;
    }
    return (2 + (l - 128));
}

fn der_len(b: *i8, pos: i32) i32 {
    let l: i32 = der_byte(b, (pos + 1));
    if ((l < 128)) {
        return l;
    }
    let n: i32 = (l - 128);
    let v: i32 = 0;
    let i: i32 = 0;
    while ((i < n)) {
        v = ((v * 256) + der_byte(b, ((pos + 2) + i)));
        i = (i + 1);
    }
    return v;
}

fn der_content(b: *i8, pos: i32) i32 {
    return (pos + der_hdr(b, pos));
}

fn der_end(b: *i8, pos: i32) i32 {
    return (der_content(b, pos) + der_len(b, pos));
}

fn der_first(b: *i8, pos: i32) i32 {
    return der_content(b, pos);
}

fn der_next(b: *i8, pos: i32) i32 {
    return der_end(b, pos);
}

fn x509_tbs_pos(b: *i8, coff: i32) i32 {
    return der_first(b, coff);
}

fn x509_tbs_child(b: *i8, coff: i32, index: i32) i32 {
    let tbs: i32 = x509_tbs_pos(b, coff);
    let p: i32 = der_first(b, tbs);
    if ((der_byte(b, p) == 160)) {
        p = der_next(b, p);
    }
    let i: i32 = 0;
    while ((i < index)) {
        p = der_next(b, p);
        i = (i + 1);
    }
    return p;
}

fn x509_serial(b: *i8, coff: i32) i32 {
    return x509_tbs_child(b, coff, 0);
}

fn x509_issuer(b: *i8, coff: i32) i32 {
    return x509_tbs_child(b, coff, 2);
}

fn x509_validity(b: *i8, coff: i32) i32 {
    return x509_tbs_child(b, coff, 3);
}

fn x509_subject(b: *i8, coff: i32) i32 {
    return x509_tbs_child(b, coff, 4);
}

fn x509_spki(b: *i8, coff: i32) i32 {
    return x509_tbs_child(b, coff, 5);
}

fn x509_sig_hash(b: *i8, coff: i32) i32 {
    let alg: i32 = der_next(b, x509_tbs_pos(b, coff));
    let oid: i32 = der_first(b, alg);
    let oc: i32 = der_content(b, oid);
    let ol: i32 = der_len(b, oid);
    let last: i32 = der_byte(b, ((oc + ol) - 1));
    if ((last == 2)) {
        return X509_HASH_SHA256();
    }
    if ((last == 3)) {
        return X509_HASH_SHA384();
    }
    return 0;
}

fn x509_sig_rs(b: *i8, coff: i32, r: *i64, s: *i64, L: i32) i32 {
    let bit: i32 = der_next(b, der_next(b, x509_tbs_pos(b, coff)));
    let bc: i32 = (der_content(b, bit) + 1);
    let ri: i32 = der_first(b, bc);
    let rc: i32 = der_content(b, ri);
    let rl: i32 = der_len(b, ri);
    if (((rl > 0) && (der_byte(b, rc) == 0))) {
        rc = (rc + 1);
        rl = (rl - 1);
    }
    bn_from_be(r, b, rc, rl, L);
    let si: i32 = der_next(b, ri);
    let sc: i32 = der_content(b, si);
    let sl: i32 = der_len(b, si);
    if (((sl > 0) && (der_byte(b, sc) == 0))) {
        sc = (sc + 1);
        sl = (sl - 1);
    }
    bn_from_be(s, b, sc, sl, L);
    return 0;
}

fn x509_sig_rs_at(b: *i8, seqpos: i32, r: *i64, s: *i64, L: i32) i32 {
    let ri: i32 = der_first(b, seqpos);
    let rc: i32 = der_content(b, ri);
    let rl: i32 = der_len(b, ri);
    if (((rl > 0) && (der_byte(b, rc) == 0))) {
        rc = (rc + 1);
        rl = (rl - 1);
    }
    bn_from_be(r, b, rc, rl, L);
    let si: i32 = der_next(b, ri);
    let sc: i32 = der_content(b, si);
    let sl: i32 = der_len(b, si);
    if (((sl > 0) && (der_byte(b, sc) == 0))) {
        sc = (sc + 1);
        sl = (sl - 1);
    }
    bn_from_be(s, b, sc, sl, L);
    return 0;
}

fn x509_pubkey(b: *i8, coff: i32, Qx: *i64, Qy: *i64) i32 {
    let spki: i32 = x509_spki(b, coff);
    let alg: i32 = der_first(b, spki);
    let oid1: i32 = der_first(b, alg);
    let curveoid: i32 = der_next(b, oid1);
    let cc: i32 = der_content(b, curveoid);
    let cl: i32 = der_len(b, curveoid);
    let curve: i32 = X509_CURVE_NONE();
    let flen: i32 = 0;
    if (((cl == 8) && (der_byte(b, ((cc + cl) - 1)) == 7))) {
        curve = X509_CURVE_P256();
        flen = 32;
    }
    if (((cl == 5) && (der_byte(b, ((cc + cl) - 1)) == 34))) {
        curve = X509_CURVE_P384();
        flen = 48;
    }
    if ((curve == X509_CURVE_NONE())) {
        return X509_CURVE_NONE();
    }
    let bit: i32 = der_next(b, alg);
    let pc: i32 = (der_content(b, bit) + 1);
    if ((der_byte(b, pc) != 4)) {
        return X509_CURVE_NONE();
    }
    let L: i32 = (flen / 2);
    bn_from_be(Qx, b, (pc + 1), flen, L);
    bn_from_be(Qy, b, ((pc + 1) + flen), flen, L);
    return curve;
}

fn x509_der_equal(b: *i8, p1: i32, b2: *i8, p2: i32) i32 {
    let n1: i32 = (der_end(b, p1) - p1);
    let n2: i32 = (der_end(b2, p2) - p2);
    if ((n1 != n2)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i < n1)) {
        if ((der_byte(b, (p1 + i)) != der_byte(b2, (p2 + i)))) {
            return 0;
        }
        i = (i + 1);
    }
    return 1;
}

fn x509_time_digit(b: *i8, p: i32) i32 {
    return (der_byte(b, p) - 48);
}

fn x509_time2(b: *i8, p: i32) i32 {
    return ((x509_time_digit(b, p) * 10) + x509_time_digit(b, (p + 1)));
}

fn x509_time_epoch(b: *i8, tpos: i32) i64 {
    let tag: i32 = der_byte(b, tpos);
    let c: i32 = der_content(b, tpos);
    let year: i32 = 0;
    let m: i32 = 0;
    if ((tag == 23)) {
        let yy: i32 = x509_time2(b, c);
        year = (2000 + yy);
        if ((yy >= 50)) {
            year = (1900 + yy);
        }
        m = (c + 2);
    } else {
        year = ((x509_time2(b, c) * 100) + x509_time2(b, (c + 2)));
        m = (c + 4);
    }
    let mon: i32 = x509_time2(b, m);
    let day: i32 = x509_time2(b, (m + 2));
    let hh: i32 = x509_time2(b, (m + 4));
    let mm: i32 = x509_time2(b, (m + 6));
    let ss: i32 = x509_time2(b, (m + 8));
    let y: i64 = (year) as i64;
    let mo: i64 = (mon) as i64;
    if ((mon <= 2)) {
        y = (y - 1);
    }
    let era: i64 = (y / 400);
    let yoe: i64 = (y - (era * 400));
    let mp: i64 = (mon + 9);
    if ((mon > 2)) {
        mp = (mon - 3);
    }
    let doy: i64 = (((((153 * mp) + 2) / 5) + (day) as i64) - 1);
    let doe: i64 = ((((yoe * 365) + (yoe / 4)) - (yoe / 100)) + doy);
    let days: i64 = (((era * 146097) + doe) - 719468);
    return ((((days * 86400) + ((hh) as i64 * 3600)) + ((mm) as i64 * 60)) + (ss) as i64);
}

fn x509_valid_at(b: *i8, coff: i32, now: i64) i32 {
    let v: i32 = x509_validity(b, coff);
    let nb: i32 = der_first(b, v);
    let na: i32 = der_next(b, nb);
    let t0: i64 = x509_time_epoch(b, nb);
    let t1: i64 = x509_time_epoch(b, na);
    if ((now < t0)) {
        return 0;
    }
    if ((now > t1)) {
        return 0;
    }
    return 1;
}

fn x509_ci_eq(b: *i8, p: i32, host: []u8, hoff: i32, n: i32) i32 {
    let i: i32 = 0;
    while ((i < n)) {
        let a: i32 = der_byte(b, (p + i));
        if (((a >= 65) && (a <= 90))) {
            a = (a + 32);
        }
        let c: i32 = (host[(hoff + i)]) as i32;
        if (((c >= 65) && (c <= 90))) {
            c = (c + 32);
        }
        if ((a != c)) {
            return 0;
        }
        i = (i + 1);
    }
    return 1;
}

fn x509_dns_match(b: *i8, p: i32, n: i32, host: []u8) i32 {
    if ((((n >= 2) && (der_byte(b, p) == 42)) && (der_byte(b, (p + 1)) == 46))) {
        let suffix_len: i32 = (n - 1);
        if ((host.len <= suffix_len)) {
            return 0;
        }
        let hstart: i32 = (host.len - suffix_len);
        let d: i32 = 0;
        while ((d < hstart)) {
            if ((host[d] == (46) as u8)) {
                return 0;
            }
            d = (d + 1);
        }
        return x509_ci_eq(b, (p + 1), host, hstart, suffix_len);
    }
    if ((n != host.len)) {
        return 0;
    }
    return x509_ci_eq(b, p, host, 0, n);
}

fn x509_hostname_ok(b: *i8, coff: i32, host: []u8) i32 {
    let tbs: i32 = x509_tbs_pos(b, coff);
    let tend: i32 = der_end(b, tbs);
    let p: i32 = der_first(b, tbs);
    let found_ext: i32 = (0 - 1);
    while ((p < tend)) {
        if ((der_byte(b, p) == 163)) {
            found_ext = p;
            p = tend;
        } else {
            p = der_next(b, p);
        }
    }
    if ((found_ext < 0)) {
        return 0;
    }
    let exts: i32 = der_first(b, found_ext);
    let e: i32 = der_first(b, exts);
    let eend: i32 = der_end(b, exts);
    while ((e < eend)) {
        let oid: i32 = der_first(b, e);
        let oc: i32 = der_content(b, oid);
        let ol: i32 = der_len(b, oid);
        if (((((ol == 3) && (der_byte(b, oc) == 85)) && (der_byte(b, (oc + 1)) == 29)) && (der_byte(b, (oc + 2)) == 17))) {
            let vv: i32 = der_next(b, oid);
            if ((der_byte(b, vv) == 1)) {
                vv = der_next(b, vv);
            }
            let oct: i32 = der_content(b, vv);
            let names: i32 = oct;
            let g: i32 = der_first(b, names);
            let gend: i32 = der_end(b, names);
            while ((g < gend)) {
                if ((der_byte(b, g) == 130)) {
                    let gc: i32 = der_content(b, g);
                    let gl: i32 = der_len(b, g);
                    if ((x509_dns_match(b, gc, gl, host) == 1)) {
                        return 1;
                    }
                }
                g = der_next(b, g);
            }
            return 0;
        }
        e = der_next(b, e);
    }
    return 0;
}

fn cv_b64val(c: i32) i32 {
    if (((c >= 65) && (c <= 90))) {
        return (c - 65);
    }
    if (((c >= 97) && (c <= 122))) {
        return ((c - 97) + 26);
    }
    if (((c >= 48) && (c <= 57))) {
        return ((c - 48) + 52);
    }
    if ((c == 43)) {
        return 62;
    }
    if ((c == 47)) {
        return 63;
    }
    return (0 - 1);
}

fn cv_b64_decode(src: []u8, off: i32, n: i32, out: *i8) i32 {
    let acc: i32 = 0;
    let bits: i32 = 0;
    let w: i32 = 0;
    let i: i32 = 0;
    while ((i < n)) {
        let c: i32 = (src[(off + i)]) as i32;
        if ((c == 61)) {
            i = n;
        } else {
            let v: i32 = cv_b64val(c);
            if ((v >= 0)) {
                acc = ((acc << 6) + v);
                bits = (bits + 6);
                if ((bits >= 8)) {
                    bits = (bits - 8);
                    out[w] = (((acc >> bits) & 255)) as i8;
                    w = (w + 1);
                }
            }
            i = (i + 1);
        }
    }
    return w;
}

fn cv_digest_bn(digest: *i8, digest_len: i32, curveL: i32, out: *i64) void {
    let curve_bytes: i32 = (curveL * 2);
    let n: i32 = digest_len;
    if ((n > curve_bytes)) {
        n = curve_bytes;
    }
    bn_from_be(out, digest, 0, n, curveL);
}

fn cv_verify_sig(b: *i8, coff: i32, issuer_curve: i32, Qx: *i64, Qy: *i64) i32 {
    let hashid: i32 = x509_sig_hash(b, coff);
    if ((hashid == 0)) {
        return 0;
    }
    let tbs: i32 = x509_tbs_pos(b, coff);
    let tlen: i32 = (der_end(b, tbs) - tbs);
    let digest: *i8 = _zag_malloc(64);
    let dlen: i32 = 0;
    if ((hashid == X509_HASH_SHA256())) {
        sha256((((b) as i64 + (tbs) as i64)) as *i8, tlen, digest);
        dlen = 32;
    } else {
        sha384((((b) as i64 + (tbs) as i64)) as *i8, tlen, digest);
        dlen = 48;
    }
    let L: i32 = 16;
    if ((issuer_curve == X509_CURVE_P384())) {
        L = 24;
    }
    let r: *i64 = bn_new();
    let s: *i64 = bn_new();
    x509_sig_rs(b, coff, r, s, L);
    let z: *i64 = bn_new();
    cv_digest_bn(digest, dlen, L, z);
    if ((issuer_curve == X509_CURVE_P256())) {
        return ecdsa_verify_p256(Qx, Qy, z, r, s);
    }
    if ((issuer_curve == X509_CURVE_P384())) {
        return ecdsa_verify_p384(Qx, Qy, z, r, s);
    }
    return 0;
}

fn cv_root_verify(ib: *i8, top_coff: i32) i32 {
    let issuer: i32 = x509_issuer(ib, top_coff);
    let pem: []u8 = _zag_read_file("/etc/ssl/certs/ca-certificates.crt");
    if ((pem.len < 1)) {
        return 0;
    }
    let der: *i8 = _zag_malloc(8192);
    let i: i32 = 0;
    while ((i < pem.len)) {
        if (((((i + 15) < pem.len) && (pem[i] == (45) as u8)) && (pem[(i + 5)] == (66) as u8))) {
            while (((i < pem.len) && (pem[i] != (10) as u8))) {
                i = (i + 1);
            }
            i = (i + 1);
            let b64start: i32 = i;
            while (((i < pem.len) && (pem[i] != (45) as u8))) {
                i = (i + 1);
            }
            let dlen: i32 = cv_b64_decode(pem, b64start, (i - b64start), der);
            if ((dlen > 0)) {
                let rsubj: i32 = x509_subject(der, 0);
                if ((x509_der_equal(ib, issuer, der, rsubj) == 1)) {
                    let rQx: *i64 = bn_new();
                    let rQy: *i64 = bn_new();
                    let rcurve: i32 = x509_pubkey(der, 0, rQx, rQy);
                    if ((rcurve == X509_CURVE_NONE())) {
                        return 0;
                    }
                    return cv_verify_sig(ib, top_coff, rcurve, rQx, rQy);
                }
            }
        }
        i = (i + 1);
    }
    return 0;
}

fn certverify_chain(b: *i8, cert_off: *i32, count: i32, host: []u8, now: i64) i32 {
    if ((count < 1)) {
        return 0;
    }
    if ((x509_hostname_ok(b, cert_off[0], host) == 0)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i < count)) {
        if ((x509_valid_at(b, cert_off[i], now) == 0)) {
            return 0;
        }
        i = (i + 1);
    }
    i = 0;
    while ((i < (count - 1))) {
        if ((x509_der_equal(b, x509_issuer(b, cert_off[i]), b, x509_subject(b, cert_off[(i + 1)])) == 0)) {
            return 0;
        }
        let iQx: *i64 = bn_new();
        let iQy: *i64 = bn_new();
        let icurve: i32 = x509_pubkey(b, cert_off[(i + 1)], iQx, iQy);
        if ((icurve == X509_CURVE_NONE())) {
            return 0;
        }
        if ((cv_verify_sig(b, cert_off[i], icurve, iQx, iQy) == 0)) {
            return 0;
        }
        i = (i + 1);
    }
    let a: i32 = 0;
    while ((a < count)) {
        if ((cv_root_verify(b, cert_off[a]) == 1)) {
            return 1;
        }
        a = (a + 1);
    }
    return 0;
}

struct TlsConn {
    fd: i64,
    priv: *i8,
    transcript: *i8,
    tlen: i32,
    hs_secret: *i8,
    c_hs: *i8,
    s_hs_key: *i8,
    s_hs_iv: *i8,
    c_hs_key: *i8,
    c_hs_iv: *i8,
    s_ap_key: *i8,
    s_ap_iv: *i8,
    c_ap_key: *i8,
    c_ap_iv: *i8,
    s_seq: i64,
    c_seq: i64,
    err: i32,
}

fn tls_ok() i32 {
    return 0;
}

fn tls_last_authenticated() i32 {
    return 1;
}

fn tls_put8(b: *i8, at: i32, v: i32) i32 {
    b[at] = ((v & 255)) as i8;
    return (at + 1);
}

fn tls_put16(b: *i8, at: i32, v: i32) i32 {
    b[at] = (((v >> 8) & 255)) as i8;
    b[(at + 1)] = ((v & 255)) as i8;
    return (at + 2);
}

fn tls_put24(b: *i8, at: i32, v: i32) i32 {
    b[at] = (((v >> 16) & 255)) as i8;
    b[(at + 1)] = (((v >> 8) & 255)) as i8;
    b[(at + 2)] = ((v & 255)) as i8;
    return (at + 3);
}

fn tls_putbytes(b: *i8, at: i32, src: *i8, n: i32) i32 {
    let i: i32 = 0;
    while ((i < n)) {
        b[(at + i)] = src[i];
        i = (i + 1);
    }
    return (at + n);
}

fn tls_putstr(b: *i8, at: i32, s: []u8) i32 {
    let i: i32 = 0;
    while ((i < s.len)) {
        b[(at + i)] = (s[i]) as i8;
        i = (i + 1);
    }
    return (at + s.len);
}

fn tls_rd16(b: *i8, at: i32) i32 {
    return ((((b[at]) as u8) as i32 * 256) + ((b[(at + 1)]) as u8) as i32);
}

fn tls_rd24(b: *i8, at: i32) i32 {
    return (((((b[at]) as u8) as i32 * 65536) + (((b[(at + 1)]) as u8) as i32 * 256)) + ((b[(at + 2)]) as u8) as i32);
}

fn tls_nonce(iv: *i8, seq: i64, out: *i8) void {
    let i: i32 = 0;
    while ((i < 12)) {
        out[i] = iv[i];
        i = (i + 1);
    }
    let s: i64 = seq;
    let j: i32 = 0;
    while ((j < 8)) {
        let sb: i64 = ((s >> ((7 - j) * 8)) & 255);
        out[(4 + j)] = ((((out[(4 + j)]) as u8) as i64 ^ sb)) as i8;
        j = (j + 1);
    }
}

fn tls_transcript_add(c: *TlsConn, msg: *i8, n: i32) void {
    let i: i32 = 0;
    while ((i < n)) {
        c.*.transcript[(c.*.tlen + i)] = msg[i];
        i = (i + 1);
    }
    c.*.tlen = (c.*.tlen + n);
}

fn tls_transcript_hash(c: *TlsConn, out: *i8) void {
    sha256(c.*.transcript, c.*.tlen, out);
}

fn tls_build_client_hello(c: *TlsConn, host: []u8, pub: *i8, out: *i8) i32 {
    let p: i32 = 4;
    p = tls_put16(out, p, 771);
    let rnd: *i8 = _zag_malloc(32);
    let _r: i32 = crypto_random(rnd, 32);
    p = tls_putbytes(out, p, rnd, 32);
    p = tls_put8(out, p, 32);
    let sid: *i8 = _zag_malloc(32);
    let _s: i32 = crypto_random(sid, 32);
    p = tls_putbytes(out, p, sid, 32);
    p = tls_put16(out, p, 2);
    p = tls_put16(out, p, 4867);
    p = tls_put8(out, p, 1);
    p = tls_put8(out, p, 0);
    let ext_len_pos: i32 = p;
    p = (p + 2);
    let ext_start: i32 = p;
    p = tls_put16(out, p, 0);
    p = tls_put16(out, p, (host.len + 5));
    p = tls_put16(out, p, (host.len + 3));
    p = tls_put8(out, p, 0);
    p = tls_put16(out, p, host.len);
    p = tls_putstr(out, p, host);
    p = tls_put16(out, p, 10);
    p = tls_put16(out, p, 4);
    p = tls_put16(out, p, 2);
    p = tls_put16(out, p, 29);
    p = tls_put16(out, p, 13);
    p = tls_put16(out, p, 8);
    p = tls_put16(out, p, 6);
    p = tls_put16(out, p, 1027);
    p = tls_put16(out, p, 2052);
    p = tls_put16(out, p, 1025);
    p = tls_put16(out, p, 43);
    p = tls_put16(out, p, 3);
    p = tls_put8(out, p, 2);
    p = tls_put16(out, p, 772);
    p = tls_put16(out, p, 51);
    p = tls_put16(out, p, 38);
    p = tls_put16(out, p, 36);
    p = tls_put16(out, p, 29);
    p = tls_put16(out, p, 32);
    p = tls_putbytes(out, p, pub, 32);
    let _fix: i32 = tls_put16(out, ext_len_pos, (p - ext_start));
    let _h1: i32 = tls_put8(out, 0, 1);
    let _h2: i32 = tls_put24(out, 1, (p - 4));
    return p;
}

fn tls_derive_traffic_keys(secret: *i8, key: *i8, iv: *i8) void {
    hkdf_expand_label(secret, "key", (0) as *i8, 0, 32, key);
    hkdf_expand_label(secret, "iv", (0) as *i8, 0, 12, iv);
}

fn tls_key_schedule(c: *TlsConn, server_pub: *i8) void {
    let zeros: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        zeros[i] = (0) as i8;
        i = (i + 1);
    }
    let empty_hash: *i8 = _zag_malloc(32);
    sha256(zeros, 0, empty_hash);
    let early: *i8 = _zag_malloc(32);
    hkdf_extract(zeros, 32, zeros, 32, early);
    let derived: *i8 = _zag_malloc(32);
    hkdf_expand_label(early, "derived", empty_hash, 32, 32, derived);
    let shared: *i8 = _zag_malloc(32);
    x25519_shared(shared, c.*.priv, server_pub);
    hkdf_extract(derived, 32, shared, 32, c.*.hs_secret);
    let th: *i8 = _zag_malloc(32);
    tls_transcript_hash(c, th);
    hkdf_expand_label(c.*.hs_secret, "c hs traffic", th, 32, 32, c.*.c_hs);
    let s_hs: *i8 = _zag_malloc(32);
    hkdf_expand_label(c.*.hs_secret, "s hs traffic", th, 32, 32, s_hs);
    tls_derive_traffic_keys(c.*.c_hs, c.*.c_hs_key, c.*.c_hs_iv);
    tls_derive_traffic_keys(s_hs, c.*.s_hs_key, c.*.s_hs_iv);
    c.*.s_seq = 0;
    c.*.c_seq = 0;
}

fn tls_app_schedule(c: *TlsConn) void {
    let zeros: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        zeros[i] = (0) as i8;
        i = (i + 1);
    }
    let empty_hash: *i8 = _zag_malloc(32);
    sha256(zeros, 0, empty_hash);
    let derived2: *i8 = _zag_malloc(32);
    hkdf_expand_label(c.*.hs_secret, "derived", empty_hash, 32, 32, derived2);
    let master: *i8 = _zag_malloc(32);
    hkdf_extract(derived2, 32, zeros, 32, master);
    let th: *i8 = _zag_malloc(32);
    tls_transcript_hash(c, th);
    let c_ap: *i8 = _zag_malloc(32);
    let s_ap: *i8 = _zag_malloc(32);
    hkdf_expand_label(master, "c ap traffic", th, 32, 32, c_ap);
    hkdf_expand_label(master, "s ap traffic", th, 32, 32, s_ap);
    tls_derive_traffic_keys(c_ap, c.*.c_ap_key, c.*.c_ap_iv);
    tls_derive_traffic_keys(s_ap, c.*.s_ap_key, c.*.s_ap_iv);
}

fn tls_read_record(c: *TlsConn, rtype: *i32, buf: *i8) i32 {
    let hdr: *i8 = _zag_malloc(5);
    if ((net_tcp_recv_n(c.*.fd, hdr, 5) < 0)) {
        return (0 - 1);
    }
    rtype.* = ((hdr[0]) as u8) as i32;
    let len: i32 = tls_rd16(hdr, 3);
    if (((len < 0) || (len > 20000))) {
        return (0 - 2);
    }
    if ((net_tcp_recv_n(c.*.fd, buf, len) < 0)) {
        return (0 - 3);
    }
    return len;
}

fn tls_send_plain(c: *TlsConn, payload: *i8, n: i32) i64 {
    let rec: *i8 = _zag_malloc((n + 5));
    let p: i32 = tls_put8(rec, 0, 22);
    p = tls_put16(rec, p, 771);
    p = tls_put16(rec, p, n);
    p = tls_putbytes(rec, p, payload, n);
    return net_tcp_send_raw(c.*.fd, rec, p);
}

fn tls_send_encrypted(c: *TlsConn, key: *i8, iv: *i8, seq: i64, inner_type: i32, data: *i8, n: i32) i64 {
    let inner: *i8 = _zag_malloc((n + 1));
    let i: i32 = 0;
    while ((i < n)) {
        inner[i] = data[i];
        i = (i + 1);
    }
    inner[n] = (inner_type) as i8;
    let inner_len: i32 = (n + 1);
    let ctlen: i32 = (inner_len + 16);
    let aad: *i8 = _zag_malloc(5);
    let _a: i32 = tls_put8(aad, 0, 23);
    let _a2: i32 = tls_put16(aad, 1, 771);
    let _a3: i32 = tls_put16(aad, 3, ctlen);
    let nonce: *i8 = _zag_malloc(12);
    tls_nonce(iv, seq, nonce);
    let ct: *i8 = _zag_malloc(ctlen);
    aead_seal(key, nonce, aad, 5, inner, inner_len, ct);
    let rec: *i8 = _zag_malloc((ctlen + 5));
    let p: i32 = tls_putbytes(rec, 0, aad, 5);
    p = tls_putbytes(rec, p, ct, ctlen);
    return net_tcp_send_raw(c.*.fd, rec, p);
}

fn tls_decrypt_record(key: *i8, iv: *i8, seq: i64, ct: *i8, ctlen: i32, out: *i8, outlen: *i32) i32 {
    let aad: *i8 = _zag_malloc(5);
    let _a: i32 = tls_put8(aad, 0, 23);
    let _a2: i32 = tls_put16(aad, 1, 771);
    let _a3: i32 = tls_put16(aad, 3, ctlen);
    let nonce: *i8 = _zag_malloc(12);
    tls_nonce(iv, seq, nonce);
    if ((aead_open(key, nonce, aad, 5, ct, ctlen, out) == 0)) {
        return (0 - 1);
    }
    let plen: i32 = (ctlen - 16);
    while (((plen > 0) && (out[(plen - 1)] == (0) as i8))) {
        plen = (plen - 1);
    }
    if ((plen < 1)) {
        return (0 - 2);
    }
    let itype: i32 = ((out[(plen - 1)]) as u8) as i32;
    outlen.* = (plen - 1);
    return itype;
}

fn tls_alloc_conn() *TlsConn {
    let c: *TlsConn = (_zag_malloc(@sizeOf[TlsConn]())) as *TlsConn;
    c.*.priv = _zag_malloc(32);
    c.*.transcript = _zag_malloc(20000);
    c.*.tlen = 0;
    c.*.hs_secret = _zag_malloc(32);
    c.*.c_hs = _zag_malloc(32);
    c.*.s_hs_key = _zag_malloc(32);
    c.*.s_hs_iv = _zag_malloc(12);
    c.*.c_hs_key = _zag_malloc(32);
    c.*.c_hs_iv = _zag_malloc(12);
    c.*.s_ap_key = _zag_malloc(32);
    c.*.s_ap_iv = _zag_malloc(12);
    c.*.c_ap_key = _zag_malloc(32);
    c.*.c_ap_iv = _zag_malloc(12);
    c.*.err = 0;
    return c;
}

fn tls_parse_server_hello(sh: *i8, shlen: i32, server_pub: *i8) i32 {
    if ((((sh[0]) as u8) as i32 != 2)) {
        return (0 - 1);
    }
    let p: i32 = 4;
    p = (p + 2);
    p = (p + 32);
    let sidlen: i32 = ((sh[p]) as u8) as i32;
    p = ((p + 1) + sidlen);
    p = (p + 2);
    p = (p + 1);
    let ext_total: i32 = tls_rd16(sh, p);
    p = (p + 2);
    let ext_end: i32 = (p + ext_total);
    while (((p + 4) <= ext_end)) {
        let etype: i32 = tls_rd16(sh, p);
        p = (p + 2);
        let elen: i32 = tls_rd16(sh, p);
        p = (p + 2);
        if ((etype == 51)) {
            let keylen: i32 = tls_rd16(sh, (p + 2));
            let i: i32 = 0;
            while (((i < keylen) && (i < 32))) {
                server_pub[i] = sh[((p + 4) + i)];
                i = (i + 1);
            }
            return 0;
        }
        p = (p + elen);
    }
    return (0 - 2);
}

fn tls_authenticate(c: *TlsConn, hs: *i8, hslen: i32, host: []u8) i32 {
    let mo: i32 = 0;
    let cert_msg: i32 = (0 - 1);
    let cert_end: i32 = (0 - 1);
    let cv_msg: i32 = (0 - 1);
    while (((mo + 4) <= hslen)) {
        let mtype: i32 = ((hs[mo]) as u8) as i32;
        let mlen: i32 = tls_rd24(hs, (mo + 1));
        let mend: i32 = ((mo + 4) + mlen);
        if ((mtype == 11)) {
            cert_msg = mo;
            cert_end = mend;
        }
        if ((mtype == 15)) {
            cv_msg = mo;
        }
        mo = mend;
    }
    if (((cert_msg < 0) || (cv_msg < 0))) {
        return 0;
    }
    let body: i32 = (cert_msg + 4);
    let ctx_len: i32 = ((hs[body]) as u8) as i32;
    let listp: i32 = ((body + 1) + ctx_len);
    let list_len: i32 = tls_rd24(hs, listp);
    let e: i32 = (listp + 3);
    let list_end: i32 = (e + list_len);
    let cert_off: *i32 = (_zag_malloc((16 * 4))) as *i32;
    let count: i32 = 0;
    while ((((e + 3) <= list_end) && (count < 16))) {
        let clen: i32 = tls_rd24(hs, e);
        cert_off[count] = (e + 3);
        count = (count + 1);
        e = ((e + 3) + clen);
        let extlen: i32 = tls_rd16(hs, e);
        e = ((e + 2) + extlen);
    }
    if ((count < 1)) {
        return 0;
    }
    let leafQx: *i64 = bn_new();
    let leafQy: *i64 = bn_new();
    let leafcurve: i32 = x509_pubkey(hs, cert_off[0], leafQx, leafQy);
    if (((leafcurve != X509_CURVE_P256()) && (leafcurve != X509_CURVE_P384()))) {
        return 0;
    }
    let cvhash: *i8 = _zag_malloc(32);
    let tmp: *i8 = _zag_malloc(((c.*.tlen + cert_end) + 16));
    let n: i32 = 0;
    let k: i32 = 0;
    while ((k < c.*.tlen)) {
        tmp[n] = c.*.transcript[k];
        n = (n + 1);
        k = (k + 1);
    }
    k = 0;
    while ((k < cert_end)) {
        tmp[n] = hs[k];
        n = (n + 1);
        k = (k + 1);
    }
    sha256(tmp, n, cvhash);
    let content: *i8 = _zag_malloc(200);
    let cn: i32 = 0;
    while ((cn < 64)) {
        content[cn] = (32) as i8;
        cn = (cn + 1);
    }
    let label: []u8 = "TLS 1.3, server CertificateVerify";
    let li: i32 = 0;
    while ((li < label.len)) {
        content[cn] = (label[li]) as i8;
        cn = (cn + 1);
        li = (li + 1);
    }
    content[cn] = (0) as i8;
    cn = (cn + 1);
    let hi: i32 = 0;
    while ((hi < 32)) {
        content[cn] = (cvhash[hi]) as i8;
        cn = (cn + 1);
        hi = (hi + 1);
    }
    let cvb: i32 = (cv_msg + 4);
    let scheme: i32 = tls_rd16(hs, cvb);
    let L: i32 = 16;
    let digest: *i8 = _zag_malloc(64);
    let dlen: i32 = 0;
    if ((scheme == 1027)) {
        sha256(content, cn, digest);
        dlen = 32;
        L = 16;
    } else if ((scheme == 1283)) {
        sha384(content, cn, digest);
        dlen = 48;
        L = 24;
    } else {
        return 0;
    }
    let sigp: i32 = (cvb + 4);
    let rr: *i64 = bn_new();
    let ss: *i64 = bn_new();
    x509_sig_rs_at(hs, sigp, rr, ss, L);
    let z: *i64 = bn_new();
    cv_digest_bn(digest, dlen, L, z);
    let cv_ok: i32 = 0;
    if ((scheme == 1027)) {
        cv_ok = ecdsa_verify_p256(leafQx, leafQy, z, rr, ss);
    } else {
        cv_ok = ecdsa_verify_p384(leafQx, leafQy, z, rr, ss);
    }
    if ((cv_ok == 0)) {
        return 0;
    }
    let now: i64 = _zag_raw_syscall(201, 0, 0, 0, 0, 0, 0);
    return certverify_chain(hs, cert_off, count, host, now);
}

fn tls_https_get(host: []u8, port: i32, path: []u8, out: *i8, cap: i32) i32 {
    let ip: i64 = net_dns_resolve(host);
    if ((ip < 0)) {
        return (0 - 10);
    }
    let fd: i64 = net_tcp_connect(ip, port);
    if ((fd < 0)) {
        return (0 - 11);
    }
    let c: *TlsConn = tls_alloc_conn();
    c.*.fd = fd;
    let _r: i32 = crypto_random(c.*.priv, 32);
    let pub: *i8 = _zag_malloc(32);
    x25519_base(pub, c.*.priv);
    let ch: *i8 = _zag_malloc(1024);
    let chlen: i32 = tls_build_client_hello(c, host, pub, ch);
    tls_transcript_add(c, ch, chlen);
    let _w: i64 = tls_send_plain(c, ch, chlen);
    let rbuf: *i8 = _zag_malloc(20000);
    let rtype: i32 = 0;
    let rlen: i32 = tls_read_record(c, &rtype, rbuf);
    while (((rlen > 0) && (rtype == 20))) {
        rlen = tls_read_record(c, &rtype, rbuf);
    }
    if (((rlen < 0) || (rtype != 22))) {
        net_tcp_close(fd);
        return (0 - 12);
    }
    tls_transcript_add(c, rbuf, rlen);
    let server_pub: *i8 = _zag_malloc(32);
    if ((tls_parse_server_hello(rbuf, rlen, server_pub) != 0)) {
        net_tcp_close(fd);
        return (0 - 13);
    }
    tls_key_schedule(c, server_pub);
    let hs_stream: *i8 = _zag_malloc(20000);
    let hs_len: i32 = 0;
    let saw_finished: i32 = 0;
    let dec: *i8 = _zag_malloc(20000);
    let guard: i32 = 0;
    while (((saw_finished == 0) && (guard < 32))) {
        rlen = tls_read_record(c, &rtype, rbuf);
        if ((rlen < 0)) {
            net_tcp_close(fd);
            return (0 - 14);
        }
        if ((rtype == 20)) {
            guard = (guard + 1);
        }
        if ((rtype == 23)) {
            let plen: i32 = 0;
            let itype: i32 = tls_decrypt_record(c.*.s_hs_key, c.*.s_hs_iv, c.*.s_seq, rbuf, rlen, dec, &plen);
            c.*.s_seq = (c.*.s_seq + 1);
            if ((itype < 0)) {
                net_tcp_close(fd);
                return (0 - 15);
            }
            if ((itype == 22)) {
                let i: i32 = 0;
                while ((i < plen)) {
                    hs_stream[(hs_len + i)] = dec[i];
                    i = (i + 1);
                }
                hs_len = (hs_len + plen);
                let q: i32 = 0;
                while (((q + 4) <= hs_len)) {
                    let mtype: i32 = ((hs_stream[q]) as u8) as i32;
                    let mlen: i32 = tls_rd24(hs_stream, (q + 1));
                    if ((((q + 4) + mlen) > hs_len)) {
                        q = hs_len;
                    } else {
                        if ((mtype == 20)) {
                            saw_finished = 1;
                        }
                        q = ((q + 4) + mlen);
                    }
                }
            }
        }
        guard = (guard + 1);
    }
    if ((saw_finished == 0)) {
        net_tcp_close(fd);
        return (0 - 16);
    }
    if ((tls_authenticate(c, hs_stream, hs_len, host) == 0)) {
        net_tcp_close(fd);
        return (0 - 30);
    }
    tls_transcript_add(c, hs_stream, hs_len);
    let th_sf: *i8 = _zag_malloc(32);
    tls_transcript_hash(c, th_sf);
    let fin_key: *i8 = _zag_malloc(32);
    hkdf_expand_label(c.*.c_hs, "finished", (0) as *i8, 0, 32, fin_key);
    let verify: *i8 = _zag_malloc(32);
    hmac_sha256(fin_key, 32, th_sf, 32, verify);
    let finmsg: *i8 = _zag_malloc(36);
    let fp: i32 = tls_put8(finmsg, 0, 20);
    fp = tls_put24(finmsg, 1, 32);
    fp = tls_putbytes(finmsg, fp, verify, 32);
    let _cf: i64 = tls_send_encrypted(c, c.*.c_hs_key, c.*.c_hs_iv, c.*.c_seq, 22, finmsg, fp);
    c.*.c_seq = (c.*.c_seq + 1);
    tls_app_schedule(c);
    c.*.s_seq = 0;
    let c_app_seq: i64 = 0;
    let req: []u8 = _zag_str_concat("GET ", path);
    req = _zag_str_concat(req, " HTTP/1.0\r\nHost: ");
    req = _zag_str_concat(req, host);
    req = _zag_str_concat(req, "\r\nUser-Agent: RayBrowser/0.1 (RayOS)\r\nConnection: close\r\n\r\n");
    let reqbuf: *i8 = _zag_malloc(req.len);
    let i: i32 = 0;
    while ((i < req.len)) {
        reqbuf[i] = (req[i]) as i8;
        i = (i + 1);
    }
    let _hr: i64 = tls_send_encrypted(c, c.*.c_ap_key, c.*.c_ap_iv, c_app_seq, 23, reqbuf, req.len);
    c_app_seq = (c_app_seq + 1);
    let total: i32 = 0;
    let reading: i32 = 1;
    while (((reading == 1) && (total < cap))) {
        rlen = tls_read_record(c, &rtype, rbuf);
        if ((rlen < 0)) {
            reading = 0;
        } else if ((rtype == 23)) {
            let plen: i32 = 0;
            let itype: i32 = tls_decrypt_record(c.*.s_ap_key, c.*.s_ap_iv, c.*.s_seq, rbuf, rlen, dec, &plen);
            c.*.s_seq = (c.*.s_seq + 1);
            if ((itype < 0)) {
                reading = 0;
            } else if ((itype == 23)) {
                let k: i32 = 0;
                while (((k < plen) && (total < cap))) {
                    out[total] = dec[k];
                    total = (total + 1);
                    k = (k + 1);
                }
            } else if ((itype == 21)) {
                reading = 0;
            }
        } else if ((rtype == 21)) {
            reading = 0;
        }
    }
    net_tcp_close(fd);
    return total;
}

struct HttpUrl {
    ok: i32,
    secure: i32,
    host: []u8,
    port: i32,
    path: []u8,
}

struct HttpResponse {
    ok: i32,
    status: i32,
    secure: i32,
    ip: i64,
    headers: []u8,
    body: []u8,
    error: []u8,
}

fn http_lower(c: u8) u8 {
    if (((c >= (65) as u8) && (c <= (90) as u8))) {
        return (c + 32);
    }
    return c;
}

fn http_ci_contains(hay: []u8, needle: []u8) i32 {
    if ((needle.len < 1)) {
        return 1;
    }
    if ((hay.len < needle.len)) {
        return 0;
    }
    let i: i32 = 0;
    while ((i <= (hay.len - needle.len))) {
        let j: i32 = 0;
        let hit: i32 = 1;
        while ((j < needle.len)) {
            if ((http_lower(hay[(i + j)]) != http_lower(needle[j]))) {
                hit = 0;
                j = needle.len;
            } else {
                j = (j + 1);
            }
        }
        if ((hit == 1)) {
            return 1;
        }
        i = (i + 1);
    }
    return 0;
}

fn http_header(headers: []u8, name: []u8) []u8 {
    let n: i32 = 0;
    let start: i32 = 0;
    while ((n <= headers.len)) {
        if (((n == headers.len) || (headers[n] == (10) as u8))) {
            let line: []u8 = headers[start..n];
            if ((line.len > (name.len + 1))) {
                let match: i32 = 1;
                let k: i32 = 0;
                while ((k < name.len)) {
                    if ((http_lower(line[k]) != http_lower(name[k]))) {
                        match = 0;
                        k = name.len;
                    } else {
                        k = (k + 1);
                    }
                }
                if (((match == 1) && (line[name.len] == (58) as u8))) {
                    let v: i32 = (name.len + 1);
                    while (((v < line.len) && ((line[v] == (32) as u8) || (line[v] == (9) as u8)))) {
                        v = (v + 1);
                    }
                    let e: i32 = line.len;
                    while (((e > v) && ((line[(e - 1)] == (13) as u8) || (line[(e - 1)] == (32) as u8)))) {
                        e = (e - 1);
                    }
                    return line[v..e];
                }
            }
            start = (n + 1);
        }
        n = (n + 1);
    }
    return "";
}

fn http_parse_url(url: []u8) HttpUrl {
    let bad: HttpUrl = HttpUrl{ .ok = 0, .secure = 0, .host = "", .port = 80, .path = "/" };
    let at: i32 = 0;
    let scheme_end: i32 = (0 - 1);
    let i: i32 = 0;
    while (((i + 2) < url.len)) {
        if ((((url[i] == (58) as u8) && (url[(i + 1)] == (47) as u8)) && (url[(i + 2)] == (47) as u8))) {
            scheme_end = i;
            i = url.len;
        } else {
            i = (i + 1);
        }
    }
    let secure: i32 = 0;
    let port: i32 = 80;
    if ((scheme_end >= 0)) {
        if ((scheme_end == 5)) {
            secure = 1;
            port = 443;
        }
        at = (scheme_end + 3);
    }
    let hstart: i32 = at;
    while ((((at < url.len) && (url[at] != (47) as u8)) && (url[at] != (58) as u8))) {
        at = (at + 1);
    }
    let host: []u8 = url[hstart..at];
    if ((host.len < 1)) {
        return bad;
    }
    if (((at < url.len) && (url[at] == (58) as u8))) {
        at = (at + 1);
        let pstart: i32 = at;
        while (((at < url.len) && (url[at] != (47) as u8))) {
            at = (at + 1);
        }
        port = (_zag_str_to_i64(url[pstart..at])) as i32;
    }
    let path: []u8 = "/";
    if ((at < url.len)) {
        path = url[at..url.len];
    }
    return HttpUrl{ .ok = 1, .secure = secure, .host = host, .port = port, .path = path };
}

fn http_parse_status(resp: []u8) i32 {
    let i: i32 = 0;
    while (((i < resp.len) && (resp[i] != (32) as u8))) {
        i = (i + 1);
    }
    while (((i < resp.len) && (resp[i] == (32) as u8))) {
        i = (i + 1);
    }
    let code: i32 = 0;
    while ((((i < resp.len) && (resp[i] >= (48) as u8)) && (resp[i] <= (57) as u8))) {
        code = ((code * 10) + ((resp[i]) as i32 - (48) as i32));
        i = (i + 1);
    }
    return code;
}

fn http_body_offset(resp: []u8) i32 {
    let i: i32 = 0;
    while (((i + 3) < resp.len)) {
        if (((((resp[i] == (13) as u8) && (resp[(i + 1)] == (10) as u8)) && (resp[(i + 2)] == (13) as u8)) && (resp[(i + 3)] == (10) as u8))) {
            return (i + 4);
        }
        i = (i + 1);
    }
    i = 0;
    while (((i + 1) < resp.len)) {
        if (((resp[i] == (10) as u8) && (resp[(i + 1)] == (10) as u8))) {
            return (i + 2);
        }
        i = (i + 1);
    }
    return resp.len;
}

fn http_hexval(c: u8) i32 {
    if (((c >= (48) as u8) && (c <= (57) as u8))) {
        return ((c) as i32 - (48) as i32);
    }
    if (((c >= (97) as u8) && (c <= (102) as u8))) {
        return (((c) as i32 - (97) as i32) + 10);
    }
    if (((c >= (65) as u8) && (c <= (70) as u8))) {
        return (((c) as i32 - (65) as i32) + 10);
    }
    return (0 - 1);
}

fn http_dechunk(body: []u8) []u8 {
    let out: *i8 = _zag_malloc((body.len + 1));
    let n: i32 = 0;
    let at: i32 = 0;
    let go: i32 = 1;
    while (((go == 1) && (at < body.len))) {
        let sz: i32 = 0;
        let any: i32 = 0;
        while (((at < body.len) && (http_hexval(body[at]) >= 0))) {
            sz = ((sz * 16) + http_hexval(body[at]));
            at = (at + 1);
            any = (any + 1);
        }
        while (((at < body.len) && (body[at] != (10) as u8))) {
            at = (at + 1);
        }
        at = (at + 1);
        if (((any == 0) || (sz == 0))) {
            go = 0;
        } else {
            let k: i32 = 0;
            while (((k < sz) && (at < body.len))) {
                out[n] = (body[at]) as i8;
                n = (n + 1);
                at = (at + 1);
                k = (k + 1);
            }
            while (((at < body.len) && ((body[at] == (13) as u8) || (body[at] == (10) as u8)))) {
                at = (at + 1);
            }
        }
    }
    let ou: *u8 = (out) as *u8;
    return ou[0..n];
}

fn http_err(msg: []u8) HttpResponse {
    return HttpResponse{ .ok = 0, .status = 0, .secure = 0, .ip = (0 - 1), .headers = "", .body = "", .error = msg };
}

fn http_fetch_once(url: []u8) HttpResponse {
    let u: HttpUrl = http_parse_url(url);
    if ((u.ok == 0)) {
        return http_err("bad url");
    }
    let resp: []u8 = "";
    if ((u.secure == 1)) {
        let cap: i32 = 524288;
        let out: *i8 = _zag_malloc(cap);
        let n: i32 = tls_https_get(u.host, u.port, u.path, out, cap);
        if ((n < 0)) {
            return http_err("tls handshake failed");
        }
        let ou: *u8 = (out) as *u8;
        resp = ou[0..n];
    } else {
        let ip: i64 = net_dns_resolve(u.host);
        if ((ip < 0)) {
            return http_err("dns resolution failed");
        }
        let fd: i64 = net_tcp_connect(ip, u.port);
        if ((fd < 0)) {
            return http_err("connect failed");
        }
        let req: []u8 = _zag_str_concat("GET ", u.path);
        req = _zag_str_concat(req, " HTTP/1.1\r\nHost: ");
        req = _zag_str_concat(req, u.host);
        req = _zag_str_concat(req, "\r\nUser-Agent: RayBrowser/0.1 (RayOS)\r\nConnection: close\r\n\r\n");
        let w: i64 = net_tcp_send(fd, req);
        if ((w < 0)) {
            net_tcp_close(fd);
            return http_err("send failed");
        }
        resp = net_tcp_recv_all(fd, 524288);
        net_tcp_close(fd);
    }
    if ((resp.len < 12)) {
        return http_err("empty response");
    }
    let status: i32 = http_parse_status(resp);
    let boff: i32 = http_body_offset(resp);
    let headers: []u8 = resp[0..boff];
    let body: []u8 = resp[boff..resp.len];
    if ((http_ci_contains(http_header(headers, "transfer-encoding"), "chunked") == 1)) {
        body = http_dechunk(body);
    }
    return HttpResponse{ .ok = 1, .status = status, .secure = u.secure, .ip = 0, .headers = headers, .body = body, .error = "" };
}

fn http_resolve_location(base: []u8, loc: []u8) []u8 {
    if ((loc.len < 1)) {
        return base;
    }
    let i: i32 = 0;
    while (((i + 2) < loc.len)) {
        if ((((loc[i] == (58) as u8) && (loc[(i + 1)] == (47) as u8)) && (loc[(i + 2)] == (47) as u8))) {
            return loc;
        }
        i = (i + 1);
    }
    let bu: HttpUrl = http_parse_url(base);
    let scheme: []u8 = "http://";
    if ((bu.secure == 1)) {
        scheme = "https://";
    }
    let origin: []u8 = _zag_str_concat(scheme, bu.host);
    if ((loc[0] == (47) as u8)) {
        return _zag_str_concat(origin, loc);
    }
    return _zag_str_concat(origin, _zag_str_concat("/", loc));
}

fn http_get(url: []u8) HttpResponse {
    let current: []u8 = url;
    let hops: i32 = 0;
    let r: HttpResponse = http_fetch_once(current);
    while ((((r.ok == 1) && (hops < 5)) && (((((r.status == 301) || (r.status == 302)) || (r.status == 303)) || (r.status == 307)) || (r.status == 308)))) {
        let loc: []u8 = http_header(r.headers, "location");
        if ((loc.len < 1)) {
            hops = 5;
        } else {
            current = http_resolve_location(current, loc);
            r = http_fetch_once(current);
            hops = (hops + 1);
        }
    }
    return r;
}

fn main() i32 {
    _zag_println("net_http_test: running");
    if ((net_parse_ipv4("1.1.1.1") != 16843009)) {
        _zag_println("net_http_test: FAIL ipv4 parse");
        return 1;
    }
    if ((net_parse_ipv4("not.an.ip.x") >= 0)) {
        _zag_println("net_http_test: FAIL ipv4 reject");
        return 1;
    }
    let u: HttpUrl = http_parse_url("http://example.com:8080/a/b?c=d");
    if ((u.ok != 1)) {
        _zag_println("net_http_test: FAIL url ok");
        return 1;
    }
    if ((_zag_strcmp(u.host, "example.com") == 0)) {
        _zag_println("net_http_test: FAIL url host");
        return 1;
    }
    if ((u.port != 8080)) {
        _zag_println("net_http_test: FAIL url port");
        return 1;
    }
    if ((_zag_strcmp(u.path, "/a/b?c=d") == 0)) {
        _zag_println("net_http_test: FAIL url path");
        return 1;
    }
    if ((net_chamber_init() != 0)) {
        _zag_println("net_http_test: FAIL chamber init");
        return 1;
    }
    let ip: i64 = net_dns_resolve("example.com");
    if ((ip < 0)) {
        _zag_println("net_http_test: no network egress — offline checks passed");
        _zag_println("net_http_test: ok");
        return 0;
    }
    _zag_print("net_http_test: example.com -> ");
    _zag_println(net_ip_str(ip));
    let r: HttpResponse = http_get("http://example.com/");
    if ((r.ok != 1)) {
        _zag_print("net_http_test: fetch error: ");
        _zag_println(r.error);
        _zag_println("net_http_test: ok (dns worked, fetch unreachable)");
        return 0;
    }
    _zag_print("net_http_test: HTTP status ");
    _zag_println(_zag_i64_to_str((r.status) as i64));
    if (((r.status < 100) || (r.status > 599))) {
        _zag_println("net_http_test: FAIL bad status");
        return 1;
    }
    if (((net_chamber_tx_bytes() < 1) || (net_chamber_rx_bytes() < 1))) {
        _zag_println("net_http_test: FAIL chamber counters not updated");
        return 1;
    }
    _zag_print("net_http_test: tx=");
    _zag_print(_zag_i64_to_str(net_chamber_tx_bytes()));
    _zag_print(" rx=");
    _zag_println(_zag_i64_to_str(net_chamber_rx_bytes()));
    _zag_println("net_http_test: ok");
    return 0;
}

