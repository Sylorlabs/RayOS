fn chacha20_xor(key: *i8, nonce: *i8, counter: i64, data: *i8, dlen: i32, out: *i8) void {
    let ks: *i8 = _zag_malloc(64);
    let i: i32 = 0;
    while ((i < dlen)) {
        if (((i % 64) == 0)) {
            chacha_block(key, nonce, (counter + ((i / 64)) as i64), ks);
        }
        out[i] = ((((data[i]) as u8) as i64 ^ ((ks[(i % 64)]) as u8) as i64)) as i8;
        i = (i + 1);
    }
}

fn aead_pad16(n: i32) i32 {
    let r: i32 = (n % 16);
    if ((r == 0)) {
        return 0;
    }
    return (16 - r);
}

fn aead_mac_data(aad: *i8, aadlen: i32, ct: *i8, ctlen: i32, out: *i8) i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while ((i < aadlen)) {
        out[n] = aad[i];
        n = (n + 1);
        i = (i + 1);
    }
    let p: i32 = aead_pad16(aadlen);
    i = 0;
    while ((i < p)) {
        out[n] = (0) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    i = 0;
    while ((i < ctlen)) {
        out[n] = ct[i];
        n = (n + 1);
        i = (i + 1);
    }
    p = aead_pad16(ctlen);
    i = 0;
    while ((i < p)) {
        out[n] = (0) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    let a: i64 = (aadlen) as i64;
    i = 0;
    while ((i < 8)) {
        out[n] = (((a >> (i * 8)) & 255)) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    let c: i64 = (ctlen) as i64;
    i = 0;
    while ((i < 8)) {
        out[n] = (((c >> (i * 8)) & 255)) as i8;
        n = (n + 1);
        i = (i + 1);
    }
    return n;
}

fn aead_seal(key: *i8, nonce: *i8, aad: *i8, aadlen: i32, pt: *i8, dlen: i32, out: *i8) void {
    let polykey: *i8 = _zag_malloc(64);
    chacha_block(key, nonce, 0, polykey);
    chacha20_xor(key, nonce, 1, pt, dlen, out);
    let md: *i8 = _zag_malloc(((aadlen + dlen) + 64));
    let mdlen: i32 = aead_mac_data(aad, aadlen, out, dlen, md);
    poly1305(md, mdlen, polykey, (((out) as i64 + (dlen) as i64)) as *i8);
}

fn aead_open(key: *i8, nonce: *i8, aad: *i8, aadlen: i32, ct: *i8, ctlen: i32, out: *i8) i32 {
    if ((ctlen < 16)) {
        return 0;
    }
    let clen: i32 = (ctlen - 16);
    let polykey: *i8 = _zag_malloc(64);
    chacha_block(key, nonce, 0, polykey);
    let md: *i8 = _zag_malloc(((aadlen + clen) + 64));
    let mdlen: i32 = aead_mac_data(aad, aadlen, ct, clen, md);
    let tag: *i8 = _zag_malloc(16);
    poly1305(md, mdlen, polykey, tag);
    let i: i32 = 0;
    let diff: i32 = 0;
    while ((i < 16)) {
        if ((((tag[i]) as u8) as i32 != ((ct[(clen + i)]) as u8) as i32)) {
            diff = 1;
        }
        i = (i + 1);
    }
    if ((diff == 1)) {
        return 0;
    }
    chacha20_xor(key, nonce, 1, ct, clen, out);
    return 1;
}

fn crypto_random(out: *i8, n: i32) i32 {
    let path: []u8 = "/dev/urandom";
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(path), 0, 0, 0, 0, 0);
    if ((fd < 0)) {
        return (0 - 1);
    }
    let got: i32 = 0;
    while ((got < n)) {
        let r: i64 = _zag_raw_syscall(0, fd, ((out) as i64 + (got) as i64), ((n - got)) as i64, 0, 0, 0);
        if ((r <= 0)) {
            let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
            return (0 - 2);
        }
        got = (got + (r) as i32);
    }
    let _c: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return 0;
}

fn x25519_base(pub: *i8, priv: *i8) void {
    let base: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        base[i] = (0) as i8;
        i = (i + 1);
    }
    base[0] = (9) as i8;
    scalarmult(pub, priv, base);
}

fn x25519_shared(out: *i8, priv: *i8, peer: *i8) void {
    scalarmult(out, priv, peer);
}

fn ct_hex(o: *i8, n: i32) []u8 {
    let d: []u8 = "0123456789abcdef";
    let s: []u8 = "";
    let i: i32 = 0;
    while ((i < n)) {
        let v: i32 = ((o[i]) as u8) as i32;
        s = _zag_str_concat(s, d[(v / 16)..((v / 16) + 1)]);
        s = _zag_str_concat(s, d[(v % 16)..((v % 16) + 1)]);
        i = (i + 1);
    }
    return s;
}

fn main() i32 {
    _zag_println("crypto_test: running");
    let msg: []u8 = "abc";
    let m: *i8 = _zag_malloc(3);
    m[0] = (97) as i8;
    m[1] = (98) as i8;
    m[2] = (99) as i8;
    let out: *i8 = _zag_malloc(32);
    sha256(m, 3, out);
    if ((_zag_strcmp(ct_hex(out, 32), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == 0)) {
        _zag_println("crypto_test: FAIL sha256");
        return 1;
    }
    let priv: *i8 = _zag_malloc(32);
    let i: i32 = 0;
    while ((i < 32)) {
        priv[i] = ((i + 1)) as i8;
        i = (i + 1);
    }
    let pub: *i8 = _zag_malloc(32);
    x25519_base(pub, priv);
    let priv2: *i8 = _zag_malloc(32);
    i = 0;
    while ((i < 32)) {
        priv2[i] = ((100 - i)) as i8;
        i = (i + 1);
    }
    let pub2: *i8 = _zag_malloc(32);
    x25519_base(pub2, priv2);
    let s1: *i8 = _zag_malloc(32);
    let s2: *i8 = _zag_malloc(32);
    x25519_shared(s1, priv, pub2);
    x25519_shared(s2, priv2, pub);
    if ((_zag_strcmp(ct_hex(s1, 32), ct_hex(s2, 32)) == 0)) {
        _zag_println("crypto_test: FAIL x25519 ecdh mismatch");
        return 1;
    }
    let key: *i8 = _zag_malloc(32);
    i = 0;
    while ((i < 32)) {
        key[i] = ((i * 7)) as i8;
        i = (i + 1);
    }
    let nonce: *i8 = _zag_malloc(12);
    i = 0;
    while ((i < 12)) {
        nonce[i] = ((i * 3)) as i8;
        i = (i + 1);
    }
    let pt: []u8 = "RayOS ternary photonic secure channel";
    let ptb: *i8 = _zag_malloc(pt.len);
    i = 0;
    while ((i < pt.len)) {
        ptb[i] = (pt[i]) as i8;
        i = (i + 1);
    }
    let sealed: *i8 = _zag_malloc((pt.len + 16));
    aead_seal(key, nonce, key, 4, ptb, pt.len, sealed);
    let opened: *i8 = _zag_malloc(pt.len);
    let ok: i32 = aead_open(key, nonce, key, 4, sealed, (pt.len + 16), opened);
    if ((ok != 1)) {
        _zag_println("crypto_test: FAIL aead open");
        return 1;
    }
    let ou: *u8 = (opened) as *u8;
    if ((_zag_strcmp(ou[0..pt.len], pt) == 0)) {
        _zag_println("crypto_test: FAIL aead roundtrip");
        return 1;
    }
    _zag_println("crypto_test: sha256 + x25519 ecdh + chacha20poly1305 verified");
    _zag_println("crypto_test: ok");
    return 0;
}

