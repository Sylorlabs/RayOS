                at = (p + 1);
            } else {
                let depth2: i64 = ((len[i64](stack) - 1)) as i64;
                let index: i64 = html_push_node(&doc, HtmlNode{ .kind = html_node_element(), .parent = html_parent(&stack), .depth = depth2, .tag = tag, .text = "" });
                at = (p + 1);
                if ((((index >= 0) && (self_close == 0)) && (html_is_void(tag) == 0))) {
                    if ((html_is_rawtext(tag) == 1)) {
                        let cpos: i32 = html_find_close(source, at, tag);
                        let cend: i32 = source.len;
                        if ((cpos >= 0)) {
                            cend = cpos;
                        }
                        let inner: []u8 = html_trim(source, at, cend);
                        if ((inner.len > 0)) {
                            let _ri: i64 = html_push_node(&doc, HtmlNode{ .kind = html_node_text(), .parent = index, .depth = ((depth2 + 1)) as i64, .tag = "#text", .text = inner });
                        }
                        if ((cpos >= 0)) {
                            let gt: i32 = html_find_sequence(source, cpos, ">");
                            if ((gt >= 0)) {
                                at = (gt + 1);
                            } else {
                                at = source.len;
                            }
                        } else {
                            at = source.len;
                        }
                    } else if ((depth2 < html_max_depth())) {
                        push[i64](&stack, index);
                    } else {
                        doc.errors = (doc.errors + 1);
                    }
                }
            }
        }
    }
    free[i64](&stack);
    return doc;
}

fn html_count_kind(doc: *HtmlDocument, kind: i64) i64 {
    let count: i64 = 0;
    let i: i32 = 0;
    while ((i < len[HtmlNode](doc.*.nodes))) {
        if ((get[HtmlNode](doc.*.nodes, i).kind == kind)) {
            count = (count + 1);
        }
        i = (i + 1);
    }
    return count;
}

fn html_test_fail(msg: []u8) void {
    _zag_print("html_parser_test FAIL: ");
    _zag_println(msg);
    _zag_exit(1);
}

fn main() i32 {
    _zag_println("html_parser_test: running");
    let doc: HtmlDocument = html_parse("<!doctype html><html><body><h1>Ray Browser</h1><!--safe--><p>Native <b>Flash</b><br>DOM</p></body></html>");
    if ((doc.errors != 0)) {
        html_test_fail("valid page errors");
    }
    if ((html_count_kind(&doc, html_node_element()) != 6)) {
        html_test_fail("element count");
    }
    if ((html_count_kind(&doc, html_node_text()) != 4)) {
        html_test_fail("text count");
    }
    if ((html_equal_fold(get[HtmlNode](doc.nodes, 3).tag, "H1") != 1)) {
        html_test_fail("case fold");
    }
    html_document_free(&doc);
    let malformed: HtmlDocument = html_parse("<main><p>one</main></ghost>");
    if ((malformed.errors < 1)) {
        html_test_fail("mismatched close recovery");
    }
    if ((len[HtmlNode](malformed.nodes) < 3)) {
        html_test_fail("recovered DOM");
    }
    html_document_free(&malformed);
    if ((_zag_strcmp(html_decode("Fish &amp; Chips"), "Fish & Chips") == 0)) {
        html_test_fail("entity amp");
    }
    if ((_zag_strcmp(html_decode("5 &lt; 7 &gt; 3"), "5 < 7 > 3") == 0)) {
        html_test_fail("entity lt/gt");
    }
    if ((_zag_strcmp(html_decode("caf&#233; &copy;"), "cafe C") == 0)) {
        html_test_fail("entity numeric/copy fold");
    }
    if ((_zag_strcmp(html_decode("na&iuml;ve &szlig;"), "naive s") == 0)) {
        html_test_fail("named latin1 fold");
    }
    let rt: HtmlDocument = html_parse("<body><style>.a{x<y}</style><script>if(a<b&&c>d)f();</script><p>ok</p></body>");
    if ((rt.errors != 0)) {
        html_test_fail("rawtext spurious tags");
    }
    if ((html_count_kind(&rt, html_node_element()) != 4)) {
        html_test_fail("rawtext element count");
    }
    html_document_free(&rt);
    _zag_println("html_parser_test: entities + rawtext + fold verified");
    _zag_println("html_parser_test: ok");
    return 0;
}

