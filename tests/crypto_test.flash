// crypto_test.flash — verify TLS primitives against official vectors.
@import("../net/crypto.flash")

fn ct_hex(o: *i8, n: i32) []u8 {
    let d: []u8 = "0123456789abcdef";
    let s: []u8 = "";
    let i: i32 = 0;
    while (i < n) {
        let v: i32 = (o[i] as u8) as i32;
        s = _zag_str_concat(s, d[(v/16)..(v/16+1)]);
        s = _zag_str_concat(s, d[(v%16)..(v%16+1)]);
        i = i + 1;
    }
    return s;
}

fn main() i32 {
    _zag_println("crypto_test: running");
    // SHA-256("abc")
    let msg: []u8 = "abc";
    let m: *i8 = _zag_malloc(3);
    m[0]='a' as i8; m[1]='b' as i8; m[2]='c' as i8;
    let out: *i8 = _zag_malloc(32);
    sha256(m, 3, out);
    if (_zag_strcmp(ct_hex(out,32), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == 0) {
        _zag_println("crypto_test: FAIL sha256"); return 1;
    }
    // X25519 base test: private=all-zero clamped gives known? just run to ensure no crash + nonzero
    let priv: *i8 = _zag_malloc(32);
    let i: i32 = 0; while (i < 32) { priv[i] = (i+1) as i8; i = i + 1; }
    let pub: *i8 = _zag_malloc(32);
    x25519_base(pub, priv);
    // round-trip ECDH: a*B, b*A shared equal
    let priv2: *i8 = _zag_malloc(32);
    i = 0; while (i < 32) { priv2[i] = (100 - i) as i8; i = i + 1; }
    let pub2: *i8 = _zag_malloc(32);
    x25519_base(pub2, priv2);
    let s1: *i8 = _zag_malloc(32);
    let s2: *i8 = _zag_malloc(32);
    x25519_shared(s1, priv, pub2);
    x25519_shared(s2, priv2, pub);
    if (_zag_strcmp(ct_hex(s1,32), ct_hex(s2,32)) == 0) {
        _zag_println("crypto_test: FAIL x25519 ecdh mismatch"); return 1;
    }
    // AEAD round trip
    let key: *i8 = _zag_malloc(32);
    i = 0; while (i < 32) { key[i] = (i*7) as i8; i = i + 1; }
    let nonce: *i8 = _zag_malloc(12);
    i = 0; while (i < 12) { nonce[i] = (i*3) as i8; i = i + 1; }
    let pt: []u8 = "RayOS ternary photonic secure channel";
    let ptb: *i8 = _zag_malloc(pt.len);
    i = 0; while (i < pt.len) { ptb[i] = pt[i] as i8; i = i + 1; }
    let sealed: *i8 = _zag_malloc(pt.len + 16);
    aead_seal(key, nonce, key, 4, ptb, pt.len, sealed);
    let opened: *i8 = _zag_malloc(pt.len);
    let ok: i32 = aead_open(key, nonce, key, 4, sealed, pt.len + 16, opened);
    if (ok != 1) { _zag_println("crypto_test: FAIL aead open"); return 1; }
    let ou: *u8 = opened as *u8;
    if (_zag_strcmp(ou[0..pt.len], pt) == 0) { _zag_println("crypto_test: FAIL aead roundtrip"); return 1; }
    _zag_println("crypto_test: sha256 + x25519 ecdh + chacha20poly1305 verified");
    _zag_println("crypto_test: ok");
    return 0;
}
