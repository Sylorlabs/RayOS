extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64;

fn HW_PROT_READ() i64 {
    return 1;
}

fn HW_PROT_WRITE() i64 {
    return 2;
}

fn HW_PROT_RW() i64 {
    return 3;
}

fn HW_MAP_SHARED() i64 {
    return 1;
}

fn HW_O_RDWR() i64 {
    return 2;
}

fn HW_O_CREAT() i64 {
    return 64;
}

fn HW_O_RDWR_CREAT() i64 {
    return 66;
}

fn HW_MODE_0644() i64 {
    return 420;
}

fn HW_RT_MAGIC() i32 {
    return 1381259078;
}

fn HW_GLOBALS_ADDR() i64 {
    return 121634816000000;
}

fn HW_GLOBALS_BYTES() i64 {
    return 16384;
}

fn HW_MAP_FIXED_ANON_PRIVATE() i64 {
    return 1048610;
}

fn HW_GSLOT_HW_RT() i64 {
    return 0;
}

fn HW_GSLOT_DISPLAY() i64 {
    return 512;
}

fn HW_GSLOT_SCANOUT_LIVE() i64 {
    return 1024;
}

fn HW_GSLOT_GUEST_FB_SOH() i64 {
    return 1536;
}

fn HW_GSLOT_SLEEP_TSPEC() i64 {
    return 2048;
}

fn hw_globals() i64 {
    let addr: i64 = HW_GLOBALS_ADDR();
    let _p: i64 = _zag_raw_syscall(9, addr, HW_GLOBALS_BYTES(), (HW_PROT_RW()) as i32, HW_MAP_FIXED_ANON_PRIVATE(), (0 - 1), 0);
    return addr;
}

fn hw_rename(from: []u8, to: []u8) i32 {
    let rc: i64 = _zag_raw_syscall(82, hw_rt_path_cstr(from), hw_rt_path_cstr(to), 0, 0, 0, 0);
    return (rc) as i32;
}

fn hw_sleep_ms(ms: i32) void {
    if ((ms < 1)) {
        return;
    }
    let ts: i64 = (hw_globals() + HW_GSLOT_SLEEP_TSPEC());
    let secs: *i64 = (ts) as *i64;
    let nanos: *i64 = ((ts + 8)) as *i64;
    secs.* = ((ms / 1000)) as i64;
    nanos.* = (((ms % 1000)) as i64 * 1000000);
    let _rc: i64 = _zag_raw_syscall(35, ts, 0, 0, 0, 0, 0);
}

struct HwRtState {
    magic: i32,
    pid: i64,
    map_base: i64,
    map_size: i64,
    virt_base: i64,
    ready: i32,
    backend: i32,
}

fn hw_rt_getpid() i64 {
    return _zag_raw_syscall(39, 0, 0, 0, 0, 0, 0);
}

fn hw_rt_state_new() HwRtState {
    return HwRtState{ .magic = (HW_RT_MAGIC()) as i32, .pid = hw_rt_getpid(), .map_base = 0, .map_size = 0, .virt_base = (RAYOS_MMIO_BASE()) as i64, .ready = 0, .backend = 0 };
}

fn hw_rt_state_mut() *HwRtState {
    let st: *HwRtState = ((hw_globals() + HW_GSLOT_HW_RT())) as *HwRtState;
    if ((st.*.magic != (HW_RT_MAGIC()) as i32)) {
        st.* = hw_rt_state_new();
    }
    return st;
}

fn hw_rt_path_cstr(path: []u8) i64 {
    let raw: *i8 = _zag_malloc((path.len + 1));
    let i: i32 = 0;
    while ((i < path.len)) {
        raw[i] = path[i];
        i = (i + 1);
    }
    raw[path.len] = 0;
    return (raw) as i64;
}

fn hw_rt_mmap_devmem(size: i64, phys_off: i64) i64 {
    let devmem: []u8 = "/dev/mem";
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(devmem), (HW_O_RDWR()) as i32, 0, 0, 0, 0);
    if ((fd < 0)) {
        return 0;
    }
    let ptr: i64 = _zag_raw_syscall(9, 0, size, (HW_PROT_RW()) as i32, (HW_MAP_SHARED()) as i32, fd, phys_off);
    let _rc: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if ((ptr < 0)) {
        return 0;
    }
    return ptr;
}

fn hw_rt_unmap(addr: i64, size: i64) void {
    let _rc: i64 = _zag_raw_syscall(11, addr, size, 0, 0, 0, 0);
}

fn hw_rt_probe_writable(ptr: i64) i32 {
    let p: *i32 = (ptr) as *i32;
    let saved: i32 = p.*;
    let tag: i32 = 1381259078;
    p.* = tag;
    let got: i32 = p.*;
    p.* = saved;
    if ((got == tag)) {
        return 1;
    }
    return 0;
}

fn hw_rt_mmap_simfile(size: i64) i64 {
    let path: []u8 = "/tmp/rayos_mmio.bin";
    let fd: i64 = _zag_raw_syscall(2, hw_rt_path_cstr(path), (HW_O_RDWR_CREAT()) as i32, (HW_MODE_0644()) as i32, 0, 0, 0);
    if ((fd < 0)) {
        return 0;
    }
    let _ft: i64 = _zag_raw_syscall(77, fd, size, 0, 0, 0, 0);
    let ptr: i64 = _zag_raw_syscall(9, 0, size, (HW_PROT_RW()) as i32, (HW_MAP_SHARED()) as i32, fd, 0);
    let _rc: i64 = _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if ((ptr < 0)) {
        return 0;
    }
    return ptr;
}

fn hw_rt_init() i32 {
    let st: *HwRtState = hw_rt_state_mut();
    if ((st.*.ready == 1)) {
        return 0;
    }
    let size: i64 = (RAYOS_MMIO_MAP_BYTES()) as i64;
    let ptr: i64 = hw_rt_mmap_simfile(size);
    let backend: i32 = 2;
    if ((ptr == 0)) {
        ptr = hw_rt_mmap_devmem(size, (RAYOS_MMIO_BASE()) as i64);
        backend = 1;
        if (((ptr != 0) && (hw_rt_probe_writable(ptr) == 0))) {
            hw_rt_unmap(ptr, size);
            ptr = 0;
        }
    }
    if ((ptr == 0)) {
        return (0 - 1);
    }
    st.*.pid = hw_rt_getpid();
    st.*.map_base = ptr;
    st.*.map_size = size;
    st.*.virt_base = (RAYOS_MMIO_BASE()) as i64;
    st.*.backend = backend;
    st.*.ready = 1;
    return 0;
}

fn hw_rt_ensure() i32 {
    let st: *HwRtState = hw_rt_state_mut();
    if ((st.*.ready == 1)) {
        return 0;
    }
    return hw_rt_init();
}

fn mmio_read32(addr: i64) i32 {
    if ((hw_rt_ensure() != 0)) {
        return 0;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let off: i64 = (addr - st.*.virt_base);
    if (((off < 0) || ((off + 4) > st.*.map_size))) {
        return 0;
    }
    let bytes: *u8 = ((st.*.map_base + off)) as *u8;
    let out: i64 = 0;
    let i: i32 = 0;
    while ((i < 4)) {
        let limb: i64 = (bytes[i]) as i64;
        let j: i32 = 0;
        while ((j < i)) {
            limb = (limb * 256);
            j = (j + 1);
        }
        out = (out + limb);
        i = (i + 1);
    }
    if ((out >= 2147483648)) {
        out = (out - 4294967296);
    }
    return (out) as i32;
}

fn mmio_write32(addr: i64, val: i32) void {
    if ((hw_rt_ensure() != 0)) {
        return;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let off: i64 = (addr - st.*.virt_base);
    if (((off < 0) || ((off + 4) > st.*.map_size))) {
        return;
    }
    let pack: i64 = (val) as i64;
    if ((pack < 0)) {
        pack = (pack + 4294967296);
    }
    let bytes: *u8 = ((st.*.map_base + off)) as *u8;
    let shift: i64 = pack;
    let i: i32 = 0;
    while ((i < 4)) {
        let limb: i64 = (shift - ((shift / 256) * 256));
        bytes[i] = (limb) as u8;
        shift = (shift / 256);
        i = (i + 1);
    }
}

fn hw_mmio_ptr(addr: i64, need: i32) *i8 {
    if ((hw_rt_ensure() != 0)) {
        return null;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let off: i64 = (addr - st.*.virt_base);
    if (((off < 0) || ((off + (need) as i64) > st.*.map_size))) {
        return null;
    }
    return ((st.*.map_base + off)) as *i8;
}

fn hw_rt_backend_host() i32 {
    if ((hw_rt_ensure() != 0)) {
        return 1;
    }
    let st: *HwRtState = hw_rt_state_mut();
    if ((st.*.backend == 2)) {
        return 1;
    }
    return 0;
}

fn hw_fence() void {
    if ((hw_rt_ensure() != 0)) {
        return;
    }
    let st: *HwRtState = hw_rt_state_mut();
    let probe: i32 = mmio_read32(st.*.virt_base);
    let _sink: i32 = (probe + 0);
}

fn LINUX_IMAGE_DEFAULT_PATH() []u8 {
    return "vm/linux.bin";
}

fn LINUX_IMAGE_VMLINUZ_PATH() []u8 {
    return "vm/vmlinuz";
}

fn linux_image_resolve_path() []u8 {
    let linux_bin: []u8 = LINUX_IMAGE_DEFAULT_PATH();
    if ((_zag_file_exists(linux_bin) == 1)) {
        return linux_bin;
    }
    let vmlinuz: []u8 = LINUX_IMAGE_VMLINUZ_PATH();
    if ((_zag_file_exists(vmlinuz) == 1)) {
        return vmlinuz;
    }
    return "";
}

fn linux_image_load_bzimage(guest_ram: *ArrayList[u8]) i32 {
    let path: []u8 = linux_image_resolve_path();
    if ((path.len < 1)) {
        return linux_boot_load_bzimage("", guest_ram);
    }
    return linux_boot_load_real(path, guest_ram);
}

fn linux_image_load(path: []u8, guest_ram: *ArrayList[u8]) i32 {
    if ((path.len < 1)) {
        return linux_image_load_bzimage(guest_ram);
    }
    let raw: []u8 = _zag_read_file(path);
    if ((raw.len < (LINUX_BOOT_SECTOR_BYTES()) as i32)) {
        return linux_boot_load_bzimage(path, guest_ram);
    }
    return linux_boot_load_real(path, guest_ram);
}

fn test_fail(msg: []u8) void {
    _zag_print("linux_boot_protocol_test FAIL: ");
    _zag_println(msg);
    _zag_exit(1);
}

fn test_expect_u64(got: u64, want_min: u64, msg: []u8) void {
    if ((got <= want_min)) {
        test_fail(msg);
    }
}

fn test_expect_i32(got: i32, want: i32, msg: []u8) void {
    if ((got != want)) {
        test_fail(msg);
    }
}

fn main() i32 {
    _zag_println("linux_boot_protocol_test: running");
    if ((hw_rt_init() != 0)) {
        test_fail("hw_rt_init");
    }
    let guest_ram: ArrayList[u8] = guest_ram_new_default();
    let rc: i32 = linux_image_load_bzimage(&guest_ram);
    if ((rc != 0)) {
        test_fail("linux_image_load_bzimage");
    }
    let magic: i32 = linux_boot_magic_at_boot_sector(guest_ram);
    test_expect_i32(magic, (LINUX_BOOT_FLAG_MAGIC()) as i32, "boot sector magic 0xAA55");
    if ((linux_boot_params_valid(guest_ram) != 1)) {
        test_fail("boot_params magic");
    }
    let boot_off: i32 = (GPA_BOOT_SECTOR()) as i32;
    if ((get[u8](&guest_ram, (boot_off + 510)) != 85)) {
        test_fail("boot sig lo");
    }
    if ((get[u8](&guest_ram, (boot_off + 511)) != 170)) {
        test_fail("boot sig hi");
    }
    let hdr_off: i32 = (((GPA_LINUX_SETUP()) as i32 + (LINUX_OFF_HDR_SIG()) as i32) - (LINUX_BOOT_SECTOR_BYTES()) as i32);
    if ((get[u8](&guest_ram, (hdr_off + 0)) != 72)) {
        test_fail("setup HdrS[0]");
    }
    if ((get[u8](&guest_ram, (hdr_off + 3)) != 83)) {
        test_fail("setup HdrS[3]");
    }
    let hv: *BinaryTranslationMatrix = btm_new();
    linux_boot_attach(hv, &guest_ram);
    let pc0: u64 = linux_boot_pc(hv);
    if ((pc0 != (GPA_BOOT_SECTOR()) as u64)) {
        test_fail("linux_boot_attach pc");
    }
    let stepped: i32 = linux_boot_step_n(hv, guest_ram, 3);
    if ((stepped < 1)) {
        test_fail("linux_boot_step_n");
    }
    let pc1: u64 = linux_boot_pc(hv);
    if ((pc1 == 0)) {
        test_fail("guest pc zero after step");
    }
    free[u8](&guest_ram);
    btm_free(hv);
    _zag_println("linux_boot_protocol_test: ok");
    return 0;
}

